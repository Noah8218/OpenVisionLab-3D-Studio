<Project>
  <PropertyGroup>
    <Version>0.8.1-dev</Version>
    <OpenVisionLabProductVersion>0.8.1-dev</OpenVisionLabProductVersion>
    <OpenVisionLabViewerHostApiVersion>1.2</OpenVisionLabViewerHostApiVersion>
    <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="OpenVisionLabProductVersion" Value="$(OpenVisionLabProductVersion)" />
    <AssemblyMetadata Include="OpenVisionLabViewerHostApiVersion" Value="$(OpenVisionLabViewerHostApiVersion)" />
  </ItemGroup>
</Project>
