<UserControl x:Class="OpenVisionLab.ThreeD.Presentation.Controls.HeightLegendRangeBar"
             x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="112" MaxWidth="160" VerticalAlignment="Bottom" Focusable="False" PreviewMouseWheel="OnWheel" MouseLeftButtonDown="OnLegendMouseDown">
    <UserControl.Resources>
        <Style x:Key="Handle" TargetType="Thumb">
            <Setter Property="Width" Value="22" /><Setter Property="Height" Value="12" /><Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="SizeNS" /><Setter Property="Foreground" Value="{Binding Foreground, ElementName=Root}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Border x:Name="Surface" Background="{Binding Background, ElementName=Root}" BorderBrush="{Binding BorderBrush, ElementName=Root}" BorderThickness="1" CornerRadius="2">
                    <TextBlock Text="↕" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AutoButton" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding Foreground, ElementName=Root}" /><Setter Property="Background" Value="{Binding Background, ElementName=Root}" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=Root}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="3,0" />
            <Setter Property="FontSize" Value="10" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="RangePlotRow" Height="118" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="18" MinHeight="20" Margin="3,0,0,0" Click="OnToggleCollapsed" ToolTip="{Binding CollapseCaption, ElementName=Root}" AutomationProperties.Name="{Binding CollapseCaption, ElementName=Root}" AutomationProperties.AutomationId="HeightLegendCollapse">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AutoButton}"><Setter Property="Content" Value="−" /><Style.Triggers>
                        <DataTrigger Binding="{Binding IsEffectivelyCollapsed, ElementName=Root}" Value="True"><Setter Property="Content" Value="+" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Content="{Binding AutoCaption, ElementName=Root}" Style="{StaticResource AutoButton}" Click="OnAuto" AutomationProperties.Name="{Binding AutoCaption, ElementName=Root}" />
                <Border Margin="0,0,3,0" Padding="3,1" BorderThickness="1" BorderBrush="{Binding BorderBrush, ElementName=Root}" CornerRadius="2">
                    <TextBlock Text="{Binding ModeCaption, ElementName=Root}" TextWrapping="Wrap" FontSize="10" VerticalAlignment="Center" AutomationProperties.AutomationId="HeightLegendModeChip" />
                </Border>
            </DockPanel>
            <TextBlock FontSize="10" Text="{Binding Unit, ElementName=Root}" HorizontalAlignment="Right" />
            <TextBlock x:Name="SpaceConstraintMessage" FontSize="10" TextWrapping="Wrap" Text="{Binding SpaceConstraintCaption, ElementName=Root}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Canvas x:Name="Track" Grid.Row="1" Width="26" Background="Transparent" SizeChanged="OnTrackSizeChanged" IsVisibleChanged="OnTrackVisibilityChanged" MouseLeftButtonDown="OnTrackDoubleClick">
            <Canvas.Style><Style TargetType="Canvas"><Style.Triggers><DataTrigger Binding="{Binding ColorStyle, ElementName=Root}" Value="tolerance"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsEffectivelyCollapsed, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Canvas.Style>
            <Path x:Name="HeightHistogram" Canvas.Left="0" Fill="{Binding Foreground, ElementName=Root}" Opacity="0.28" IsHitTestVisible="False" />
            <Line x:Name="AutomaticUpperLine" X1="0" X2="26" Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="1" StrokeDashArray="2,2" IsHitTestVisible="False" />
            <Line x:Name="AutomaticLowerLine" X1="0" X2="26" Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="1" StrokeDashArray="2,2" IsHitTestVisible="False" />
            <Border x:Name="GradientTrack" Canvas.Left="7" Width="10" BorderBrush="{Binding BorderBrush, ElementName=Root}" BorderThickness="1" CornerRadius="2" Background="{Binding Gradient, ElementName=Root}" />
            <Thumb x:Name="RangeBody" Canvas.Left="7" Width="10" Cursor="SizeNS" Background="Transparent" Focusable="True" KeyboardNavigation.IsTabStop="False" KeyDown="OnBodyKeyDown" DragStarted="OnDragStarted" DragDelta="OnBodyDrag" DragCompleted="OnDragCompleted" MouseDoubleClick="OnAuto" AutomationProperties.Name="{Binding ModeCaption, ElementName=Root}">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" BorderBrush="{Binding BorderBrush, ElementName=Root}" BorderThickness="1" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb x:Name="UpperHandle" Canvas.Left="1" Style="{StaticResource Handle}" DragStarted="OnDragStarted" DragDelta="OnUpperDrag" DragCompleted="OnDragCompleted" KeyDown="OnHandleKeyDown" MouseDoubleClick="OnNumericInput" AutomationProperties.Name="{Binding UpperCaption, ElementName=Root}" />
            <Thumb x:Name="LowerHandle" Canvas.Left="1" Style="{StaticResource Handle}" DragStarted="OnDragStarted" DragDelta="OnLowerDrag" DragCompleted="OnDragCompleted" KeyDown="OnHandleKeyDown" MouseDoubleClick="OnNumericInput" AutomationProperties.Name="{Binding LowerCaption, ElementName=Root}" />
        </Canvas>
        <Canvas Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" IsHitTestVisible="False">
            <Canvas.Style><Style TargetType="Canvas"><Style.Triggers><DataTrigger Binding="{Binding ColorStyle, ElementName=Root}" Value="tolerance"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsEffectivelyCollapsed, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Canvas.Style>
            <TextBlock x:Name="UpperValueLabel" Text="{Binding Maximum, ElementName=Root, StringFormat={}{0:0.##}}" FontSize="10.5" FontFamily="Consolas" />
            <TextBlock x:Name="UpperQuarterLabel" FontSize="10.5" FontFamily="Consolas" />
            <TextBlock x:Name="MiddleLabel" FontSize="10.5" FontFamily="Consolas" />
            <TextBlock x:Name="LowerQuarterLabel" FontSize="10.5" FontFamily="Consolas" />
            <TextBlock x:Name="LowerValueLabel" Text="{Binding Minimum, ElementName=Root, StringFormat={}{0:0.##}}" FontSize="10.5" FontFamily="Consolas" />
        </Canvas>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,0" IsHitTestVisible="False">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                <DataTrigger Binding="{Binding ColorStyle, ElementName=Root}" Value="tolerance"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsEffectivelyCollapsed, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="10" Height="54" Background="{Binding Gradient, ElementName=Root}" CornerRadius="2" BorderBrush="{Binding BorderBrush, ElementName=Root}" BorderThickness="1" />
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{Binding AboveCaption, ElementName=Root}" FontSize="10.5" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding WithinCaption, ElementName=Root}" FontSize="10.5" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding BelowCaption, ElementName=Root}" FontSize="10.5" TextWrapping="Wrap" />
            </Grid>
        </Grid>
        <ScrollViewer x:Name="LegendInformationScroll" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsEffectivelyCollapsed, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
            <TextBlock x:Name="LegendInformation" FontSize="11" TextWrapping="Wrap" Text="{Binding Information, ElementName=Root}" />
        </ScrollViewer>
        <Popup x:Name="NumericPopup" Placement="Left" PlacementTarget="{Binding ElementName=Track}" StaysOpen="False" AllowsTransparency="True" Opened="OnNumericOpened" Closed="OnNumericClosed">
            <Border Padding="8" MinWidth="180" Background="{Binding Background, ElementName=Root}" BorderBrush="{Binding BorderBrush, ElementName=Root}" BorderThickness="1" CornerRadius="4">
                <StackPanel><TextBlock x:Name="InputCaption" Foreground="{Binding Foreground, ElementName=Root}" />
                    <TextBox x:Name="NumericInput" Margin="0,5,0,0" MaxWidth="320" Background="{Binding Background, ElementName=Root}" Foreground="{Binding Foreground, ElementName=Root}" BorderBrush="{Binding BorderBrush, ElementName=Root}" Padding="5" KeyDown="OnNumericKeyDown" />
                    <TextBlock x:Name="NumericError" Text="{Binding ErrorText, ElementName=Root}" Foreground="{DynamicResource ThreeD.WarningBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
