<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>OpenVisionLab.ThreeD.Shell</RootNamespace>
    <AssemblyName>OpenVisionLab.ThreeD.Shell</AssemblyName>
  </PropertyGroup>

  <Target Name="GenerateOpenVisionIntegrationBuildIdentity" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_OpenVisionRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</_OpenVisionRepositoryRoot>
      <_OpenVisionBuildIdentityFile>$(IntermediateOutputPath)OpenVisionIntegrationBuildIdentity.g.cs</_OpenVisionBuildIdentityFile>
    </PropertyGroup>
    <Exec Command="git -C &quot;$(_OpenVisionRepositoryRoot)&quot; rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="Low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_OpenVisionCommitOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_OpenVisionCommitExitCode" />
    </Exec>
    <Exec Command="git -C &quot;$(_OpenVisionRepositoryRoot)&quot; status --porcelain=v1 --untracked-files=normal -- . &quot;:(exclude)src/OpenVisionLab.ThreeD.Shell/*_wpftmp.csproj&quot;" ConsoleToMSBuild="true" StandardOutputImportance="Low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_OpenVisionStatusOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_OpenVisionStatusExitCode" />
    </Exec>
    <PropertyGroup>
      <_OpenVisionSourceCommit Condition="'$(_OpenVisionCommitExitCode)' == '0'">@(_OpenVisionCommitOutput)</_OpenVisionSourceCommit>
      <_OpenVisionSourceCommit Condition="'$(_OpenVisionSourceCommit)' == ''">unknown</_OpenVisionSourceCommit>
      <_OpenVisionSourceState Condition="'$(_OpenVisionCommitExitCode)' != '0' or '$(_OpenVisionStatusExitCode)' != '0'">unknown</_OpenVisionSourceState>
      <_OpenVisionSourceState Condition="'$(_OpenVisionSourceState)' == '' and '@(_OpenVisionStatusOutput)' == ''">clean</_OpenVisionSourceState>
      <_OpenVisionSourceState Condition="'$(_OpenVisionSourceState)' == ''">dirty</_OpenVisionSourceState>
    </PropertyGroup>
    <ItemGroup>
      <_OpenVisionBuildIdentityAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>OpenVisionSourceCommit</_Parameter1>
        <_Parameter2>$(_OpenVisionSourceCommit)</_Parameter2>
      </_OpenVisionBuildIdentityAttribute>
      <_OpenVisionBuildIdentityAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>OpenVisionSourceState</_Parameter1>
        <_Parameter2>$(_OpenVisionSourceState)</_Parameter2>
      </_OpenVisionBuildIdentityAttribute>
      <Compile Include="$(_OpenVisionBuildIdentityFile)" />
    </ItemGroup>
    <WriteCodeFragment Language="C#" OutputFile="$(_OpenVisionBuildIdentityFile)" AssemblyAttributes="@(_OpenVisionBuildIdentityAttribute)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="OpenVisionLab.WpfPropertyGrid.ThreeD" Version="[1.0.0-ovl3d.1]" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenVisionLab.ThreeD.Core\OpenVisionLab.ThreeD.Core.csproj" />
    <ProjectReference Include="..\OpenVisionLab.ThreeD.Data\OpenVisionLab.ThreeD.Data.csproj" />
    <ProjectReference Include="..\OpenVisionLab.ThreeD.Docking.Controls\OpenVisionLab.ThreeD.Docking.Controls.csproj" />
    <ProjectReference Include="..\OpenVisionLab.ThreeD.Presentation\OpenVisionLab.ThreeD.Presentation.csproj" />
    <ProjectReference Include="..\OpenVisionLab.ThreeD.Reporting\OpenVisionLab.ThreeD.Reporting.csproj" />
    <ProjectReference Include="..\OpenVisionLab.ThreeD.Tools\OpenVisionLab.ThreeD.Tools.csproj" />
    <ProjectReference Include="..\OpenVisionLab.ThreeD.Viewer\OpenVisionLab.ThreeD.Viewer.csproj" />
    <ProjectReference Include="..\OpenVisionLab.Logging\OpenVisionLab.Logging.csproj" />
    <ProjectReference Include="..\OpenVisionLab.Logging.Controls\OpenVisionLab.Logging.Controls.csproj" />
    <ProjectReference Include="..\OpenVisionLab.Localization\OpenVisionLab.Localization.csproj" />
    <ProjectReference Include="..\OpenVisionLab.Wpf.MessageDialogs\OpenVisionLab.Wpf.MessageDialogs.csproj"
                      Aliases="OvlMessageDialogs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\OpenVisionLab.Logging\log4net.config"
          Link="log4net.config"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
