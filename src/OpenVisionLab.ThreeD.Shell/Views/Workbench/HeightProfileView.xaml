<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.HeightProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:host="clr-namespace:OpenVisionLab.ThreeD.Viewer.Hosting;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             Foreground="{DynamicResource ThreeD.TextBrush}"
             AutomationProperties.AutomationId="HeightProfileView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ProfileRuntimeTextConverter" />
    </UserControl.Resources>
    <Border Padding="10,8" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
            <WrapPanel>
                <TextBlock Margin="0,3,12,3" VerticalAlignment="Center" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.Profile.Title, Korean='A–B 높이 단면', English='A–B height profile'}" />
                <Button Margin="3,3,0,3" Padding="7,3" Content="{i18n:ThreeDText Key=ThreeD.Profile.Repick, Korean='다시 선택', English='Repick'}"
                        Command="{Binding ProfileActionCommand}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Repick}" AutomationProperties.AutomationId="ProfileRepick" />
                <Button Margin="3,3,0,3" Padding="7,3" Content="{i18n:ThreeDText Key=ThreeD.Profile.Reverse, Korean='방향 바꾸기', English='Reverse direction'}"
                        Command="{Binding ProfileActionCommand}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Swap}" AutomationProperties.AutomationId="ProfileSwap" />
                <Button Margin="3,3,0,3" Padding="7,3" Content="{i18n:ThreeDText Key=ThreeD.Profile.Cancel, Korean='선택 취소', English='Cancel pick'}"
                        Command="{Binding ProfileActionCommand}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Cancel}"
                        Visibility="{Binding ProfileIsPicking, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="ProfileCancel" />
                <Button Margin="3,3,0,3" Padding="7,3" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Profile.Collapse, Korean='그래프 접기 또는 펼치기', English='Collapse or expand graph'}"
                        Command="{Binding ProfileActionCommand}" CommandParameter="{x:Static host:ViewerHeightProfileAction.ToggleCollapsed}" AutomationProperties.AutomationId="ProfileCollapse">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="{i18n:ThreeDText Key=ThreeD.Profile.ExpandGraph, Korean='그래프 펼치기', English='Expand graph'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProfileBodyVisible}" Value="True">
                                    <Setter Property="Content" Value="{i18n:ThreeDText Key=ThreeD.Profile.CollapseGraph, Korean='그래프 접기', English='Collapse graph'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="3,3,0,3" Padding="7,3" Content="{i18n:ThreeDText Key=ThreeD.Profile.Clear, Korean='측정 지우기', English='Clear measurement'}"
                        Command="{Binding ProfileActionCommand}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Clear}" AutomationProperties.AutomationId="ProfileClear" />
            </WrapPanel>
            <StackPanel Visibility="{Binding ProfileBodyVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <WrapPanel Margin="0,8,0,2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                        <TextBlock Text="{i18n:ThreeDText Key=ThreeD.Profile.XyDistance, Korean='XY 거리 ', English='XY distance '}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding ProfileGridDistance}" />
                        <TextBlock Margin="3,0,0,0" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{i18n:ThreeDText Key=ThreeD.Profile.Cells, Korean='셀', English='cells'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                        <TextBlock Text="{i18n:ThreeDText Key=ThreeD.Profile.SpatialDistance, Korean='3D 거리 ', English='3D distance '}" />
                        <TextBlock Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{i18n:ThreeDText Key=ThreeD.Profile.Uncalibrated, Korean='— · 교정 없음', English='— · no calibration'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{i18n:ThreeDText Key=ThreeD.Profile.HeightDifference, Korean='높이 차이 ', English='Height difference '}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding ProfileHeightDelta}" />
                        <TextBlock Margin="3,0,0,0" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{i18n:ThreeDText Key=ThreeD.Profile.RawHeight, Korean='원시 높이', English='raw height'}" />
                    </StackPanel>
                </WrapPanel>
                <Border Height="94" Padding="6" Background="{DynamicResource ThreeD.ViewportBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <Viewbox Stretch="Fill">
                        <Canvas Width="240" Height="54" Background="Transparent" MouseMove="OnTraceMouseMove">
                            <Line X1="0" Y1="13.5" X2="240" Y2="13.5" Stroke="{DynamicResource ThreeD.DividerBrush}" StrokeThickness="0.5" />
                            <Line X1="0" Y1="27" X2="240" Y2="27" Stroke="{DynamicResource ThreeD.DividerBrush}" StrokeThickness="0.5" />
                            <Line X1="0" Y1="40.5" X2="240" Y2="40.5" Stroke="{DynamicResource ThreeD.DividerBrush}" StrokeThickness="0.5" />
                            <Path Data="{Binding ProfilePathData}" Stroke="{DynamicResource ThreeD.WarningBrush}" StrokeThickness="1.1" StrokeLineJoin="Round" />
                            <Line X1="{Binding ProfileLinkedCursorX}" X2="{Binding ProfileLinkedCursorX}" Y1="0" Y2="54" Stroke="{DynamicResource ThreeD.InfoBrush}" StrokeThickness="1"
                                  Visibility="{Binding ProfileLinkedCursorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Ellipse Width="6" Height="6" Canvas.Left="{Binding ProfileLinkedCursorMarkerLeft}" Canvas.Top="{Binding ProfileLinkedCursorMarkerTop}"
                                     Fill="{DynamicResource ThreeD.InfoBrush}" Visibility="{Binding ProfileLinkedCursorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.InfoBrush}" TextWrapping="Wrap"
                           Visibility="{Binding ProfileLinkedCursorVisible, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="ProfileCursorReadout">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ProfileRuntimeTextConverter}" ConverterParameter="ProfileCursor">
                            <Binding Path="ProfileLinkedCursorSummary" />
                            <Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="A" />
                    <TextBlock Grid.Column="1" Margin="8,0" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                               Text="{i18n:ThreeDText Key=ThreeD.Profile.Axis, Korean='가로: XY 거리(셀) · 세로: 높이(원시 높이) · 결측은 끊어서 표시', English='X: XY distance (cells) · Y: raw height · missing cells break the trace'}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="B" />
                </Grid>
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding ProfileEndpointSummary}" TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding ProfileRange}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.InfoBrush}" Text="{i18n:ThreeDText Key=ThreeD.Profile.PickHint, Korean='뷰에서 A, B 순서로 두 점을 선택하세요. Esc: 선택 취소', English='Pick A, then B in the view. Esc: cancel.'}" TextWrapping="Wrap"
                           Visibility="{Binding ProfileIsPicking, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
