<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.LandmarkCorrespondenceEvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
             AutomationProperties.AutomationId="LandmarkCorrespondenceEvidenceView">
    <Grid Margin="12,8" Background="{DynamicResource ThreeD.PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{DynamicResource ThreeD.DockPanelTitleTextStyle}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.CorrespondenceEvidence.Title, Korean='랜드마크 대응 정보', English='Landmark Correspondence Evidence'}" />
                <TextBlock Style="{DynamicResource ThreeD.DockPanelCaptionTextStyle}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.CorrespondenceEvidence.Caption, Korean='기준점 대응 결과', English='Landmark correspondence result'}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Style="{DynamicResource ThreeD.DockPanelStatusCardStyle}"
                    ToolTip="{i18n:ThreeDText Key=ThreeD.Workbench.CorrespondenceEvidence.ReadOnlyTip, Korean='기준점 대응 결과 · 읽기 전용', English='Landmark correspondence result · read only'}"
                    AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Workbench.CorrespondenceEvidence.ReadOnlyAction, Korean='기준점 대응 결과', English='Landmark correspondence result'}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Width="13" Height="13" Margin="0,0,4,0" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Symbol="Document24" />
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{i18n:ThreeDText Key=ThreeD.Workbench.CorrespondenceEvidence.ReadOnly, Korean='읽기 전용', English='Read-only'}" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="1"
                Margin="0,8,0,6"
                Padding="10,8"
                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{i18n:ThreeDText Key=ThreeD.Workbench.CorrespondenceEvidence.PublishedInputs, Korean='적용된 입력', English='Applied inputs'}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding LandmarkCorrespondenceUpstreamSummary}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{i18n:ThreeDText Key=ThreeD.Workbench.CorrespondenceEvidence.CurrentState, Korean='현재 대응 상태', English='Current correspondence state'}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThreeD.PrimaryTextBrush}" TextWrapping="Wrap" Text="{Binding LandmarkCorrespondenceEvidenceSummary}" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{Binding LandmarkCorrespondenceOutputHashSummary}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="2"
                   FontSize="12"
                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.CorrespondenceEvidence.Guidance, Korean='기준점 4개와 대응점 4개는 각각 한 평면에 놓이지 않아야 합니다. 변환 행렬은 XYZ 어파인 계산 도구에서 생성합니다.', English='Each set of four source and reference points must be non-coplanar. Create the transform with XYZ Affine Solve.'}" />
    </Grid>
</UserControl>
