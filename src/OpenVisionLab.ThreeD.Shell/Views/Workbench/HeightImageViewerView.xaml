<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.HeightImageViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource ThreeD.ViewportBrush}"
             Focusable="True"
             PreviewKeyDown="HeightImageViewer_PreviewKeyDown"
             AutomationProperties.AutomationId="HeightImageViewer">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="7,5"
                Background="{DynamicResource ThreeD.CommandBarBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ui:SymbolIcon Width="17"
                                       Height="17"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource ThreeD.InfoBrush}"
                                       Symbol="Image24" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.TextBrush}"
                                   Text="{Binding Localization.HeightImage}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               FontSize="9.5"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{Binding Status}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">
                        <Button Margin="0,0,4,0"
                                Padding="7,3"
                                Command="{Binding FitCommand}"
                                Content="{Binding Localization.HeightImageFit}"
                                ToolTip="{Binding Localization.HeightImageFit}"
                                AutomationProperties.Name="{Binding Localization.HeightImageFit}" />
                        <Button Margin="0,0,7,0"
                                Padding="7,3"
                                Command="{Binding ActualPixelsCommand}"
                                Content="{Binding Localization.HeightImageActualPixels}"
                                ToolTip="{Binding Localization.HeightImageActualPixels}"
                                AutomationProperties.Name="{Binding Localization.HeightImageActualPixels}" />
                        <Button Margin="0,0,3,0"
                                Padding="6,3"
                                Command="{Binding ZoomOutCommand}"
                                Content="{Binding Localization.HeightImageZoomOut}"
                                ToolTip="{Binding Localization.HeightImageZoomOut}"
                                AutomationProperties.Name="{Binding Localization.HeightImageZoomOut}" />
                        <TextBlock Width="50"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource ThreeD.TextBrush}"
                                   Text="{Binding ZoomSummary}"
                                   TextAlignment="Center" />
                        <Button Padding="6,3"
                                Command="{Binding ZoomInCommand}"
                                Content="{Binding Localization.HeightImageZoomIn}"
                                ToolTip="{Binding Localization.HeightImageZoomIn}"
                                AutomationProperties.Name="{Binding Localization.HeightImageZoomIn}" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,5,0,0"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="HeightImageDisplayRangeControls">
                    <TextBlock Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               FontSize="9"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{Binding Localization.HeightImagePalette}" />
                    <ComboBox Width="94"
                              Height="24"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding PaletteChoices}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedPalette, Mode=TwoWay}"
                              ToolTip="{Binding Localization.HeightImagePalette}"
                              AutomationProperties.Name="{Binding Localization.HeightImagePalette}" />
                    <Button Height="24"
                            Margin="0,0,8,0"
                            Padding="7,2"
                            Command="{Binding AutoRangeCommand}"
                            Content="{Binding Localization.HeightImageAutoRange}"
                            ToolTip="{Binding Localization.HeightImageAutoRangeToolTip}"
                            AutomationProperties.Name="{Binding Localization.HeightImageAutoRange}" />
                    <StackPanel Margin="0,0,6,0"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,3,0"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding Localization.HeightImageRangeMinimum}" />
                        <TextBox Width="67"
                                 Height="24"
                                 Padding="4,2"
                                 Text="{Binding RangeMinimumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Localization.HeightImageRangeMinimum}"
                                 AutomationProperties.Name="{Binding Localization.HeightImageRangeMinimum}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,3,0"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding Localization.HeightImageRangeMaximum}" />
                        <TextBox Width="67"
                                 Height="24"
                                 Padding="4,2"
                                 Text="{Binding RangeMaximumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Localization.HeightImageRangeMaximum}"
                                 AutomationProperties.Name="{Binding Localization.HeightImageRangeMaximum}" />
                    </StackPanel>
                    <Button Height="24"
                            Padding="8,2"
                            Command="{Binding ApplyManualRangeCommand}"
                            Content="{Binding Localization.HeightImageApplyRange}"
                            ToolTip="{Binding Localization.HeightImageApplyRangeToolTip}"
                            AutomationProperties.Name="{Binding Localization.HeightImageApplyRange}" />
                </WrapPanel>
                <StackPanel Margin="0,4,0,0">
                    <TextBlock FontSize="8.5"
                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                               Text="{Binding DisplayRangeSummary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="8.5"
                               Foreground="{DynamicResource ThreeD.WarningBrush}"
                               Text="{Binding RangeError}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasRangeError, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <WrapPanel Margin="0,4,0,0"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="HeightImageInvalidOverlayControls">
                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding ShowInvalidCells, Mode=TwoWay}"
                              Content="{Binding Localization.HeightImageInvalidOverlay}"
                              ToolTip="{Binding Localization.HeightImageInvalidOverlayToolTip}"
                              AutomationProperties.AutomationId="HeightImageInvalidOverlayToggle"
                              AutomationProperties.Name="{Binding Localization.HeightImageInvalidOverlay}" />
                    <Border Width="11"
                            Height="11"
                            Margin="9,0,4,0"
                            VerticalAlignment="Center"
                            Background="#E11D8D"
                            BorderBrush="#FFF1F5F9"
                            BorderThickness="1"
                            CornerRadius="1" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="8.5"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{Binding InvalidOverlaySummary}"
                               TextTrimming="CharacterEllipsis" />
                </WrapPanel>
                <Border Margin="0,5,0,0"
                        Padding="6,4"
                        Background="#1400f0e8"
                        BorderBrush="#5500f0e8"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding RoiWorkspace.HasContext, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="HeightImageRoiToolbar">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Width="10"
                                    Height="10"
                                    Margin="0,0,4,0"
                                    Background="#3300f0e8"
                                    BorderBrush="#00f0e8"
                                    BorderThickness="2" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="9"
                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                       Text="{Binding Localization.ReferenceRoi}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Width="10"
                                    Height="10"
                                    Margin="0,0,4,0"
                                    Background="#33ff9f1c"
                                    BorderBrush="#ff9f1c"
                                    BorderThickness="2" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="9"
                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                       Text="{Binding Localization.MeasurementRoi}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.InfoBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding RoiWorkspace.ActiveRoleSummary, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run FontWeight="SemiBold"
                                 Text="{Binding RoiWorkspace.LifecycleSummary, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal">
                            <Button Padding="7,2"
                                    Command="{Binding RoiWorkspace.DeleteCommand}"
                                    Content="{Binding Localization.HeightImageRoiDelete}"
                                    ToolTip="Delete"
                                    AutomationProperties.AutomationId="HeightImageRoiDelete">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RoiWorkspace.IsCaptureActive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="4"
                                   Margin="0,4,0,0"
                                   FontSize="8.5"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding RoiWorkspace.InteractionHint}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              ClipToBounds="True"
              Background="#111827">
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                          PreviewMouseDown="ImageScrollViewer_PreviewMouseDown"
                          PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                          PreviewMouseUp="ImageScrollViewer_PreviewMouseUp"
                          MouseLeave="ImageScrollViewer_MouseLeave"
                          SizeChanged="ImageScrollViewer_SizeChanged">
                <Grid x:Name="ImageSurface"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="#111827">
                    <Image x:Name="HeightImage"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True"
                           Stretch="Fill"
                           MouseLeftButtonDown="HeightImage_MouseLeftButtonDown"
                           MouseLeftButtonUp="HeightImage_MouseLeftButtonUp"
                           MouseMove="HeightImage_MouseMove"
                           MouseLeave="HeightImage_MouseLeave"
                           AutomationProperties.AutomationId="HeightImagePixels" />
                    <Canvas x:Name="RoiOverlay"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            AutomationProperties.AutomationId="HeightImageRoiOverlay" />
                    <Canvas x:Name="LinkedCursorOverlay"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="HeightImageLinkedCursor">
                        <Line x:Name="LinkedCursorVerticalLine"
                              Stroke="#b3ffffff"
                              StrokeThickness="1" />
                        <Line x:Name="LinkedCursorHorizontalLine"
                              Stroke="#b3ffffff"
                              StrokeThickness="1" />
                        <Ellipse x:Name="LinkedCursorMarker"
                                 Width="11"
                                 Height="11"
                                 Fill="#3300f0e8"
                                 Stroke="#00f0e8"
                                 StrokeThickness="2" />
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <Border Margin="0,12,12,0"
                    Padding="7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#d9172435"
                    BorderBrush="#668da2bc"
                    BorderThickness="1"
                    CornerRadius="3"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="8.5"
                               Foreground="White"
                               Text="{Binding LegendMaximum}" />
                    <Border Width="13"
                            Height="82"
                            Margin="0,3"
                            HorizontalAlignment="Center"
                            BorderBrush="#99ffffff"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,1"
                                                 EndPoint="0.5,0">
                                <GradientStop Offset="0"
                                              Color="{Binding LegendColor0}" />
                                <GradientStop Offset="0.333"
                                              Color="{Binding LegendColor1}" />
                                <GradientStop Offset="0.667"
                                              Color="{Binding LegendColor2}" />
                                <GradientStop Offset="1"
                                              Color="{Binding LegendColor3}" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="8.5"
                               Foreground="White"
                               Text="{Binding LegendMinimum}" />
                </StackPanel>
            </Border>

            <Border Margin="16"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#e6172435"
                    CornerRadius="4"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <ProgressBar Width="220"
                                 Height="4"
                                 IsIndeterminate="True" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               Text="{Binding Localization.HeightImageLoading}" />
                </StackPanel>
            </Border>

            <Border Margin="18"
                    Padding="12,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#e67f1d1d"
                    CornerRadius="4"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock MaxWidth="520"
                           Foreground="White"
                           Text="{Binding Error}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="8,5"
                Background="{DynamicResource ThreeD.CommandBarBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="9.5"
                           Foreground="{DynamicResource ThreeD.TextBrush}"
                           Text="{Binding HoverSummary}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               FontSize="9"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{Binding Localization.HeightImagePanZoomHint}" />
                    <TextBlock FontSize="9"
                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                               Text="{Binding Localization.HeightImageViewOnly}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
