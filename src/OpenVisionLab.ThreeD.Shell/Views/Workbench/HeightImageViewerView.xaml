<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.HeightImageViewerView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:legend="clr-namespace:OpenVisionLab.ThreeD.Presentation.Controls;assembly=OpenVisionLab.ThreeD.Presentation"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:host="clr-namespace:OpenVisionLab.ThreeD.Viewer.Hosting;assembly=OpenVisionLab.ThreeD.Viewer"
             Background="{DynamicResource ThreeD.ViewportBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
             Focusable="True"
             SizeChanged="Viewer_SizeChanged"
             behaviors:HeightImageViewerKeyboardBehavior.IsEnabled="True"
             behaviors:HeightImageViewerKeyboardBehavior.ApplyRoiCommand="{Binding RoiWorkspace.ApplyCommand}"
             behaviors:HeightImageViewerKeyboardBehavior.CancelRoiCommand="{Binding RoiWorkspace.CancelCommand}"
             behaviors:HeightImageViewerKeyboardBehavior.CancelProfileCommand="{Binding Presentation.ProfileActionCommand, ElementName=Root}"
             behaviors:HeightImageViewerKeyboardBehavior.DeleteRoiCommand="{Binding RoiWorkspace.DeleteCommand}"
             behaviors:HeightImageViewerKeyboardBehavior.FitCommand="{Binding FitCommand}"
             behaviors:HeightImageViewerKeyboardBehavior.ActualPixelsCommand="{Binding ActualPixelsCommand}"
             behaviors:HeightImageViewerKeyboardBehavior.ZoomInCommand="{Binding ZoomInCommand}"
             behaviors:HeightImageViewerKeyboardBehavior.ZoomOutCommand="{Binding ZoomOutCommand}"
             behaviors:HeightImageViewerKeyboardBehavior.AutoRangeCommand="{Binding AutoRangeCommand}"
             AutomationProperties.AutomationId="HeightImageViewer">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HeightProfile.LineBrush" Color="#FFD166" />
        <SolidColorBrush x:Key="HeightProfile.OutlineBrush" Color="#15191E" />
        <SolidColorBrush x:Key="HeightProfile.TextBrush" Color="#1A1408" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DrawingBrush x:Key="MissingCellHatchBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#0D1115" Geometry="M 0,0 L 8,0 8,8 0,8 Z" />
                <GeometryDrawing Geometry="M 0,8 L 8,0"><GeometryDrawing.Pen><Pen Brush="#29333E" Thickness="1" /></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="HeightOverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="0,0,2,0" /><Setter Property="Foreground" Value="#C9D3DC" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A333D" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C4243" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeightOverlayToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="0,0,2,0" /><Setter Property="Foreground" Value="#C9D3DC" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /><Border x:Name="SelectedLine" Height="2" Margin="1,0,1,0" VerticalAlignment="Bottom" Background="#6FB3A8" Visibility="Collapsed" /></Grid></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A333D" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C4243" /><Setter Property="Foreground" Value="#C7ECE5" /><Setter TargetName="SelectedLine" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C4243" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EmbeddedChromeHiddenStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseEmbeddedChrome, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeightModeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource HeightOverlayToggleStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding Presentation, ElementName=Root}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="HeightRoiToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource HeightOverlayToggleStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding RoiCaptureCommand, ElementName=Root}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="HeightDisplayToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource HeightOverlayToggleStyle}">
            <Setter Property="Command" Value="{Binding DisplayPresentation.OpenHeightDisplaySettingsCommand, ElementName=Root}" />
            <Setter Property="IsChecked" Value="{Binding DisplayPresentation.IsDisplaySettingsOpen, ElementName=Root, Mode=OneWay}" />
            <Style.Triggers><DataTrigger Binding="{Binding DisplayPresentation, ElementName=Root}" Value="{x:Null}"><Setter Property="Command" Value="{x:Null}" /><Setter Property="IsChecked" Value="{Binding IsExpanded, ElementName=HeightImageDisplaySettings, Mode=TwoWay}" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="{views:ThreeDText Key=ThreeD.Roi.Apply, Korean='ROI 적용', English='Apply ROI'}" Command="{Binding RoiWorkspace.ApplyCommand}" />
        <MenuItem Header="{views:ThreeDText Key=ThreeD.Roi.Cancel, Korean='ROI 취소', English='Cancel ROI'}" Command="{Binding RoiWorkspace.CancelCommand}" />
        <MenuItem Header="{Binding Localization.HeightImageRoiDelete}" Command="{Binding RoiWorkspace.DeleteCommand}" AutomationProperties.AutomationId="HeightImageRoiDeleteMenu" />
        <Separator />
        <MenuItem Header="{Binding Localization.HeightImageZoomIn}" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="{Binding Localization.HeightImageZoomOut}" Command="{Binding ZoomOutCommand}" />
        <Separator />
        <MenuItem Header="{Binding Localization.ViewerPalette}">
            <MenuItem StaysOpenOnClick="True"><MenuItem.Header><ComboBox Width="180" MinHeight="26" FontSize="12" ItemsSource="{Binding PaletteChoices}" SelectedItem="{Binding SelectedPaletteChoice, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding HasImage}" AutomationProperties.AutomationId="HeightImageLegacyPalette" /></MenuItem.Header></MenuItem>
        </MenuItem>
    </ContextMenu></UserControl.ContextMenu>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeightImageChrome"
                Background="{DynamicResource ThreeD.CommandBarBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="7,5" />
                    <Setter Property="Grid.Row" Value="0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="Panel.ZIndex" Value="30" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseEmbeddedChrome, ElementName=Root}" Value="True">
                            <Setter Property="Padding" Value="3" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Margin" Value="52,30,0,0" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="#DC161B20" /><Setter Property="BorderBrush" Value="#33404C" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="HeightMoveTool" Style="{StaticResource HeightModeToggleStyle}" Command="{Binding Presentation.MoveCommand, ElementName=Root}" IsChecked="{Binding Presentation.IsMoveMode, ElementName=Root, Mode=OneWay}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.Move, Korean='이동', English='Move'}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><ui:SymbolIcon Symbol="ArrowMove24" FontSize="16" /></ToggleButton>
                    <Border Width="1" Height="20" Margin="3,4,3,4" Background="#3A4552" />
                    <ToggleButton x:Name="HeightRoiTool" Style="{StaticResource HeightRoiToggleStyle}" Command="{Binding RoiCaptureCommand, ElementName=Root}" IsChecked="{Binding RoiWorkspace.IsCaptureActive, Mode=OneWay}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.Roi, Korean='ROI', English='ROI'}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><ui:SymbolIcon Symbol="RectangleLandscape24" FontSize="16" /></ToggleButton>
                    <ToggleButton x:Name="HeightProfileTool" Style="{StaticResource HeightModeToggleStyle}" Command="{Binding Presentation.MeasureCommand, ElementName=Root}" IsChecked="{Binding ProfileState.IsActive, ElementName=Root, Mode=OneWay}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.Profile, Korean='단면', English='Section'}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><ui:SymbolIcon Symbol="Line24" FontSize="16" /></ToggleButton>
                    <Border Width="1" Height="20" Margin="3,4,3,4" Background="#3A4552" />
                    <Button x:Name="HeightFitTool" Style="{StaticResource HeightOverlayButtonStyle}" Command="{Binding FitCommand}" ToolTip="{Binding Localization.HeightImageFit}" AutomationProperties.Name="{Binding Localization.HeightImageFit}"><ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="16" /></Button>
                    <Button x:Name="HeightFitRoiTool" Style="{StaticResource HeightOverlayButtonStyle}" Command="{Binding FitRoiCommand}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.FitRoi, Korean='ROI 맞춤', English='Fit ROI'}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><ui:SymbolIcon Symbol="Target24" FontSize="16" /></Button>
                    <ToggleButton x:Name="HeightImageDisplaySettingsToggle" Style="{StaticResource HeightDisplayToggleStyle}" ToolTip="{views:ThreeDText Key=ThreeD.R19.HeightDisplayOptions, Korean='높이 표시', English='Height display'}" AutomationProperties.AutomationId="HeightImageDisplaySettingsToggle" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.HeightDisplayOptions, Korean='높이 표시', English='Height display'}"><ui:SymbolIcon Symbol="Color24" FontSize="16" /></ToggleButton>
                </StackPanel>
                <TextBlock x:Name="HeightImageStatus"
                           Margin="0,5,0,0"
                           Style="{StaticResource EmbeddedChromeHiddenStyle}"
                           FontSize="12"
                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                           Text="{Binding Status}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="HeightImageStatus" />

                <StackPanel x:Name="HeightImageRangeSummary"
                            Margin="0,4,0,0"
                            Style="{StaticResource EmbeddedChromeHiddenStyle}">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                               Text="{Binding DisplayRangeSummary}"
                               TextWrapping="Wrap" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource ThreeD.WarningBrush}"
                               Text="{Binding RangeError}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasRangeError, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              SizeChanged="HeightBody_SizeChanged"
              ClipToBounds="True"
              Background="{DynamicResource ThreeD.ViewportBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="ImageScrollViewer"
                          Margin="44,22,0,0" ScrollChanged="ImageScrollViewer_ScrollChanged"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                          PreviewMouseDown="ImageScrollViewer_PreviewMouseDown"
                          PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                          PreviewMouseUp="ImageScrollViewer_PreviewMouseUp"
                          MouseLeave="ImageScrollViewer_MouseLeave">
                <Grid x:Name="ImageSurface"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThreeD.ViewportBrush}">
                    <Image x:Name="HeightImage"
                           SizeChanged="HeightImage_SizeChanged"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True"
                           Stretch="Fill"
                           MouseLeftButtonDown="HeightImage_MouseLeftButtonDown"
                           MouseLeftButtonUp="HeightImage_MouseLeftButtonUp"
                           MouseMove="HeightImage_MouseMove"
                           MouseLeave="HeightImage_MouseLeave"
                           AutomationProperties.AutomationId="HeightImagePixels"
                           AutomationProperties.Name="{Binding Localization.HeightImage}" />
                    <Rectangle x:Name="MissingCellHatch" Width="{Binding Width, ElementName=HeightImage}" Height="{Binding Height, ElementName=HeightImage}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{StaticResource MissingCellHatchBrush}" Visibility="{Binding ShowInvalidCells, Converter={StaticResource BoolToVisibilityConverter}}" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.AutomationId="HeightImageMissingHatch" />
                    <Canvas x:Name="RoiOverlay"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            AutomationProperties.AutomationId="HeightImageRoiOverlay" />
                    <Canvas x:Name="ProfileOverlay" IsHitTestVisible="False" AutomationProperties.AutomationId="HeightImageProfileOverlay" />
                    <Canvas x:Name="LinkedCursorOverlay"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="HeightImageLinkedCursor">
                        <Ellipse x:Name="LinkedCursorMarker"
                                 Width="11.5"
                                 Height="11.5"
                                 Fill="Transparent"
                                 Stroke="#E6FFFFFF"
                                 StrokeThickness="1.5" />
                        <Path x:Name="LinkedCursorPeerMarker"
                              Width="18" Height="18" Stretch="None"
                              Data="M 0,9 L 6,9 M 12,9 L 18,9 M 9,0 L 9,6 M 9,12 L 9,18"
                              Stroke="#F294BDD8" StrokeThickness="1.2" />
                    </Canvas>
                </Grid>
            </ScrollViewer>
            <Canvas x:Name="HeightAxes" SizeChanged="HeightImage_SizeChanged" IsHitTestVisible="False" ClipToBounds="True" AutomationProperties.AutomationId="HeightImageAxes" />

            <Popup x:Name="HeightImageDisplaySettingsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=HeightImageDisplaySettingsToggle}" IsOpen="{Binding IsExpanded, ElementName=HeightImageDisplaySettings, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
            <Border Padding="4"
                    Width="300"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="20"
                    Background="{DynamicResource ThreeD.CommandBarBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="1"
>
                <Expander x:Name="HeightImageDisplaySettings"
                          Padding="8"
                          IsExpanded="False"
                          Header="{views:ThreeDText Key=ThreeD.R19.HeightDisplayOptions, Korean='높이 표시', English='Height display'}"
                          HorizontalContentAlignment="Stretch"
                          Visibility="{Binding IsExpanded, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                          AutomationProperties.AutomationId="HeightImageDisplaySettings"
                          AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.HeightDisplayOptions, Korean='높이 표시', English='Height display'}">
                    <Expander.Template><ControlTemplate TargetType="Expander"><Border Padding="{TemplateBinding Padding}"><ContentPresenter /></Border></ControlTemplate></Expander.Template>
                    <WrapPanel Margin="0,5,0,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="HeightImageDisplayRangeControls">
                        <Button Margin="0,0,8,0"
                                Padding="7,3"
                                Command="{Binding ActualPixelsCommand}"
                                Content="{Binding Localization.HeightImageActualPixels}"
                                ToolTip="{Binding Localization.HeightImageActualPixels}"
                                AutomationProperties.Name="{Binding Localization.HeightImageActualPixels}" />
                        <TextBlock Margin="0,0,5,0"
                               VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding Localization.HeightImagePalette}" />
                        <ComboBox x:Name="PaletteSelector"
                                  Width="108"
                                   Margin="0,0,8,0"
                                   ItemsSource="{Binding PaletteChoices}"
                                   DisplayMemberPath="DisplayName"
                                   SelectedItem="{Binding SelectedPaletteChoice, Mode=TwoWay}"
                                   ToolTip="{Binding Localization.HeightImagePalette}"
                                  AutomationProperties.AutomationId="HeightImagePaletteSelector"
                                  AutomationProperties.Name="{Binding Localization.HeightImagePalette}" />
                        <WrapPanel x:Name="HeightImageManualDisplayControls"
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal">
                            <Button Height="30"
                                    Margin="0,0,8,0"
                                    Padding="7,2"
                                    Command="{Binding AutoRangeCommand}"
                                    Content="{Binding Localization.HeightImageAutoRange}"
                                    ToolTip="{Binding Localization.HeightImageAutoRangeToolTip}"
                                    AutomationProperties.Name="{Binding Localization.HeightImageAutoRange}" />
                            <StackPanel Margin="0,0,6,0"
                                        Orientation="Horizontal">
                                <TextBlock Margin="0,0,3,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding Localization.HeightImageRangeMinimum}" />
                                <TextBox Width="67"
                                         Height="30"
                                         Padding="4,2"
                                         Text="{Binding RangeMinimumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding Localization.HeightImageRangeMinimum}"
                                         AutomationProperties.Name="{Binding Localization.HeightImageRangeMinimum}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0"
                                        Orientation="Horizontal">
                                <TextBlock Margin="0,0,3,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding Localization.HeightImageRangeMaximum}" />
                                <TextBox Width="67"
                                         Height="30"
                                         Padding="4,2"
                                         Text="{Binding RangeMaximumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding Localization.HeightImageRangeMaximum}"
                                         AutomationProperties.Name="{Binding Localization.HeightImageRangeMaximum}" />
                            </StackPanel>
                            <Button Height="30"
                                    Padding="8,2"
                                    Command="{Binding ApplyManualRangeCommand}"
                                    Content="{Binding Localization.HeightImageApplyRange}"
                                    ToolTip="{Binding Localization.HeightImageApplyRangeToolTip}"
                                    AutomationProperties.Name="{Binding Localization.HeightImageApplyRange}" />
                        </WrapPanel>
                        <WrapPanel x:Name="HeightImageInvalidOverlayControls"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    AutomationProperties.AutomationId="HeightImageInvalidOverlayControls">
                            <CheckBox VerticalAlignment="Center"
                                      IsChecked="{Binding ShowInvalidCells, Mode=TwoWay}"
                                      Content="{Binding Localization.HeightImageInvalidOverlay}"
                                      ToolTip="{Binding Localization.HeightImageInvalidOverlayToolTip}"
                                      AutomationProperties.AutomationId="HeightImageInvalidOverlayToggle"
                                      AutomationProperties.Name="{Binding Localization.HeightImageInvalidOverlay}" />
                            <Border Width="11"
                                    Height="11"
                                    Margin="9,0,4,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource MissingCellHatchBrush}"
                                    BorderBrush="#FFF1F5F9"
                                    BorderThickness="1"
                                    CornerRadius="1" />
                            <TextBlock MaxWidth="310" VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                       Text="{Binding InvalidOverlaySummary}"
                                       TextWrapping="Wrap" />
                        </WrapPanel>
                    </WrapPanel>
                </Expander>
            </Border>

            </Popup>

            <Grid x:Name="HeightImageHeightLegend" Grid.Column="1" Margin="4,0,12,12" MaxWidth="160"
                    Background="{DynamicResource ThreeD.ViewportBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="True"
                    Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.AutomationId="HeightImageHeightLegend">
                    <legend:HeightLegendRangeBar x:Name="HeightLegendTrack" ColorStyle="{Binding HeightDisplayOptions.ColorStyle}" BelowCaption="{views:ThreeDText Key=ThreeD.Legend.Below, Korean='미만', English='Below'}" WithinCaption="{views:ThreeDText Key=ThreeD.Legend.Within, Korean='허용 범위', English='Within limits'}" AboveCaption="{views:ThreeDText Key=ThreeD.Legend.Above, Korean='초과', English='Above'}" Histogram="{Binding HeightLegendHistogram}" Minimum="{Binding HeightLegendMinimum}" Maximum="{Binding HeightLegendMaximum}" DataMinimum="{Binding Frame.Minimum}" DataMaximum="{Binding Frame.Maximum}" Gradient="{Binding HeightLegendGradient}" EditCommand="{Binding HeightLegendEditCommand}" ErrorText="{Binding RangeError}" SpaceConstraintCaption="{views:ThreeDText Key=ThreeD.Legend.SpaceConstraint, Korean='크게 보기에서 범례 표시', English='Maximize pane to show legend'}" Unit="{Binding LegendUnit}" ModeCaption="{Binding DisplayRangeMode}" Information="{Binding HeightLegendInformation}" IsCollapsed="{Binding IsHeightLegendCollapsed, Mode=TwoWay}" CollapseCaption="{views:ThreeDText Key=ThreeD.Legend.Collapse, Korean='범례 접기/펼치기', English='Collapse or expand legend'}" AutoCaption="{views:ThreeDText Key=ThreeD.Legend.Auto, Korean='자동', English='Auto'}" LowerCaption="{views:ThreeDText Key=ThreeD.Legend.Lower, Korean='색 범위 하한', English='Colour range lower limit'}" UpperCaption="{views:ThreeDText Key=ThreeD.Legend.Upper, Korean='색 범위 상한', English='Colour range upper limit'}" Background="{DynamicResource ThreeD.PanelBrush}" Foreground="{DynamicResource ThreeD.TextBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" />
            </Grid>

            <Border Margin="16"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#e6172435"
                    CornerRadius="4"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <ProgressBar Width="220"
                                 Height="4"
                                 IsIndeterminate="True" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               Text="{Binding Localization.HeightImageLoading}" />
                </StackPanel>
            </Border>

            <Border Margin="18"
                    Padding="12,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#e67f1d1d"
                    CornerRadius="4"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock MaxWidth="520"
                           Foreground="White"
                           Text="{Binding Error}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </Border>
                <Border Margin="8,0,112,8" MaxWidth="440" HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="10"
                         Padding="5,2"
                        Background="#1400f0e8"
                        BorderBrush="#5500f0e8"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding RoiWorkspace.IsCaptureActive, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="HeightImageRoiToolbar">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Width="10"
                                    Height="10"
                                    Margin="0,0,4,0"
                                    Background="#3300f0e8"
                                    BorderBrush="#00f0e8"
                                    BorderThickness="2" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                       Text="{Binding Localization.ReferenceRoi}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Border Width="10"
                                    Height="10"
                                    Margin="0,0,4,0"
                                    Background="#33ff9f1c"
                                    BorderBrush="#ff9f1c"
                                    BorderThickness="2" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                       Text="{Binding Localization.MeasurementRoi}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.InfoBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding RoiWorkspace.ActiveRoleSummary, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run FontWeight="SemiBold"
                                 Text="{Binding RoiWorkspace.LifecycleSummary, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource HeightOverlayButtonStyle}" Command="{Binding RoiWorkspace.ApplyCommand}" ToolTip="{views:ThreeDText Key=ThreeD.Roi.Apply, Korean='ROI 적용', English='Apply ROI'}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><ui:SymbolIcon Symbol="Checkmark24" FontSize="16" /></Button>
                            <Button Style="{StaticResource HeightOverlayButtonStyle}" Command="{Binding RoiWorkspace.CancelCommand}" ToolTip="{views:ThreeDText Key=ThreeD.Roi.Cancel, Korean='ROI 취소', English='Cancel ROI'}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><ui:SymbolIcon Symbol="Dismiss24" FontSize="16" /></Button>
                            <Menu IsMainMenu="False" Background="Transparent"><MenuItem Header="⋯" Template="{StaticResource R19TopMenuItemTemplate}" AutomationProperties.Name="{Binding Localization.HeightImageRoiDelete}"><MenuItem Command="{Binding RoiWorkspace.DeleteCommand}" Header="{Binding Localization.HeightImageRoiDelete}" AutomationProperties.AutomationId="HeightImageRoiDelete" /></MenuItem></Menu>
                        </StackPanel>
                        <TextBlock x:Name="HeightImageRoiInteractionHint"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="4"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource EmbeddedChromeHiddenStyle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding RoiWorkspace.InteractionHint}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    </ScrollViewer>
                </Border>

        </Grid>

        <Border x:Name="HeightImageCursorStatus" Grid.Row="2"
                Height="24"
                Padding="10,0"
                Background="#141920"
                BorderBrush="#2A323B"
                BorderThickness="0,1,0,0">
                <ScrollViewer x:Name="HeightImageCursorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="True">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeightImageCoordinateText" Margin="0,0,8,0" VerticalAlignment="Center"
                                   MaxWidth="{Binding ViewportWidth, ElementName=HeightImageCursorScroller}"
                                   FontFamily="Cascadia Mono, Cascadia Code, Consolas"
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                   Foreground="#CFE6F5" Text="{Binding CursorCoordinateValueSummary, Mode=OneWay}"
                                   ToolTip="{Binding HoverSummary}" AutomationProperties.AutomationId="HeightImageCoordinateStatus" />
                        <DockPanel Grid.Column="1">
                            <TextBlock x:Name="HeightImageScaleStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       FontFamily="{Binding FontFamily, ElementName=Root}" FontSize="11.5" Foreground="#8B98A6"
                                       TextTrimming="CharacterEllipsis"><Run Text="{Binding PixelsPerCellSummary, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding LegendUnit, Mode=OneWay}" /></TextBlock>
                            <TextBlock x:Name="HeightImageSelectionContext" Margin="0,0,8,0" VerticalAlignment="Center"
                                       FontFamily="{Binding FontFamily, ElementName=Root}" FontSize="11.5"
                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectionContext, ElementName=Root, Mode=OneWay}" ToolTip="{Binding SelectionContext, ElementName=Root}" />
                        </DockPanel>
                    </Grid>
                </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
