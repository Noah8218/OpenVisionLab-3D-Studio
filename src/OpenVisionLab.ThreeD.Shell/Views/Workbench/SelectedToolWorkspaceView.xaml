                                        <TextBox Grid.Row="5" Grid.Column="2" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.HalfExtentY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="5" Grid.Column="3" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.HalfExtentZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>

                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="8.5"
                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                               Text="{Binding OrientedBoxEditor.ValidationSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="8.5"
                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.OrientedBoxReviewBarHint, Korean='위 검토 바 사용: Enter 적용, Esc 취소', English='Use the Review bar above: Enter applies, Esc cancels.'}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Margin="0,5,0,0"
                                           FontSize="8.5"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding OrientedBoxEditor.Status}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Expander>

                <Expander x:Name="OutputSection"
                          IsExpanded="True"
                          Style="{StaticResource WorkspaceSectionStyle}"
                          Header="{views:ThreeDText Key=ThreeD.Workspace.Outputs, Korean='4  출력', English='4  Outputs'}">
                    <StackPanel>
                    <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding SelectedToolWorkspace.Outputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        AutomationProperties.Name="Selected tool output and actions">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Button Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SelectWorkspaceOutputCommand, ElementName=SelectedToolRoot}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Select tool output">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ThreeD.AccentBrush}"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="6,0,0,0"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                                               Text="{Binding State}" />
                                                </Grid>
                                                <TextBlock FontSize="10.5"
                                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                           Text="{Binding Contract}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                       Text="{Binding ValueLabel}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="7,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                                       Text="{Binding Value}" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       Text="{Binding Unit}" />
                                            <Border Grid.Column="3"
                                                    Margin="7,0,0,0"
                                                    Padding="5,1"
                                                    Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                                    CornerRadius="2"
                                                    Visibility="{Binding HasResultStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ResultStatus}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ResultStatus}" Value="Pass">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ResultStatus}" Value="Fail">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ResultStatus}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                   Text="{Binding Detail}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                   Text="{Binding Availability}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource ThreeD.PassBrush}"
                                                   Text="{Binding ComparePinsSummary}"
                                                   Visibility="{Binding HasComparePins, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Margin="0,0,3,0"
                                                       Padding="5,3"
                                                       HorizontalAlignment="Stretch"
                                                       Content="{views:ThreeDText Key=ThreeD.Workspace.OutputShow, Korean='보기', English='Show'}"
                                                       Icon="{ui:SymbolIcon Eye24}"
                                                       Command="{Binding DataContext.ShowWorkspaceOutputCommand, ElementName=SelectedToolRoot}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="{Binding Availability}"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       AutomationProperties.Name="Show selected output in Viewer" />
                                            <ui:Button Grid.Column="1"
                                                       Margin="3,0"
                                                       Padding="5,3"
                                                       HorizontalAlignment="Stretch"
                                                       Content="{views:ThreeDText Key=ThreeD.Workspace.OutputPin, Korean='고정', English='Pin'}"
                                                       Icon="{ui:SymbolIcon Document24}"
                                                       Command="{Binding DataContext.PinWorkspaceOutputCommand, ElementName=SelectedToolRoot}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="{Binding Availability}"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       AutomationProperties.Name="Pin selected output to comparison" />
                                            <ui:Button Grid.Column="2"
                                                       Margin="3,0,0,0"
                                                       Padding="5,3"
                                                       HorizontalAlignment="Stretch"
                                                       Content="{views:ThreeDText Key=ThreeD.Workspace.OutputCompare, Korean='비교', English='Compare'}"
                                                       Icon="{ui:SymbolIcon Table24}"
                                                       Command="{Binding DataContext.CompareWorkspaceOutputCommand, ElementName=SelectedToolRoot}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="{Binding Availability}"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       AutomationProperties.Name="Open selected output comparison" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,8,0,0"
                            Padding="8"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="{Binding HasCompletenessCellResults, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="Completeness failed cell review">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThreeD.TextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.CompletenessReview, Korean='셀 결과 검토', English='Cell result review'}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="9"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.CompletenessReviewViewOnly, Korean='보기 전용 · 레시피 및 실행 상태 변경 없음', English='View only · recipe and execution state stay unchanged'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.FailBrush}"
                                           Text="{Binding CompletenessFailureNavigationSummary}" />
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Margin="0,0,3,0"
                                           Padding="6,3"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding PreviousCompletenessFailureCommand}"
                                           ToolTip="{views:ThreeDText Key=ThreeD.Command.PreviousFailedCellTip, Korean='이전 실패 셀을 2D/3D에서 함께 선택합니다.', English='Select the previous failed cell in both 2D and 3D.'}"
                                           AutomationProperties.Name="Previous failed completeness cell">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowLeft24" />
                                        <TextBlock Margin="5,0,0,0"
                                                   Text="{views:ThreeDText Key=ThreeD.Command.PreviousFailedCell, Korean='이전 실패', English='Previous failure'}" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Grid.Column="1"
                                           Margin="3,0,0,0"
                                           Padding="6,3"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding NextCompletenessFailureCommand}"
                                           ToolTip="{views:ThreeDText Key=ThreeD.Command.NextFailedCellTip, Korean='다음 실패 셀을 2D/3D에서 함께 선택합니다.', English='Select the next failed cell in both 2D and 3D.'}"
                                           AutomationProperties.Name="Next failed completeness cell">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0"
                                                   Text="{views:ThreeDText Key=ThreeD.Command.NextFailedCell, Korean='다음 실패', English='Next failure'}" />
                                        <ui:SymbolIcon Symbol="ArrowRight24" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>

                            <ItemsControl Margin="0,6,0,0"
                                          ItemsSource="{Binding CompletenessCellResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,1"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SelectCompletenessCellCommand, ElementName=SelectedToolRoot}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Select completeness cell">
                                            <Border Padding="6,4"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.PanelBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThreeD.TextBrush}"
                                                                   Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,1,0,0"
                                                                   FontSize="8.5"
                                                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                                   Text="{Binding EvidenceSummary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,1,0,0"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                                   Text="{Binding IdentitySummary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasMappedThicknessIdentity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="7,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding StatusText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="Pass">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="Fail">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Expander>

                <Expander Margin="0,0,0,7"
                          IsExpanded="False"
                          Header="{views:ThreeDText Key=ThreeD.Workspace.Help, Korean='도움말', English='Help'}">
                    <TextBlock Margin="0,5,0,0"
                               Padding="8"
                               Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                               FontSize="9.5"
                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                               Text="{Binding SelectedToolWorkspace.Help}"
                               TextWrapping="Wrap" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
