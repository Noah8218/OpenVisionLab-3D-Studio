<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.SelectedToolWorkspaceView"
             x:Name="SelectedToolRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:propertyGrid="clr-namespace:OpenVisionLab.ThreeD.Shell.PropertyGrid"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:workbenchVm="clr-namespace:OpenVisionLab.ThreeD.Shell.ViewModels.Workbench"
             AutomationProperties.AutomationId="SelectedToolWorkspace">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
        <Style x:Key="WorkspaceSectionStyle" TargetType="{x:Type Expander}">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <StackPanel>
                            <ToggleButton x:Name="SectionHeader"
                                          MinHeight="32"
                                          Padding="8,4"
                                          HorizontalContentAlignment="Stretch"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="HeaderSurface"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{DynamicResource ThreeD.CommandBarBrush}"
                                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="Chevron"
                                                               Width="16"
                                                               Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                               Symbol="ChevronRight16" />
                                                <ContentPresenter Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  ContentSource="Content"
                                                                  RecognizesAccessKey="True" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Symbol" Value="ChevronDown16" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="Background"
                                                        Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface"
                                                        Property="Background"
                                                        Value="{DynamicResource ThreeD.HoverSurfaceBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.InputBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeaderSurface"
                                                        Property="Background"
                                                        Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.InputBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.FocusBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chevron"
                                                        Property="Foreground"
                                                        Value="{DynamicResource ThreeD.DisabledBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="Background"
                                                        Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.DividerBrush}" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ToggleButton>
                            <Border x:Name="SectionContent"
                                    Visibility="Collapsed">
                                <ContentPresenter ContentSource="Content" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="SectionContent"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SectionHeader"
                                        Property="IsEnabled"
                                        Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RequiredSettingsSectionStyle" TargetType="Expander" BasedOn="{StaticResource WorkspaceSectionStyle}">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel Margin="0,10,0,6">
                            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource ThreeD.PrimaryTextBrush}" Text="{TemplateBinding Header}" />
                            <ContentPresenter ContentSource="Content" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegionCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style x:Key="EditorPageTabStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ThreeD.CommandBarBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoiLifecycleStateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Drawing}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Review}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Applied}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="A"
                    Modifiers="Control+Alt"
                    Command="{Binding AnalyzePreparationPresetsCommand}" />
        <KeyBinding Key="P"
                    Modifiers="Control+Alt"
                    Command="{Binding ProposePreparationPresetCommand}" />
        <KeyBinding Key="R"
                    Modifiers="Control+Alt"
                    Command="{Binding ReviewPreparationPresetCommand}" />
        <KeyBinding Key="C"
                    Modifiers="Control+Alt"
                    Command="{Binding CancelPreparationPresetReviewCommand}" />
        <KeyBinding Key="D"
                    Modifiers="Control+Alt"
                    Command="{Binding ApplyPreparationPresetDraftCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource ThreeD.PanelBrush}"
          TextElement.Foreground="{DynamicResource ThreeD.TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2"
                Margin="12"
                Padding="12"
                VerticalAlignment="Top"
                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Style="{DynamicResource ThreeD.PanelTitleTextStyle}"
                           Text="{Binding Localization.NoRecipeStepSelected}" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{Binding Localization.NoRecipeStepSelectedDetail}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedToolWorkspace.HasSelectedStep}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSourceQualityWorkspaceVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <workbench:SourceQualityWorkspaceView
            x:Name="SourceQualityWorkspace"
            Grid.RowSpan="2"
            DataContext="{Binding SourceQuality}"
            Visibility="{Binding DataContext.IsSourceQualityWorkspaceVisible, ElementName=SelectedToolRoot, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer x:Name="SelectedToolScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <StackPanel Margin="8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedToolWorkspace.HasSelectedStep}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border x:Name="SelectedToolHeader"
                        Margin="0,0,0,6"
                        Padding="8,6"
                        Background="{DynamicResource ThreeD.CommandBarBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        AutomationProperties.AutomationId="SelectedToolHeader">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLabPresentation, ElementName=SelectedToolRoot}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedToolHeaderTitle"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{views:ThreeDText Key=ThreeD.Workspace.ToolSettings, Korean='도구 설정', English='Tool settings'}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}">
                                <Run Text="{Binding SelectedPipelineStep.Order, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding PipelineSteps.Count, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <ComboBox x:Name="SelectedToolStepSelector"
                                  MinHeight="34"
                                  Margin="0,4,0,0"
                                  ItemsSource="{Binding PipelineSteps}"
                                  SelectedItem="{Binding SelectedPipelineStep, Mode=TwoWay}"
                                  SelectionChanged="OnSelectedToolStepSelectionChanged"
                                  AutomationProperties.AutomationId="SelectedToolStepSelector"
                                  AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.SelectInspectionStep, Korean='검사 단계 선택', English='Select inspection step'}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ToolName}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border x:Name="TeachFailureCorrectionContext"
                        Margin="0,0,0,8"
                        Padding="10"
                        Background="{DynamicResource ThreeD.WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource ThreeD.WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding HasActiveValidationFailureCorrectionContext, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="TeachFailureCorrectionContext">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThreeD.WarningBrush}"
                                       Text="{views:ThreeDText Key=ThreeD.Workspace.FixFailureInTeach, Korean='실패 샘플 수정', English='Fix failed sample in Teach'}" />
                            <Border Grid.Column="1"
                                    Margin="7,0,0,0"
                                    Padding="6,2"
                                    Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                    CornerRadius="8">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.WarningBrush}"
                                           Text="{Binding ActiveValidationFailureCorrectionContext.SampleStatus}" />
                            </Border>
                        </Grid>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActiveValidationFailureCorrectionContext.SampleName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ActiveValidationFailureCorrectionContext.SourcePath}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding ActiveValidationFailureCorrectionContext.ToolName, Converter={StaticResource ViewerRuntimeTextConverter}, ConverterParameter=RuleLabel}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{Binding ActiveValidationFailureCorrectionContext.Reason}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{Binding ActiveValidationFailureCorrectionContext.CellSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.FixFailureNextAction, Korean='ROI 또는 설정값을 검토하고 미리보기를 직접 실행한 뒤 샘플 세트를 다시 실행하세요.', English='Review the ROI or parameters, run Preview explicitly, then rerun the sample set.'}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="SelectedToolSectionMenuLabel"
                           Margin="1,0,0,5"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                           Text="{views:ThreeDText Key=ThreeD.Workspace.ItemMenu, Korean='항목 메뉴', English='Item menu'}"
                           Visibility="Collapsed" />

                <Grid Margin="0,0,0,6"
                      Visibility="Collapsed"
                      AutomationProperties.AutomationId="SelectedToolEditorPages"
                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.ToolSettingPages, Korean='도구 설정 항목', English='Tool setting pages'}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="EditorAllTab"
                                 Grid.Column="0"
                                 GroupName="SelectedToolEditorPage"
                                 IsChecked="True"
                                 Style="{StaticResource EditorPageTabStyle}"
                                 Checked="OnEditorPageChecked"
                                 Tag="All"
                                 Content="{views:ThreeDText Key=ThreeD.Workspace.EditorPageAll, Korean='전체', English='All'}"
                                 AutomationProperties.AutomationId="SelectedToolEditorPageAll" />
                    <RadioButton x:Name="EditorRegionTab"
                                 Grid.Column="1"
                                 GroupName="SelectedToolEditorPage"
                                 Style="{StaticResource EditorPageTabStyle}"
                                 Checked="OnEditorPageChecked"
                                 Tag="Region"
                                 Content="{views:ThreeDText Key=ThreeD.Workspace.EditorPageRegion, Korean='영역', English='Region'}"
                                 Visibility="{Binding IsSelectedStepRegionSurfaceVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                 AutomationProperties.AutomationId="SelectedToolEditorPageRegion" />
                    <RadioButton x:Name="EditorJudgmentTab"
                                 Grid.Column="2"
                                 GroupName="SelectedToolEditorPage"
                                 Style="{StaticResource EditorPageTabStyle}"
                                 Checked="OnEditorPageChecked"
                                 Tag="Judgment"
                                 Content="{views:ThreeDText Key=ThreeD.Workspace.EditorPageJudgment, Korean='판정', English='Judgment'}"
                                 Visibility="{Binding IsSelectedStepMeasurement, Converter={StaticResource BoolToVisibilityConverter}}"
                                 AutomationProperties.AutomationId="SelectedToolEditorPageJudgment" />
                    <RadioButton x:Name="EditorDetailTab"
                                 Grid.Column="3"
                                 Margin="0"
                                 GroupName="SelectedToolEditorPage"
                                 Style="{StaticResource EditorPageTabStyle}"
                                 Checked="OnEditorPageChecked"
                                 Tag="Detail"
                                 Content="{views:ThreeDText Key=ThreeD.Workspace.EditorPageDetail, Korean='상세', English='Details'}"
                                 AutomationProperties.AutomationId="SelectedToolEditorPageDetail" />
                </Grid>



                <Border x:Name="SelectedToolRouteProblem"
                        Margin="0,0,0,8"
                        Padding="10"
                        Background="{DynamicResource ThreeD.WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource ThreeD.WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        AutomationProperties.AutomationId="SelectedToolRouteProblem">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSelectedStepFlowProblem}" Value="True" />
                                        <Condition Binding="{Binding IsSelectedStepDualRoiTeaching}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{Binding SelectedStepFlowProblem.Status}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding SelectedStepFlowProblem.Detail}"
                                   TextWrapping="Wrap" />
                        <ui:Button Margin="0,8,0,0"
                                   Padding="9,4"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                                   Content="{Binding Localization.RepairRoute}"
                                   Command="{Binding FocusFlowProblemStepCommand}"
                                   CommandParameter="{Binding SelectedStepFlowProblem}"
                                   ToolTip="{Binding Localization.RepairRouteToolTip}"
                                   AutomationProperties.AutomationId="RepairSelectedToolRoute"
                                   AutomationProperties.Name="{Binding Localization.RepairRoute}"
                                   AutomationProperties.HelpText="{Binding Localization.RepairRouteToolTip}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,8"
                        Padding="8"
                        Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                        BorderBrush="{DynamicResource ThreeD.AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsSurfaceMatchExperimentVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="SurfaceMatchExperimentComparison"
                        AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.SurfaceMatchExperimentAccessible, Korean='Surface Match 적용 결과와 후보 비교', English='Surface Match applied and candidate comparison'}">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{views:ThreeDText Key=ThreeD.Workspace.SurfaceMatchExperiment, Korean='정합 결과 및 설정값 실험', English='Match results and parameter experiment'}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.AccentBrush}"
                                       Text="{Binding SurfaceMatchExperimentViewSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Margin="0,6,0,0"
                              Visibility="{Binding IsSurfaceMatchCollectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                       Text="{views:ThreeDText Key=ThreeD.Workspace.RetainedMatch, Korean='보존 매치', English='Retained match'}" />
                            <ComboBox Grid.Column="1"
                                      MinHeight="30"
                                      ItemsSource="{Binding SurfaceMatchCollectionItems}"
                                      SelectedItem="{Binding SelectedSurfaceMatchCollectionItem, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CanSelectSurfaceMatchCollectionItem}"
                                      ToolTip="{Binding SelectedSurfaceMatchCollectionItem.MatchId}"
                                      AutomationProperties.AutomationId="SurfaceMatchCollectionSelector"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.RetainedMatchAccessible, Korean='보존된 Surface Match 결과 선택', English='Select retained Surface Match result'}" />
                            <Grid Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button MinHeight="26"
                                           Margin="0,0,3,0"
                                           Padding="5,2"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding PreviousSurfaceMatchCollectionItemCommand}"
                                           ToolTip="{views:ThreeDText Key=ThreeD.Command.PreviousRetainedMatchTip, Korean='뷰어에서 이전 보존 Surface Match 결과를 선택합니다.', English='Select the previous retained Surface Match result in the Viewer.'}"
                                           AutomationProperties.AutomationId="PreviousSurfaceMatchCollectionItem"
                                           AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.PreviousRetainedMatchAccessible, Korean='이전 보존 Surface Match 결과', English='Previous retained Surface Match result'}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowLeft24" />
                                        <TextBlock Margin="4,0,0,0"
                                                   Text="{views:ThreeDText Key=ThreeD.Command.PreviousRetainedMatch, Korean='이전 결과', English='Previous'}" />
                                    </StackPanel>
                                </ui:Button>
