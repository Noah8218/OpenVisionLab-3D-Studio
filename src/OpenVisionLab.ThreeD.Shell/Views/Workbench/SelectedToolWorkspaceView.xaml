                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        AutomationProperties.AutomationId="SelectedToolInspectionContext">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Text="{views:ThreeDText Key=ThreeD.Workspace.InspectionContext, Korean='검사 컨텍스트', English='Inspection context'}" />
                            <ui:Button Grid.Column="1" Margin="7,0,0,0" Padding="7,3"
                                       Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                                       Command="{Binding OpenSelectedToolLabCommand}"
                                       Visibility="{Binding IsSelectedToolLabAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                       ToolTip="{Binding Localization.OpenSelectedToolLab}"
                                       AutomationProperties.Name="{Binding Localization.OpenSelectedToolLab}" />
                        </Grid>
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding SelectedToolWorkspace.HasSelectedStep, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.InspectionInput, Korean='검사 입력', English='Inspection input'}" />
                                    <TextBlock x:Name="InspectionContextInputName"
                                               Margin="0,2,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedToolWorkspace.Inputs[0].DisplayName}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding SelectedToolWorkspace.Inputs[0].DisplayName}"
                                               AutomationProperties.AutomationId="InspectionContextInputName" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.MainDisplay, Korean='주 화면', English='Main display'}" />
                                    <TextBlock x:Name="InspectionContextMainDisplay"
                                               Margin="0,2,0,0"
                                               FontSize="12"
                                               Text="{Binding MainViewerSummary}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding MainViewerSummary}"
                                               AutomationProperties.AutomationId="InspectionContextMainDisplay" />
                                </StackPanel>
                            </Grid>
                            <Expander x:Name="InspectionContextDetails" Margin="0,7,0,0"
                                      Style="{StaticResource WorkspaceSectionStyle}"
                                      Header="{views:ThreeDText Key=ThreeD.Workspace.InspectionDetails, Korean='상태 · 식별 정보', English='Status and identifiers'}"
                                      AutomationProperties.AutomationId="InspectionContextDetails">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock FontSize="12" Text="{Binding SelectedToolWorkspace.CommonState}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="{Binding Localization.SelectedToolOutputPolicyLabel, Mode=OneWay}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding SelectedToolWorkspace.OutputPolicy, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,3,0,0" FontSize="12" Text="{Binding MeasurementExecutionSummary}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.StepId, Korean='단계 ID', English='Step ID'}" />
                                    <TextBlock x:Name="InspectionContextStepId" FontSize="12"
                                               Text="{Binding SelectedPipelineStep.Id}" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="InspectionContextStepId" />
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.InspectionInputId, Korean='검사 입력 ID', English='Inspection input ID'}" />
                                    <TextBlock x:Name="InspectionContextInputId" FontSize="12"
                                               Text="{Binding SelectedToolWorkspace.Inputs[0].EntityId}" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="InspectionContextInputId" />
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.MainDisplayId, Korean='주 화면 ID', English='Main display ID'}" />
                                    <TextBlock x:Name="InspectionContextMainDisplayId" FontSize="12"
                                               Text="{Binding MainViewerContentId}" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="InspectionContextMainDisplayId" />
                                    <ItemsControl x:Name="InspectionContextRegions" Margin="0,6,0,0"
                                                  ItemsSource="{Binding SelectedToolWorkspace.Regions}"
                                                  AutomationProperties.AutomationId="InspectionContextRegions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,5">
                                                    <TextBlock FontSize="12" TextWrapping="Wrap">
                                                        <Run FontWeight="SemiBold" Text="{Binding Label, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding State, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                               Text="{Binding SelectionId}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SelectedToolSetupCard"
                        Margin="0,0,0,6"
                        Padding="7"
                        Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                        BorderBrush="{DynamicResource ThreeD.AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsSelectedStepDualRoiTeaching, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="SelectedToolSetupCard">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{views:ThreeDText Key=ThreeD.Workspace.StepSetup, Korean='단계 설정', English='Step setup'}" />
                            </StackPanel>
                            <ui:Button x:Name="SelectedToolSetupBackToToolsButton"
                                       Grid.Column="1"
                                       MinHeight="26"
                                       Margin="7,0,0,0"
                                       Padding="6,2"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowLeft24}"
                                       Content="{views:ThreeDText Key=ThreeD.Command.BackToTools, Korean='도구', English='Tools'}"
                                       Command="{Binding OpenToolLibraryCommand}"
                                       ToolTip="{views:ThreeDText Key=ThreeD.Command.BackToToolsTip, Korean='검사 도구 목록으로 돌아갑니다. 레시피나 검사는 변경하지 않습니다.', English='Return to Inspection Tools without changing the recipe or running inspection.'}"
                                       AutomationProperties.AutomationId="SelectedToolSetupBackToTools"
                                       AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.BackToToolsAccessible, Korean='검사 도구 목록으로 돌아가기', English='Back to Inspection Tools'}" />
                        </Grid>

                        <TextBlock Margin="0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.RequiredSetup, Korean='필수 설정', English='Required setup'}"
                                   Visibility="Collapsed" />
                        <ItemsControl ItemsSource="{Binding SelectedToolWorkspace.Regions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12"
                                                   Text="{Binding Label}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="7,0,0,0"
                                                   FontSize="12"
                                                   Style="{StaticResource RoiLifecycleStateTextStyle}"
                                                   Text="{Binding State}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,1,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12"
                                       Text="{views:ThreeDText Key=ThreeD.Workspace.Parameters, Korean='검사 조건', English='Inspection settings'}" />
                            <TextBlock x:Name="SelectedToolSetupStatusText"
                                       Grid.Column="1" Margin="7,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                       Text="{Binding SelectedToolWorkspace.ParameterStatus}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Padding="7,3" HorizontalAlignment="Right"
                                    Content="{views:ThreeDText Key=ThreeD.Workspace.GoToSettings, Korean='설정으로 이동', English='Go to settings'}"
                                    Click="OnShowParameterSettingsClicked"
                                    Visibility="{Binding SelectedToolWorkspace.IsParameterEditorSupported, Converter={StaticResource BoolToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="SelectedToolGoToSettings" />
                        </Grid>
                        <Border Margin="0,6,0,0"
                                Padding="7,5"
                                Background="{DynamicResource ThreeD.WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource ThreeD.WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding HasSelectedStepFlowProblem, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource ThreeD.WarningBrush}"
                                       Text="{Binding SelectedStepFlowProblem.Detail}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding TeachingSelectionCaptureInstruction}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsTeachingSelectionCaptureActive, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Grid Margin="0,7,0,0">
                            <ui:Button x:Name="SelectedToolSetupRepairButton"
                                       Padding="8,4"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                                       Content="{Binding Localization.RepairRoute}"
                                       Command="{Binding FocusFlowProblemStepCommand}"
                                       CommandParameter="{Binding SelectedStepFlowProblem}"
                                       ToolTip="{Binding Localization.RepairRouteToolTip}"
                                       AutomationProperties.AutomationId="SelectedToolSetupPrimaryActionRepair"
                                       AutomationProperties.Name="{Binding Localization.RepairRoute}"
                                       Visibility="{Binding HasSelectedStepFlowProblem, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ui:Button x:Name="SelectedToolSetupFirstRoiButton"
                                       Padding="8,4"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon TargetArrow24}"
                                       Content="{views:ThreeDText Key=ThreeD.Command.DrawFirstRoi, Korean='기준 ROI 그리기', English='Draw Reference ROI'}"
                                       Command="{Binding CapturePlaneFlatnessReferenceRoiCommand}"
                                       AutomationProperties.AutomationId="SelectedToolSetupPrimaryActionFirstRoi">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSelectedStepFlowProblem}" Value="False" />
                                                    <Condition Binding="{Binding IsTeachingSelectionCaptureActive}" Value="False" />
                                                    <Condition Binding="{Binding HasDualRoiFirstSelection}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button x:Name="SelectedToolSetupSecondRoiButton"
                                       Padding="8,4"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon TargetArrow24}"
                                       Content="{views:ThreeDText Key=ThreeD.Command.DrawSecondRoi, Korean='측정 ROI 그리기', English='Draw Measurement ROI'}"
                                       Command="{Binding CapturePlaneFlatnessMeasurementRoiCommand}"
                                       AutomationProperties.AutomationId="SelectedToolSetupPrimaryActionSecondRoi">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSelectedStepFlowProblem}" Value="False" />
                                                    <Condition Binding="{Binding IsTeachingSelectionCaptureActive}" Value="False" />
                                                    <Condition Binding="{Binding HasDualRoiFirstSelection}" Value="True" />
                                                    <Condition Binding="{Binding HasDualRoiSecondSelection}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button x:Name="SelectedToolSetupApplyRoiButton"
                                       Padding="8,4"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                       Content="{views:ThreeDText Key=ThreeD.Command.ApplyCurrentRoi, Korean='현재 ROI 적용', English='Apply current ROI'}"
                                       Command="{Binding ApplyTeachingSelectionCaptureCommand}"
                                       AutomationProperties.AutomationId="SelectedToolSetupPrimaryActionApplyRoi">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSelectedStepFlowProblem}" Value="False" />
                                                    <Condition Binding="{Binding IsTeachingSelectionCaptureActive}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                            <ui:Button x:Name="SelectedToolSetupApplyParametersButton"
                                       Padding="8,4"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Center"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       Content="{Binding Localization.ApplyParameters}"
                                       Command="{Binding ApplySelectedStepParameterDraftCommand}"
                                       AutomationProperties.AutomationId="SelectedToolSetupPrimaryActionApplyParameters">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSelectedStepFlowProblem}" Value="False" />
                                                    <Condition Binding="{Binding IsTeachingSelectionCaptureActive}" Value="False" />
                                                    <Condition Binding="{Binding HasCompleteDualRoiTeaching}" Value="True" />
                                                    <Condition Binding="{Binding HasPendingStepParameterChanges}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>

                        </Grid>

                    </StackPanel>
                </Border>
                </StackPanel>
                <Expander x:Name="OutputSection"
                          IsExpanded="True"
                          Style="{StaticResource WorkspaceSectionStyle}"
                          Header="{views:ThreeDText Key=ThreeD.Workspace.Outputs, Korean='4  출력', English='4  Outputs'}">
                    <StackPanel>
                    <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding SelectedToolWorkspace.Outputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.SelectedToolOutputAccessible, Korean='선택 도구 출력 및 작업', English='Selected tool output and actions'}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Button Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SelectWorkspaceOutputCommand, ElementName=SelectedToolRoot}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.SelectToolOutputAccessible, Korean='도구 출력 선택', English='Select tool output'}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ThreeD.AccentBrush}"
                                                               Text="{Binding DisplayName}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="6,0,0,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                                               Text="{Binding State}" />
                                                </Grid>
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                           Text="{Binding ContractDisplay}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                       Text="{Binding ValueLabel}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="7,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                                       Text="{Binding Value}" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       Text="{Binding Unit}" />
                                            <Border Grid.Column="3"
                                                    Margin="7,0,0,0"
                                                    Padding="5,1"
                                                    Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                                    CornerRadius="2"
                                                    Visibility="{Binding HasResultStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ResultStatus}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ResultStatus}" Value="Pass">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ResultStatus}" Value="Fail">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ResultStatus}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <Expander Margin="0,4,0,0"
                                                  Header="{views:ThreeDText Key=ThreeD.Expert.TechnicalDetails, Korean='기술 정보', English='Technical details'}"
                                                  IsExpanded="False"
                                                  AutomationProperties.AutomationId="SelectedToolTechnicalDetails"
                                                  AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Expert.TechnicalDetails, Korean='기술 정보', English='Technical details'}">
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       Text="{Binding Detail}"
                                                       TextWrapping="Wrap" />
                                        </Expander>
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                   Text="{Binding Availability}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ThreeD.PassBrush}"
                                                   Text="{Binding ComparePinsSummary}"
                                                   Visibility="{Binding HasComparePins, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Margin="0,0,3,0"
                                                       Padding="5,3"
                                                       HorizontalAlignment="Stretch"
                                                       Icon="{ui:SymbolIcon Eye24}"
                                                       Command="{Binding DataContext.ShowWorkspaceOutputCommand, ElementName=SelectedToolRoot}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="{views:ThreeDText Key=ThreeD.Command.ShowOutputInViewerTip, Korean='선택한 출력을 뷰어에 표시', English='Show selected output in Viewer'}"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.ShowOutputInViewerAccessible, Korean='선택한 출력을 뷰어에 표시', English='Show selected output in Viewer'}" />
                                            <ui:Button Grid.Column="1"
                                                       Margin="3,0"
                                                       Padding="5,3"
                                                       HorizontalAlignment="Stretch"
                                                       Icon="{ui:SymbolIcon Document24}"
                                                       Command="{Binding DataContext.PinWorkspaceOutputCommand, ElementName=SelectedToolRoot}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="{views:ThreeDText Key=ThreeD.Command.PinOutputTip, Korean='선택한 출력을 비교 대상으로 고정', English='Pin selected output for comparison'}"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.PinOutputAccessible, Korean='선택한 출력을 비교 대상으로 고정', English='Pin selected output to comparison'}" />
                                            <ui:Button Grid.Column="2"
                                                       Margin="3,0,0,0"
                                                       Padding="5,3"
                                                       HorizontalAlignment="Stretch"
                                                       Icon="{ui:SymbolIcon Table24}"
                                                       Command="{Binding DataContext.CompareWorkspaceOutputCommand, ElementName=SelectedToolRoot}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="{views:ThreeDText Key=ThreeD.Command.CompareOutputTip, Korean='선택한 출력의 비교 화면 열기', English='Open selected output comparison'}"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.CompareOutputAccessible, Korean='선택한 출력 비교 열기', English='Open selected output comparison'}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,8,0,0"
                            Padding="8"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="{Binding HasCompletenessCellResults, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.CompletenessFailedCellReviewAccessible, Korean='완전성 실패 셀 검토', English='Completeness failed cell review'}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThreeD.TextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.CompletenessReview, Korean='셀 결과 검토', English='Cell result review'}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.CompletenessReviewViewOnly, Korean='보기 전용 · 레시피 및 실행 상태 변경 없음', English='View only · recipe and execution state stay unchanged'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.FailBrush}"
                                           Text="{Binding CompletenessFailureNavigationSummary}" />
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Margin="0,0,3,0"
                                           Padding="6,3"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding PreviousCompletenessFailureCommand}"
                                           ToolTip="{views:ThreeDText Key=ThreeD.Command.PreviousFailedCellTip, Korean='이전 실패 셀을 2D/3D에서 함께 선택합니다.', English='Select the previous failed cell in both 2D and 3D.'}"
                                           AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.PreviousFailedCompletenessCellAccessible, Korean='이전 완전성 실패 셀', English='Previous failed completeness cell'}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowLeft24" />
                                        <TextBlock Margin="5,0,0,0"
                                                   Text="{views:ThreeDText Key=ThreeD.Command.PreviousFailedCell, Korean='이전 실패', English='Previous failure'}" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Grid.Column="1"
                                           Margin="3,0,0,0"
                                           Padding="6,3"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding NextCompletenessFailureCommand}"
                                           ToolTip="{views:ThreeDText Key=ThreeD.Command.NextFailedCellTip, Korean='다음 실패 셀을 2D/3D에서 함께 선택합니다.', English='Select the next failed cell in both 2D and 3D.'}"
                                           AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.NextFailedCompletenessCellAccessible, Korean='다음 완전성 실패 셀', English='Next failed completeness cell'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0"
                                                   Text="{views:ThreeDText Key=ThreeD.Command.NextFailedCell, Korean='다음 실패', English='Next failure'}" />
                                        <ui:SymbolIcon Symbol="ArrowRight24" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>

                            <ItemsControl Margin="0,6,0,0"
                                          ItemsSource="{Binding CompletenessCellResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,1"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SelectCompletenessCellCommand, ElementName=SelectedToolRoot}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.SelectCompletenessCellAccessible, Korean='완전성 셀 선택', English='Select completeness cell'}">
                                            <Border Padding="6,4"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.PanelBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThreeD.TextBrush}"
                                                                   Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,1,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                                   Text="{Binding EvidenceSummary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,1,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                                   Text="{Binding IdentitySummary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasMappedThicknessIdentity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="7,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding StatusText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Expander>

                <Expander Header="{views:ThreeDText Key=ThreeD.Workspace.ToolExecutionOptions, Korean='도구 사용 설정', English='Tool execution options'}" IsExpanded="False" Margin="0,0,0,7"><CheckBox VerticalAlignment="Center"
                          Margin="0,0,0,6"
                          Content="{views:ThreeDText Key=ThreeD.Workspace.OutputEnabled, Korean='이 도구 사용', English='Enable this tool'}"
                          IsChecked="{Binding SelectedPipelineStep.OutputEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditRecipe}"
                          ToolTip="{views:ThreeDText Key=ThreeD.Workspace.OutputEnabledTip, Korean='끄면 레시피 실행에서 이 도구를 건너뜁니다.', English='When off, recipe execution skips this tool.'}"
                          AutomationProperties.AutomationId="SelectedToolOutputEnabledToggle" /></Expander><Expander Margin="0,0,0,7"
                          IsExpanded="False"
                          Header="{views:ThreeDText Key=ThreeD.Workspace.Help, Korean='도움말', English='Help'}">
                    <StackPanel>
                        <TextBlock Margin="0,5,0,0"
                                   Padding="8"
                                   Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding SelectedToolWorkspace.Help}"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,6,0,0"
                                Padding="8"
                                Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.InfoBrush}"
                                           Text="{Binding Localization.SelectedToolExampleLabel}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{Binding SelectedToolWorkspace.Example}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.InfoBrush}"
                                           Text="{Binding Localization.SelectedToolExpectedOverlayLabel}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{Binding SelectedToolWorkspace.ExpectedOverlay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
                </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="SelectedToolActionBar"
                Grid.Row="1"
                Margin="10,8,10,10"
                Padding="8,6"
                Background="{DynamicResource ThreeD.CommandBarBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="1"
                CornerRadius="4"
                AutomationProperties.AutomationId="SelectedToolActionBar">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedToolWorkspace.HasSelectedStep}" Value="True" />
                                <Condition Binding="{Binding IsSourceQualityWorkspaceVisible}" Value="False" />
                                <Condition Binding="{Binding IsLabPresentation, ElementName=SelectedToolRoot}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SelectedToolParameterNotice"
                           Grid.Row="0"
                           AutomationProperties.AutomationId="SelectedToolParameterNotice"
                           Text="{Binding SelectedToolWorkspace.ParameterStatus}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingStepParameterChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="PreviewActionButton"
                               MinWidth="120"
                               Height="30"
                               Margin="0,0,4,0"
                               Padding="5,4"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Appearance="Primary"
                               FontSize="12"
                               Content="{views:ThreeDText Key=ThreeD.Command.RunSelectedAction, Korean='선택 도구 실행', English='Run selected tool'}"
                               Command="{Binding RunSelectedStepCommand}"
                               ToolTip="{views:ThreeDText Key=ThreeD.Command.RunSelectedTip, Korean='선택 도구 실행 (F5)', English='Run selected tool (F5)'}"
                               AutomationProperties.AutomationId="PreviewTeachingToolButton"
                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.RunSelectedAccessible, Korean='선택 검사 단계 실행', English='Run selected inspection step'}" />
                    <ui:Button x:Name="CancelPreviewActionButton"
                               Grid.Column="1"
                               MinWidth="62"
                               Height="30"
                               Padding="5,4"
                               FontSize="12"
                               Content="{views:ThreeDText Key=ThreeD.Command.CancelAction, Korean='취소', English='Cancel'}"
                               Command="{Binding CancelSelectedPreviewCommand}"
                               Visibility="{Binding IsSelectedStepPreviewRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="{views:ThreeDText Key=ThreeD.Command.CancelSelectedRunTip, Korean='진행 중인 실행 취소', English='Cancel the current run'}"
                               AutomationProperties.AutomationId="CancelTeachingPreviewButton"
                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.CancelSelectedRunAccessible, Korean='선택 도구 실행 취소', English='Cancel selected tool run'}" />
                </Grid>
                <TextBlock x:Name="SelectedToolExplicitRunHint"
                           Grid.Row="2"
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Workspace.ExplicitRunHint, Korean='영역과 조건을 확인한 뒤 실행하세요.', English='Check regions and settings, then run.'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="False">
                                    <Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Workspace.LoadInputBeforeRun, Korean='먼저 티칭 3D 입력을 불러오세요.', English='Load a teaching 3D input first.'}" />
                                </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPipelineStep.OutputEnabled}" Value="False"><Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Workspace.ToolDisabled, Korean='이 도구는 꺼져 있습니다. 상세에서 도구 사용을 켜세요.', English='This tool is off. Enable it in Details.'}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
