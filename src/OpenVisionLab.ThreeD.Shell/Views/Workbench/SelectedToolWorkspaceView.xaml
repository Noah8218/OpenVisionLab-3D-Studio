                                CornerRadius="3"
                                Visibility="{Binding SelectedToolWorkspace.IsParameterEditorSupported, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                 <StackPanel Margin="0,0,0,6"
                                             Visibility="{Binding IsSelectedStepAcceptanceLimitsUnconfigured, Converter={StaticResource BoolToVisibilityConverter}}">
                                     <TextBlock Text="{views:ThreeDText Key=ThreeD.Workspace.UnconfiguredLimitsNote, Korean='규격 미설정 · 값만 측정합니다.', English='Limits not configured · measure values only.'}"
                                                TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.WarningBrush}" />
                                     <Button Margin="0,5,0,0" HorizontalAlignment="Stretch"
                                             Content="{views:ThreeDText Key=ThreeD.Workspace.ConfigureLimits, Korean='현재 조건을 판정 규격으로 사용', English='Use current settings as acceptance limits'}"
                                             Command="{Binding ConfigureSelectedStepAcceptanceLimitsCommand}"
                                             AutomationProperties.AutomationId="ConfigureSelectedStepAcceptanceLimits" />
                                 </StackPanel>
                                 <CheckBox x:Name="ShowAdvancedSamples" IsChecked="False" Margin="0,0,0,5" Content="{views:ThreeDText Key=ThreeD.Workspace.AdvancedSamples, Korean='유효점 상세 설정', English='Valid sample settings'}" />
