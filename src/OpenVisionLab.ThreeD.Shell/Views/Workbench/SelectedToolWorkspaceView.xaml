                                               AutomationProperties.AutomationId="NewOrientedBox3D"
                                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.OrientedBox.CreateAccessible, Korean='숫자 OrientedBox3D 생성', English='Create numeric OrientedBox3D'}" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox MinWidth="160"
                                              ItemsSource="{Binding OrientedBoxEditor.Selections}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding OrientedBoxEditor.SelectedSelection, Mode=TwoWay}"
                                              ToolTip="{views:ThreeDText Key=ThreeD.Workspace.OrientedBoxSelection, Korean='저장된 3D 박스 선택', English='Select an applied 3D box'}"
                                              AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.OrientedBox.SelectAccessible, Korean='적용된 OrientedBox3D 선택', English='Applied OrientedBox3D selections'}" />
                                    <ui:Button Grid.Column="1"
                                               Margin="6,0,0,0"
                                               Padding="7,3"
                                               Content="{views:ThreeDText Key=ThreeD.Command.DeleteOrientedBox, Korean='박스 삭제', English='Delete box'}"
                                               Command="{Binding OrientedBoxEditor.DeleteCommand}"
                                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.OrientedBox.DeleteAccessible, Korean='선택한 OrientedBox3D 삭제', English='Delete selected OrientedBox3D'}" />
                                </Grid>

                                <StackPanel Margin="0,6,0,0"
                                            Visibility="{Binding OrientedBoxEditor.IsDraftOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.RegionName, Korean='영역 이름', English='Region name'}" />
                                    <TextBox Margin="0,2,0,5"
                                             Text="{Binding OrientedBoxEditor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.OrientedBox.NameAccessible, Korean='OrientedBox3D 영역 이름', English='OrientedBox3D region name'}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" Text="X" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="12" Text="Y" />
                                        <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="12" Text="Z" />

                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12"
                                                   Text="{views:ThreeDText Key=ThreeD.Workspace.Center, Korean='중심', English='Center'}" />
