                                                   FontSize="12"
                                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                   Text="{views:ThreeDText Key=ThreeD.Workspace.OrientedBoxPersistedVolumeBoundary, Korean='중심 XYZ와 반길이 XYZ가 저장되는 3D 체적입니다. 격자 사각형의 보기 전용 Y 위치와 다릅니다.', English='Persisted 3D volume: center XYZ and half-extents XYZ. This is separate from the GridRectangle view-only Y position.'}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
