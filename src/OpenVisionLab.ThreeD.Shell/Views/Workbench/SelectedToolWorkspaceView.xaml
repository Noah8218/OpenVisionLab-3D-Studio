                                                 Text="{Binding OrientedBoxEditor.CenterX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.CenterY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="1" Grid.Column="3" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.CenterZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <TextBlock Grid.Row="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{views:ThreeDText Key=ThreeD.Workbench.OrientedBox.AxisX, Korean='축 X', English='Axis X'}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisXX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="2" Grid.Column="2" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisXY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="2" Grid.Column="3" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisXZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <TextBlock Grid.Row="3"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{views:ThreeDText Key=ThreeD.Workbench.OrientedBox.AxisY, Korean='축 Y', English='Axis Y'}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisYX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="3" Grid.Column="2" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisYY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="3" Grid.Column="3" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisYZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <TextBlock Grid.Row="4"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{views:ThreeDText Key=ThreeD.Workbench.OrientedBox.AxisZ, Korean='축 Z', English='Axis Z'}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisZX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="4" Grid.Column="2" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisZY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="4" Grid.Column="3" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.AxisZZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <TextBlock Grid.Row="5" VerticalAlignment="Center" FontSize="12"
                                                   Text="{views:ThreeDText Key=ThreeD.Workspace.HalfExtents, Korean='반길이', English='Half size'}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.HalfExtentX, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="5" Grid.Column="2" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.HalfExtentY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Grid.Row="5" Grid.Column="3" Margin="1"
                                                 Text="{Binding OrientedBoxEditor.HalfExtentZ, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>

                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                               Text="{Binding OrientedBoxEditor.ValidationSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.OrientedBoxReviewBarHint, Korean='위 검토 바 사용: Enter 적용, Esc 취소', English='Use the Review bar above: Enter applies, Esc cancels.'}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding OrientedBoxEditor.Status}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Expander>
                </Grid>
                <Grid>
                <Expander x:Name="ParametersExpander"
                          Style="{StaticResource RequiredSettingsSectionStyle}"
                          IsExpanded="True"
                          AutomationProperties.AutomationId="SelectedToolParametersExpander"
                          AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.Parameters.SelectedToolAccessible, Korean='선택 도구 설정값', English='Selected tool parameters'}"
                          Header="{views:ThreeDText Key=ThreeD.Settings.ConditionsSection, Korean='03  검사 조건', English='03  Inspection settings'}"
                          ToolTip="{Binding SelectedToolWorkspace.ParameterStatus}">
                    <StackPanel Margin="0,5,0,0">
                        <Border Padding="8"
                                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
