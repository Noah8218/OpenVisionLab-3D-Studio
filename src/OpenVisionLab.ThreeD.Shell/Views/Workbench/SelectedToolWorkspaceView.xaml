                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SettingsDraftTextBrush}" Text="{views:ThreeDText Key=ThreeD.Settings.UnappliedChangesCompact, Korean='미적용 변경', English='Unapplied changes'}" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="SelectedToolFooterDiscardButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SettingsFooterDiscardButtonStyle}" Content="{Binding Localization.Discard}" Command="{Binding DiscardSelectedStepParameterDraftCommand}" AutomationProperties.AutomationId="DiscardSelectedToolParameters" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.Parameters.DiscardToolDraftAccessibleName, Korean='선택 도구 설정값 변경 취소', English='Discard selected tool parameter changes'}" />
                        <Button x:Name="SelectedToolFooterApplyButton" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SettingsFooterApplyButtonStyle}" Content="{views:ThreeDText Key=ThreeD.Settings.ApplyCompact, Korean='적용', English='Apply'}"
                                behaviors:CommitPropertyGridCommandBehavior.IsEnabled="True"
                                behaviors:CommitPropertyGridCommandBehavior.PropertyGrid="{Binding ElementName=StepPropertyGrid}"
                                behaviors:CommitPropertyGridCommandBehavior.AdditionalPropertyGrid="{Binding ElementName=AcceptancePropertyGrid}"
                                behaviors:CommitPropertyGridCommandBehavior.Command="{Binding ApplySelectedStepParameterDraftCommand}"
                                behaviors:CommitPropertyGridCommandBehavior.ErrorCommand="{Binding ReportParameterDraftCommitErrorCommand}"
                                AutomationProperties.AutomationId="ApplySelectedToolParameters" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.Parameters.ApplyToolDraftAccessibleName, Korean='검사 실행 없이 선택 도구 설정값 적용', English='Apply selected tool parameters without running inspection'}" />
                    </Grid>
                </Border>

                <TextBlock x:Name="SelectedToolParameterNotice"
                           Grid.Row="2"
                           AutomationProperties.AutomationId="SelectedToolParameterNotice"
                           Text="{Binding SelectedToolWorkspace.ParameterStatus}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           LineHeight="17.4" LineStackingStrategy="BlockLineHeight"
                           Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingStepParameterChanges}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviewActionButton" Style="{StaticResource SettingsFooterPrimaryButtonStyle}" Height="34" FontSize="13" Margin="0,0,6,0" Padding="10,4" HorizontalAlignment="Stretch"
                            Command="{Binding RunSelectedStepCommand}" ToolTip="{views:ThreeDText Key=ThreeD.Command.RunSelectedTip, Korean='선택 도구 실행 (F5)', English='Run selected tool (F5)'}"
                            AutomationProperties.AutomationId="PreviewTeachingToolButton" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.RunSelectedAccessible, Korean='선택 검사 단계 실행', English='Run selected inspection step'}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play16" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{views:ThreeDText Key=ThreeD.Settings.RunCompact, Korean='실행', English='Run'}" VerticalAlignment="Center" />
                            <Border Margin="6,0,0,0" Padding="5,0" BorderThickness="1,1,1,2" BorderBrush="{DynamicResource ThreeD.PrimaryButtonTextBrush}" CornerRadius="4" VerticalAlignment="Center"><TextBlock Text="F5" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Normal" LineHeight="16" LineStackingStrategy="BlockLineHeight" /></Border>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Margin="0,0,6,0" Padding="8,4" MinHeight="34" Style="{StaticResource SettingsFooterButtonStyle}" Content="{views:ThreeDText Key=ThreeD.Settings.UndoCompact, Korean='되돌리기', English='Undo'}" Command="{Binding UndoSelectedStepParametersCommand}" ToolTip="Ctrl+Z" AutomationProperties.AutomationId="UndoSelectedToolParametersFooter" />
                    <Button x:Name="SelectedToolFooterMenuButton" Grid.Column="2" Width="30" Height="34" Padding="0" Content="⋯" FontSize="20" Tag="{Binding}" Click="OnFooterToolMenuClick"
                            ToolTip="{views:ThreeDText Key=ThreeD.Flow.ToolMenu, Korean='도구 메뉴', English='Tool menu'}" AutomationProperties.AutomationId="SelectedToolFooterMenu" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Flow.ToolMenu, Korean='도구 메뉴', English='Tool menu'}">
                        <Button.ContextMenu><ContextMenu Placement="Top" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding Localization.MoveUp}" Command="{Binding MoveSelectedStepUpCommand}" />
                            <MenuItem Header="{Binding Localization.MoveDown}" Command="{Binding MoveSelectedStepDownCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding Localization.RemoveStep}" Command="{Binding RemoveSelectedStepCommand}" />
                            <MenuItem Header="{Binding Localization.OpenSelectedToolLab}" Command="{Binding OpenSelectedToolLabCommand}" />
                        </ContextMenu></Button.ContextMenu>
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsFooterButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSelectedStepPreviewRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <ui:Button x:Name="CancelPreviewActionButton"
                               Grid.Column="2"
                               MinWidth="62"
                               Height="34"
                               Padding="5,4"
                               FontSize="12"
                               Content="{views:ThreeDText Key=ThreeD.Command.CancelAction, Korean='취소', English='Cancel'}"
                               Command="{Binding CancelSelectedPreviewCommand}"
                               Visibility="{Binding IsSelectedStepPreviewRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="{views:ThreeDText Key=ThreeD.Command.CancelSelectedRunTip, Korean='진행 중인 실행 취소', English='Cancel the current run'}"
                               AutomationProperties.AutomationId="CancelTeachingPreviewButton"
                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.CancelSelectedRunAccessible, Korean='선택 도구 실행 취소', English='Cancel selected tool run'}" />
                </Grid>
                <TextBlock x:Name="SelectedToolExplicitRunHint"
                           Grid.Row="2"
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="False"><Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Workspace.LoadInputBeforeRun, Korean='먼저 티칭 3D 입력을 불러오세요.', English='Load a teaching 3D input first.'}" />
                                </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPipelineStep.OutputEnabled}" Value="False"><Setter Property="Visibility" Value="Visible" /><Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Workspace.ToolDisabled, Korean='이 도구는 꺼져 있습니다. 상세에서 도구 사용을 켜세요.', English='This tool is off. Enable it in Details.'}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
