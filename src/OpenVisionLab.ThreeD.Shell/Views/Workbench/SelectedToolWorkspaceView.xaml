                                                                          ShowAdvancedParameters="{Binding IsChecked, ElementName=ShowAdvancedSamples}"
                                                                          IsEnabled="{Binding CanEditRecipe}"
                                                                          Height="150"
                                                                          SelectedObject="{Binding SelectedToolWorkspace.ParameterDraft}"
                                                                          PropertyValueChangedCommand="{Binding MarkSelectedStepParameterDraftDirtyCommand}" />
                                 <Border Margin="0,7,0,0"
                                         Padding="8"
                                         Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                         BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                                         BorderThickness="1"
                                         CornerRadius="3"
                                         Visibility="{Binding IsPreparationPresetAssistantVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                         AutomationProperties.AutomationId="PreparationPresetAssistant"
                                         AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.PreparationPreset.AssistantAccessible, Korean='전처리 추천 설정', English='Preparation preset draft assistant'}">
                                     <StackPanel>
                                         <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <TextBlock FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource ThreeD.InfoBrush}"
                                                        Text="{views:ThreeDText Key=ThreeD.Workspace.PreparationPresetAssistant, Korean='전처리 추천 설정', English='Preparation preset draft'}" />
                                             <TextBlock Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource ThreeD.AccentBrush}"
                                                        Text="{Binding PreparationPresetAssistantStageText}" />
                                         </Grid>
                                         <TextBlock Margin="0,4,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                    Text="{Binding PreparationPresetAssistantSummary}"
                                                    TextWrapping="Wrap" />
                                         <Grid Margin="0,6,0,0">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="Auto" />
                                                 <ColumnDefinition Width="*" />
                                             </Grid.ColumnDefinitions>
                                             <TextBlock VerticalAlignment="Center"
                                                        Margin="0,0,7,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                        Text="{views:ThreeDText Key=ThreeD.Workspace.Preset, Korean='프리셋', English='Preset'}" />
                                             <ComboBox Grid.Column="1"
                                                       MinHeight="30"
                                                       ItemsSource="{Binding PreparationPresetOptions}"
                                                       SelectedItem="{Binding SelectedPreparationPreset, Mode=TwoWay}"
                                                       DisplayMemberPath="DisplayName"
                                                       IsEnabled="{Binding IsPreparationPresetAnalysisReady}"
                                                       ToolTip="{Binding SelectedPreparationPreset.Detail}"
                                                       AutomationProperties.AutomationId="PreparationPresetSelector"
                                                       AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.PreparationPreset.SelectAccessible, Korean='Filter 준비 프리셋 선택', English='Select a Filter preparation preset'}" />
                                         </Grid>
                                         <WrapPanel Margin="0,6,0,0">
                                             <Button Margin="0,0,5,5"
                                                     Content="{views:ThreeDText Key=ThreeD.Command.Analyze, Korean='분석', English='Analyze'}"
                                                     Command="{Binding AnalyzePreparationPresetsCommand}"
                                                     ToolTip="{views:ThreeDText Key=ThreeD.Command.AnalyzePreparationPresetsTip, Korean='현재 필터 설정에 사용할 수 있는 저장 설정을 확인합니다. 검사는 실행하지 않습니다. (Ctrl+Alt+A)', English='Inspect the preparation presets available for the current Filter draft without executing. (Ctrl+Alt+A)'}"
                                                     AutomationProperties.AutomationId="AnalyzePreparationPresets"
                                                     AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.PreparationPreset.AnalyzeAccessible, Korean='준비 프리셋 분석', English='Analyze preparation presets'}" />
                                             <Button Margin="0,0,5,5"
                                                     Content="{views:ThreeDText Key=ThreeD.Command.Propose, Korean='제안', English='Propose'}"
                                                     Command="{Binding ProposePreparationPresetCommand}"
                                                     ToolTip="{views:ThreeDText Key=ThreeD.Command.ProposePreparationPresetTip, Korean='선택한 저장 설정으로 추천 설정을 준비합니다. 레시피와 검사 상태는 변경하지 않습니다. (Ctrl+Alt+P)', English='Prepare the selected preset as a draft proposal without changing the recipe or execution. (Ctrl+Alt+P)'}"
                                                     AutomationProperties.AutomationId="ProposePreparationPreset"
                                                     AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.PreparationPreset.ProposeAccessible, Korean='준비 프리셋 제안', English='Propose preparation preset'}" />
                                             <Button Margin="0,0,5,5"
                                                     Content="{views:ThreeDText Key=ThreeD.Command.Review, Korean='검토', English='Review'}"
                                                     Command="{Binding ReviewPreparationPresetCommand}"
                                                     ToolTip="{views:ThreeDText Key=ThreeD.Command.ReviewPreparationPresetTip, Korean='추천 설정을 확인합니다. 확인만으로는 설정값이나 레시피를 변경하지 않습니다. (Ctrl+Alt+R)', English='Review the proposal without changing the draft or recipe. (Ctrl+Alt+R)'}"
                                                     AutomationProperties.AutomationId="ReviewPreparationPreset"
                                                     AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.PreparationPreset.ReviewAccessible, Korean='준비 프리셋 검토', English='Review preparation preset'}" />
                                             <Button Margin="0,0,5,5"
                                                     Content="{views:ThreeDText Key=ThreeD.Command.Cancel, Korean='취소', English='Cancel'}"
                                                     Command="{Binding CancelPreparationPresetReviewCommand}"
                                                     ToolTip="{views:ThreeDText Key=ThreeD.Command.CancelPreparationPresetTip, Korean='임시 프리셋 제안과 검토 상태만 취소합니다. 레시피와 실행은 변경하지 않습니다. (Ctrl+Alt+C)', English='Cancel the transient preset proposal and review state without changing the recipe or execution. (Ctrl+Alt+C)'}"
                                                     AutomationProperties.AutomationId="CancelPreparationPresetReview"
                                                     AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.PreparationPreset.CancelAccessible, Korean='준비 프리셋 검토 취소', English='Cancel preparation preset review'}" />
                                             <Button Margin="0,0,0,5"
                                                     Content="{views:ThreeDText Key=ThreeD.Command.ApplyDraft, Korean='설정창에 입력', English='Apply draft'}"
                                                     Command="{Binding ApplyPreparationPresetDraftCommand}"
                                                     ToolTip="{views:ThreeDText Key=ThreeD.Command.ApplyPreparationPresetDraftTip, Korean='검토한 프리셋을 설정창에 입력합니다. 설정값 적용 전에는 레시피가 바뀌지 않습니다. (Ctrl+Alt+D)', English='Apply the reviewed preset to the PropertyGrid draft only. The recipe stays unchanged until normal Apply. (Ctrl+Alt+D)'}"
                                                     AutomationProperties.AutomationId="ApplyPreparationPresetDraft"
                                                     AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.PreparationPreset.ApplyAccessible, Korean='추천 설정을 설정창에 입력', English='Apply preparation preset to draft'}" />
                                         </WrapPanel>
                                     </StackPanel>
                                 </Border>
                                <WrapPanel Margin="0,6,0,0" HorizontalAlignment="Right">
                                    <Button Margin="0,0,5,0"
                                            Content="{Binding Localization.Discard}"
                                            Command="{Binding DiscardSelectedStepParameterDraftCommand}"
                                            AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.Parameters.DiscardToolDraftAccessibleName, Korean='선택 도구 설정값 변경 취소', English='Discard selected tool parameter changes'}" />
                                    <Button Content="{Binding Localization.ApplyParameters}"
                                            IsEnabled="{Binding HasPendingStepParameterChanges}"
                                            behaviors:CommitPropertyGridCommandBehavior.IsEnabled="True"
                                            behaviors:CommitPropertyGridCommandBehavior.PropertyGrid="{Binding ElementName=StepPropertyGrid}"
                                            behaviors:CommitPropertyGridCommandBehavior.Command="{Binding ApplySelectedStepParameterDraftCommand}"
                                            behaviors:CommitPropertyGridCommandBehavior.ErrorCommand="{Binding ReportParameterDraftCommitErrorCommand}"
                                            AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workbench.Parameters.ApplyToolDraftAccessibleName, Korean='검사 실행 없이 선택 도구 설정값 적용', English='Apply selected tool parameters without running inspection'}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding SelectedToolWorkspace.ParameterStatus}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedToolWorkspace.IsParameterEditorSupported}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedToolWorkspace.HasPendingParameterChanges}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>
                </Grid>

                <Expander IsExpanded="False" Header="{views:ThreeDText Key=ThreeD.Workspace.OutlierDetails, Korean='처리 상세', English='Processing details'}" Margin="0,0,0,7"
