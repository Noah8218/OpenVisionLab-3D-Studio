<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.SelectedToolWorkspaceView"
             x:Name="SelectedToolRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:propertyGrid="clr-namespace:OpenVisionLab.ThreeD.Shell.PropertyGrid"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:workbenchVm="clr-namespace:OpenVisionLab.ThreeD.Shell.ViewModels.Workbench"
             AutomationProperties.AutomationId="SelectedToolWorkspace">
    <UserControl.Resources>
        <workbench:MeasurementNumberTextConverter x:Key="MeasurementNumberTextConverter" />
        <SolidColorBrush x:Key="SettingsFooterSurfaceBrush" Color="#1F262E" />
        <SolidColorBrush x:Key="SettingsButtonHoverBorderBrush" Color="#4B5967" />
        <SolidColorBrush x:Key="SettingsButtonPressedBorderBrush" Color="#7B8C9A" />
        <SolidColorBrush x:Key="SettingsButtonDisabledSurfaceBrush" Color="#1E252C" />
        <SolidColorBrush x:Key="SettingsButtonDisabledBorderBrush" Color="#323C47" />
        <SolidColorBrush x:Key="SettingsPrimaryDisabledSurfaceBrush" Color="#2A3A3A" />
        <SolidColorBrush x:Key="SettingsPrimaryDisabledBorderBrush" Color="#2F4443" />
        <SolidColorBrush x:Key="SettingsPrimaryDisabledTextBrush" Color="#7F9C97" />
        <SolidColorBrush x:Key="SettingsDraftTextBrush" Color="#F3D9AE" />
        <Style x:Key="SettingsFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Malgun Gothic" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="SettingsButtonFocusOutline" Margin="-3" BorderBrush="{DynamicResource ThreeD.FocusBrush}" BorderThickness="2" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SettingsButtonFocusOutline" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SettingsButtonFocusOutline" Property="Visibility" Value="Collapsed" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource SettingsButtonHoverBorderBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource SettingsButtonPressedBorderBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource SettingsButtonDisabledSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource SettingsButtonDisabledBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsFooterDiscardButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsFooterButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource SettingsDraftTextBrush}" />
        </Style>
        <Style x:Key="SettingsFooterPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsFooterButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThreeD.AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryButtonTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.AccentHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.AccentPressedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentPressedBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource SettingsPrimaryDisabledSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource SettingsPrimaryDisabledBorderBrush}" /><Setter Property="Foreground" Value="{StaticResource SettingsPrimaryDisabledTextBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsFooterApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsFooterPrimaryButtonStyle}">
            <Setter Property="IsEnabled" Value="{Binding HasPendingStepParameterChanges}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValidationErrors, ElementName=StepPropertyGrid}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                <DataTrigger Binding="{Binding HasValidationErrors, ElementName=AcceptancePropertyGrid}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                <DataTrigger Binding="{Binding CanEditRecipe}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectedToolApplyParameterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="IsEnabled" Value="{Binding HasPendingStepParameterChanges}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValidationErrors, ElementName=StepPropertyGrid}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                <DataTrigger Binding="{Binding HasValidationErrors, ElementName=AcceptancePropertyGrid}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                <DataTrigger Binding="{Binding CanEditRecipe}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <workbench:HeightImageFrameConverter x:Key="HeightImageFrameConverter" />
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
        <SolidColorBrush x:Key="AppliedRoiHoverBorderBrush" Color="#8C9DAE" />
        <Style x:Key="AppliedRoiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17.4" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
        </Style>
        <Style x:Key="AppliedRoiTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Malgun Gothic" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="ContentBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                <ScrollViewer x:Name="PART_ContentHost" BorderThickness="0" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <Border x:Name="FocusOutline" Margin="-2" BorderBrush="{DynamicResource ThreeD.FocusBrush}" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{StaticResource AppliedRoiHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceSectionStyle" TargetType="{x:Type Expander}">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <StackPanel>
                            <ToggleButton x:Name="SectionHeader"
                                          MinHeight="32"
                                          Padding="8,4"
                                          HorizontalContentAlignment="Stretch"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="HeaderSurface"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{DynamicResource ThreeD.CommandBarBrush}"
                                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="Chevron"
                                                               Width="16"
                                                               Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                               Symbol="ChevronRight16" />
                                                <ContentPresenter Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  ContentSource="Content"
                                                                  RecognizesAccessKey="True" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Symbol" Value="ChevronDown16" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="Background"
                                                        Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface"
                                                        Property="Background"
                                                        Value="{DynamicResource ThreeD.HoverSurfaceBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.InputBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeaderSurface"
                                                        Property="Background"
                                                        Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.InputBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.FocusBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chevron"
                                                        Property="Foreground"
                                                        Value="{DynamicResource ThreeD.DisabledBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="Background"
                                                        Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                                <Setter TargetName="HeaderSurface"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ThreeD.DividerBrush}" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ToggleButton>
                            <Border x:Name="SectionContent"
                                    Visibility="Collapsed">
                                <ContentPresenter ContentSource="Content" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="SectionContent"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SectionHeader"
                                        Property="IsEnabled"
                                        Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RequiredSettingsSectionStyle" TargetType="Expander" BasedOn="{StaticResource WorkspaceSectionStyle}">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12"><StackPanel>
                            <TextBlock x:Name="RequiredSettingsHeader" Margin="0,0,0,4" FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontWeight="650" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{TemplateBinding Header}" />
                            <ContentPresenter ContentSource="Content" />
                        </StackPanel></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLabPresentation, ElementName=SelectedToolRoot}" Value="True">
                    <Setter Property="Margin" Value="0,0,0,7" />
                    <Setter Property="Template">
                        <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12"><StackPanel>
                            <TextBlock x:Name="RequiredSettingsHeader" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource ThreeD.PrimaryTextBrush}" Text="{TemplateBinding Header}" />
                            <ContentPresenter ContentSource="Content" />
                        </StackPanel></Border>
                    </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RegionCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style x:Key="EditorPageTabStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ThreeD.CommandBarBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoiLifecycleStateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Drawing}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Review}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Applied}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoSelectedStepParametersCommand}" />
        <KeyBinding Key="A"
                    Modifiers="Control+Alt"
                    Command="{Binding AnalyzePreparationPresetsCommand}" />
        <KeyBinding Key="P"
                    Modifiers="Control+Alt"
                    Command="{Binding ProposePreparationPresetCommand}" />
        <KeyBinding Key="R"
                    Modifiers="Control+Alt"
                    Command="{Binding ReviewPreparationPresetCommand}" />
        <KeyBinding Key="C"
                    Modifiers="Control+Alt"
                    Command="{Binding CancelPreparationPresetReviewCommand}" />
        <KeyBinding Key="D"
                    Modifiers="Control+Alt"
                    Command="{Binding ApplyPreparationPresetDraftCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource ThreeD.PanelBrush}"
          TextElement.Foreground="{DynamicResource ThreeD.TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="1" Grid.RowSpan="2"
                Margin="12"
                Padding="12"
                VerticalAlignment="Top"
                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Style="{DynamicResource ThreeD.PanelTitleTextStyle}"
                           Text="{Binding Localization.NoRecipeStepSelected}" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{Binding Localization.NoRecipeStepSelectedDetail}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedToolWorkspace.HasSelectedStep}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSourceQualityWorkspaceVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <workbench:SourceQualityWorkspaceView
            x:Name="SourceQualityWorkspace"
            Grid.Row="1" Grid.RowSpan="2"
            DataContext="{Binding SourceQuality}"
            Visibility="{Binding DataContext.IsSourceQualityWorkspaceVisible, ElementName=SelectedToolRoot, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border Grid.Row="0" Height="34" Padding="10,0" Background="{DynamicResource ThreeD.DockHeaderBrush}" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1">
            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{views:ThreeDText Key=ThreeD.Workspace.ToolSettings, Korean='도구 설정', English='Tool settings'}" />
        </Border>
        <Border x:Name="SelectedToolHeader"
                        Grid.Row="1" Margin="0"
                        Padding="12,10"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="4"
                        AutomationProperties.AutomationId="SelectedToolHeader">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedToolWorkspace.HasSelectedStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsLabPresentation, ElementName=SelectedToolRoot}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedToolHeaderTitle" Visibility="Collapsed" Text="{Binding SelectedPipelineStep.ToolName}" />
                            <TextBox x:Name="SelectedToolNameEditor" FontSize="14" FontWeight="SemiBold" Padding="3,2" MinHeight="26" Margin="-4,0,0,0" Background="Transparent" BorderThickness="1" IsReadOnly="{Binding IsRecipeMutationBlocked}" Text="{Binding SelectedPipelineStep.ToolName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="SelectedToolNameEditor" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Settings.ToolName, Korean='도구 이름', English='Tool name'}">
                                <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger></Style.Triggers>
                                </Style></TextBox.Style>
                            </TextBox>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}">
                                <Run Text="{Binding SelectedPipelineStep.Order, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding PipelineSteps.Count, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding SelectedPipelineStep.Tool.DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPipelineStep.Tool.DisplayName}" />
                    </StackPanel>
                </Border>
        <Grid Grid.Row="2" x:Name="SelectedToolEditorWorkspace">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedToolWorkspace.HasSelectedStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsSourceQualityWorkspaceVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
<Expander Margin="12,0"
                          IsExpanded="True"
                          Header="{views:ThreeDText Key=ThreeD.Settings.InputSection, Korean='입력', English='Input'}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource RequiredSettingsSectionStyle}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Border Padding="0,8" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1"><ContentPresenter ContentSource="Content" /></Border></ControlTemplate></Setter.Value></Setter></Style></Expander.Style>
                    <StackPanel Margin="0,5,0,0">
                        <ItemsControl ItemsSource="{Binding SelectedToolWorkspace.DataInputs}" AutomationProperties.AutomationId="SelectedToolDataInputs">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,0,0,6">

