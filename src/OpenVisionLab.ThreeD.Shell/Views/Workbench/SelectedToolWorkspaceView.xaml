<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.SelectedToolWorkspaceView"
             x:Name="SelectedToolRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:propertyGrid="clr-namespace:OpenVisionLab.ThreeD.Shell.PropertyGrid"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:workbenchVm="clr-namespace:OpenVisionLab.ThreeD.Shell.ViewModels.Workbench"
             AutomationProperties.AutomationId="SelectedToolWorkspace">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="WorkspaceSectionStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="IsExpanded" Value="False" />
        </Style>
        <Style x:Key="RegionCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style x:Key="RoiLifecycleStateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Drawing}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Review}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Lifecycle}"
                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Applied}">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ThreeD.PanelBrush}"
          TextElement.Foreground="{DynamicResource ThreeD.TextBrush}">
        <Border Margin="12"
                Padding="12"
                VerticalAlignment="Top"
                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Style="{DynamicResource ThreeD.PanelTitleTextStyle}"
                           Text="{Binding Localization.NoRecipeStepSelected}" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="10.5"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{Binding Localization.NoRecipeStepSelectedDetail}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedToolWorkspace.HasSelectedStep}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSourceQualityWorkspaceVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <workbench:SourceQualityWorkspaceView
            DataContext="{Binding SourceQuality}"
            Visibility="{Binding IsSourceQualityWorkspaceVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedToolWorkspace.HasSelectedStep}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border x:Name="TeachFailureCorrectionContext"
                        Margin="0,0,0,8"
                        Padding="10"
                        Background="#FFF7ED"
                        BorderBrush="#F97316"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding HasActiveValidationFailureCorrectionContext, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="TeachFailureCorrectionContext">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#9A3412"
                                       Text="{views:ThreeDText Key=ThreeD.Workspace.FixFailureInTeach, Korean='실패 샘플 수정', English='Fix failed sample in Teach'}" />
                            <Border Grid.Column="1"
                                    Margin="7,0,0,0"
                                    Padding="6,2"
                                    Background="#FFEDD5"
                                    CornerRadius="8">
                                <TextBlock FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#C2410C"
                                           Text="{Binding ActiveValidationFailureCorrectionContext.SampleStatus}" />
                            </Border>
                        </Grid>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActiveValidationFailureCorrectionContext.SampleName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ActiveValidationFailureCorrectionContext.SourcePath}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding ActiveValidationFailureCorrectionContext.ToolName, StringFormat=Rule: {0}}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="#9A3412"
                                   Text="{Binding ActiveValidationFailureCorrectionContext.Reason}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#C2410C"
                                   Text="{Binding ActiveValidationFailureCorrectionContext.CellSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.FixFailureNextAction, Korean='ROI 또는 파라미터를 검토하고 Preview를 명시적으로 실행한 뒤 샘플 세트를 다시 실행하세요.', English='Review the ROI or parameters, run Preview explicitly, then rerun the sample set.'}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="9"
                        Margin="0,0,0,8"
                        Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                        BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedToolWorkspace.Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource ThreeD.InfoBrush}"
                                       Text="{Binding SelectedToolWorkspace.State}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="7,0,0,0"
                                   Padding="7,3"
                                   VerticalAlignment="Center"
                                   Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                                   Command="{Binding OpenSelectedToolLabCommand}"
                                   Visibility="{Binding IsSelectedToolLabAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                   ToolTip="{Binding Localization.OpenSelectedToolLab}"
                                   AutomationProperties.Name="{Binding Localization.OpenSelectedToolLab}" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,7"
                        Padding="8"
                        Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding IsSelectedStepLevelSurface, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.LevelSurfaceEvidence, Korean='표면 레벨링 증거', English='Level Surface evidence'}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding LevelSurfaceReferenceSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Text="{Binding LevelSurfaceExecutionSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.AccentBrush}"
                                   Text="{Binding LevelSurfaceResidualSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding LevelSurfaceTransformSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding LevelSurfaceOutputSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.LevelSurfaceBoundary, Korean='원본 격자와 결측 셀은 유지되며 파생 C3D에만 높이 기울기 보정이 적용됩니다.', English='The source grid and missing cells are preserved; height detrending applies only to the derived C3D.'}"
                                   TextWrapping="Wrap" />
                        <ui:Button Margin="0,6,0,0"
                                   Padding="7,3"
                                   HorizontalAlignment="Left"
                                   Content="{views:ThreeDText Key=ThreeD.Command.AddLevelReferenceRoi, Korean='기준 ROI 추가', English='Add reference ROI'}"
                                   Icon="{ui:SymbolIcon AddCircle24}"
                                   Command="{Binding BeginAdditionalLevelSurfaceReferenceCommand}"
                                   AutomationProperties.Name="Add another Level Surface reference ROI" />
                    </StackPanel>
                </Border>

                <Expander Style="{StaticResource WorkspaceSectionStyle}"
                          Header="{views:ThreeDText Key=ThreeD.Workspace.Inputs, Korean='1  입력', English='1  Inputs'}">
                    <StackPanel Margin="0,5,0,0">
                        <ItemsControl ItemsSource="{Binding SelectedToolWorkspace.Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,4"
                                            Padding="0"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.SelectWorkspaceInputCommand, ElementName=SelectedToolRoot}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Select typed tool input">
                                        <Border Padding="7,5"
                                                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding RequiredContract}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="6,0,0,0"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                                               Text="{Binding State}" />
                                                </Grid>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding EntityId}" />
                                                <TextBlock Margin="0,1,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}">
                                                    <Run Text="{Binding FrameId}" />
                                                    <Run Text=" | " />
                                                    <Run Text="{Binding Unit}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Margin="0,3,0,0"
                                  IsExpanded="False"
                                  Header="{views:ThreeDText Key=ThreeD.Workspace.EditTypedRoute, Korean='고급 입력 경로 편집', English='Advanced input route editing'}">
                            <StackPanel Margin="0,5,0,0">
                                <TextBox Text="{Binding SelectedPipelineStep.InputEntityIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.Workspace.RouteDoesNotRun, Korean='경로 변경은 Preview 또는 Run을 실행하지 않습니다.', English='Changing a route does not invoke Preview or Run.'}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource WorkspaceSectionStyle}"
                          Header="{views:ThreeDText Key=ThreeD.Workspace.Parameters, Korean='2  파라미터', English='2  Parameters'}">
                    <StackPanel Margin="0,5,0,0">
                        <Border Padding="8"
                                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding SelectedToolWorkspace.IsParameterEditorSupported, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="{Binding Localization.TypedParameters}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="6,0,0,0"
                                               FontSize="9"
                                               Foreground="{DynamicResource ThreeD.AccentBrush}"
                                               Text="{Binding SelectedStepAdapterStatus}" />
                                </Grid>
                                <propertyGrid:RecipeStepPropertyGridHost x:Name="StepPropertyGrid"
                                                                         Height="210"
                                                                         SelectedObject="{Binding SelectedToolWorkspace.ParameterDraft}"
                                                                         PropertyValueChangedCommand="{Binding MarkSelectedStepParameterDraftDirtyCommand}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{Binding SelectedToolWorkspace.ParameterStatus}"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,6,0,0" HorizontalAlignment="Right">
                                    <Button Margin="0,0,5,0"
                                            Content="{Binding Localization.Discard}"
                                            Command="{Binding DiscardSelectedStepParameterDraftCommand}"
                                            AutomationProperties.Name="Discard selected tool parameter changes" />
                                    <Button Content="{Binding Localization.ApplyParameters}"
                                            IsEnabled="{Binding HasPendingStepParameterChanges}"
                                            Click="OnApplyParametersClick"
                                            AutomationProperties.Name="Apply selected tool parameters without running inspection" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="9.5"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding SelectedToolWorkspace.ParameterStatus}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedToolWorkspace.IsParameterEditorSupported}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>

                <Border Margin="0,0,0,7"
                        Padding="8"
                        Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding IsSelectedStepRemoveOutlierPixels, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.OutlierEvidence, Korean='이상치 제거 증거', English='Outlier removal evidence'}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding RemoveOutlierRuleSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9.5"
                                   Text="{Binding RemoveOutlierExecutionSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.AccentBrush}"
                                   Text="{Binding RemoveOutlierOutputSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding RemoveOutlierMaskSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.OutlierSourceImmutable, Korean='원본은 변경되지 않으며 제거 셀은 파생 출력에서 결측으로 표시됩니다.', English='The source is unchanged; removed cells become missing only in the derived output.'}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander Style="{StaticResource WorkspaceSectionStyle}"
                          IsExpanded="True"
                          Visibility="{Binding IsSelectedStepRegionSurfaceVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                          Header="{views:ThreeDText Key=ThreeD.Workspace.Regions, Korean='3  ROI / 영역', English='3  ROI / Regions'}">
                    <StackPanel Margin="0,5,0,0">
                        <Border Margin="0,0,0,6"
                                Padding="8,6"
                                Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource ThreeD.AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding IsSelectedStepDualRoiMeasurement, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="ActiveRoiLifecycleSummary">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="9"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{views:ThreeDText Key=ThreeD.Workspace.ActiveRoiRole, Korean='현재 ROI 역할', English='Active ROI role'}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="9"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding SelectedToolWorkspace.ActiveRegionPosition}" />
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedToolWorkspace.ActiveRegion.Label}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="6,0,0,0"
                                               Style="{StaticResource RoiLifecycleStateTextStyle}"
                                               DataContext="{Binding SelectedToolWorkspace.ActiveRegion}"
                                               Text="{Binding State}" />
                                </Grid>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.Workspace.RoiMissingNext, Korean='다음 작업: ROI 그리기를 선택하세요.', English='Next: select Draw ROI.'}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedToolWorkspace.ActiveRegion.Lifecycle}"
                                                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Missing}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.Workspace.RoiDrawingNext, Korean='뷰어에서 첫 모서리와 반대편 모서리를 지정하세요.', English='Pick the first and opposite corners in the Viewer.'}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedToolWorkspace.ActiveRegion.Lifecycle}"
                                                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Drawing}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.Workspace.RoiReviewNext, Korean='그리기는 끝났습니다. 핸들 또는 숫자를 조정한 뒤 적용하거나 취소하세요.', English='Drawing is complete. Adjust handles or numbers, then Apply or Cancel.'}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedToolWorkspace.ActiveRegion.Lifecycle}"
                                                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Review}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.Workspace.RoiAppliedNext, Korean='적용된 ROI입니다. 편집·삭제·ROI 맞춤을 선택할 수 있습니다.', English='This ROI is applied. Edit, delete, or Fit ROI is available.'}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedToolWorkspace.ActiveRegion.Lifecycle}"
                                                             Value="{x:Static workbenchVm:InspectionWorkspaceRegionLifecycleState.Applied}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ThicknessRepeatGridPanel"
                                Margin="0,0,0,6"
                                Padding="8"
                                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                BorderBrush="{DynamicResource ThreeD.AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                AutomationProperties.AutomationId="ThicknessRepeatGridPanel">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelectedStepThickness}" Value="True" />
                                                <Condition Binding="{Binding IsTeachingSelectionCaptureActive}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Localization.ThicknessRepeatGrid}" />
                                        <TextBlock Margin="0,2,0,0"
