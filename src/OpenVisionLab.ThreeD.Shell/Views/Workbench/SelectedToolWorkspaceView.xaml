                        Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsSelectedStepRemoveOutlierPixels, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.OutlierEvidence, Korean='이상치 제거 정보', English='Outlier removal evidence'}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding RemoveOutlierRuleSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Text="{Binding RemoveOutlierExecutionSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.AccentBrush}"
                                   Text="{Binding RemoveOutlierOutputSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding RemoveOutlierMaskSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.OutlierSourceImmutable, Korean='원본은 변경되지 않으며 제거 셀은 파생 출력에서 결측으로 표시됩니다.', English='The source is unchanged; removed cells become missing only in the derived output.'}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>


                <Expander x:Name="SettingsDetails" Style="{StaticResource WorkspaceSectionStyle}" Header="{views:ThreeDText Key=ThreeD.Settings.Details, Korean='상세 정보', English='Details'}" IsExpanded="False" Margin="0,12,0,8" AutomationProperties.AutomationId="SelectedToolDetails">
