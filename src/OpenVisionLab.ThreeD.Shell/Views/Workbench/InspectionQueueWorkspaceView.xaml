<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.InspectionQueueWorkspaceView"
             x:Name="QueueRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             AutomationProperties.AutomationId="InspectionQueueWorkspace">
    <UserControl.Resources>
        <workbench:MeasurementNumberTextConverter x:Key="MeasurementNumberTextConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <workbench:InspectionCountGridLengthConverter x:Key="InspectionCountGridLengthConverter" />
        <Style x:Key="QueueChoiceStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="22" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QueueFilterStyle" TargetType="ToggleButton" BasedOn="{StaticResource QueueChoiceStyle}">
            <Setter Property="Height" Value="24" /><Setter Property="Padding" Value="9,0" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QueueNativeMenuStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Style.Triggers><DataTrigger Binding="{Binding DockPaneCommands, ElementName=QueueRoot}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="QueueRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /><Setter Property="Padding" Value="6" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></Trigger>
            </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>

        </Style>
        <Style x:Key="QueueStatusIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Circle16" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Pass"><Setter Property="Symbol" Value="Checkmark16" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fail"><Setter Property="Symbol" Value="Dismiss16" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Symbol" Value="ErrorCircle16" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning"><Setter Property="Symbol" Value="Warning16" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter Property="Symbol" Value="Stop16" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Symbol" Value="Play16" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InspectionDistributionSegmentStyle" TargetType="Border">
            <Style.Triggers><DataTrigger Binding="{Binding}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="QueueStatusPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="7,1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="MinHeight" Value="20" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Pass"><Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fail"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning"><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource ThreeD.PanelBrush}" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.Queue, Korean='반복 검사 목록', English='Repeated inspection queue'}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Padding="6,0" Background="{DynamicResource ThreeD.CommandBarBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="0,0,0,1" AutomationProperties.AutomationId="InspectionQueueHeader">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="{shell:ThreeDText Key=ThreeD.Inspection.FileQueueTitle, Korean='검사 파일', English='Inspection files'}" />
                    <TextBlock Grid.Column="1" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding AllCount}" />
                    <ui:Button Grid.Column="3" Height="24" MinHeight="0" Padding="5,0" Icon="{ui:SymbolIcon Add16}" Content="{shell:ThreeDText Key=ThreeD.Inspection.Files, Korean='파일', English='Files'}" Command="{Binding AddFilesCommand}" AutomationProperties.AutomationId="InspectionAddFiles" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.AddFiles, Korean='파일 추가', English='Add files'}" />
                    <ui:Button Grid.Column="4" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="4,0" Icon="{ui:SymbolIcon FolderOpen16}" Command="{Binding AddFolderCommand}" ToolTip="{shell:ThreeDText Key=ThreeD.Inspection.AddFolder, Korean='폴더 추가', English='Add folder'}" AutomationProperties.AutomationId="InspectionAddFolder" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.AddFolder, Korean='폴더 추가', English='Add folder'}" />
                    <Menu Grid.Column="5" Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Width="28" Height="24" MinHeight="0" Padding="4,0" Template="{StaticResource R19TopMenuItemTemplate}" AutomationProperties.AutomationId="InspectionAdditionalMenu" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.MoreActions, Korean='검사 작업', English='Inspection actions'}">
                            <MenuItem.Header><TextBlock FontSize="18" Text="⋯" /></MenuItem.Header>
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.UseSelectedInputForTeaching, Korean='티칭 입력으로 사용', English='Use as teaching input'}" Command="{Binding UseSelectedInputForTeachingCommand}" AutomationProperties.AutomationId="InspectionUseTeachingInput" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.CheckDisplayedFiles, Korean='표시 파일 체크', English='Check displayed files'}" Command="{Binding CheckVisibleCommand}" AutomationProperties.AutomationId="InspectionCheckVisible" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.UncheckFiles, Korean='표시 파일 체크 해제', English='Uncheck displayed files'}" Command="{Binding UncheckVisibleCommand}" AutomationProperties.AutomationId="InspectionUncheckVisible" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.ClearQueue, Korean='목록 비우기', English='Clear queue'}" Command="{Binding ClearQueueCommand}" AutomationProperties.AutomationId="InspectionClearQueue" />
                            <Separator />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.RunSelected, Korean='선택한 파일 검사', English='Inspect selected file'}" Command="{Binding RunSelectedCommand}" AutomationProperties.AutomationId="InspectionRunSelected" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.RunAll, Korean='전체 파일 다시 검사', English='Inspect all files again'}" Command="{Binding RunAllCommand}" AutomationProperties.AutomationId="InspectionRunAll" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.RunRemaining, Korean='남은 파일 검사', English='Inspect remaining files'}" Command="{Binding RunRemainingCommand}" AutomationProperties.AutomationId="InspectionRunRemaining" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.NewContext, Korean='새 검사 목록 준비', English='Prepare new inspection queue'}" Command="{Binding NewInspectionContextCommand}" AutomationProperties.AutomationId="InspectionNewContext" />
                            <Separator />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.OpenRecord, Korean='선택 파일 실행 기록', English='Selected file Run Record'}" Command="{Binding OpenRunRecordCommand}" AutomationProperties.AutomationId="InspectionOpenRunRecord" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.OpenPreviousRecord, Korean='이전 실행 기록', English='Previous Run Record'}" Command="{Binding OpenPreviousRunRecordCommand}" AutomationProperties.AutomationId="InspectionOpenPreviousRunRecord" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.ExportCsv, Korean='CSV 내보내기', English='Export CSV'}" Command="{Binding ExportCsvCommand}" AutomationProperties.AutomationId="InspectionExportCsv" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Inspection.ReturnToTeaching, Korean='티칭으로 돌아가기', English='Return to teaching'}" Command="{Binding ReturnToTeachingCommand}" AutomationProperties.AutomationId="InspectionReturnToTeaching" />
                            <MenuItem Header="{shell:ThreeDText Key=ThreeD.Navigation.Results, Korean='결과', English='Results'}" Command="{Binding ResultsCommand, ElementName=QueueRoot}" CommandParameter="{x:Static shell:ShellWorkspaceMode.Review}" AutomationProperties.AutomationId="OpenInspectionResultsButton" />
                            <Separator />
                            <MenuItem Style="{StaticResource QueueNativeMenuStyle}" Header="{shell:ThreeDText Key=ThreeD.Dock.AutoHide, Korean='자동 숨김', English='Auto hide'}" Command="{Binding DockPaneCommands.AutoHideCommand, ElementName=QueueRoot}" AutomationProperties.AutomationId="InspectionAutoHidePaneAction" />
                            <MenuItem Style="{StaticResource QueueNativeMenuStyle}" Header="{shell:ThreeDText Key=ThreeD.Dock.Float, Korean='분리 창', English='Float'}" Command="{Binding DockPaneCommands.FloatCommand, ElementName=QueueRoot}" AutomationProperties.AutomationId="InspectionFloatPaneAction" />
                        </MenuItem>
                    </Menu>
                    <ui:Button Grid.Column="6" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="4,0" Icon="{ui:SymbolIcon Pin16}" Command="{Binding DockPaneCommands.AutoHideCommand, ElementName=QueueRoot}" ToolTip="{shell:ThreeDText Key=ThreeD.Dock.AutoHide, Korean='자동 숨김', English='Auto hide'}" AutomationProperties.AutomationId="InspectionQueueAutoHide" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Dock.AutoHide, Korean='자동 숨김', English='Auto hide'}">
                        <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Style.Triggers><DataTrigger Binding="{Binding DockPaneCommands, ElementName=QueueRoot}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1">
            <Border Margin="10,4,10,6" Padding="10,8" CornerRadius="6" Background="{DynamicResource ThreeD.InspectionSummarySurfaceBrush}" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="1" AutomationProperties.AutomationId="InspectionQueueSummaryCard">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding ProcessedCountText}" AutomationProperties.AutomationId="InspectionQueueCounts" />
                        <TextBlock Grid.Column="1" FontSize="12" LineHeight="23.2" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" VerticalAlignment="Top" AutomationProperties.AutomationId="InspectionQueuePassRate">
                            <Run Text="{shell:ThreeDText Key=ThreeD.Inspection.PassRate, Korean='OK 비율', English='OK rate'}" /><Run Text=" " /><Run FontSize="16" FontWeight="650" Foreground="{DynamicResource ThreeD.TextBrush}" Text="{Binding PassRateText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <Grid Height="6" Margin="0,6,0,0" Background="{DynamicResource ThreeD.InspectionStateTrackBrush}" ClipToBounds="True" UseLayoutRounding="False" SizeChanged="OnDistributionSizeChanged" AutomationProperties.AutomationId="InspectionQueueSummaryProgress"
                          AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.StateDistribution, Korean='전체 목록 상태 분포', English='Whole queue state distribution'}" AutomationProperties.HelpText="{Binding CountsText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding PassCount, Converter={StaticResource InspectionCountGridLengthConverter}, Mode=OneWay}" />
                            <ColumnDefinition Width="{Binding FailCount, Converter={StaticResource InspectionCountGridLengthConverter}, Mode=OneWay}" />
                            <ColumnDefinition Width="{Binding ErrorCount, Converter={StaticResource InspectionCountGridLengthConverter}, Mode=OneWay}" />
                            <ColumnDefinition Width="{Binding WarningCount, Converter={StaticResource InspectionCountGridLengthConverter}, Mode=OneWay}" />
                            <ColumnDefinition Width="{Binding CancelledCount, Converter={StaticResource InspectionCountGridLengthConverter}, Mode=OneWay}" />
                            <ColumnDefinition Width="{Binding UntestedCount, Converter={StaticResource InspectionCountGridLengthConverter}, Mode=OneWay}" />
                            <ColumnDefinition Width="{Binding RunningCount, Converter={StaticResource InspectionCountGridLengthConverter}, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Border DataContext="{Binding PassCount}" Style="{StaticResource InspectionDistributionSegmentStyle}" Background="{DynamicResource ThreeD.InspectionPassSegmentBrush}" />
                        <Border Grid.Column="1" DataContext="{Binding FailCount}" Style="{StaticResource InspectionDistributionSegmentStyle}" Background="{DynamicResource ThreeD.InspectionFailSegmentBrush}" />
                        <Border Grid.Column="2" DataContext="{Binding ErrorCount}" Style="{StaticResource InspectionDistributionSegmentStyle}" Background="{DynamicResource ThreeD.InspectionErrorSegmentBrush}" />
                        <Border Grid.Column="3" DataContext="{Binding WarningCount}" Style="{StaticResource InspectionDistributionSegmentStyle}" Background="{DynamicResource ThreeD.WarningBrush}" />
                        <Border Grid.Column="4" DataContext="{Binding CancelledCount}" Style="{StaticResource InspectionDistributionSegmentStyle}" Background="{DynamicResource ThreeD.InspectionCancelledSegmentBrush}" />
                        <Border Grid.Column="5" DataContext="{Binding UntestedCount}" Style="{StaticResource InspectionDistributionSegmentStyle}" Background="{DynamicResource ThreeD.InspectionUntestedSegmentBrush}" />
                        <Border Grid.Column="6" DataContext="{Binding RunningCount}" Style="{StaticResource InspectionDistributionSegmentStyle}" Background="{DynamicResource ThreeD.AccentBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
                <ScrollViewer Margin="10,0,10,6" MaxHeight="36" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding SummaryText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding SummaryText}" AutomationProperties.AutomationId="InspectionQueueSummary" />
                </ScrollViewer>
            </StackPanel>
            <WrapPanel Grid.Row="2" Margin="10,2,6,2" AutomationProperties.AutomationId="InspectionStatusFilters">
            <RadioButton Style="{StaticResource QueueFilterStyle}" IsChecked="{Binding IsStatusFilterAll, Mode=OneWay}" Command="{Binding SetStatusFilterCommand}" CommandParameter="All" AutomationProperties.AutomationId="InspectionFilterAll">
                <TextBlock><Run Text="{shell:ThreeDText Key=ThreeD.Inspection.FilterAll, Korean='전체', English='All'}" /><Run Text=" " /><Run Text="{Binding AllCount, Mode=OneWay}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource QueueFilterStyle}" IsChecked="{Binding IsStatusFilterFail, Mode=OneWay}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Fail" AutomationProperties.AutomationId="InspectionFilterFail">
                <TextBlock><Run Text="{shell:ThreeDText Key=ThreeD.Inspection.FilterFail, Korean='NG', English='Fail'}" /><Run Text=" " /><Run Text="{Binding FailCount, Mode=OneWay}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource QueueFilterStyle}" IsChecked="{Binding IsStatusFilterError, Mode=OneWay}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Error" AutomationProperties.AutomationId="InspectionFilterError">
                <TextBlock><Run Text="{shell:ThreeDText Key=ThreeD.Inspection.FilterError, Korean='오류', English='Error'}" /><Run Text=" " /><Run Text="{Binding ErrorCount, Mode=OneWay}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource QueueFilterStyle}" IsChecked="{Binding IsStatusFilterUntested, Mode=OneWay}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Untested" AutomationProperties.AutomationId="InspectionFilterUntested">
                <TextBlock><Run Text="{shell:ThreeDText Key=ThreeD.Inspection.FilterUntested, Korean='미검사', English='Untested'}" /><Run Text=" " /><Run Text="{Binding UntestedCount, Mode=OneWay}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource QueueFilterStyle}" IsChecked="{Binding IsStatusFilterCancelled, Mode=OneWay}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Cancelled" AutomationProperties.AutomationId="InspectionFilterCancelled">
                <TextBlock><Run Text="{shell:ThreeDText Key=ThreeD.Inspection.FilterCancelled, Korean='취소', English='Cancelled'}" /><Run Text=" " /><Run Text="{Binding CancelledCount, Mode=OneWay}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource QueueFilterStyle}" IsChecked="{Binding IsStatusFilterPass, Mode=OneWay}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Pass" AutomationProperties.AutomationId="InspectionFilterPass">
                <TextBlock><Run Text="{shell:ThreeDText Key=ThreeD.Inspection.FilterPass, Korean='통과', English='Pass'}" /><Run Text=" " /><Run Text="{Binding PassCount, Mode=OneWay}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource QueueFilterStyle}" IsChecked="{Binding IsStatusFilterWarning, Mode=OneWay}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Warning" AutomationProperties.AutomationId="InspectionFilterWarning">
                <TextBlock><Run Text="{shell:ThreeDText Key=ThreeD.Inspection.FilterWarning, Korean='주의', English='Warning'}" /><Run Text=" " /><Run Text="{Binding WarningCount, Mode=OneWay}" /></TextBlock>
            </RadioButton>
            </WrapPanel>
            <Grid Grid.Row="3" Margin="10,0,10,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Search16" Width="14" Height="14" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" VerticalAlignment="Center" />
                <ui:TextBox Grid.Column="1" MinHeight="30" Padding="6,4" PlaceholderText="{shell:ThreeDText Key=ThreeD.Inspection.SearchFiles, Korean='파일 이름·경로 검색', English='Search file name or path'}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.SearchFiles, Korean='파일 이름·경로 검색', English='Search file name or path'}" AutomationProperties.AutomationId="InspectionSearch" />
                <ui:Button Grid.Column="2" Width="24" Height="30" MinWidth="0" MinHeight="0" Padding="4,0" Icon="{ui:SymbolIcon Dismiss16}" Command="{Binding ClearSearchCommand}" ToolTip="{shell:ThreeDText Key=ThreeD.Inspection.ClearSearch, Korean='검색 지우기', English='Clear search'}" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.ClearSearch, Korean='검색 지우기', English='Clear search'}" AutomationProperties.AutomationId="InspectionClearSearch" />
            </Grid>
            <Grid Grid.Row="4" Margin="6,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="InspectionQueueScrollViewer" Visibility="{Binding HasVisibleSamples, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding VisibleSamples}" AutomationProperties.AutomationId="InspectionQueueItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox Width="20" Height="22" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.AutomationId="InspectionQueueInclude" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.IncludeInRun, Korean='검사 목록에 포함', English='Include in inspection queue'}" AutomationProperties.HelpText="{Binding SourcePath}">
                                        <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsRunning, ElementName=QueueRoot}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding DataContext.HasPendingRecordSave, ElementName=QueueRoot}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></CheckBox.Style>
                                    </CheckBox>
                                    <Button Grid.Column="1" Style="{StaticResource QueueRowButtonStyle}" Command="{Binding DataContext.SelectSampleCommand, ElementName=QueueRoot}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding SourcePath}" AutomationProperties.AutomationId="InspectionQueueSelectSample">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Width="14" Height="14" VerticalAlignment="Center" Style="{StaticResource QueueStatusIconStyle}" />
                                            <StackPanel Grid.Column="1" Margin="7,0,7,0">
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" AutomationProperties.AutomationId="InspectionQueueFileName" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding StatusSummary}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="InspectionQueueFileSummary" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Right" Style="{StaticResource QueueStatusPillStyle}"><TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" Text="{Binding StateText}" AutomationProperties.AutomationId="InspectionQueueFileStatus" /></Border>
                                                <TextBlock Margin="0,2,0,0" MaxWidth="80" FontSize="11" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="{Binding ElapsedText}" AutomationProperties.AutomationId="InspectionQueueFileElapsed"
                                                           AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.ElapsedTime, Korean='검사 소요 시간', English='Inspection elapsed time'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding EmptyQueueText}" AutomationProperties.AutomationId="InspectionQueueEmpty">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasVisibleSamples}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <Expander Grid.Row="5" Margin="10,4" IsExpanded="False" Visibility="{Binding HasSelectedSample, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="InspectionFileResults">
                <Expander.Header><TextBlock FontSize="12" TextWrapping="Wrap" Text="{shell:ThreeDText Key=ThreeD.Inspection.SelectedFileDetails, Korean='선택 파일 정보·결과', English='Selected file details and results'}" /></Expander.Header>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedSample}" Margin="4,6">
                        <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding FileName}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding SourcePath}" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.InputPath, Korean='검사 입력 경로', English='Inspection input path'}" AutomationProperties.AutomationId="InspectionSelectedSourcePath" />
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" Text="{Binding StatusSummary}" AutomationProperties.AutomationId="InspectionSelectedStatusSummary" />
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" AutomationProperties.AutomationId="InspectionSelectedElapsed">
                            <Run Text="{shell:ThreeDText Key=ThreeD.Inspection.ElapsedTime, Korean='검사 소요 시간', English='Inspection elapsed time'}" /><Run Text=": " /><Run Text="{Binding ElapsedText, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Steps}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,5,0,5" TextElement.Foreground="{DynamicResource ThreeD.SecondaryTextBrush}">
                                                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.ColumnSpan="2" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ToolName}" />
                                                                                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Text="{shell:ThreeDText Key=ThreeD.Inspection.Judgement, Korean='판정', English='Result'}" />
                                                                                        <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding StatusLabel}" />
                                                                                        <TextBlock Grid.Row="2" Margin="0,3,0,0" TextWrapping="Wrap" Text="{shell:ThreeDText Key=ThreeD.Inspection.MeasuredValue, Korean='측정값', English='Value'}" />
                                                                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,3,0,0">
                                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                                            <TextBlock TextWrapping="Wrap" Text="{Binding Value, Converter={StaticResource MeasurementNumberTextConverter}}" AutomationProperties.AutomationId="InspectionFileResultValue" />
                                                                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="80" Text="{Binding Unit}" AutomationProperties.AutomationId="InspectionFileResultUnit" />
                                                                                        </Grid>
                                                                                        <TextBlock Grid.Row="3" Margin="0,3,0,0" TextWrapping="Wrap" Text="{shell:ThreeDText Key=ThreeD.Inspection.ResultLocation, Korean='검사 위치', English='Location'}" />
                                                                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="InspectionFileResultPosition">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Text" Value="{Binding Overlays}" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding Overlays}" Value="">
                                                                                                            <Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Inspection.NoRecordedLocation, Korean='기록된 위치 없음', English='No recorded location'}" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <Border Grid.Row="6" Margin="10,4" Padding="8" CornerRadius="4" Background="{DynamicResource ThreeD.FailSurfaceBrush}" BorderBrush="{DynamicResource ThreeD.FailBrush}" BorderThickness="1" AutomationProperties.AutomationId="InspectionRecordSaveFailure" Visibility="{Binding HasPendingRecordSave, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{shell:ThreeDText Key=ThreeD.Inspection.RecordSaveFailed, Korean='검사 중단 · 기록 저장 실패', English='Inspection stopped · record save failed'}" />
                    <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="InspectionRecordSaveMessageScroll"><TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding SummaryText}" /></ScrollViewer>
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{shell:ThreeDText Key=ThreeD.Inspection.SaveOnlyRecovery, Korean='계산 결과는 유지됩니다. 저장만 다시 시도하며, 남은 파일 검사는 직접 시작하세요.', English='Calculated results are kept. Retry saving only; start remaining inspections separately.'}" />
                    <Button HorizontalAlignment="Left" Margin="0,6,0,0" MinHeight="30" Padding="8,4" Content="{shell:ThreeDText Key=ThreeD.Inspection.RetryRecordSaveOnly, Korean='기록 저장만 다시 시도', English='Retry saving record only'}" Command="{Binding RetryRecordSaveCommand}" AutomationProperties.AutomationId="InspectionRetryRecordSave" />
                </StackPanel>
            </Border>
            <Border Grid.Row="7" Padding="10,8" Background="{DynamicResource ThreeD.PanelAlternateBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center" FontSize="11.5" IsChecked="{Binding AreVisibleSamplesChecked, Mode=OneWay}" Command="{Binding SetVisibleCheckedCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Content="{shell:ThreeDText Key=ThreeD.Inspection.CheckDisplayed, Korean='표시 파일 체크', English='Check displayed'}" AutomationProperties.AutomationId="InspectionCheckAllVisible" />
                    <Button Grid.Column="2" MinHeight="26" Padding="5,2" FontSize="11.5" Content="{shell:ThreeDText Key=ThreeD.Inspection.RemoveSelectedShort, Korean='선택 제거', English='Remove selected'}" Command="{Binding RemoveSelectedCommand}" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Inspection.RemoveSelected, Korean='선택 파일 목록에서 제거', English='Remove selected file from queue'}" AutomationProperties.AutomationId="InspectionRemoveSelected" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
