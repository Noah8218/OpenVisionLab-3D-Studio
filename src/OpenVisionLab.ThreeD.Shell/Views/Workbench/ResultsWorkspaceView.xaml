<UserControl x:Name="ResultsRoot" x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.ResultsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             xmlns:host="clr-namespace:OpenVisionLab.ThreeD.Viewer.Hosting;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:dock="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
             AutomationProperties.AutomationId="ResultsWorkspace">
    <UserControl.Resources>
        <workbench:MeasurementNumberTextConverter x:Key="MeasurementNumberTextConverter" />
        <Style x:Key="DrawerProfileFocusVisual" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Margin="-3" BorderBrush="{DynamicResource ThreeD.FocusBrush}" BorderThickness="2" CornerRadius="5" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DrawerProfileButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" /><Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="8,2" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Malgun Gothic" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DrawerProfileFocusVisual}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter TargetName="Surface" Property="Opacity" Value="0.55" /></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InspectionResultsTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="Height" Value="34" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="{DynamicResource ThreeD.CommandBarBrush}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="12,0"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <SolidColorBrush x:Key="ThreeD.TeachingResultsHeaderBrush" Color="#1D242B" />
        <SolidColorBrush x:Key="ThreeD.TeachingResultsLineBrush" Color="#262E37" />
        <SolidColorBrush x:Key="ThreeD.TeachingResultsSelectedBrush" Color="#203034" />
        <SolidColorBrush x:Key="ThreeD.TeachingResultsHoverBrush" Color="#222A32" />
        <SolidColorBrush x:Key="ThreeD.TeachingResultsBandBrush" Color="#2F5B44" />
        <SolidColorBrush x:Key="ThreeD.TeachingResultsMetaTextBrush" Color="#8B98A6" />
        <SolidColorBrush x:Key="ThreeD.TeachingResultsGripBrush" Color="#55626F" />
        <Style x:Key="TeachingDockButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TeachingResultsMetaTextBrush}" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Template" Value="{DynamicResource TeachingIconTemplate}" />
            <Style.Triggers><DataTrigger Binding="{Binding DockPaneCommands, ElementName=ResultsRoot}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <ControlTemplate x:Key="TeachingIconTemplate" TargetType="ButtonBase">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Opacity" Value="0.55" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="TeachingDetailsButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" /><Setter Property="Height" Value="22" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Template" Value="{StaticResource TeachingIconTemplate}" />
        </Style>
        <Style x:Key="TeachingStatusPill" TargetType="Border">
            <Setter Property="Padding" Value="6,1" /><Setter Property="CornerRadius" Value="9" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Pass"><Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.TeachingResultsBandBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Fail"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.InspectionErrorTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Previous"><Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <workbench:TeachingResultVisibilityConverter x:Key="TeachingResultVisibilityConverter" />
        <Style x:Key="ResultsTabFocusVisual" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Margin="2" BorderBrush="{DynamicResource ThreeD.FocusBrush}" BorderThickness="2" CornerRadius="3" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ResultsTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Height" Value="33" /><Setter Property="MinWidth" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ResultsTabFocusVisual}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid x:Name="TabSurface" Background="Transparent">
                    <ContentPresenter Margin="11,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="SelectedUnderline" Margin="9,0" Height="2" VerticalAlignment="Bottom" CornerRadius="2" Background="{DynamicResource ThreeD.AccentBrush}" Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /><Setter TargetName="SelectedUnderline" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="TeachingResultCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TeachingResultNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource TeachingResultCellStyle}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Cascadia Code, Consolas" /><Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.TeachingResultsMetaTextBrush}" />
        </Style>
        <Style x:Key="TeachingResultHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,6" /><Setter Property="Background" Value="{DynamicResource ThreeD.TeachingResultsHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TeachingResultNumericHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TeachingResultHeaderStyle}"><Setter Property="HorizontalContentAlignment" Value="Right" /></Style>
        <Style x:Key="TeachingResultTimeStyle" TargetType="TextBlock" BasedOn="{StaticResource TeachingResultNumberStyle}"><Setter Property="TextAlignment" Value="Left" /></Style>
        <Style x:Key="TeachingResultRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource ThreeD.CalibrationDataGridRowStyle}">
            <Setter Property="BorderThickness" Value="0" /><Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource TeachingResultVisibilityConverter}">
                <Binding Path="Step" />
                <Binding Path="DataContext.Workbench.SelectedTeachingResult.Step" RelativeSource="{RelativeSource AncestorType=workbench:ResultsWorkspaceView}" />
                <Binding Path="DataContext.ResultsWorkspace.ShowOnlySelectedTool" RelativeSource="{RelativeSource AncestorType=workbench:ResultsWorkspaceView}" />
            </MultiBinding></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.TeachingResultsHoverBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.TeachingResultsSelectedBrush}" /><Setter Property="BorderThickness" Value="0" /></Trigger>
                <DataTrigger Binding="{Binding IsSelectedTool}" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.TeachingResultsSelectedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TeachingResultGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource ThreeD.CalibrationDataGridCellStyle}">
            <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="InspectionResultCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="6,5" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        </Style>
        <Style x:Key="InspectionResultGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="ColumnHeaderHeight" Value="28" /><Setter Property="MinRowHeight" Value="32" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" /><Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        </Style>
        <Style x:Key="InspectionSummaryCell" TargetType="TextBlock" BasedOn="{StaticResource InspectionResultCell}">
            <Setter Property="Margin" Value="10,5" /><Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="InspectionOutputNumber" TargetType="TextBlock" BasedOn="{StaticResource InspectionSummaryCell}">
            <Setter Property="TextAlignment" Value="Right" /><Setter Property="FontFamily" Value="Cascadia Mono, Cascadia Code, Consolas" />
        </Style>
        <Style x:Key="InspectionOutputRow" TargetType="DataGridRow" BasedOn="{StaticResource ThreeD.CalibrationDataGridRowStyle}">
            <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}: {1}"><Binding Path="ToolName" /><Binding Path="OutputName" /></MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="InspectionSummaryNumber" TargetType="TextBlock" BasedOn="{StaticResource InspectionSummaryCell}">
            <Setter Property="TextAlignment" Value="Right" /><Setter Property="FontFamily" Value="Cascadia Mono, Cascadia Code, Consolas" />
        </Style>
        <Style x:Key="InspectionSummaryPass" TargetType="TextBlock" BasedOn="{StaticResource InspectionSummaryNumber}"><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></Style>
        <Style x:Key="InspectionSummaryFail" TargetType="TextBlock" BasedOn="{StaticResource InspectionSummaryNumber}"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></Style>
        <Style x:Key="InspectionSummaryError" TargetType="TextBlock" BasedOn="{StaticResource InspectionSummaryNumber}"><Setter Property="Foreground" Value="{DynamicResource ThreeD.InspectionErrorTextBrush}" /></Style>
        <Style x:Key="InspectionSummaryHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="10,5" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.InspectionSummarySurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" /></DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InspectionResultStatusPill" TargetType="Border">
            <Setter Property="Padding" Value="5,1" /><Setter Property="Margin" Value="5,3" /><Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="MinHeight" Value="20" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pass"><Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InspectionResultsNativeMenuStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Style.Triggers><DataTrigger Binding="{Binding DockPaneCommands, ElementName=ResultsRoot}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource ThreeD.PanelBrush}">
        <TabControl x:Name="InspectionResultsTabs" DataContext="{Binding Workbench.InspectionQueue}" BorderThickness="0" Padding="0" Background="{DynamicResource ThreeD.PanelBrush}" ItemContainerStyle="{StaticResource InspectionResultsTabStyle}" AutomationProperties.AutomationId="InspectionResultsTabs">
            <TabControl.Style><Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsInspectWorkspaceSelected, RelativeSource={RelativeSource AncestorType=workbench:ResultsWorkspaceView}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TabControl.Style>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource ThreeD.CommandBarBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="0,0,0,1" AutomationProperties.AutomationId="InspectionResultsHeader">
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0" />
                                <Grid Grid.Column="1" Margin="8,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="11.5" Text="{Binding SelectedSample.FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSample.SourcePath}" AutomationProperties.AutomationId="InspectionSelectedFile" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Text="{Binding SelectedSample.StateText}" AutomationProperties.AutomationId="InspectionSelectedFileStatus" />
                                </Grid>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Margin="4,0,6,0" Content="{views:ThreeDText Key=ThreeD.Inspection.FailedStepsOnly, Korean='NG 항목만', English='NG items only'}" IsChecked="{Binding ShowOnlyFailedSteps, Mode=TwoWay}" AutomationProperties.AutomationId="InspectionFailedStepsOnly">
                                        <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></CheckBox.Style>
                                    </CheckBox>
                                    <ui:Button Height="24" MinHeight="0" Padding="6,0" Icon="{ui:SymbolIcon Table24}" Content="{views:ThreeDText Key=ThreeD.Inspection.ExportCsv, Korean='CSV 내보내기', English='Export CSV'}" Command="{Binding ExportCsvCommand}" AutomationProperties.AutomationId="InspectionResultsExportCsv">
                                        <ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ui:Button.Style>
                                    </ui:Button>
                                    <Menu Background="Transparent">
                                        <MenuItem Width="26" Height="24" MinHeight="0" Padding="4,0" Template="{DynamicResource R19TopMenuItemTemplate}" AutomationProperties.AutomationId="InspectionResultsMenu" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Inspection.ResultActions, Korean='결과 작업', English='Result actions'}">
                                            <MenuItem.Header><ui:SymbolIcon Symbol="MoreHorizontal16" FontSize="14" /></MenuItem.Header>
                                            <MenuItem Header="{views:ThreeDText Key=ThreeD.Inspection.OpenRunRecord, Korean='현재 기록 열기', English='Open current record'}" Command="{Binding OpenRunRecordCommand}" />
                                            <MenuItem Header="{views:ThreeDText Key=ThreeD.Inspection.OpenPreviousRunRecord, Korean='이전 기록', English='Previous record'}" Command="{Binding OpenPreviousRunRecordCommand}" />
                                            <MenuItem Header="{views:ThreeDText Key=ThreeD.Inspection.ExportCsv, Korean='CSV 내보내기', English='Export CSV'}" Command="{Binding ExportCsvCommand}" />
                                            <MenuItem Header="{views:ThreeDText Key=ThreeD.Inspection.ReturnTeaching, Korean='티칭으로', English='Return to teaching'}" Command="{Binding ReturnToTeachingCommand}" />
                                            <Separator />
                                            <MenuItem Style="{StaticResource InspectionResultsNativeMenuStyle}" Header="{views:ThreeDText Key=ThreeD.Dock.AutoHide, Korean='자동 숨김', English='Auto hide'}" Command="{Binding DockPaneCommands.AutoHideCommand, ElementName=ResultsRoot}" AutomationProperties.AutomationId="InspectionResultsAutoHideAction" />
                                            <MenuItem Style="{StaticResource InspectionResultsNativeMenuStyle}" Header="{views:ThreeDText Key=ThreeD.Dock.Float, Korean='분리 창', English='Float'}" Command="{Binding DockPaneCommands.FloatCommand, ElementName=ResultsRoot}" AutomationProperties.AutomationId="InspectionResultsFloatAction" />
                                        </MenuItem>
                                    </Menu>
                                    <ui:Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="4,0" Icon="{ui:SymbolIcon Pin16}" Command="{Binding DockPaneCommands.AutoHideCommand, ElementName=ResultsRoot}" ToolTip="{views:ThreeDText Key=ThreeD.Dock.AutoHide, Korean='자동 숨김', English='Auto hide'}" AutomationProperties.AutomationId="InspectionResultsAutoHide" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Dock.AutoHide, Korean='자동 숨김', English='Auto hide'}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="1" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="{views:ThreeDText Key=ThreeD.Inspection.FileResults, Korean='파일 결과', English='File results'}" AutomationProperties.AutomationId="InspectionFileResultsTab">
                <Grid AutomationProperties.AutomationId="InspectionSelectedDetails">
                    <DataGrid Style="{StaticResource InspectionResultGrid}" MinRowHeight="35" FontSize="12.5" ColumnHeaderHeight="NaN" ColumnHeaderStyle="{StaticResource InspectionSummaryHeader}" RowStyle="{StaticResource InspectionOutputRow}" RowDetailsVisibilityMode="VisibleWhenSelected" SelectionMode="Single" SelectionUnit="FullRow" ItemsSource="{Binding VisibleOutputResults}" SelectedItem="{Binding SelectedOutputResult, Mode=TwoWay}" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Inspection.StepResults, Korean='선택 파일의 단계 결과', English='Selected input step results'}" AutomationProperties.AutomationId="InspectionStepResults">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Padding="8,3" Loaded="OnSummaryDetailsLayoutChanged" SizeChanged="OnSummaryDetailsLayoutChanged">
                                    <Expander Header="{views:ThreeDText Key=ThreeD.Inspection.MeasurementDetails, Korean='측정 상세', English='Measurement details'}" AutomationProperties.AutomationId="InspectionOutputDetails">
                                        <StackPanel TextElement.Foreground="{DynamicResource ThreeD.SecondaryTextBrush}">
                                            <TextBlock Text="{Binding OutputName}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Limits, Converter={StaticResource MeasurementNumberTextConverter}}" TextWrapping="Wrap" AutomationProperties.AutomationId="InspectionOutputRecordedRange">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Step.Limits, Converter={StaticResource MeasurementNumberTextConverter}}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DisplayMessage}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Step.Metrics, Converter={StaticResource MeasurementNumberTextConverter}}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Step.Overlays}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Step.StepId, StringFormat=Step: {0}}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Step.OutputEntityId, StringFormat=Output: {0}}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Step.OutputSha256}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Step.DurationMilliseconds, StringFormat={}{0:0.##} ms}" />
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="46" MinWidth="46" Header="#" Binding="{Binding OrderLabel}" ElementStyle="{StaticResource InspectionResultCell}" />
                            <DataGridTextColumn Width="1.4*" MinWidth="128" Header="{views:ThreeDText Key=ThreeD.Inspection.Tool, Korean='도구', English='Tool'}" Binding="{Binding ToolLabel}" ElementStyle="{StaticResource InspectionSummaryCell}" />
                            <DataGridTextColumn Width="1.1*" MinWidth="110" Header="{views:ThreeDText Key=ThreeD.Inspection.Output, Korean='출력', English='Output'}" Binding="{Binding OutputName}" ElementStyle="{StaticResource InspectionSummaryCell}" />
                            <DataGridTextColumn Width="1.4*" MinWidth="224" Header="{views:ThreeDText Key=ThreeD.Inspection.Value, Korean='값', English='Value'}" Binding="{Binding ValueWithUnit, Converter={StaticResource MeasurementNumberTextConverter}}" ElementStyle="{StaticResource InspectionOutputNumber}" />
