                    </workbench:RecipePipelineReviewView.Style>
                </workbench:RecipePipelineReviewView>
                <ScrollViewer x:Name="DrawerProfileScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Visibility="{Binding DataContext.ResultsWorkspace.IsSectionSelected, ElementName=ResultsRoot, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="DrawerProfileScroll">
                    <workbench:HeightProfileView x:Name="DrawerHeightProfile" MinHeight="120" Height="{Binding ViewportHeight, ElementName=DrawerProfileScroll}" UseEmbeddedChrome="True" UseTeachingDrawerLayout="True" ShowCoordinateFooter="False" FontFamily="Segoe UI, Malgun Gothic" SelectionContext="{Binding DataContext.Workbench.SelectedPipelineStep.ToolName, ElementName=ResultsRoot}" ViewerHost="{Binding ViewerContent, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Visibility="{Binding DataContext.ResultsWorkspace.IsSectionSelected, ElementName=ResultsRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </ScrollViewer>
                <Grid Visibility="{Binding ResultsWorkspace.IsLogSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding Workbench.ExecutionLog}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="None" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" Margin="12,6" MinColumnWidth="0"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent" HorizontalGridLinesBrush="#262E37" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.AutomationId="TeachingActivityLog">
                        <DataGrid.Resources>
                            <Style x:Key="ActivityTextStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,4,0,4" /><Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                            <Style x:Key="ActivityTimeStyle" TargetType="TextBlock" BasedOn="{StaticResource ActivityTextStyle}">
                                <Setter Property="FontFamily" Value="Cascadia Mono, Cascadia Code, Consolas" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="Margin" Value="0,4,10,4" />
                            </Style>
                            <Style x:Key="ActivitySeverityStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Malgun Gothic" /><Setter Property="Margin" Value="0,4,10,4" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ThreeD.InspectionErrorTextBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="NotRun"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding WasCanceled}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template"><Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Border x:Name="ActivityRowSurface" Background="{TemplateBinding Background}"><DataGridCellsPresenter x:Name="PART_CellsPresenter" SnapsToDevicePixels="True" /></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActivityRowSurface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ActivityRowSurface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value></Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /><Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Grid Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" /><Border x:Name="FocusCue" BorderBrush="Transparent" BorderThickness="1" IsHitTestVisible="False" /></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusCue" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{views:ThreeDText Key=ThreeD.Drawer.Time, Korean='시간', English='Time'}" Binding="{Binding Time}" Width="66.25" ElementStyle="{StaticResource ActivityTimeStyle}" />
                            <DataGridTemplateColumn Header="{views:ThreeDText Key=ThreeD.Drawer.Action, Korean='작업', English='Action'}" ClipboardContentBinding="{Binding StatusLabel}" Width="17.25">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="●" Style="{StaticResource ActivitySeverityStyle}" ToolTip="{Binding StatusLabel}" AutomationProperties.Name="{Binding StatusLabel}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{views:ThreeDText Key=ThreeD.Drawer.Content, Korean='내용', English='Details'}" ClipboardContentBinding="{Binding Message}" Width="*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message, Mode=OneWay}" Style="{StaticResource ActivityTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="12,10" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" Foreground="{DynamicResource ThreeD.DisabledBrush}" VerticalAlignment="Top" TextWrapping="Wrap" IsHitTestVisible="False"
                               Text="{views:ThreeDText Key=ThreeD.Drawer.ExecutionLogEmpty, Korean='이 작업에서 아직 실행하지 않았습니다.', English='Nothing has been run in this task yet.'}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Workbench.ExecutionLog.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <workbench:OutputCompareView x:Name="OutputCompareWorkspace"
                                             Visibility="{Binding DataContext.ResultsWorkspace.IsOutputCompareSelected, RelativeSource={RelativeSource AncestorType=workbench:ResultsWorkspaceView}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             DataContext="{Binding Workbench}" />
                <ScrollViewer x:Name="ReportsWorkspace"
                              Visibility="{Binding ResultsWorkspace.IsReportsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                       Text="{Binding Localization.ResultsWorkspaceReports}" />
                        </StackPanel>
                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Padding="14"
                                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.AccentBrush}"
                                           Text="{Binding RunSnapshotSummary, Converter={StaticResource ViewerRuntimeTextConverter}}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{Binding RunSnapshotEvidence, Converter={StaticResource ViewerRuntimeTextConverter}}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding InspectionStepSummary, Converter={StaticResource ViewerRuntimeTextConverter}}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <WrapPanel>
                            <ui:Button Margin="0,0,6,6"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Content="{Binding Localization.RunRecordOpen}"
                                       Command="{Binding SelectRunRecordCommand}" />
                            <ui:Button Margin="0,0,6,6"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Document24}"
                                       Content="{Binding Localization.RunRecordOpenCurrent}"
                                       Command="{Binding OpenRunRecordCommand}" />
                            <ui:Button Margin="0,0,6,6"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon DocumentText24}"
                                       Content="{Binding Localization.RunRecordOpenHtml}"
                                       Command="{Binding OpenHtmlReportCommand}" />
                            <ui:Button Margin="0,0,6,6"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Table24}"
                                       Content="{Binding Localization.RunRecordOpenCsv}"
                                       Command="{Binding OpenCsvReportCommand}" />
                            <ui:Button Margin="0,0,6,6"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon SaveCopy24}"
                                       x:Name="ReportsExportResultsButton"
                                       Content="{Binding Localization.RunRecordExport}"
                                       Command="{Binding ExportRunRecordCommand}" />
                            <ui:Button Margin="0,0,6,6"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Folder24}"
                                       Content="{Binding Localization.RunRecordOpenFolder}"
                                       Command="{Binding OpenRunRecordFolderCommand}" />
                            </WrapPanel>
                            <Expander x:Name="ReportsSupportFilesSection" Margin="0,8,0,0" IsExpanded="False"
                                      Header="{views:ThreeDText Key=ThreeD.Results.SupportInformation, Korean='지원용 자료', English='Support files'}">
                            <StackPanel>
                            <TextBlock Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="{Binding Localization.SupportBundlePrivacyNotice}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding Localization.SupportBundlePrivacyNotice}" />
                            <ui:Button Margin="0,6,0,0" HorizontalAlignment="Left"
                                       x:Name="ReportsSupportFilesButton"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon DocumentLock24}"
                                       Content="{Binding Localization.SupportBundleExport}"
                                       Command="{Binding ExportPrivacySafeSupportBundleCommand}"
                                       ToolTip="{Binding Localization.SupportBundleToolTip}"
                                       AutomationProperties.AutomationId="ReportsPrivacySafeSupportBundleButton"
                                       AutomationProperties.Name="{Binding Localization.SupportBundleExport}"
                                       AutomationProperties.HelpText="{Binding Localization.SupportBundleToolTip}" />
                            </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
