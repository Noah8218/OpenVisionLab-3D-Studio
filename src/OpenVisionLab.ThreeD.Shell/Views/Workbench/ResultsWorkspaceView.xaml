                            <DataGridTextColumn Width="1.6*" MinWidth="150" Header="{views:ThreeDText Key=ThreeD.Inspection.Cause, Korean='원인', English='Cause'}" Binding="{Binding CauseLabel}" ElementStyle="{StaticResource InspectionSummaryCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Padding="12" Background="{DynamicResource ThreeD.PanelBrush}">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedResultNotice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding SelectedResultNotice}" AutomationProperties.AutomationId="InspectionResultsNotice" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{views:ThreeDText Key=ThreeD.Inspection.AllSummary, Korean='전체 요약', English='Overall summary'}" AutomationProperties.AutomationId="InspectionSummaryTab">
