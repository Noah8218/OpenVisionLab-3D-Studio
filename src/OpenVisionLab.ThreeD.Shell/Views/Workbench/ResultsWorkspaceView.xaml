                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.TextBrush}"
                                   Text="{Binding Localization.ResultsWorkspaceRunResultTitle}" />
                        <TextBlock x:Name="CompactResultSnapshot"
                                   Margin="12,0,0,0"
