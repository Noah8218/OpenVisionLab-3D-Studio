                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock FontWeight="SemiBold" Text="{Binding RecordedAt}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding Name}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Status}" Foreground="{DynamicResource ThreeD.AccentBrush}" />
                                    <TextBlock Margin="8,0,0,0"><Run Text="{Binding StepCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding DataContext.Localization.StepsLabel, RelativeSource={RelativeSource AncestorType=workbench:ResultsWorkspaceView}, Mode=OneWay}" /></TextBlock>
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Margin="0,0,0,6" Text="{views:ThreeDText Key=ThreeD.Results.OpenHistoryGuide, Korean='기록을 선택한 뒤 열기를 누르세요.', English='Select a record, then choose Open.'}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                    <ui:Button HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowRight24}" Content="{Binding Localization.RunRecordOpenRecent}" Command="{Binding OpenRecentRunRecordCommand}" CommandParameter="{Binding SelectedItem, ElementName=ResultsHistoryList}" AutomationProperties.AutomationId="ResultsOpenSelectedHistory" />
                    <ui:Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowSwap24}" Content="{Binding Localization.RunRecordCompareRecent}" Command="{Binding CompareRecentRunRecordCommand}" AutomationProperties.AutomationId="ResultsCompareSelectedHistory" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ResultsWorkspaceHeader"
                Grid.Column="1"
                Padding="16,10"
                Background="{DynamicResource ThreeD.CommandBarBrush}"
