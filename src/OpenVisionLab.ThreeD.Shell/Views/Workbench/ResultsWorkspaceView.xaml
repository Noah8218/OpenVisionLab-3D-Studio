                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding Workbench.SelectedToolWorkspace.CurrentOutput.ResultStatus}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="TeachingCompactResultSnapshot">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ResultsWorkspaceView}}" Value="True" />
                                                <Condition Binding="{Binding IsAuthoringWorkspaceSelected}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Grid>
