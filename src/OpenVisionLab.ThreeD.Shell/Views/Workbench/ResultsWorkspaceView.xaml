                    <DataGrid Style="{StaticResource InspectionResultGrid}" ItemsSource="{Binding MeasurementSummaries}" AutomationProperties.AutomationId="InspectionMeasurementSummaries"
                              ColumnHeaderStyle="{StaticResource InspectionSummaryHeader}" ColumnHeaderHeight="NaN" MinRowHeight="35" FontSize="12.5" RowDetailsVisibilityMode="VisibleWhenSelected" SelectionMode="Single">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Padding="10,3" Loaded="OnSummaryDetailsLayoutChanged" SizeChanged="OnSummaryDetailsLayoutChanged">
                                    <Expander Header="{views:ThreeDText Key=ThreeD.Inspection.DistributionDetails, Korean='파일별 값·저장 조건', English='Values by file and saved settings'}" AutomationProperties.AutomationId="InspectionSummaryDetails">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SettingsIdentity}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" AutomationProperties.AutomationId="InspectionSummarySettings" />
                                            <TextBlock Text="{Binding StepId}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Kind}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                                            <ItemsControl ItemsSource="{Binding Points}" AutomationProperties.AutomationId="InspectionSummaryFileValues">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Text="{Binding FileName}" TextWrapping="Wrap" /><TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" /><TextBlock Text="{Binding RunId}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" /></StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding ValueText}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Cascadia Code, Consolas" /><TextBlock Text="{Binding Unit}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" /></StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding RangeText}" TextWrapping="Wrap" Margin="8,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="1.2*" MinWidth="112" Header="{views:ThreeDText Key=ThreeD.Inspection.Tool, Korean='도구', English='Tool'}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,5"><TextBlock Text="{Binding ToolName}" TextWrapping="Wrap" /><TextBlock Text="{Binding SettingsLabel}" FontSize="10.5" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Visibility="{Binding HasMultipleSettings, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="1.1*" MinWidth="110" Header="{views:ThreeDText Key=ThreeD.Inspection.Output, Korean='출력', English='Output'}" Binding="{Binding OutputLabel}" ElementStyle="{StaticResource InspectionSummaryCell}" />
                            <DataGridTextColumn Width="44" MinWidth="44" Header="OK" Binding="{Binding PassCount}" ElementStyle="{StaticResource InspectionSummaryPass}" />
                            <DataGridTextColumn Width="44" MinWidth="44" Header="NG" Binding="{Binding FailCount}" ElementStyle="{StaticResource InspectionSummaryFail}" />
                            <DataGridTextColumn Width="58" MinWidth="58" Header="{views:ThreeDText Key=ThreeD.Inspection.Error, Korean='오류', English='Error'}" Binding="{Binding ErrorCount}" ElementStyle="{StaticResource InspectionSummaryError}" />
                            <DataGridTextColumn Width="*" MinWidth="88" Header="{views:ThreeDText Key=ThreeD.Inspection.Minimum, Korean='최소', English='Minimum'}" Binding="{Binding Minimum, StringFormat=0.##, TargetNullValue=—}" ElementStyle="{StaticResource InspectionSummaryNumber}" />
                            <DataGridTextColumn Width="*" MinWidth="88" Header="{views:ThreeDText Key=ThreeD.Inspection.Mean, Korean='평균', English='Mean'}" Binding="{Binding Mean, StringFormat=0.##, TargetNullValue=—}" ElementStyle="{StaticResource InspectionSummaryNumber}" />
                            <DataGridTextColumn Width="*" MinWidth="88" Header="{views:ThreeDText Key=ThreeD.Inspection.Maximum, Korean='최대', English='Maximum'}" Binding="{Binding Maximum, StringFormat=0.##, TargetNullValue=—}" ElementStyle="{StaticResource InspectionSummaryNumber}" />
                            <DataGridTemplateColumn Width="220" MinWidth="220" Header="{views:ThreeDText Key=ThreeD.Inspection.FileValueRange, Korean='파일별 값 · 허용 범위', English='Values by file · Allowable range'}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="10,5"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions><workbench:InspectionSummaryPlot Width="180" Height="24" HorizontalAlignment="Left" Summary="{Binding}" AutomationProperties.AutomationId="InspectionSummaryPlot" AutomationProperties.Name="{Binding OutputLabel}" AutomationProperties.HelpText="{Binding RangeText}" /><TextBlock Grid.Column="1" Text="—" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" AutomationProperties.AutomationId="InspectionSummaryMissingRange"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding RangeText}" Value="—"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="12,46,12,0" VerticalAlignment="Top" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{views:ThreeDText Key=ThreeD.Inspection.NoSummary, Korean='아직 검사 기록이 없습니다.', English='No inspection records yet.'}" AutomationProperties.AutomationId="InspectionSummaryEmpty">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding MeasurementSummaries.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="{views:ThreeDText Key=ThreeD.Inspection.RecordExport, Korean='기록·내보내기', English='Records and export'}" AutomationProperties.AutomationId="InspectionRecordTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="InspectionRecordScroll">
                    <StackPanel Margin="10,6">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedSample.FileName}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding SelectedSample.SourcePath}" AutomationProperties.AutomationId="InspectionRecordInputPath" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding SelectedSample.Message}" AutomationProperties.AutomationId="InspectionRecordMessage" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Margin="0,0,8,0" Text="{Binding SelectedSample.RunId}" />
                            <TextBlock Margin="0,0,8,0" Text="{Binding SelectedSample.RecordedAtText}" />
                            <TextBlock Text="{Binding SelectedSample.RecipeRevision}" />
                        </WrapPanel>
                        <TextBlock Margin="0,3,0,0" FontSize="11.5" TextWrapping="Wrap" Text="{Binding SelectedSample.InputSha256}" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Inspection.InputIdentity, Korean='검사 입력 콘텐츠 식별값', English='Inspection input content identity'}" AutomationProperties.AutomationId="InspectionRecordInputIdentity" />
                        <TextBlock Margin="0,3,0,0" FontSize="11.5" TextWrapping="Wrap" Text="{Binding SelectedSample.RecipeSha256}" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Inspection.RecipeIdentity, Korean='검사 레시피 콘텐츠 식별값', English='Inspection recipe content identity'}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Padding="8,4" Margin="0,0,6,3" Content="{views:ThreeDText Key=ThreeD.Inspection.OpenRunRecord, Korean='현재 기록 열기', English='Open current record'}" Command="{Binding OpenRunRecordCommand}" AutomationProperties.AutomationId="InspectionOpenRunRecord" />
                            <Button Padding="8,4" Margin="0,0,6,3" Content="{views:ThreeDText Key=ThreeD.Inspection.OpenPreviousRunRecord, Korean='이전 기록', English='Previous record'}" Command="{Binding OpenPreviousRunRecordCommand}" AutomationProperties.AutomationId="InspectionOpenPreviousRunRecord" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <workbench:ResultsHistoryView x:Name="HistoryDashboard">
