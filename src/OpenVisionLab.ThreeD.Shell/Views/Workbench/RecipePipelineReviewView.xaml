                                                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RunRecordContext.RunRecordComparisonStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="DirectlyComparable">
