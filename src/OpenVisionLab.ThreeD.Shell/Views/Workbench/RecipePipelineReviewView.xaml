                                       CommandParameter="{Binding SelectedItem, ElementName=RecentRunRecordCombo}"
                                       Visibility="{Binding HasItems, ElementName=RecentRunRecordCombo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="RunRecordOpenRecentButton"
                                       AutomationProperties.Name="{Binding Localization.RunRecordOpenRecent}" />
                            <ui:Button x:Name="RunRecordCompareRecentButton"
                                       Margin="0,0,0,4"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowSwap24}"
                                       Content="{Binding Localization.RunRecordCompareRecent}"
                                       Command="{Binding RunRecordContext.CompareRecentRunRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Visibility="{Binding HasItems, ElementName=RecentRunRecordCombo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       ToolTip="{Binding Localization.RunRecordComparisonDetail}"
                                       AutomationProperties.AutomationId="RunRecordCompareRecentButton"
                                       AutomationProperties.Name="{Binding Localization.RunRecordCompareRecent}"
                                       AutomationProperties.HelpText="{Binding Localization.RunRecordComparisonDetail}" />
                            </WrapPanel>
                            <TextBlock x:Name="SupportBundlePrivacyNotice"
                                       Margin="1,0,1,0"
                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                       FontSize="12"
                                       Text="{Binding Localization.SupportBundlePrivacyNotice}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SupportBundlePrivacyNotice"
                                       AutomationProperties.Name="{Binding Localization.SupportBundlePrivacyNotice}" />
                        </StackPanel>
                        <Border x:Name="RunRecordEvidenceSummary"
                                Grid.Row="1"
                                Margin="4,0,4,7"
                                Padding="8,6"
                                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                AutomationProperties.AutomationId="RunRecordEvidenceSummary">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Localization.RunRecordSourceQuality}"
                                           ToolTip="{Binding Localization.RunRecordSourceQualityDetail}" />
                                <Border Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Padding="5,2"
                                        HorizontalAlignment="Left"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunRecordContext.SourceQualityState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Pass">
                                                    <Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunRecordContext.SourceQualityState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Warning">
                                                    <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunRecordContext.SourceQualityState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Mismatch">
                                                    <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunRecordContext.SourceQualityState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding RunRecordContext.SourceQualityStateText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding RunRecordContext.SourceQualitySummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RunRecordContext.SourceQualityDetail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           AutomationProperties.Name="{Binding Localization.RunRecordSourceQuality}"
                                           AutomationProperties.HelpText="{Binding RunRecordContext.SourceQualityDetail, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBlock Grid.Row="1"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Localization.RunRecordThresholdCorrection}"
                                           ToolTip="{Binding Localization.RunRecordThresholdCorrectionDetail}" />
                                <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="5,2"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource ThreeD.PanelBrush}"
                                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                    <TextBlock Foreground="{DynamicResource ThreeD.AccentBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding RunRecordContext.ThresholdCorrectionStateText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                                <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding RunRecordContext.ThresholdCorrectionSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               TextTrimming="CharacterEllipsis" />
