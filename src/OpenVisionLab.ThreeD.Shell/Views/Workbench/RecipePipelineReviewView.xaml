                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding Localization.RunRecordComparisonTitle}" />
                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="6,2"
                                            BorderThickness="1"
                                            CornerRadius="8">
