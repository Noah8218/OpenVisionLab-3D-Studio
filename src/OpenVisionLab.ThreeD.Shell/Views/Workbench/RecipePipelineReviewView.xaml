                                    <ItemsControl ItemsSource="{Binding RunRecordContext.ThresholdCorrectionItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Grid.Column="1"
                                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                               FontSize="12"
                                                               Text="{Binding Evidence}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Evidence}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border x:Name="RunRecordComparisonPanel"
                                Grid.Row="3"
                                Margin="4,0,4,7"
                                Padding="8,7"
                                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding RunRecordContext.HasRunRecordComparison, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsVisibleChanged="RunRecordComparisonPanel_IsVisibleChanged"
                                AutomationProperties.AutomationId="RunRecordComparisonPanel"
                                AutomationProperties.Name="{Binding Localization.RunRecordComparisonTitle}">
