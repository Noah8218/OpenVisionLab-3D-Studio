                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Grid.Column="1"
                                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                               FontSize="9.5"
                                                               Text="{Binding Evidence}"
                                                               TextTrimming="CharacterEllipsis"
