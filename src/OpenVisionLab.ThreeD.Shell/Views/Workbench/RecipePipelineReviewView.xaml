                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RunRecordContext.RunRecordComparisonStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="ConditionsChanged">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RunRecordContext.RunRecordComparisonStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="NotDirectlyComparable">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RunRecordContext.RunRecordComparisonStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Error">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding RunRecordContext.RunRecordComparisonStateText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding RunRecordContext.RunRecordComparisonSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="RunRecordComparisonSummary" />
                                <ScrollViewer x:Name="RunRecordComparisonDetailsViewer"
                                              Grid.Row="3"
                                              MaxHeight="92"
                                              Margin="0,5,0,0"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Text="{Binding RunRecordContext.RunRecordComparisonDetails, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="RunRecordComparisonDetails" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Grid x:Name="RunRecordColumns"
                              Grid.Row="4"
                              Margin="8,2,8,4"
                              Visibility="{Binding HasItems, ElementName=RunRecordStepsList, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{Binding Localization.ColumnNumber}" />
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{Binding Localization.ColumnTool}" />
                            <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{Binding Localization.ColumnState}" />
                            <TextBlock Grid.Column="3" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{Binding Localization.ValidationSetDuration}" />
                            <TextBlock Grid.Column="4" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{Binding Localization.ColumnEvidence}" />
                        </Grid>
                        <TextBlock x:Name="RunRecordEmptyHint"
                                   Grid.Row="5"
                                   Margin="8,12,8,0"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding Localization.ResultsWorkspaceNoRun}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="RunRecordEmptyHint"
                                   AutomationProperties.Name="{Binding Localization.ResultsWorkspaceNoRun}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=RunRecordStepsList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="RunRecordStepsList"
                                 Grid.Row="5"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding RunRecordSteps, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{Binding Localization.RunRecordTitle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,3"
                                            Padding="7,5"
                                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="1.25*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Order}" />
                                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" Text="{Binding Stage}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2"
                                                    Margin="0,0,8,0"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                                <Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                                <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Status}" />
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       FontSize="12"
                                                       Text="{Binding Timing}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Timing}" />
                                            <TextBlock Grid.Column="4"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       FontSize="12"
                                                       Text="{Binding Evidence}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Evidence}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="ValidationTabItem"
                         Header="{Binding Localization.ValidationSet}">
                    <Grid x:Name="ValidationWorkspaceContent"
                          Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="ValidationSetHeader"
                              Margin="4,0,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ValidationSetTitleSummary">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Localization.ValidationSetTitle}" />
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding ValidationSetSummary}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ValidationSetCapability}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{Binding ValidationSetProgressText}"
                                           Visibility="{Binding IsValidationSetRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ProgressBar Height="4"
                                             Width="180"
                                             Margin="0,3,0,0"
                                             HorizontalAlignment="Left"
                                             Maximum="100"
                                             Value="{Binding ValidationSetProgress, Mode=OneWay}"
                                             Visibility="{Binding IsValidationSetRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center">
