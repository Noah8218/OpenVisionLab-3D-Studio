<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.RecipePipelineReviewView"
             x:Name="ValidationReviewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             xmlns:dock="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
             AutomationProperties.AutomationId="RecipePipelineReview">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ValidationNativePaneActionStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Style.Triggers><DataTrigger Binding="{Binding DockPaneCommands, ElementName=ValidationReviewRoot}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <ControlTemplate x:Key="ValidationResultTabTemplate" TargetType="RadioButton">
            <Border x:Name="TabSurface" MinHeight="34" Padding="10,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ValidationResultNavigationStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers><DataTrigger Binding="{Binding IsValidationSamplesExternal, ElementName=ValidationReviewRoot}" Value="True"><Setter Property="Template" Value="{StaticResource ValidationResultTabTemplate}" /><Setter Property="Margin" Value="0" /><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="600" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ValidationMatrixCellStyle" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="6,5" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <workbench:ValidationMatrixValueConverter x:Key="ValidationMatrixValue" />
        <workbench:ValidationMatrixValueConverter x:Key="ValidationMatrixDisplayValue" IncludeStatus="False" />
        <SolidColorBrush x:Key="ValidationMatrixHeaderBrush" Color="#1D242B" />
        <SolidColorBrush x:Key="ValidationMatrixLineBrush" Color="#262E37" />
        <SolidColorBrush x:Key="ValidationMatrixHoverBrush" Color="#222A32" />
        <SolidColorBrush x:Key="ValidationMatrixSelectedBrush" Color="#203034" />
        <SolidColorBrush x:Key="ValidationMatrixPassBorderBrush" Color="#3D6049" />
        <SolidColorBrush x:Key="ValidationMatrixFailBorderBrush" Color="#6E434B" />
        <SolidColorBrush x:Key="ValidationMatrixErrorBrush" Color="#3A2A1F" />
        <SolidColorBrush x:Key="ValidationMatrixErrorBorderBrush" Color="#6E4A30" />
        <SolidColorBrush x:Key="ValidationGroupPassBrush" Color="#2F5B44" />
        <SolidColorBrush x:Key="ValidationGroupFailBrush" Color="#C9686C" />
        <SolidColorBrush x:Key="ValidationGroupErrorBrush" Color="#C98450" />
        <SolidColorBrush x:Key="ValidationGroupNoneBrush" Color="#3A444F" />
        <Style x:Key="ValidationGroupCellStyle" TargetType="ItemsControl">
            <Setter Property="Margin" Value="10,5" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="AlternationCount" Value="2147483647" />
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="2,0,0,0" /><Style.Triggers><Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter Property="Margin" Value="0" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
            <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
                <Border Width="9" Height="14" CornerRadius="2" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Detail}" AutomationProperties.AutomationId="ValidationGroupMember">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource ValidationGroupNoneBrush}" /><Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Pass"><Setter Property="Background" Value="{StaticResource ValidationGroupPassBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Background" Value="{StaticResource ValidationGroupFailBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Background" Value="{StaticResource ValidationGroupErrorBrush}" /></DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                </Border>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ValidationMatrixRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="MinHeight" Value="31.125" /><Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ValidationMatrixHoverBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource ValidationMatrixSelectedBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValidationMatrixGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ValidationMatrixLineBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /><Setter Property="BorderThickness" Value="1" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ValidationMatrixHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="10,6" /><Setter Property="MinHeight" Value="29.89" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="500" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Setter Property="Background" Value="{StaticResource ValidationMatrixHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.SoftDividerBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="ValidationMatrixDisplayCellStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,5" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextAlignment" Value="Right" /><Setter Property="FontFamily" Value="Cascadia Mono, Cascadia Code, Consolas, D2Coding" />
        </Style>
        <Style x:Key="ValidationMatrixFileStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,5" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding SourcePath}" />
        </Style>
        <Style x:Key="ValidationMatrixEvidenceStyle" TargetType="TextBlock" BasedOn="{StaticResource ValidationMatrixFileStyle}">
            <Setter Property="TextTrimming" Value="None" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Setter Property="ToolTip" Value="{Binding Message}" />
        </Style>
        <Style x:Key="ValidationMatrixPillStyle" TargetType="Border">
            <Setter Property="Height" Value="20" /><Setter Property="Padding" Value="7,0" /><Setter Property="CornerRadius" Value="10" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextElement.FontSize" Value="12" /><Setter Property="TextElement.FontWeight" Value="600" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.SoftDividerBrush}" />
        </Style>
        <Style x:Key="ValidationMatrixStatusPillStyle" TargetType="Border" BasedOn="{StaticResource ValidationMatrixPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pass"><Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.PassBrush}" /><Setter Property="BorderBrush" Value="{StaticResource ValidationMatrixPassBorderBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.FailBrush}" /><Setter Property="BorderBrush" Value="{StaticResource ValidationMatrixFailBorderBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Background" Value="{StaticResource ValidationMatrixErrorBrush}" /><Setter Property="BorderBrush" Value="{StaticResource ValidationMatrixErrorBorderBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.InspectionErrorTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="TextElement.Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValidationMatrixAgreementPillStyle" TargetType="Border" BasedOn="{StaticResource ValidationMatrixPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Agreement}" Value="Match"><Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource ValidationMatrixPassBorderBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Agreement}" Value="FalseReject"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource ValidationMatrixFailBorderBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Agreement}" Value="FalseAccept"><Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource ValidationMatrixFailBorderBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValidationMatrixFalseRejectSummaryStyle" TargetType="Border" BasedOn="{StaticResource ValidationMatrixPillStyle}"><Style.Triggers><DataTrigger Binding="{Binding ValidationSetFalseRejectCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ValidationMatrixFalseAcceptSummaryStyle" TargetType="Border" BasedOn="{StaticResource ValidationMatrixPillStyle}"><Style.Triggers><DataTrigger Binding="{Binding ValidationSetFalseAcceptCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ValidationMatrixErrorSummaryStyle" TargetType="Border" BasedOn="{StaticResource ValidationMatrixPillStyle}"><Style.Triggers><DataTrigger Binding="{Binding ValidationSetErrorCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>

        <DataTemplate x:Key="ValidationMatrixExpectedTemplate"><TextBlock Margin="10,5" VerticalAlignment="Center" Text="{Binding ExpectedVerdictText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsGood}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsBad}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
        <DataTemplate x:Key="ValidationMatrixStatusTemplate"><Border Margin="10,0" Style="{StaticResource ValidationMatrixStatusPillStyle}" ToolTip="{Binding Message}"><TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding StatusText}" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Pass"><Setter Property="Text" Value="✓ OK" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Text" Value="× NG" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate>
        <workbench:HeightImageFrameConverter x:Key="ValidationSamplePreview" />
        <Style x:Key="ValidationAgreementTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.NotRun, Korean='미검증', English='Not run'}" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Agreement}" Value="Match"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.Match, Korean='일치', English='Match'}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Agreement}" Value="FalseReject"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.FalseReject, Korean='과검출', English='False reject'}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Agreement}" Value="FalseAccept"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.FalseAccept, Korean='미검출', English='False accept'}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Agreement}" Value="Error"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.Error, Korean='오류', English='Error'}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Agreement}" Value="Warning"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.Warning, Korean='경고', English='Warning'}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Agreement}" Value="Unset"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.Unset, Korean='기대 미지정', English='Expectation unset'}" /></DataTrigger>
                <DataTrigger Binding="{Binding Agreement}" Value="HeldOut"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.HeldOut, Korean='보류', English='Held-out'}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValidationMatrixAgreementLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ValidationAgreementTextStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding Agreement}" Value="Match"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.MatrixMatch, Korean='✓ 일치', English='✓ Match'}" /></DataTrigger><DataTrigger Binding="{Binding Agreement}" Value="FalseReject"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.MatrixFalseReject, Korean='× 과검출', English='× False reject'}" /></DataTrigger><DataTrigger Binding="{Binding Agreement}" Value="FalseAccept"><Setter Property="Text" Value="{shell:ThreeDText Key=ThreeD.Validation.MatrixFalseAccept, Korean='× 미검출', English='× False accept'}" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="ValidationMatrixAgreementTemplate"><Border Margin="10,0" Style="{StaticResource ValidationMatrixAgreementPillStyle}"><TextBlock VerticalAlignment="Center" Style="{StaticResource ValidationMatrixAgreementLabelStyle}" /></Border></DataTemplate>
        <SolidColorBrush x:Key="ValidationMismatchHoverBrush" Color="#1E252C" />
        <SolidColorBrush x:Key="ValidationMismatchSelectedBrush" Color="#1D2A2C" />
        <Style x:Key="ValidationMismatchActionStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ValidationMismatchItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="CardSurface" Background="Transparent" Padding="12,10" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="{StaticResource ValidationMismatchHoverBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardSurface" Property="Background" Value="{StaticResource ValidationMismatchSelectedBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <ControlTemplate x:Key="ContentOnlyTabControlTemplate"
                         TargetType="{x:Type TabControl}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}" />
            </Border>
        </ControlTemplate>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F5"
                    Modifiers="Control"
                    Command="{Binding RunTeachingRecipeCommand}" />
        <KeyBinding Key="F5"
                    Modifiers="Control+Shift"
                    Command="{Binding RunValidationSetCommand}" />
    </UserControl.InputBindings>
    <Border x:Name="ReviewSurface" Background="{DynamicResource ThreeD.PanelBrush}"
            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="ValidationWorkspaceNavigation"
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Padding="8,6"
                    Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="ValidationWorkspaceNavigation">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel x:Name="ValidationNavigationRow" VerticalAlignment="Center">
                        <StackPanel x:Name="ValidationHeaderLeading" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <dock:AnchorablePaneTitle x:Name="ValidationHeaderGrip" Width="10" Height="16" Model="{Binding DockPaneCommands.LayoutElement, ElementName=ValidationReviewRoot}" ToolTip="{shell:ThreeDText Key=ThreeD.Dock.Drag, Korean='끌어서 도킹 위치 변경', English='Drag to change docking position'}" AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Dock.Drag, Korean='끌어서 도킹 위치 변경', English='Drag to change docking position'}">
                                <dock:AnchorablePaneTitle.Style><Style TargetType="dock:AnchorablePaneTitle"><Setter Property="Cursor" Value="SizeAll" /><Style.Triggers><DataTrigger Binding="{Binding DockPaneCommands, ElementName=ValidationReviewRoot}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></dock:AnchorablePaneTitle.Style>
                                <dock:AnchorablePaneTitle.Template><ControlTemplate TargetType="dock:AnchorablePaneTitle"><Rectangle Fill="{DynamicResource ThreeD.DataMutedTextBrush}"><Rectangle.OpacityMask><DrawingBrush TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute" Viewbox="0,0,5,5" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="White"><GeometryDrawing.Geometry><EllipseGeometry Center="2.5,2.5" RadiusX="1.1" RadiusY="1.1" /></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Rectangle.OpacityMask></Rectangle></ControlTemplate></dock:AnchorablePaneTitle.Template>
                            </dock:AnchorablePaneTitle>
                            <ui:SymbolIcon Symbol="Layer24" Width="14" Height="14" FontSize="14" Margin="4,0,7,0" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" IsHitTestVisible="False" />
                        </StackPanel>
                        <RadioButton x:Name="ValidationSamplesNavigation"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Center"
                                     Content="{Binding Localization.ValidationWorkspaceSamples}"
                                     IsChecked="{Binding ValidationWorkspace.IsSamplesSelected, Mode=OneWay}"
                                     behaviors:CheckedCommandBehavior.IsEnabled="True"
                                     behaviors:CheckedCommandBehavior.Command="{Binding ValidationWorkspace.SelectSectionCommand}"
                                     behaviors:CheckedCommandBehavior.CommandParameter="Samples"
                                     AutomationProperties.AutomationId="ValidationSamplesNavigation"
                                     AutomationProperties.Name="{Binding Localization.ValidationWorkspaceSamples}"
                                     />
                        <RadioButton x:Name="ValidationResultsNavigation"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="ValidationResultsNavigation"
                                     IsChecked="{Binding ValidationWorkspace.IsResultsSelected, Mode=OneWay}"
                                     behaviors:CheckedCommandBehavior.IsEnabled="True"
                                     behaviors:CheckedCommandBehavior.Command="{Binding ValidationWorkspace.SelectSectionCommand}"
                                     behaviors:CheckedCommandBehavior.CommandParameter="Results">
                            <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource ValidationResultNavigationStyle}"><Setter Property="Content" Value="{Binding Localization.ValidationWorkspaceResults}" /><Style.Triggers><DataTrigger Binding="{Binding IsValidationSamplesExternal, ElementName=ValidationReviewRoot}" Value="True"><Setter Property="Content" Value="{shell:ThreeDText Key=ThreeD.Validation.Matrix, Korean='결과표', English='Results table'}" /></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                        </RadioButton>
                        <RadioButton x:Name="ValidationFailuresNavigation"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="ValidationFailuresNavigation"
                                     IsChecked="{Binding ValidationWorkspace.IsFailuresSelected, Mode=OneWay}"
                                     behaviors:CheckedCommandBehavior.IsEnabled="True"
                                     behaviors:CheckedCommandBehavior.Command="{Binding ValidationWorkspace.SelectSectionCommand}"
                                     behaviors:CheckedCommandBehavior.CommandParameter="Failures">
                            <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource ValidationResultNavigationStyle}"><Setter Property="Content" Value="{Binding Localization.ValidationWorkspaceFailures}" /><Style.Triggers><DataTrigger Binding="{Binding IsValidationSamplesExternal, ElementName=ValidationReviewRoot}" Value="True"><Setter Property="Content" Value="{shell:ThreeDText Key=ThreeD.Validation.Mismatches, Korean='불일치', English='Mismatches'}" /></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                        </RadioButton>
                        <RadioButton x:Name="ValidationThresholdNavigation"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="ValidationThresholdNavigation"
                                     IsChecked="{Binding ValidationWorkspace.IsThresholdsSelected, Mode=OneWay}"
                                     behaviors:CheckedCommandBehavior.IsEnabled="True"
                                     behaviors:CheckedCommandBehavior.Command="{Binding ValidationWorkspace.SelectSectionCommand}"
                                     behaviors:CheckedCommandBehavior.CommandParameter="Thresholds">
                            <RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource ValidationResultNavigationStyle}"><Setter Property="Content" Value="{Binding Localization.ValidationWorkspaceThresholds}" /><Style.Triggers><DataTrigger Binding="{Binding IsValidationSamplesExternal, ElementName=ValidationReviewRoot}" Value="True"><Setter Property="Content" Value="{shell:ThreeDText Key=ThreeD.Validation.Distribution, Korean='값 분포', English='Value distribution'}" /></DataTrigger></Style.Triggers></Style></RadioButton.Style>
                        </RadioButton>
                        <RadioButton x:Name="ValidationHeldOutNavigation"
                                     VerticalAlignment="Center"
                                     Content="{Binding Localization.ValidationWorkspaceHeldOut}"
                                     AutomationProperties.AutomationId="ValidationHeldOutNavigation"
                                     AutomationProperties.Name="{Binding Localization.ValidationWorkspaceHeldOut}"
                                     IsChecked="{Binding ValidationWorkspace.IsHeldOutSelected, Mode=OneWay}"
                                     behaviors:CheckedCommandBehavior.IsEnabled="True"
                                     behaviors:CheckedCommandBehavior.Command="{Binding ValidationWorkspace.SelectSectionCommand}"
                                     behaviors:CheckedCommandBehavior.CommandParameter="HeldOut" />
                        <StackPanel x:Name="ValidationMatrixSummary" Orientation="Horizontal" Margin="8,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.AutomationId="ValidationMatrixSummary">
                            <Border Style="{StaticResource ValidationMatrixPillStyle}" Margin="0,0,4,0" Background="{DynamicResource ThreeD.PassSurfaceBrush}" BorderBrush="{StaticResource ValidationMatrixPassBorderBrush}" TextElement.Foreground="{DynamicResource ThreeD.PassBrush}"><TextBlock VerticalAlignment="Center"><Run Text="✓ " /><Run Text="{shell:ThreeDText Key=ThreeD.Validation.Match, Korean='일치', English='Match'}" /><Run Text=" " /><Run Text="{Binding ValidationSetMatchCount, Mode=OneWay}" /></TextBlock></Border>
                            <Border Style="{StaticResource ValidationMatrixFalseRejectSummaryStyle}" Margin="0,0,4,0" Background="{DynamicResource ThreeD.FailSurfaceBrush}" BorderBrush="{StaticResource ValidationMatrixFailBorderBrush}" TextElement.Foreground="{DynamicResource ThreeD.FailBrush}"><TextBlock VerticalAlignment="Center"><Run Text="× " /><Run Text="{shell:ThreeDText Key=ThreeD.Validation.FalseReject, Korean='과검출', English='False reject'}" /><Run Text=" " /><Run Text="{Binding ValidationSetFalseRejectCount, Mode=OneWay}" /></TextBlock></Border>
                            <Border Style="{StaticResource ValidationMatrixFalseAcceptSummaryStyle}" Margin="0,0,4,0" Background="{DynamicResource ThreeD.FailSurfaceBrush}" BorderBrush="{StaticResource ValidationMatrixFailBorderBrush}" TextElement.Foreground="{DynamicResource ThreeD.FailBrush}"><TextBlock VerticalAlignment="Center"><Run Text="× " /><Run Text="{shell:ThreeDText Key=ThreeD.Validation.FalseAccept, Korean='미검출', English='False accept'}" /><Run Text=" " /><Run Text="{Binding ValidationSetFalseAcceptCount, Mode=OneWay}" /></TextBlock></Border>
                            <Border Style="{StaticResource ValidationMatrixErrorSummaryStyle}" Background="{StaticResource ValidationMatrixErrorBrush}" BorderBrush="{StaticResource ValidationMatrixErrorBorderBrush}" TextElement.Foreground="{DynamicResource ThreeD.InspectionErrorTextBrush}"><TextBlock VerticalAlignment="Center"><Run Text="! " /><Run Text="{shell:ThreeDText Key=ThreeD.Validation.Error, Korean='오류', English='Error'}" /><Run Text=" " /><Run Text="{Binding ValidationSetErrorCount, Mode=OneWay}" /></TextBlock></Border>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel x:Name="ValidationMatrixHeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
