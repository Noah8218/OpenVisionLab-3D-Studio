                                        <DataGridTextColumn Width="125" Header="{Binding ValidationSetFile, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FileName}" />
                                        <DataGridTextColumn Width="62" Header="{Binding ValidationSetRole, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Role}" />
                                        <DataGridTextColumn Width="62" Header="{Binding ValidationSetRunState, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Status}" />
                                        <DataGridTextColumn Width="78" Header="{Binding ValidationSetExpected, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding ExpectedMatch}" />
                                        <DataGridTextColumn Width="1*" Header="{Binding ValidationSetMetric, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Metrics}" />
                                        <DataGridTextColumn Width="170" Header="{shell:ThreeDText Key=ThreeD.Validation.SampleSha256, Korean='샘플 SHA-256', English='Sample SHA-256'}" Binding="{Binding SampleIdentity}">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="ToolTip" Value="{Binding SampleIdentity}" />
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ValidationThresholdCandidatesGrid"
                                          Grid.Row="4"
                                          MaxHeight="190"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding ValidationThresholdCandidates}"
                                          SelectedItem="{Binding SelectedValidationThresholdCandidate, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Validation.DeterministicThresholdCandidatesAccessible, Korean='임계값 후보', English='Threshold candidates'}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="92" Header="{Binding ValidationSetScope, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Scope}" />
                                        <DataGridTextColumn Width="125" Header="{Binding ValidationSetOwner, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding OwnerName}" />
                                        <DataGridTextColumn Width="125" Header="{Binding ValidationSetMetric, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding MetricName}" />
                                        <DataGridTextColumn Width="72" Header="{shell:ThreeDText Key=ThreeD.Validation.Rule, Korean='규칙', English='Rule'}" Binding="{Binding LimitKind}" />
                                        <DataGridTextColumn Width="115" Header="{Binding ValidationSetLimits, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Limits}" />
                                        <DataGridTextColumn Width="62" Header="{Binding ValidationSetCorrect, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding CorrectCount}" />
                                        <DataGridTextColumn Width="58" Header="{Binding ValidationSetErrors, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding ErrorCount}" />
                                        <DataGridTextColumn Width="78" Header="{Binding ValidationSetFalseAccept, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FalseAcceptCount}" />
                                        <DataGridTextColumn Width="78" Header="{Binding ValidationSetFalseReject, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FalseRejectCount}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ValidationThresholdDecisionsGrid"
                                          Grid.Row="4"
                                          Grid.Column="2"
                                          MaxHeight="190"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding SelectedValidationThresholdDecisions}"
                                          HeadersVisibility="Column"
                                          AutomationProperties.Name="{shell:ThreeDText Key=ThreeD.Validation.SelectedThresholdSampleDecisionsAccessible, Korean='선택 임계값 후보의 정확한 샘플 판정', English='Exact sample decisions for selected threshold candidate'}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="32" Header="#" Binding="{Binding SampleOrder}" />
                                        <DataGridTextColumn Width="115" Header="{Binding ValidationSetFile, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FileName}" />
                                        <DataGridTextColumn Width="150" Header="{shell:ThreeDText Key=ThreeD.Validation.SampleId, Korean='샘플 ID', English='Sample ID'}" Binding="{Binding SampleIdentity}">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="ToolTip" Value="{Binding SampleIdentity}" />
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="68" Header="{Binding ValidationSetExpected, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding ExpectedRole}" />
                                        <DataGridTextColumn Width="68" Header="{Binding ValidationSetPredicted, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding PredictedRole}" />
                                        <DataGridTextColumn Width="92" Header="{Binding ValidationSetDecision, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Decision}" />
                                        <DataGridTextColumn Width="72" Header="{Binding ValidationSetMetric, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Value}" />
                                        <DataGridTextColumn Width="82" Header="{shell:ThreeDText Key=ThreeD.Validation.CellEvidence, Korean='셀 정보', English='Cell evidence'}" Binding="{Binding EvidenceLocator}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Expander>
                    </Grid>
                </TabItem>
                <TabItem x:Name="InspectionQueueTabItem"
                         Header="{shell:ThreeDText Key=ThreeD.Inspection.Queue, Korean='검사 목록', English='Inspection queue'}"
                         AutomationProperties.AutomationId="InspectionQueueTab">
                    <workbench:InspectionQueueWorkspaceView DataContext="{Binding InspectionQueue}"
                                                            DockPaneCommands="{Binding DockPaneCommands, RelativeSource={RelativeSource AncestorType=workbench:RecipePipelineReviewView}}"
                                                            ResultsCommand="{Binding RunRecordContext.SelectWorkspaceCommand, RelativeSource={RelativeSource AncestorType=workbench:RecipePipelineReviewView}}"
                                                            AutomationProperties.AutomationId="InspectionQueueView" />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
