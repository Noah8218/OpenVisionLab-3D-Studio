                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Right">
                                <StackPanel x:Name="ValidationIssueNavigationHost"
                                            Orientation="Horizontal">
                                    <StackPanel x:Name="ValidationIssueCommands"
                                                Orientation="Horizontal"
                                                Visibility="{Binding HasValidationSetIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Margin="0,0,4,0"
                                                Padding="7,3"
                                                Command="{Binding PreviousValidationSetIssueCommand}"
                                                ToolTip="{Binding Localization.ValidationSetPreviousIssue}"
                                                AutomationProperties.Name="{Binding Localization.ValidationSetPreviousIssue}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Width="14" Height="14" Margin="0,0,4,0" Symbol="ArrowRight24">
                                                    <ui:SymbolIcon.RenderTransform>
                                                        <RotateTransform Angle="180" />
                                                    </ui:SymbolIcon.RenderTransform>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="{Binding Localization.ValidationSetPreviousIssue}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="0,0,4,0"
                                                Padding="7,3"
                                                Command="{Binding NextValidationSetIssueCommand}"
                                                ToolTip="{Binding Localization.ValidationSetNextIssue}"
                                                AutomationProperties.Name="{Binding Localization.ValidationSetNextIssue}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,4,0" Text="{Binding Localization.ValidationSetNextIssue}" />
                                                <ui:SymbolIcon Width="14" Height="14" Symbol="ArrowRight24" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <Button Padding="8,3"
                                        Command="{Binding OpenValidationSetComparisonCommand}"
                                        ToolTip="{Binding Localization.ValidationSetComparisonHint}"
                                        AutomationProperties.Name="{Binding Localization.ValidationSetOpenComparison}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Width="15" Height="15" Margin="0,0,5,0" Symbol="Eye24" />
                                        <TextBlock Text="{Binding Localization.ValidationSetOpenComparison}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <Grid x:Name="ValidationSetPrimaryGrid"
                              Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ValidationSamplesColumn" Width="1.35*" />
                                <ColumnDefinition x:Name="ValidationPrimaryGapColumn" Width="8" />
                                <ColumnDefinition x:Name="ValidationRecordColumn" Width="1.15*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ValidationSamplesPane"
                                    Padding="6"
                                    Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="2,0,2,5"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="{Binding Localization.ValidationSetSamples}" />
                                    <DataGrid Grid.Row="1"
                                              AutoGenerateColumns="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding ValidationSetSamples}"
                                              SelectedItem="{Binding SelectedValidationSetSample, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              AutomationProperties.Name="{Binding Localization.ValidationSetSamples}">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="34" Header="#" Binding="{Binding Order}" />
                                            <DataGridTextColumn Width="88" Header="{Binding ValidationSetExpectedRole, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding RoleText}" />
                                            <DataGridTextColumn Width="1.5*"
                                                                Header="{Binding ValidationSetFile, Source={x:Static shell:ThreeDLocalization.Shared}}"
                                                                Binding="{Binding FileName}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding FileName}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="82" Header="{Binding ValidationSetRunState, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding StatusText}" />
                                            <DataGridTextColumn Width="76" Header="{Binding ValidationSetDuration, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Duration}" />
                                            <DataGridTextColumn Width="2*"
                                                                Header="{shell:ThreeDText Key=ThreeD.Column.ValidationEvidence, Korean='실행 근거', English='Evidence'}"
                                                                Binding="{Binding Message}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding Message}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding Localization.ValidationSetNoSamples}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasValidationSetSamples}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Border x:Name="ValidationRecordPane"
                                    Grid.Column="2"
                                    Padding="6"
                                    Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="2,0,2,5"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="{Binding Localization.ValidationSetSelectedRecord}" />
                                    <ListBox x:Name="ValidationSetStepsList"
                                             Grid.Row="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding SelectedValidationSetSteps}"
                                             SelectedItem="{Binding SelectedValidationSetStep, Mode=TwoWay}"
                                             SelectionChanged="ValidationSetStepsList_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,3"
                                                        Padding="7,5"
                                                        Background="{DynamicResource ThreeD.PanelBrush}"
                                                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="64" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding Order}" />
                                                        <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Text="{Binding ToolName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolName}" />
                                                        <TextBlock Grid.Column="2" FontSize="9.5" FontWeight="SemiBold" Text="{Binding StatusText}" />
                                                        <TextBlock Grid.Column="3"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                                   Text="{Binding Evidence}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Evidence}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Column="2"
                                            Grid.RowSpan="2"
                                            Padding="7,5"
                                            Background="{DynamicResource ThreeD.PanelBrush}"
                                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Visibility="{Binding HasSelectedValidationSetStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="1*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThreeD.AccentBrush}"
                                                           Text="{Binding Localization.ValidationSetMetrics}" />
                                                <ListBox Grid.Row="1"
                                                         Margin="0,3,0,0"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         ItemsSource="{Binding SelectedValidationSetStep.Metrics}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="9" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="9" FontWeight="SemiBold">
                                                                    <Run Text="{Binding Value}" />
                                                                    <Run Text="{Binding Unit}" />
                                                                    <Run Text="{Binding StatusText}" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThreeD.AccentBrush}"
                                                           Text="{Binding Localization.ValidationSetOverlays}" />
                                                <ListBox Grid.Row="1"
                                                         Margin="0,3,0,0"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         ItemsSource="{Binding SelectedValidationSetStep.Overlays}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="9" FontWeight="SemiBold" Text="{Binding Kind}" />
                                                                <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="9" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                                <TextBlock Grid.Column="2" Margin="6,0,0,0" FontSize="9" Text="{Binding StatusText}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding Localization.ValidationSetNoSelection}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedValidationSetSample}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>

                        <Expander x:Name="ValidationEvidenceExpander"
                                  Grid.Row="4"
                                  Margin="4,6,4,0"
                                  IsExpanded="{Binding IsValidationEvidenceExpanded, Mode=TwoWay}"
                                  MaxHeight="190"
                                  Header="{Binding Localization.ValidationSetLabeledEvidence}">
                            <StackPanel Margin="0,5,0,0">
                                <TextBlock FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Text="{Binding ValidationEvidenceSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,2,0,4"
                                           FontSize="9"
                                           Foreground="{DynamicResource ThreeD.WarningBrush}"
                                           Text="{Binding ValidationEvidenceWarning}"
                                           TextWrapping="Wrap" />
                                <DataGrid MaxHeight="130"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding ValidationEvidenceDistributions}"
                                          HeadersVisibility="Column"
                                          AutomationProperties.Name="Per-step and per-region labeled metric distributions">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="78" Header="{Binding ValidationSetScope, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Scope}" />
                                        <DataGridTextColumn Width="130" Header="{Binding ValidationSetOwner, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding OwnerName}" />
                                        <DataGridTextColumn Width="150" Header="{Binding ValidationSetMetric, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding MetricName}" />
                                        <DataGridTextColumn Width="1*" Header="Good · development" Binding="{Binding Good}" />
                                        <DataGridTextColumn Width="1*" Header="Bad · development" Binding="{Binding Bad}" />
                                        <DataGridTextColumn Width="1*" Header="Held-out · excluded" Binding="{Binding HeldOut}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="ValidationThresholdExpander"
                                  Grid.Row="5"
                                  Margin="4,4,4,0"
                                  IsExpanded="{Binding IsValidationThresholdExpanded, Mode=TwoWay}"
                                  MaxHeight="560"
                                  Header="{Binding Localization.ValidationSetThresholdCandidates}">
                            <Grid Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="3">
                                    <TextBlock FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Text="{Binding ValidationThresholdSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,3"
                                               FontSize="9"
                                               Foreground="{DynamicResource ThreeD.AccentBrush}"
                                               Text="{Binding Localization.ValidationSetThresholdReadOnly}" />
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="9"
                                               Foreground="{DynamicResource ThreeD.WarningBrush}"
                                               Text="{Binding ValidationThresholdWarning}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Grid.Row="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button x:Name="ReviewValidationThresholdButton"
                                                Margin="0,0,5,0"
                                                Command="{Binding ReviewValidationThresholdCandidateCommand}"
                                                ToolTip="{Binding Localization.ValidationSetThresholdReview}"
                                                AutomationProperties.Name="{Binding Localization.ValidationSetThresholdReview}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Width="15" Height="15" Margin="0,0,5,0" Symbol="Search24" />
                                                <TextBlock Text="{Binding Localization.ValidationSetThresholdReview}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CancelValidationThresholdReviewButton"
                                                Margin="0,0,5,0"
                                                Command="{Binding CancelValidationThresholdReviewCommand}"
                                                ToolTip="{Binding Localization.ValidationSetThresholdCancelReview}"
                                                AutomationProperties.Name="{Binding Localization.ValidationSetThresholdCancelReview}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Width="15" Height="15" Margin="0,0,5,0" Symbol="Dismiss24" />
                                                <TextBlock Text="{Binding Localization.ValidationSetThresholdCancelReview}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ApplyValidationThresholdButton"
                                                Margin="0,0,5,0"
                                                Command="{Binding ApplyValidationThresholdCandidateCommand}"
                                                ToolTip="{Binding Localization.ValidationSetThresholdApplyDraft}"
                                                AutomationProperties.Name="{Binding Localization.ValidationSetThresholdApplyDraft}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Width="15" Height="15" Margin="0,0,5,0" Symbol="Checkmark24" />
                                                <TextBlock Text="{Binding Localization.ValidationSetThresholdApplyDraft}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RevalidateDevelopmentButton"
                                                Margin="0,0,5,0"
                                                Command="{Binding RevalidateValidationThresholdCorrectionCommand}"
                                                ToolTip="{Binding Localization.ValidationSetThresholdRevalidateDevelopment}"
                                                AutomationProperties.Name="{Binding Localization.ValidationSetThresholdRevalidateDevelopment}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Width="15" Height="15" Margin="0,0,5,0" Symbol="ArrowSync24" />
                                                <TextBlock Text="{Binding Localization.ValidationSetThresholdRevalidateDevelopment}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ReplayHeldOutButton"
                                                Command="{Binding ReplayValidationThresholdHeldOutCommand}"
                                                ToolTip="{Binding Localization.ValidationSetThresholdReplayHeldOut}"
                                                AutomationProperties.Name="{Binding Localization.ValidationSetThresholdReplayHeldOut}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Width="15" Height="15" Margin="0,0,5,0" Symbol="Play24" />
                                                <TextBlock Text="{Binding Localization.ValidationSetThresholdReplayHeldOut}" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="9"
                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{Binding ValidationThresholdCorrectionSummary}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <DataGrid x:Name="ValidationThresholdParameterChangesGrid"
                                          Grid.Row="2"
                                          MaxHeight="78"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding ValidationThresholdParameterChanges}"
                                          HeadersVisibility="Column"
                                          Visibility="{Binding HasValidationThresholdParameterChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          AutomationProperties.Name="Reviewed typed parameter changes">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="1*" Header="Typed parameter" Binding="{Binding ParameterName}" />
                                        <DataGridTextColumn Width="95" Header="Before" Binding="{Binding BeforeValue}" />
                                        <DataGridTextColumn Width="82" Header="Suggested" Binding="{Binding ProposedValue}" />
                                        <DataGridTextColumn Width="82" Header="Manual" Binding="{Binding ManualValue}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ValidationThresholdHeldOutGrid"
                                          Grid.Row="2"
                                          Grid.Column="2"
                                          MaxHeight="78"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding ValidationThresholdHeldOutSamples}"
                                          HeadersVisibility="Column"
                                          Visibility="{Binding HasValidationThresholdHeldOutEvidence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          AutomationProperties.Name="Explicit Held-out replay evidence">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="32" Header="#" Binding="{Binding SampleOrder}" />
                                        <DataGridTextColumn Width="115" Header="{Binding ValidationSetFile, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FileName}" />
                                        <DataGridTextColumn Width="62" Header="Status" Binding="{Binding Status}" />
                                        <DataGridTextColumn Width="1*" Header="{Binding ValidationSetMetric, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Metrics}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ValidationThresholdDevelopmentGrid"
                                          Grid.Row="3"
                                          Grid.ColumnSpan="3"
                                          MaxHeight="112"
                                          Margin="0,5,0,0"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding ValidationThresholdDevelopmentSamples}"
                                          HeadersVisibility="Column"
                                          Visibility="{Binding HasValidationThresholdDevelopmentEvidence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          AutomationProperties.Name="Before and after development correction evidence">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="58" Header="Stage" Binding="{Binding Stage}" />
                                        <DataGridTextColumn Width="32" Header="#" Binding="{Binding SampleOrder}" />
                                        <DataGridTextColumn Width="125" Header="{Binding ValidationSetFile, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FileName}" />
                                        <DataGridTextColumn Width="62" Header="Role" Binding="{Binding Role}" />
                                        <DataGridTextColumn Width="62" Header="Status" Binding="{Binding Status}" />
                                        <DataGridTextColumn Width="78" Header="Expected" Binding="{Binding ExpectedMatch}" />
                                        <DataGridTextColumn Width="1*" Header="{Binding ValidationSetMetric, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Metrics}" />
                                        <DataGridTextColumn Width="170" Header="Sample SHA-256" Binding="{Binding SampleIdentity}">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="ToolTip" Value="{Binding SampleIdentity}" />
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ValidationThresholdCandidatesGrid"
                                          Grid.Row="4"
                                          MaxHeight="190"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding ValidationThresholdCandidates}"
                                          SelectedItem="{Binding SelectedValidationThresholdCandidate, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          AutomationProperties.Name="Review-only deterministic threshold candidates">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="92" Header="{Binding ValidationSetScope, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Scope}" />
                                        <DataGridTextColumn Width="125" Header="{Binding ValidationSetOwner, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding OwnerName}" />
                                        <DataGridTextColumn Width="125" Header="{Binding ValidationSetMetric, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding MetricName}" />
                                        <DataGridTextColumn Width="72" Header="Rule" Binding="{Binding LimitKind}" />
                                        <DataGridTextColumn Width="115" Header="{Binding ValidationSetLimits, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Limits}" />
                                        <DataGridTextColumn Width="62" Header="{Binding ValidationSetCorrect, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding CorrectCount}" />
                                        <DataGridTextColumn Width="58" Header="{Binding ValidationSetErrors, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding ErrorCount}" />
                                        <DataGridTextColumn Width="78" Header="{Binding ValidationSetFalseAccept, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FalseAcceptCount}" />
                                        <DataGridTextColumn Width="78" Header="{Binding ValidationSetFalseReject, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FalseRejectCount}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ValidationThresholdDecisionsGrid"
                                          Grid.Row="4"
                                          Grid.Column="2"
                                          MaxHeight="190"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding SelectedValidationThresholdDecisions}"
                                          HeadersVisibility="Column"
                                          AutomationProperties.Name="Exact sample decisions for selected threshold candidate">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="32" Header="#" Binding="{Binding SampleOrder}" />
                                        <DataGridTextColumn Width="115" Header="{Binding ValidationSetFile, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding FileName}" />
                                        <DataGridTextColumn Width="150" Header="Sample ID" Binding="{Binding SampleIdentity}">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="ToolTip" Value="{Binding SampleIdentity}" />
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="68" Header="{Binding ValidationSetExpected, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding ExpectedRole}" />
                                        <DataGridTextColumn Width="68" Header="{Binding ValidationSetPredicted, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding PredictedRole}" />
                                        <DataGridTextColumn Width="92" Header="{Binding ValidationSetDecision, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Decision}" />
                                        <DataGridTextColumn Width="72" Header="{Binding ValidationSetMetric, Source={x:Static shell:ThreeDLocalization.Shared}}" Binding="{Binding Value}" />
                                        <DataGridTextColumn Width="82" Header="Cell evidence" Binding="{Binding EvidenceLocator}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Expander>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
