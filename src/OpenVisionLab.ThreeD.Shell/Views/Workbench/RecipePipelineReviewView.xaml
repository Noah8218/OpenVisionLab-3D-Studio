                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding RecordedAt}" />
                                            <Run Text=" | " />
                                            <Run FontWeight="SemiBold" Text="{Binding Status}" />
                                            <Run Text=" | " />
                                            <Run Text="{Binding StepCount}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding DataContext.Localization.StepsLabel, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Run Text=" | " />
                                            <Run Text="{Binding Name}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:Button x:Name="RunRecordOpenRecentButton"
                                       Margin="0,0,3,4"
