<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.ViewerWorkspaceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             xmlns:host="clr-namespace:OpenVisionLab.ThreeD.Viewer.Hosting;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:workbenchViewModels="clr-namespace:OpenVisionLab.ThreeD.Shell.ViewModels.Workbench"
             xmlns:workbenchViews="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             AutomationProperties.AutomationId="ViewerWorkspace">
    <UserControl.InputBindings>
        <KeyBinding Key="D1" Command="{Binding SetSingleViewerLayoutCommand}" />
        <KeyBinding Key="D2" Command="{Binding ShowHeightImageOnlyCommand}" />
        <KeyBinding Key="D3" Command="{Binding OpenHeightImageCommand}" />

        <KeyBinding Key="F" Command="{Binding Presentation.FitAllCommand, ElementName=MainViewerPresentationBar}" />
        <KeyBinding Key="R" Command="{Binding Presentation.RotateCommand, ElementName=MainViewerPresentationBar}" />
        <KeyBinding Key="M" Command="{Binding Presentation.MoveCommand, ElementName=MainViewerPresentationBar}" />
        <KeyBinding Key="Escape" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Cancel}" />
        <KeyBinding Key="Left" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Left}" />
        <KeyBinding Key="Right" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Right}" />
        <KeyBinding Key="Up" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Up}" />
        <KeyBinding Key="Down" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Down}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <ContextMenu x:Key="WorkbenchViewerContextMenu">
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.InputLoad, Korean='입력 불러오기', English='Load input'}" Command="{Binding Import3DDataCommand}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}" Command="{Binding Tag.FitAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="F" />
            <Separator />
            <MenuItem Tag="OrbitHere" Header="{views:ThreeDText Key=ThreeD.Viewer.OrbitHere, Korean='여기를 회전 중심으로', English='Orbit around here'}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.Rotate, Korean='회전', English='Rotate'}" Command="{Binding Tag.RotateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsChecked="{Binding Tag.IsRotateMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" InputGestureText="R" IsCheckable="True" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.Move, Korean='이동', English='Move'}" Command="{Binding Tag.MoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsChecked="{Binding Tag.IsMoveMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" InputGestureText="M" IsCheckable="True" />
            <Separator />
            <MenuItem Header="3D" Command="{Binding SetSingleViewerLayoutCommand}" IsCheckable="True" IsChecked="{Binding IsSingleViewerLayout, Mode=OneWay}" />
            <MenuItem Header="XY" Command="{Binding ShowHeightImageOnlyCommand}" IsCheckable="True" IsChecked="{Binding IsHeightImageOnlyViewerLayout, Mode=OneWay}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.SplitLayout, Korean='분할', English='Split'}" Command="{Binding OpenHeightImageCommand}" IsCheckable="True" IsChecked="{Binding IsSplitVerticalViewerLayout, Mode=OneWay}" />
            <Separator />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.Measure, Korean='두 점 측정', English='Measure two points'}" Command="{Binding Tag.MeasureCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsChecked="{Binding Tag.IsProfileMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" IsCheckable="True" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Profile.Repick, Korean='A/B 다시 선택', English='Repick A/B'}" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Repick}" Visibility="{Binding Tag.HasProfileEndpoints, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Header="A ↔ B" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Swap}" Visibility="{Binding Tag.HasProfileEndpoints, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Profile.Clear, Korean='현재 측정 지우기', English='Clear measurement'}" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Clear}" Visibility="{Binding Tag.ProfileState.Visible, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Separator />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.ColorDisplay, Korean='색상·표시', English='Color and display'}" Command="{Binding Tag.OpenDisplaySettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <ContextMenu x:Key="HeightImageContextMenu">
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.InputLoad, Korean='입력 불러오기', English='Load input'}" Command="{Binding Import3DDataCommand}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}" Command="{Binding HeightImageViewer.FitCommand}" InputGestureText="F" />
            <MenuItem Header="1:1" Command="{Binding HeightImageViewer.ActualPixelsCommand}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.HeightImage.AutoRange, Korean='높이 자동 범위', English='Auto height range'}" Command="{Binding HeightImageViewer.AutoRangeCommand}" />
            <Separator />
            <MenuItem Header="3D" Command="{Binding SetSingleViewerLayoutCommand}" IsCheckable="True" IsChecked="{Binding IsSingleViewerLayout, Mode=OneWay}" />
            <MenuItem Header="XY" Command="{Binding ShowHeightImageOnlyCommand}" IsCheckable="True" IsChecked="{Binding IsHeightImageOnlyViewerLayout, Mode=OneWay}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.SplitLayout, Korean='분할', English='Split'}" Command="{Binding OpenHeightImageCommand}" IsCheckable="True" IsChecked="{Binding IsSplitVerticalViewerLayout, Mode=OneWay}" />
            <Separator />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.Measure, Korean='두 점 측정', English='Measure two points'}" Command="{Binding Tag.MeasureCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsChecked="{Binding Tag.IsProfileMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" IsCheckable="True" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Profile.Repick, Korean='A/B 다시 선택', English='Repick A/B'}" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Repick}" Visibility="{Binding Tag.HasProfileEndpoints, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Header="A ↔ B" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Swap}" Visibility="{Binding Tag.HasProfileEndpoints, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Profile.Clear, Korean='현재 측정 지우기', English='Clear measurement'}" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Clear}" Visibility="{Binding Tag.ProfileState.Visible, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
        </ContextMenu>
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
        <Style x:Key="ViewerLayoutIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Opacity" Value="0.64" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerLayoutIconToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Opacity" Value="0.64" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerCameraLinkToggleStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ViewerLayoutIconToggleStyle}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="ViewerModeToggleStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ViewerLayoutIconToggleStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ViewerCombinedModeToggleStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ViewerModeToggleStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="ViewerWorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Focusable="False">
    <Grid x:Name="ViewerWorkspaceSurface" Background="{DynamicResource ThreeD.PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ViewerCommandRows" Grid.Row="0" VerticalAlignment="Top">
            <Border x:Name="ViewerLayoutToolbar"
                    Margin="8,4,8,4"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Panel.ZIndex="10"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="ViewerLayoutToolbar"
                    AutomationProperties.Name="{Binding Localization.ViewerLayout}"
                    AutomationProperties.HelpText="{Binding ViewerWorkspaceLayoutSummary}">
                <WrapPanel VerticalAlignment="Center">
                    <ToggleButton x:Name="ThreeDViewerMode"
                                  Style="{StaticResource ViewerModeToggleStyle}"
                                  Command="{Binding SetSingleViewerLayoutCommand}"
                                  IsChecked="{Binding IsSingleViewerLayout, Mode=OneWay}"
                                  ToolTip="{Binding Localization.ViewerReturnToSingle}"
                                  AutomationProperties.Name="{Binding Localization.ViewerSingle}"
                                  AutomationProperties.AutomationId="ViewerSingleLayout"
                                  Content="3D">
                    </ToggleButton>
                    <ToggleButton x:Name="HeightOnlyViewerMode"
                                  Style="{StaticResource ViewerModeToggleStyle}"
                                  Command="{Binding ShowHeightImageOnlyCommand}"
                                  IsChecked="{Binding IsHeightImageOnlyViewerLayout, Mode=OneWay}"
                                  Content="XY"
                                  ToolTip="{Binding Localization.HeightImageViewOnly}"
                                  AutomationProperties.Name="{Binding Localization.HeightImage}"
                                  AutomationProperties.AutomationId="ViewerHeightImageOnly" />
                    <ToggleButton x:Name="ThreeDHeightViewerMode"
                                  Style="{StaticResource ViewerCombinedModeToggleStyle}"
                                  Command="{Binding OpenHeightImageCommand}"
                                  IsChecked="{Binding IsSplitVerticalViewerLayout, Mode=OneWay}"
                                  ToolTip="{Binding Localization.HeightImageViewOnly}"
                                  AutomationProperties.Name="{Binding Localization.OpenHeightImage}"
                                  AutomationProperties.AutomationId="OpenHeightImage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HeightImageModeLabel"
                                       Text="{views:ThreeDText Key=ThreeD.Viewer.SplitLayout, Korean='분할', English='Split'}" />
                        </StackPanel>
                    </ToggleButton>
                    <Menu IsMainMenu="False" x:Name="ViewerWorkspaceOptionsMenu"
                          Margin="0,0,6,0"
                          Height="30"
                          Padding="0"
                          VerticalAlignment="Center"
                          Background="{DynamicResource ThreeD.PanelBrush}"
                          Foreground="{DynamicResource ThreeD.TextBrush}"
                          AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.ViewerLayoutOptions, Korean='화면 배치', English='Layout'}"
                          AutomationProperties.AutomationId="ViewerWorkspaceOptionsMenu">
<MenuItem Template="{StaticResource R19TopMenuItemTemplate}" Header="{views:ThreeDText Key=ThreeD.R19.ViewerLayoutOptions, Korean='화면 배치', English='Layout'}"
                                  Height="30"
                                  Padding="6,0"
                                  FontSize="12"
                                  VerticalContentAlignment="Center"
                                  ToolTip="{Binding ViewerWorkspaceLayoutSummary}"
                                  AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.ViewerLayoutOptions, Korean='화면 배치', English='Layout'}"
                                  AutomationProperties.HelpText="{Binding ViewerWorkspaceLayoutSummary}"
                                  AutomationProperties.AutomationId="ViewerWorkspaceOptionsRoot">
                            <MenuItem Header="{Binding Localization.ViewerSplitHorizontal}"
                                      Command="{Binding SplitViewerHorizontallyCommand}"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsSplitHorizontalViewerLayout, Mode=OneWay}"
                                      AutomationProperties.Name="{Binding Localization.ViewerSplitHorizontal}"
                                      AutomationProperties.AutomationId="ViewerSplitHorizontalLayout" />
                            <MenuItem Header="{Binding Localization.ViewerPopOut}"
                                      Command="{Binding PopOutViewerCommand}"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsPopOutViewerLayout, Mode=OneWay}"
                                      AutomationProperties.Name="{Binding Localization.ViewerPopOut}"
                                      AutomationProperties.AutomationId="ViewerPopOutLayout" />
                            <Separator />
                            <MenuItem Header="{Binding ViewerCameraLinkLabel}"
                                      Command="{Binding ToggleViewerCameraLinkCommand}"
                                      IsCheckable="True"
                                      IsChecked="{Binding ViewerWorkspace.IsCameraLinked, Mode=OneWay}"
                                      ToolTip="{Binding ViewerCameraLinkSummary}"
                                      AutomationProperties.Name="{Binding ViewerCameraLinkLabel}"
                                      AutomationProperties.HelpText="{Binding ViewerCameraLinkSummary}"
                                      AutomationProperties.AutomationId="ViewerCameraLink" />
                            <Separator />
                            <MenuItem x:Name="ViewerInspectionOutputCompare"
                                      Header="{views:ThreeDText Key=ThreeD.R19.ViewerComparePinned, Korean='고정 결과 A/B 비교', English='Compare pinned A/B'}"
                                      IsCheckable="True"
                                      Command="{Binding ShowOutputCompareViewerCommand}"
                                      IsChecked="{Binding IsOutputCompareViewerActive, Mode=OneWay}"
                                      IsEnabled="{Binding CanShowOutputCompareViewer}"
                                      AutomationProperties.AutomationId="ViewerInspectionOutputCompare" />
                        </MenuItem>
                    </Menu>
                </WrapPanel>
            </Border><Border x:Name="ViewerInspectionDataSwitch" Margin="0,4,8,4" AutomationProperties.AutomationId="ViewerInspectionDataSwitch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasInspectionStep}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Menu IsMainMenu="False" Background="Transparent">
                    <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.DataView, Korean='입력 / 결과', English='Input / result'}" Template="{StaticResource R19TopMenuItemTemplate}">
                        <MenuItem x:Name="ViewerInspectionInput" Header="{views:ThreeDText Key=ThreeD.Viewer.Input, Korean='입력', English='Input'}" IsCheckable="True"
                                  Command="{Binding SetInspectionDataViewCommand}" CommandParameter="{x:Static workbenchViewModels:ViewerInspectionDataView.Input}"
                                  IsChecked="{Binding IsInspectionInputView, Mode=OneWay}" AutomationProperties.AutomationId="ViewerInspectionInput" />
                        <MenuItem x:Name="ViewerInspectionOutput" Header="{views:ThreeDText Key=ThreeD.Viewer.Output, Korean='결과', English='Output'}" IsCheckable="True"
                                  Command="{Binding SetInspectionDataViewCommand}" CommandParameter="{x:Static workbenchViewModels:ViewerInspectionDataView.Output}"
                                  IsChecked="{Binding IsInspectionOutputView, Mode=OneWay}" AutomationProperties.AutomationId="ViewerInspectionOutput" />
                        <MenuItem x:Name="ViewerInspectionInputOutput" Header="{views:ThreeDText Key=ThreeD.Viewer.InputOutput, Korean='입력 + 결과', English='Input + result'}" IsCheckable="True"
                                  Command="{Binding SetInspectionDataViewCommand}" CommandParameter="{x:Static workbenchViewModels:ViewerInspectionDataView.InputOutput}"
                                  IsChecked="{Binding IsInspectionInputOutputView, Mode=OneWay}" AutomationProperties.AutomationId="ViewerInspectionInputOutput" />
                    </MenuItem>
                </Menu>
            </Border>



        </WrapPanel>



        <Border Grid.Row="3" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Background="{DynamicResource ThreeD.PanelBrush}">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsInspectionFileView}" Value="True" /><Condition Binding="{Binding InspectionQueue.HasSelectedSample}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
            </Style.Triggers></Style></Border.Style>
            <TextBlock Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{views:ThreeDText Key=ThreeD.Inspection.NoInput, Korean='검사할 파일을 추가하고 선택하세요.', English='Add and select an inspection file.'}" />
        </Border>
        <Border Grid.Row="3"
                Margin="12,12,12,0"
                Padding="9,5"
                MaxWidth="520"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="9"
                Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Visibility="{Binding HasViewerOnlyImport, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.AutomationId="ViewerOnlyImportSummary">
            <TextBlock Foreground="{DynamicResource ThreeD.TextBrush}"
                       Text="{Binding ViewerOnlyImportSummary, Converter={StaticResource ViewerRuntimeTextConverter}}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ViewerOnlyImportSummary, Converter={StaticResource ViewerRuntimeTextConverter}}" />
        </Border>

        <Grid x:Name="ViewerGrid"
              Grid.Row="3"
              Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstRow" Height="*" />
                <RowDefinition x:Name="MiddleRow" Height="0" />
                <RowDefinition x:Name="SecondRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FirstColumn" Width="*" />
                <ColumnDefinition x:Name="MiddleColumn" Width="0" />
                <ColumnDefinition x:Name="SecondColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MainSlot"
                    Background="{DynamicResource ThreeD.ViewportBrush}"
                    BorderThickness="2"
                    CornerRadius="3"
                    behaviors:PreviewMouseDownCommandBehavior.IsEnabled="True"
                    behaviors:PreviewMouseDownCommandBehavior.Command="{Binding FocusViewerWorkspaceSlotCommand}"
                    behaviors:PreviewMouseDownCommandBehavior.CommandParameter="viewer.main"
                    AutomationProperties.AutomationId="MainViewerSlot">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewerWorkspace.IsMainFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="7,0"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MainViewerContentPin"
                                      MinWidth="120"
                                      MaxWidth="240"
                                      MinHeight="30"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding MainViewerCandidates}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding MainViewerContentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding CanEditMainViewerPin, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTip="{Binding MainViewerSummary, Converter={StaticResource ViewerRuntimeTextConverter}}"
                                      AutomationProperties.Name="{Binding Localization.ViewerMainSlot}"
                                      AutomationProperties.AutomationId="MainViewerContentPin" />
                            <TextBlock MaxWidth="240"
                                       Margin="4,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThreeD.TextBrush}"

                                       TextTrimming="CharacterEllipsis"
                                       >
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding EffectiveMainViewerSummary}" />
                                        <Setter Property="ToolTip" Value="{Binding EffectiveMainViewerSummary}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInspectionStep}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOutputCompareViewerActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInspectionFileView}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="ToolTip" Value="{Binding InspectionQueue.SelectedSample.SourcePath}" /><Setter Property="Text" Value="{Binding InspectionQueue.SelectedSample.FileName, TargetNullValue=—}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="3D" />
                                <ui:Button Margin="4,0,0,0"
                                           Padding="7,2"
                                           Content="×"
                                           Command="{Binding ClearMainViewerPinCommand}"
                                           Visibility="{Binding CanEditMainViewerPin, Converter={StaticResource BoolToVisibilityConverter}}"
                                           ToolTip="{Binding Localization.ViewerClearPin}"
                                           AutomationProperties.Name="{Binding Localization.ViewerClearPin}"
                                           AutomationProperties.AutomationId="ClearMainViewerPin" />
                            </StackPanel>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="-7,4,-7,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeightImageOnlyViewerLayout}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasInspectionStep}" Value="True" />
                                    <Condition Binding="{Binding HasEffectiveMainGeometry}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <workbenchViews:ViewerPresentationBar x:Name="MainViewerPresentationBar"
                                                      Margin="0"
                                                      ViewerHost="{Binding MainViewerContent, ElementName=Root}"
                                                      DialogPlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      SlotLabel="" />
            </Border>
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="4,3"
                                    Visibility="{Binding HeightImageViewer.HasLinkedCursor, Converter={StaticResource BoolToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="SharedHeightCursorSummary">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Width="16" Height="16" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource ThreeD.InfoBrush}" Symbol="CursorClick24" />
                                        <TextBlock Margin="0,0,7,0" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThreeD.InfoBrush}"
                                                   Text="{Binding Localization.SharedHeightCursor}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource ThreeD.TextBrush}" TextWrapping="Wrap"
                                               Text="{Binding HeightImageViewer.HoverSummary}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ContentPresenter x:Name="MainViewerPresenter"
                                          Content="{Binding MainViewerContent, ElementName=Root}"
                                          Visibility="{Binding HasEffectiveMainGeometry, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Border x:Name="ViewerCompareMainNoGeometry"
                                MaxWidth="460"
                                Margin="24"
                                Padding="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                AutomationProperties.Name="{Binding Localization.OutputCompareNoSelection}"
                                AutomationProperties.HelpText="{Binding Localization.OutputCompareDetail}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsOutputCompareViewerActive}" Value="True" />
                                                <Condition Binding="{Binding HasEffectiveMainGeometry}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding Localization.OutputCompareNoSelection}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding Localization.OutputCompareDetail}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ViewerInputNoGeometry"
                                MaxWidth="460"
                                Margin="24"
                                Padding="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                AutomationProperties.AutomationId="ViewerInputNoGeometry">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInspectionInputView}" Value="True" />
                                                <Condition Binding="{Binding HasInspectionStep}" Value="True" />
                                                <Condition Binding="{Binding HasEffectiveMainGeometry}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInspectionInputOutputView}" Value="True" />
                                                <Condition Binding="{Binding HasEffectiveMainGeometry}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsInspectionFileView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionInput.DisplayName}" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding ViewerInspectionInput.State}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding Localization.ViewerMainNoOutput}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ViewerOutputNoGeometry"
                                MaxWidth="460"
                                Margin="24"
                                Padding="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                AutomationProperties.AutomationId="ViewerOutputNoGeometry">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInspectionOutputView}" Value="True" />
                                                <Condition Binding="{Binding HasEffectiveOutputGeometry}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsInspectionFileView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionOutput.DisplayName}" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding ViewerInspectionOutput.ResultStatus}"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,7,0,0"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ViewerInspectionOutput.HasEvidenceValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding ViewerInspectionOutput.ValueLabel}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThreeD.TextBrush}"
                                               Text="{Binding ViewerInspectionOutput.Value}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding ViewerInspectionOutput.Unit}" />
                                </StackPanel>
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionOutput.Availability}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ViewerInputFirstAction"
                                MaxWidth="430"
                                Margin="20"
                                Padding="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                AutomationProperties.AutomationId="ViewerInputFirstAction">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasSurfaceMatchEvidence}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasViewerOnlyImport}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInspectionFileView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon Width="32"
                                               Height="32"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                               Symbol="FolderOpen24" />
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding Localization.LoadInputActionTitle}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Opacity="0.78"
                                           Text="{Binding Localization.LoadInputActionDetail}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <ui:Button Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           Content="{Binding Localization.Import3DData}"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Command="{Binding Import3DDataCommand}"
                                           ToolTip="{Binding Localization.Import3DDataToolTip}"
                                           AutomationProperties.Name="{Binding Localization.Import3DData}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="ViewerSplitter"
                          Background="{DynamicResource ThreeD.DividerBrush}"
                          ShowsPreview="True"
                          Visibility="Collapsed" />

            <Border x:Name="AuxiliarySlot"
                    Background="{DynamicResource ThreeD.ViewportBrush}"
                    BorderThickness="2"
                    CornerRadius="3"
                    Visibility="Collapsed"
                    behaviors:PreviewMouseDownCommandBehavior.IsEnabled="True"
                    behaviors:PreviewMouseDownCommandBehavior.Command="{Binding FocusViewerWorkspaceSlotCommand}"
                    behaviors:PreviewMouseDownCommandBehavior.CommandParameter="viewer.auxiliary"
                    AutomationProperties.AutomationId="AuxiliaryViewerSlot">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewerWorkspace.IsAuxiliaryFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="7,0"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AuxiliaryViewerContentPin"
                                      MinWidth="120"
                                      MaxWidth="240"
                                      MinHeight="30"
                                      ItemsSource="{Binding ViewerWorkspaceCandidates}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding AuxiliaryViewerContentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding CanEditAuxiliaryViewerPin, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTip="{Binding AuxiliaryViewerSummary, Converter={StaticResource ViewerRuntimeTextConverter}}"
                                      AutomationProperties.Name="{Binding Localization.ViewerAuxiliaryOutput}"
                                      AutomationProperties.AutomationId="AuxiliaryViewerContentPin">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Text" Value="{Binding DisplayName}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}"
                                                                     Value="{x:Static workbenchViewModels:ViewerWorkspaceCandidateKind.HeightImage}">
                                                            <Setter Property="Text"
                                                                    Value="{Binding DataContext.Localization.HeightImage, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock MaxWidth="240"
                                       Margin="4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                       Text="{Binding EffectiveAuxiliaryViewerSummary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding EffectiveAuxiliaryViewerSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInspectionInputOutputView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOutputCompareViewerActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Text" Value="3D" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.Kind, ElementName=AuxiliaryViewerContentPin}"
                                                             Value="{x:Static workbenchViewModels:ViewerWorkspaceCandidateKind.HeightImage}">
                                                    <Setter Property="Text" Value="{Binding Localization.HeightImage}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ui:Button Margin="4,0,0,0"
                                           Padding="7,2"
                                           Content="×"
                                           Command="{Binding ClearAuxiliaryViewerPinCommand}"
                                           Visibility="{Binding CanEditAuxiliaryViewerPin, Converter={StaticResource BoolToVisibilityConverter}}"
                                           ToolTip="{Binding Localization.ViewerClearPin}"
                                           AutomationProperties.Name="{Binding Localization.ViewerClearPin}"
                                           AutomationProperties.AutomationId="ClearAuxiliaryViewerPin" />
                            </StackPanel>
                    <workbenchViews:ViewerPresentationBar x:Name="AuxiliaryViewerPresentationBar"
                                                                   Grid.Row="1"
                                                                   Grid.ColumnSpan="2"
                                                                   Margin="-7,4,-7,-4"
                                                                   DialogPlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                   SlotLabel="{Binding AuxiliaryViewerSlotLabel}" />

                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ContentControl x:Name="AuxiliaryViewerHost" />
                        <TextBlock x:Name="AuxiliaryEmptyText"
                                   MaxWidth="360"
                                   Margin="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding Localization.ViewerAuxiliaryNoOutput}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Border x:Name="ViewerComparedOutputNoGeometry"
                                MaxWidth="360"
                                Margin="18"
                                Padding="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                AutomationProperties.AutomationId="ViewerComparedOutputNoGeometry">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInspectionInputOutputView}" Value="True" />
                                                <Condition Binding="{Binding HasEffectiveOutputGeometry}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsInspectionFileView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionOutput.DisplayName}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding ViewerInspectionOutput.ResultStatus}"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,6,0,0"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ViewerInspectionOutput.HasEvidenceValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding ViewerInspectionOutput.ValueLabel}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThreeD.TextBrush}"
                                               Text="{Binding ViewerInspectionOutput.Value}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding ViewerInspectionOutput.Unit}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionOutput.Availability}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <workbenchViews:HeightProfileView x:Name="InlineHeightProfile" Grid.Row="4" ViewerHost="{Binding MainViewerContent, ElementName=Root}"
                                       Visibility="{Binding DataContext.ProfileVisible, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
    </ScrollViewer>
</UserControl>
