<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.ViewerWorkspaceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.AutomationId="ViewerWorkspace">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ViewerLayoutIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Opacity" Value="0.64" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerLayoutIconToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Opacity" Value="0.64" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ThreeD.PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ViewerLayoutToolbar"
                Margin="0,6,0,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.AutomationId="ViewerLayoutToolbar"
                AutomationProperties.Name="{Binding Localization.ViewerLayout}"
                AutomationProperties.HelpText="{Binding ViewerWorkspaceLayoutSummary}">
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource ViewerLayoutIconButtonStyle}"
                        Command="{Binding OpenHeightImageCommand}"
                        ToolTip="{Binding Localization.HeightImageViewOnly}"
                        AutomationProperties.Name="{Binding Localization.OpenHeightImage}"
                        AutomationProperties.AutomationId="OpenHeightImage">
                    <ui:SymbolIcon Width="17"
                                   Height="17"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                   Symbol="DataHistogram24" />
                </Button>
                <Border Width="1"
                        Height="22"
                        Margin="3,0,7,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ThreeD.DividerBrush}" />
                <ToggleButton Style="{StaticResource ViewerLayoutIconToggleStyle}"
                              Command="{Binding SetSingleViewerLayoutCommand}"
                              IsChecked="{Binding IsSingleViewerLayout, Mode=OneWay}"
                              ToolTip="{Binding Localization.ViewerReturnToSingle}"
                              AutomationProperties.Name="{Binding Localization.ViewerSingle}"
                              AutomationProperties.AutomationId="ViewerSingleLayout">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="16" Height="16">
                            <Path Data="M2,2 H14 V14 H2 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                  StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ViewerLayoutIconToggleStyle}"
                              Command="{Binding SplitViewerVerticallyCommand}"
                              IsChecked="{Binding IsSplitVerticalViewerLayout, Mode=OneWay}"
                              ToolTip="{Binding Localization.ViewerPresentationOnly}"
                              AutomationProperties.Name="{Binding Localization.ViewerSplitVertical}"
                              AutomationProperties.AutomationId="ViewerSplitVerticalLayout">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="16" Height="16">
                            <Path Data="M2,2 H14 V14 H2 Z M8,2 V14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                  StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ViewerLayoutIconToggleStyle}"
                              Command="{Binding SplitViewerHorizontallyCommand}"
                              IsChecked="{Binding IsSplitHorizontalViewerLayout, Mode=OneWay}"
                              ToolTip="{Binding Localization.ViewerPresentationOnly}"
                              AutomationProperties.Name="{Binding Localization.ViewerSplitHorizontal}"
                              AutomationProperties.AutomationId="ViewerSplitHorizontalLayout">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="16" Height="16">
                            <Path Data="M2,2 H14 V14 H2 Z M2,8 H14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                  StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ViewerLayoutIconToggleStyle}"
                              Command="{Binding PopOutViewerCommand}"
                              IsChecked="{Binding IsPopOutViewerLayout, Mode=OneWay}"
                              ToolTip="{Binding Localization.ViewerPresentationOnly}"
                              AutomationProperties.Name="{Binding Localization.ViewerPopOut}"
                              AutomationProperties.AutomationId="ViewerPopOutLayout">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="16" Height="16">
                            <Path Data="M2,5 V14 H11 M6,2 H14 V10 M8,8 L14,2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                  StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <StackPanel Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding ViewerWorkspace.HasAuxiliarySlot, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SymbolIcon Width="16"
                                   Height="16"
                                   Margin="4,0,5,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Symbol="Document24" />
                    <ComboBox Width="190"
                              MinHeight="25"
                              ItemsSource="{Binding ViewerWorkspaceCandidates}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding AuxiliaryViewerContentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{Binding Localization.ViewerAuxiliaryOutput}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid x:Name="ViewerGrid"
              Grid.Row="0"
              Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstRow" Height="*" />
                <RowDefinition x:Name="MiddleRow" Height="0" />
                <RowDefinition x:Name="SecondRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FirstColumn" Width="*" />
                <ColumnDefinition x:Name="MiddleColumn" Width="0" />
                <ColumnDefinition x:Name="SecondColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MainSlot"
                    Background="{DynamicResource ThreeD.ViewportBrush}"
                    BorderThickness="2"
                    CornerRadius="3"
                    PreviewMouseDown="MainSlot_PreviewMouseDown"
                    AutomationProperties.AutomationId="MainViewerSlot">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewerWorkspace.IsMainFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="7,4"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding ViewerWorkspace.HasAuxiliarySlot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Margin="0,0,6,0"
                                    Padding="5,2"
                                    Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                    CornerRadius="2">
                                <TextBlock FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ThreeD.InfoBrush}"
                                           Text="A" />
                            </Border>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                       Text="{Binding Localization.ViewerMainSlot}" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <ContentPresenter x:Name="MainViewerPresenter"
                                          Content="{Binding MainViewerContent, ElementName=Root}" />
                        <Border MaxWidth="560"
                                Margin="14,14,14,30"
                                Padding="9,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="#e6172435"
                                BorderBrush="#00f0e8"
                                BorderThickness="1"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Visibility="{Binding HeightImageViewer.HasLinkedCursor, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="SharedHeightCursorSummary">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Width="16"
                                               Height="16"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Foreground="#00f0e8"
                                               Symbol="CursorClick24" />
                                <TextBlock Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="#00f0e8"
                                           Text="{Binding Localization.SharedHeightCursor}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="9.5"
                                           Foreground="White"
                                           Text="{Binding HeightImageViewer.HoverSummary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ViewerInputFirstAction"
                                MaxWidth="430"
                                Margin="20"
                                Padding="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                AutomationProperties.AutomationId="ViewerInputFirstAction">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasSurfaceMatchEvidence}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon Width="32"
                                               Height="32"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                               Symbol="FolderOpen24" />
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding Localization.LoadInputActionTitle}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Opacity="0.78"
                                           Text="{Binding Localization.LoadInputActionDetail}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <ui:Button Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           Content="{Binding Localization.Open3DMap}"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Command="{Binding LoadC3DSourceCommand}"
                                           ToolTip="{Binding Localization.Open3DMapToolTip}"
                                           AutomationProperties.Name="{Binding Localization.Open3DMap}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="ViewerSplitter"
                          Background="{DynamicResource ThreeD.DividerBrush}"
                          ShowsPreview="True"
                          Visibility="Collapsed" />

            <Border x:Name="AuxiliarySlot"
                    Background="{DynamicResource ThreeD.ViewportBrush}"
                    BorderThickness="2"
                    CornerRadius="3"
                    Visibility="Collapsed"
                    PreviewMouseDown="AuxiliarySlot_PreviewMouseDown"
                    AutomationProperties.AutomationId="AuxiliaryViewerSlot">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewerWorkspace.IsAuxiliaryFocused}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="7,4"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,6,0"
                                    Padding="5,2"
                                    Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                    CornerRadius="2">
                                <TextBlock FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ThreeD.InfoBrush}"
                                           Text="B" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding Localization.ViewerAuxiliarySlot}" />
                                <TextBlock Margin="0,1,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding AuxiliaryViewerSummary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ContentControl x:Name="AuxiliaryViewerHost" />
                        <TextBlock x:Name="AuxiliaryEmptyText"
                                   MaxWidth="360"
                                   Margin="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding Localization.ViewerAuxiliaryNoOutput}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
