                                MaxWidth="460"
                                Margin="24"
                                Padding="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                AutomationProperties.AutomationId="ViewerOutputNoGeometry">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInspectionOutputView}" Value="True" />
                                                <Condition Binding="{Binding HasEffectiveOutputGeometry}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsReadOnlySampleView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionOutput.DisplayName}" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding ViewerInspectionOutput.ResultStatus}"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,7,0,0"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ViewerInspectionOutput.HasEvidenceValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding ViewerInspectionOutput.ValueLabel}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThreeD.TextBrush}"
                                               Text="{Binding ViewerInspectionOutput.Value}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding ViewerInspectionOutput.Unit}" />
                                </StackPanel>
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionOutput.Availability}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ViewerInputFirstAction"
                                MaxWidth="430"
                                Margin="20"
                                Padding="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                AutomationProperties.AutomationId="ViewerInputFirstAction">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasSurfaceMatchEvidence}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasViewerOnlyImport}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReadOnlySampleView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon Width="32"
                                               Height="32"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                               Symbol="FolderOpen24" />
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding Localization.LoadInputActionTitle}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <ui:Button Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           Content="{Binding Localization.Import3DData}"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Command="{Binding Import3DDataCommand}"
                                           ToolTip="{Binding Localization.Import3DDataToolTip}"
                                           AutomationProperties.Name="{Binding Localization.Import3DData}" />
                            </StackPanel>
                        </Border>
                        </Grid>
                        <workbenchViews:HeightImageViewerView x:Name="MainPaneHeightView" Presentation="{Binding Presentation, ElementName=MainViewerPresentationBar}" DisplayPresentation="{Binding Presentation, ElementName=MainViewerPresentationBar}" RoiCaptureCommand="{Binding DataContext.BeginTeachingSelectionCaptureCommand, ElementName=Root}" SelectionContext="{Binding SelectionContext, ElementName=Root}" DataContext="{Binding MainViewerPane.HeightImage}" UseEmbeddedChrome="True" Visibility="{Binding DataContext.MainViewerPane.IsHeight, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" ProfileState="{Binding Presentation.ProfileState, ElementName=MainViewerPresentationBar}" ProfilePickCommand="{Binding Presentation.ProfilePickCommand, ElementName=MainViewerPresentationBar}" />
                        <workbenchViews:HeightProfileView x:Name="MainPaneProfile" SelectionContext="{Binding SelectionContext, ElementName=Root}" UseEmbeddedChrome="True" ViewerHost="{Binding MainViewerContent, ElementName=Root}" Visibility="{Binding DataContext.MainViewerPane.IsSection, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="ViewerSplitter"
                          Background="Transparent"
                          ShowsPreview="True"
                          Visibility="Collapsed">
                <GridSplitter.Template><ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}"><Border x:Name="Divider" Width="1" Background="{DynamicResource ThreeD.DividerBrush}" HorizontalAlignment="Center" /></Grid>
                    <ControlTemplate.Triggers><Trigger Property="ResizeDirection" Value="Rows"><Setter TargetName="Divider" Property="Width" Value="Auto" /><Setter TargetName="Divider" Property="Height" Value="1" /><Setter TargetName="Divider" Property="HorizontalAlignment" Value="Stretch" /><Setter TargetName="Divider" Property="VerticalAlignment" Value="Center" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></GridSplitter.Template>
            </GridSplitter>

            <Border x:Name="AuxiliarySlot"
                    Background="{DynamicResource ThreeD.ViewportBrush}"
                    BorderThickness="0"
                    CornerRadius="3"
                    Visibility="Collapsed"
                    behaviors:PreviewMouseDownCommandBehavior.IsEnabled="True"
                    behaviors:PreviewMouseDownCommandBehavior.Command="{Binding FocusViewerWorkspaceSlotCommand}"
                    behaviors:PreviewMouseDownCommandBehavior.CommandParameter="viewer.auxiliary"
                    AutomationProperties.AutomationId="AuxiliaryViewerSlot">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="AuxiliaryViewerSlotHeader" Height="32" Padding="10,0,6,0" Background="#161B20" BorderBrush="#2A323B" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ContentControl x:Name="AuxiliaryPaneSourceRole" Content="{Binding AuxiliaryViewerPane}" ContentTemplate="{StaticResource ViewerPaneSourceRole}" />
                            <ComboBox x:Name="AuxiliaryViewerContentPin" Grid.Column="1" MinWidth="80" MaxWidth="360" MinHeight="0" Height="24" Padding="6,0" FontSize="12"
                                      HorizontalAlignment="Left" ItemsSource="{Binding ViewerWorkspaceCandidates}" SelectedValuePath="Id"
                                      SelectedValue="{Binding AuxiliaryViewerContentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Tag="{Binding AuxiliaryViewerPane.SourceName}" ToolTip="{Binding AuxiliaryViewerPane.SourcePath}" AutomationProperties.Name="{Binding AuxiliaryViewerPane.SourceName}" AutomationProperties.AutomationId="AuxiliaryViewerContentPin">
                                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource ViewerSourcePinStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CanEditAuxiliaryViewerPin}" Value="True" /><Condition Binding="{Binding IsFourViewerLayout}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                                </Style.Triggers></Style></ComboBox.Style>
                            </ComboBox>
                            <TextBlock x:Name="AuxiliaryViewerSourceSummary" Grid.Column="1" Margin="2,0,6,0" VerticalAlignment="Center" FontSize="12" Text="{Binding AuxiliaryViewerPane.SourceName}" ToolTip="{Binding AuxiliaryViewerPane.SourcePath}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=AuxiliaryViewerContentPin}" Value="Visible"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ContentControl Grid.Column="2" Content="{Binding AuxiliaryViewerPane}" ContentTemplate="{StaticResource ViewerPaneKindTabs}" AutomationProperties.AutomationId="AuxiliaryPaneKindTabs" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Button Width="28" Height="24" MinHeight="0" Padding="3" Background="Transparent" BorderThickness="0" Command="{Binding ToggleViewerPaneMaximizedCommand}" CommandParameter="viewer.auxiliary" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.MaximizeRestore, Korean='패널 확대 / 복원', English='Maximize / restore pane'}" AutomationProperties.AutomationId="AuxiliaryPaneMaximize"><ui:SymbolIcon Symbol="ArrowExpand24" FontSize="14" /></Button>
                                <ContentControl x:Name="AuxiliaryPaneMenuHost" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="AuxiliaryViewerKindLabel" Visibility="Collapsed"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="3D" /><Style.Triggers><DataTrigger Binding="{Binding AuxiliaryViewerPane.IsHeight}" Value="True"><Setter Property="Text" Value="{Binding Localization.HeightImage}" /></DataTrigger><DataTrigger Binding="{Binding AuxiliaryViewerPane.IsSection}" Value="True"><Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Viewer.Section, Korean='단면', English='Section'}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                    <workbenchViews:ViewerPresentationBar x:Name="AuxiliaryViewerPresentationBar"
                                                                   HeightImage="{Binding AuxiliaryViewerPane.HeightImage}"
                                                                   Panel.ZIndex="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                   Margin="8"
                                                                   SlotLabel="" />
                        <ContentControl x:Name="AuxiliaryViewerHost" />
                        <workbenchViews:HeightProfileView x:Name="AuxiliaryPaneProfile" SelectionContext="{Binding SelectionContext, ElementName=Root}" UseEmbeddedChrome="True" ViewerHost="{Binding ViewerHost, ElementName=AuxiliaryViewerPresentationBar}" Visibility="{Binding DataContext.AuxiliaryViewerPane.IsSection, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock x:Name="AuxiliaryEmptyText"
                                   MaxWidth="360"
                                   Margin="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding Localization.ViewerAuxiliaryNoOutput}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Border x:Name="ViewerComparedOutputNoGeometry"
                                MaxWidth="360"
                                Margin="18"
                                Padding="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThreeD.PanelBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                AutomationProperties.AutomationId="ViewerComparedOutputNoGeometry">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInspectionInputOutputView}" Value="True" />
                                                <Condition Binding="{Binding HasEffectiveOutputGeometry}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsReadOnlySampleView}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionOutput.DisplayName}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{Binding ViewerInspectionOutput.ResultStatus}"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,6,0,0"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ViewerInspectionOutput.HasEvidenceValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding ViewerInspectionOutput.ValueLabel}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThreeD.TextBrush}"
                                               Text="{Binding ViewerInspectionOutput.Value}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding ViewerInspectionOutput.Unit}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding ViewerInspectionOutput.Availability}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="FourSectionSlot" Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource ThreeD.ViewportBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1" AutomationProperties.AutomationId="FourSectionSlot">
                <Grid><Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Background="#1a2025" Margin="0,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentControl x:Name="SectionPaneSourceRole" Margin="10,0,0,0" Content="{Binding SectionViewerPane}" ContentTemplate="{StaticResource ViewerPaneSourceRole}" />
                        <TextBlock Grid.Column="1" Margin="2,0,6,0" VerticalAlignment="Center" FontSize="12" Text="{Binding SectionViewerPane.SourceName}" ToolTip="{Binding SectionViewerPane.SourcePath}" TextTrimming="CharacterEllipsis" />
                        <ContentControl Grid.Column="2" Content="{Binding SectionViewerPane}" ContentTemplate="{StaticResource ViewerPaneKindTabs}" AutomationProperties.AutomationId="FourSectionSlotKindTabs" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Width="28" Height="24" MinHeight="0" Padding="3" Background="Transparent" BorderThickness="0" Command="{Binding ToggleViewerPaneMaximizedCommand}" CommandParameter="viewer.section" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.MaximizeRestore, Korean='패널 확대 / 복원', English='Maximize / restore pane'}" AutomationProperties.AutomationId="FourSectionPaneMaximize"><ui:SymbolIcon Symbol="ArrowExpand24" FontSize="14" /></Button>
                            <ContentControl x:Name="FourSectionMenuHost" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl x:Name="FourSectionSlotThreeDHost" Visibility="{Binding DataContext.SectionViewerPane.IsThreeD, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <workbenchViews:ViewerPresentationBar x:Name="FourSectionSlotPresentationBar" HeightImage="{Binding SectionViewerPane.HeightImage}" DialogPlacementTarget="{Binding DisplaySettingsAnchor, ElementName=SectionPaneHeightView}" Panel.ZIndex="10" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding DataContext.SectionViewerPane.IsThreeD, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" ViewerHost="{Binding Content, ElementName=FourSectionSlotThreeDHost}" SlotLabel="" />
                        <workbenchViews:HeightProfileView x:Name="FourSectionProfile" SelectionContext="{Binding SelectionContext, ElementName=Root}" UseEmbeddedChrome="True" ViewerHost="{Binding MainViewerContent, ElementName=Root}" Visibility="{Binding DataContext.SectionViewerPane.IsSection, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <workbenchViews:HeightImageViewerView x:Name="SectionPaneHeightView" DisplayPresentation="{Binding Presentation, ElementName=FourSectionSlotPresentationBar}" Presentation="{Binding Presentation, ElementName=MainViewerPresentationBar}" SelectionContext="{Binding SelectionContext, ElementName=Root}" DataContext="{Binding SectionViewerPane.HeightImage}" UseEmbeddedChrome="True" Visibility="{Binding DataContext.SectionViewerPane.IsHeight, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" ProfileState="{Binding Presentation.ProfileState, ElementName=MainViewerPresentationBar}" ProfilePickCommand="{Binding Presentation.ProfilePickCommand, ElementName=MainViewerPresentationBar}" />
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="FourHeightSlot" Grid.Row="2" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource ThreeD.ViewportBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1" AutomationProperties.AutomationId="FourHeightSlot">
                <Grid><Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Background="#1a2025" Margin="0,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentControl x:Name="HeightPaneSourceRole" Margin="10,0,0,0" Content="{Binding HeightViewerPane}" ContentTemplate="{StaticResource ViewerPaneSourceRole}" />
                        <TextBlock Grid.Column="1" Margin="2,0,6,0" VerticalAlignment="Center" FontSize="12" Text="{Binding HeightViewerPane.SourceName}" ToolTip="{Binding HeightViewerPane.SourcePath}" TextTrimming="CharacterEllipsis" />
                        <ContentControl Grid.Column="2" Content="{Binding HeightViewerPane}" ContentTemplate="{StaticResource ViewerPaneKindTabs}" AutomationProperties.AutomationId="FourHeightSlotKindTabs" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Width="28" Height="24" MinHeight="0" Padding="3" Background="Transparent" BorderThickness="0" Command="{Binding ToggleViewerPaneMaximizedCommand}" CommandParameter="viewer.height" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.MaximizeRestore, Korean='패널 확대 / 복원', English='Maximize / restore pane'}" AutomationProperties.AutomationId="FourHeightPaneMaximize"><ui:SymbolIcon Symbol="ArrowExpand24" FontSize="14" /></Button>
                            <ContentControl x:Name="FourHeightMenuHost" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ContentControl x:Name="FourHeightSlotThreeDHost" Visibility="{Binding DataContext.HeightViewerPane.IsThreeD, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <workbenchViews:ViewerPresentationBar x:Name="FourHeightSlotPresentationBar" HeightImage="{Binding HeightViewerPane.HeightImage}" DialogPlacementTarget="{Binding DisplaySettingsAnchor, ElementName=FourHeightImageView}" Panel.ZIndex="10" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding DataContext.HeightViewerPane.IsThreeD, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" ViewerHost="{Binding Content, ElementName=FourHeightSlotThreeDHost}" SlotLabel="" />
                        <workbenchViews:HeightProfileView x:Name="FourHeightProfile" SelectionContext="{Binding SelectionContext, ElementName=Root}" UseEmbeddedChrome="True" ViewerHost="{Binding MainViewerContent, ElementName=Root}" Visibility="{Binding DataContext.HeightViewerPane.IsSection, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <workbenchViews:HeightImageViewerView x:Name="FourHeightImageView" DisplayPresentation="{Binding Presentation, ElementName=FourHeightSlotPresentationBar}" Presentation="{Binding Presentation, ElementName=MainViewerPresentationBar}" SelectionContext="{Binding SelectionContext, ElementName=Root}" DataContext="{Binding HeightViewerPane.HeightImage}" UseEmbeddedChrome="True" Visibility="{Binding DataContext.HeightViewerPane.IsHeight, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ViewerWorkspaceView}}, Converter={StaticResource BoolToVisibilityConverter}}" ProfileState="{Binding Presentation.ProfileState, ElementName=MainViewerPresentationBar}" ProfilePickCommand="{Binding Presentation.ProfilePickCommand, ElementName=MainViewerPresentationBar}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <workbenchViews:HeightProfileView x:Name="InlineHeightProfile" Grid.Row="4" ViewerHost="{Binding MainViewerContent, ElementName=Root}" SelectionContext="{Binding SelectionContext, ElementName=Root}">
            <workbenchViews:HeightProfileView.Style><Style TargetType="workbenchViews:HeightProfileView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.ProfileVisible, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding DataContext.MainViewerPane.IsSection, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding DataContext.ResultsWorkspace.IsSectionSelected, RelativeSource={RelativeSource AncestorType={x:Type workbenchViews:ToolRecipeWorkbenchView}}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></workbenchViews:HeightProfileView.Style>
        </workbenchViews:HeightProfileView>
    </Grid>
    </ScrollViewer>
</UserControl>
