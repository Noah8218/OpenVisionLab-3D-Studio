<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.ViewerWorkspaceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keyboard="clr-namespace:OpenVisionLab.ThreeD.Presentation.Behaviors;assembly=OpenVisionLab.ThreeD.Presentation"
             keyboard:ViewerKeyboardBehavior.IsEnabled="True"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             xmlns:host="clr-namespace:OpenVisionLab.ThreeD.Viewer.Hosting;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:workbenchViewModels="clr-namespace:OpenVisionLab.ThreeD.Shell.ViewModels.Workbench"
             xmlns:workbenchViews="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
             Margin="-2,-2,2,-2"
             AutomationProperties.AutomationId="ViewerWorkspace">
    <keyboard:ViewerKeyboardBehavior.Bindings>
        <KeyBinding Key="D1" Command="{Binding SetSingleViewerLayoutCommand}" />
        <KeyBinding Key="D2" Command="{Binding ShowHeightImageOnlyCommand}" />
        <KeyBinding Key="D3" Command="{Binding OpenHeightImageCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetSingleViewerLayoutCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SplitViewerVerticallyCommand}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SetFourViewerLayoutCommand}" />

        <KeyBinding Key="F" Command="{Binding Presentation.FitAllCommand, ElementName=MainViewerPresentationBar}" />
        <KeyBinding Key="R" Command="{Binding Presentation.RotateCommand, ElementName=MainViewerPresentationBar}" />
        <KeyBinding Key="M" Command="{Binding Presentation.MoveCommand, ElementName=MainViewerPresentationBar}" />
        <KeyBinding Key="Escape" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Cancel}" />
        <KeyBinding Key="Left" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Left}" />
        <KeyBinding Key="Right" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Right}" />
        <KeyBinding Key="Up" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Up}" />
        <KeyBinding Key="Down" Command="{Binding Presentation.ProfileActionCommand, ElementName=MainViewerPresentationBar}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Down}" />
    </keyboard:ViewerKeyboardBehavior.Bindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <ContextMenu x:Key="WorkbenchViewerContextMenu">
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.InputLoad, Korean='입력 불러오기', English='Load input'}" Command="{Binding Import3DDataCommand}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}" Command="{Binding Tag.FitAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="F" />
            <Separator />
            <MenuItem Tag="OrbitHere" Header="{views:ThreeDText Key=ThreeD.Viewer.OrbitHere, Korean='여기를 회전 중심으로', English='Orbit around here'}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.Rotate, Korean='회전', English='Rotate'}" Command="{Binding Tag.RotateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsChecked="{Binding Tag.IsRotateMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" InputGestureText="R" IsCheckable="True" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.Move, Korean='이동', English='Move'}" Command="{Binding Tag.MoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsChecked="{Binding Tag.IsMoveMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" InputGestureText="M" IsCheckable="True" />
            <Separator />
            <MenuItem Header="3D" Command="{Binding SetSingleViewerLayoutCommand}" IsCheckable="True" IsChecked="{Binding IsSingleViewerLayout, Mode=OneWay}" />
            <MenuItem Header="XY" Command="{Binding ShowHeightImageOnlyCommand}" IsCheckable="True" IsChecked="{Binding IsHeightImageOnlyViewerLayout, Mode=OneWay}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.SplitLayout, Korean='분할', English='Split'}" Command="{Binding OpenHeightImageCommand}" IsCheckable="True" IsChecked="{Binding IsSplitVerticalViewerLayout, Mode=OneWay}" />
            <Separator />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.Measure, Korean='두 점 측정', English='Measure two points'}" Command="{Binding Tag.MeasureCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsChecked="{Binding Tag.IsProfileMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" IsCheckable="True" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Profile.Repick, Korean='A/B 다시 선택', English='Repick A/B'}" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Repick}" Visibility="{Binding Tag.HasProfileEndpoints, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Header="A ↔ B" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Swap}" Visibility="{Binding Tag.HasProfileEndpoints, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Profile.Clear, Korean='현재 측정 지우기', English='Clear measurement'}" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Clear}" Visibility="{Binding Tag.ProfileState.Visible, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Separator />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.ColorDisplay, Korean='색상·표시', English='Color and display'}" Command="{Binding Tag.OpenDisplaySettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <ContextMenu x:Key="HeightImageContextMenu">
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.InputLoad, Korean='입력 불러오기', English='Load input'}" Command="{Binding Import3DDataCommand}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}" Command="{Binding HeightImageViewer.FitCommand}" InputGestureText="F" />
            <MenuItem Header="1:1" Command="{Binding HeightImageViewer.ActualPixelsCommand}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.HeightImage.AutoRange, Korean='높이 자동 범위', English='Auto height range'}" Command="{Binding HeightImageViewer.AutoRangeCommand}" />
            <Separator />
            <MenuItem Header="3D" Command="{Binding SetSingleViewerLayoutCommand}" IsCheckable="True" IsChecked="{Binding IsSingleViewerLayout, Mode=OneWay}" />
            <MenuItem Header="XY" Command="{Binding ShowHeightImageOnlyCommand}" IsCheckable="True" IsChecked="{Binding IsHeightImageOnlyViewerLayout, Mode=OneWay}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.SplitLayout, Korean='분할', English='Split'}" Command="{Binding OpenHeightImageCommand}" IsCheckable="True" IsChecked="{Binding IsSplitVerticalViewerLayout, Mode=OneWay}" />
            <Separator />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Viewer.Measure, Korean='두 점 측정', English='Measure two points'}" Command="{Binding Tag.MeasureCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsChecked="{Binding Tag.IsProfileMode, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" IsCheckable="True" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Profile.Repick, Korean='A/B 다시 선택', English='Repick A/B'}" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Repick}" Visibility="{Binding Tag.HasProfileEndpoints, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Header="A ↔ B" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Swap}" Visibility="{Binding Tag.HasProfileEndpoints, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Header="{views:ThreeDText Key=ThreeD.Profile.Clear, Korean='현재 측정 지우기', English='Clear measurement'}" Command="{Binding Tag.ProfileActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{x:Static host:ViewerHeightProfileAction.Clear}" Visibility="{Binding Tag.ProfileState.Visible, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
        </ContextMenu>
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
        <Style x:Key="ViewerLayoutIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Opacity" Value="0.64" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerLayoutIconToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Opacity" Value="0.64" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerPaneKindTabStyle" TargetType="ToggleButton" BasedOn="{StaticResource ViewerLayoutIconToggleStyle}">
            <Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" /><Setter Property="Height" Value="22" /><Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="7,0" /><Setter Property="FontSize" Value="11.5" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Surface" CornerRadius="3" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A333D" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C4243" /><Setter TargetName="Surface" Property="BorderBrush" Value="#6FB3A8" /><Setter Property="Foreground" Value="#C7ECE5" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#354E50" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ViewerSourcePinStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
                <TextBlock Text="{Binding ViewerName}" TextWrapping="Wrap" MaxWidth="392" ToolTip="{Binding SourcePath}" />
            </DataTemplate></Setter.Value></Setter>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="8,4" />
            </Style></Setter.Value></Setter>
            <Setter Property="Height" Value="24" /><Setter Property="MinHeight" Value="0" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="6,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Tag}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                        </Grid>
                    </Border>
                    <!-- 내용 없는 투명 클릭 면이 암시적 스타일에서 0x0으로 줄지 않도록 한다. -->
                    <ToggleButton Style="{x:Null}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Focusable="False" Background="Transparent" BorderThickness="0">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="420" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="#37424E" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#252D36" /><Setter TargetName="Surface" Property="BorderBrush" Value="#3A4552" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="ViewerPaneKindTabs">
            <Border BorderBrush="#37424E" BorderThickness="1" CornerRadius="4" Padding="2" Background="#141920" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource ViewerPaneKindTabStyle}" Content="3D" Command="{Binding SetKindCommand}" CommandParameter="{x:Static workbenchViewModels:ViewerPaneKind.ThreeD}" IsChecked="{Binding IsThreeD, Mode=OneWay}" AutomationProperties.AutomationId="PaneKindThreeD" />
                <ToggleButton Style="{StaticResource ViewerPaneKindTabStyle}" Content="{views:ThreeDText Key=ThreeD.Viewer.Height, Korean='높이', English='Height'}" Command="{Binding SetKindCommand}" CommandParameter="{x:Static workbenchViewModels:ViewerPaneKind.Height}" IsChecked="{Binding IsHeight, Mode=OneWay}" AutomationProperties.AutomationId="PaneKindHeight" />
                <ToggleButton Style="{StaticResource ViewerPaneKindTabStyle}" Content="{views:ThreeDText Key=ThreeD.Viewer.Section, Korean='단면', English='Section'}" Command="{Binding SetKindCommand}" CommandParameter="{x:Static workbenchViewModels:ViewerPaneKind.Section}" IsChecked="{Binding IsSection, Mode=OneWay}" AutomationProperties.AutomationId="PaneKindSection" />
            </StackPanel></Border>
        </DataTemplate>
        <DataTemplate x:Key="ViewerPaneSourceRole">
            <Border Margin="0,0,0,0" Padding="0" VerticalAlignment="Center"
                    Background="Transparent"
                    Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Viewer.Input, Korean='입력', English='Input'}" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsOutputSource}" Value="True">
                                <Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Viewer.Output, Korean='결과', English='Output'}" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
        <Style x:Key="ViewerCameraLinkToggleStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ViewerLayoutIconToggleStyle}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Padding" Value="8,4" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCompactChrome, ElementName=Root}" Value="True"><Setter Property="Width" Value="28" /><Setter Property="Padding" Value="3,0" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ViewerRoiScopeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ViewerLayoutIconToggleStyle}">
            <Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="28" /><Setter Property="Padding" Value="6,0" /><Setter Property="Margin" Value="0" /><Setter Property="FontSize" Value="12" /><Setter Property="Height" Value="24" />
        </Style>
        <Style x:Key="ViewerModeToggleStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ViewerLayoutIconToggleStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ViewerCombinedModeToggleStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ViewerModeToggleStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="ViewerWorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Focusable="False">
    <Grid x:Name="ViewerWorkspaceSurface" Height="{Binding ActualHeight, ElementName=Root}" Background="{DynamicResource ThreeD.PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="ViewerCommandRows" Grid.Row="0" Margin="2,2,-2,-2" MinHeight="36" VerticalAlignment="Top" LastChildFill="False">
            <ToggleButton x:Name="ViewerHelpButton" DockPanel.Dock="Right" Style="{StaticResource ViewerLayoutIconToggleStyle}" Margin="0,6,8,6" Command="{Binding ToggleViewerHelpCommand}" IsChecked="{Binding IsViewerHelpOpen, Mode=OneWay}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.Help, Korean='조작 방법', English='Viewer controls'}" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Viewer.Help, Korean='조작 방법', English='Viewer controls'}" AutomationProperties.AutomationId="ViewerHelpButton"><ui:SymbolIcon Symbol="Keyboard24" FontSize="16" /></ToggleButton>
            <Border x:Name="ViewerLayoutToolbar"
                    Margin="8,6,8,6"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Panel.ZIndex="10"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="ViewerLayoutToolbar"
                    AutomationProperties.Name="{Binding Localization.ViewerLayout}"
                    AutomationProperties.HelpText="{Binding ViewerWorkspaceLayoutSummary}">
                <WrapPanel VerticalAlignment="Center">
                    <ToggleButton x:Name="ThreeDViewerMode"
                                  Style="{StaticResource ViewerLayoutIconToggleStyle}"
                                  Command="{Binding SetSingleViewerLayoutCommand}"
                                  IsChecked="{Binding IsSingleViewerLayout, Mode=OneWay}"
                                  ToolTip="{Binding Localization.ViewerReturnToSingle}"
                                  AutomationProperties.Name="{Binding Localization.ViewerSingle}"
                                  AutomationProperties.AutomationId="ViewerSingleLayout"
                                  ><ui:SymbolIcon Symbol="Square24" FontSize="17" /></ToggleButton>
                    <ToggleButton x:Name="HeightOnlyViewerMode" Visibility="Collapsed"
                                  Style="{StaticResource ViewerModeToggleStyle}"
                                  Command="{Binding ShowHeightImageOnlyCommand}"
                                  IsChecked="{Binding IsHeightImageOnlyViewerLayout, Mode=OneWay}"
                                  Content="XY"
                                  ToolTip="{Binding Localization.HeightImageViewOnly}"
                                  AutomationProperties.Name="{Binding Localization.HeightImage}"
                                  AutomationProperties.AutomationId="ViewerHeightImageOnly" />
                    <ToggleButton x:Name="ThreeDHeightViewerMode"
                                  Style="{StaticResource ViewerLayoutIconToggleStyle}"
                                  Command="{Binding SplitViewerVerticallyCommand}"
                                  IsChecked="{Binding IsSplitVerticalViewerLayout, Mode=OneWay}"
                                  ToolTip="{views:ThreeDText Key=ThreeD.Viewer.TwoSideBySide, Korean='좌우 2개', English='Two side by side'}"
                                  AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Viewer.TwoSideBySide, Korean='좌우 2개', English='Two side by side'}"
                                  AutomationProperties.AutomationId="OpenHeightImage">
                        <StackPanel><ui:SymbolIcon Symbol="SplitVertical24" FontSize="17" /><TextBlock x:Name="HeightImageModeLabel" Visibility="Collapsed" Text="{views:ThreeDText Key=ThreeD.Viewer.SplitLayout, Korean='좌우 2개', English='Two side by side'}" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ViewerLayoutIconToggleStyle}" Command="{Binding SplitViewerHorizontallyCommand}" IsChecked="{Binding IsSplitHorizontalViewerLayout, Mode=OneWay}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.TwoStacked, Korean='상하 2개', English='Two stacked'}" AutomationProperties.AutomationId="ViewerHorizontalLayoutButton" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Viewer.TwoStacked, Korean='상하 2개', English='Two stacked'}"><ui:SymbolIcon Symbol="SplitHorizontal24" FontSize="17" /></ToggleButton>
