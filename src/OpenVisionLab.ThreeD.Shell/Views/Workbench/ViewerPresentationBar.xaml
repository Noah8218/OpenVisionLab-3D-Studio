<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.ViewerPresentationBar"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             AutomationProperties.AutomationId="ViewerPresentationBar">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
        <Style x:Key="ViewerPresentationComboBoxItemStyle"
               TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerPresentationDiagnosticItemStyle"
               TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource ViewerPresentationComboBoxItemStyle}">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                    <Setter Property="Opacity" Value="0.78" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerPresentationComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ViewerPresentationComboBoxItemStyle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerPresentationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="4,2,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerPresentationToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewportToolFocusVisualStyle" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
                <Border Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource ThreeD.FocusBrush}" CornerRadius="5" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ViewportToolButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerPresentationButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D3DC" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ViewportToolFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A333D" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A333D" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="Command" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ViewportToolToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ViewerPresentationToggleStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D3DC" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ViewportToolFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4">
                            <Grid><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border x:Name="SelectedLine" Height="2" VerticalAlignment="Bottom" Background="#6FB3A8" Visibility="Collapsed" /></Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A333D" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C4243" /><Setter Property="Foreground" Value="#C7ECE5" /><Setter TargetName="SelectedLine" Property="Visibility" Value="Visible" /></Trigger>
                            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True" /><Condition Property="IsChecked" Value="False" /></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#2A333D" /><Setter Property="Foreground" Value="White" /></MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerDisplaySegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource ViewportToolToggleStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ViewerDisplaySegmentGroupStyle" TargetType="Border">
            <Setter Property="Padding" Value="2" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A4552" /><Setter Property="Background" Value="#14191E" />
            <Setter Property="CornerRadius" Value="6" /><Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ViewerRoiToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ViewportToolToggleStyle}">
            <Style.Triggers><Trigger Property="Command" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ViewerRangeTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Presentation.HasDisplaySettingsRangeError, ElementName=Root}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerPaletteItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="4" /><Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="#181D23" BorderBrush="#3A4552" BorderThickness="1" CornerRadius="6"><ContentPresenter HorizontalAlignment="Stretch" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /><Setter TargetName="Surface" Property="Background" Value="#1F2D2D" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Height" /><Condition Binding="{Binding DataContext.CanSelectHeightColorMap, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False" /></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Grayscale" /><Condition Binding="{Binding DataContext.CanSelectGrayscaleColorMap, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False" /></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Solid" /><Condition Binding="{Binding DataContext.CanSelectSolidColorMap, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False" /></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Thermal" /><Condition Binding="{Binding DataContext.CanSelectThermalColorMap, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False" /></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="ColorVisionAssist" /><Condition Binding="{Binding DataContext.CanSelectColorVisionAssistColorMap, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False" /></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding}" Value="Deviation" /><Condition Binding="{Binding DataContext.CanSelectDeviationColorMap, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False" /></MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="ViewportToolsSurface" Padding="3" CornerRadius="8"
            Background="#DC161B20"
            BorderBrush="#33404C"
            BorderThickness="1">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Margin="0,0,8,0"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                       Text="{Binding SlotLabel, ElementName=Root}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource ViewportToolToggleStyle}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.Rotate, Korean='회전', English='Rotate'}" IsChecked="{Binding Presentation.IsRotateMode, ElementName=Root, Mode=OneWay}" Command="{Binding Presentation.RotateCommand, ElementName=Root}" AutomationProperties.AutomationId="ViewerRotate" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Viewer.Rotate, Korean='회전', English='Rotate'}"><ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" /></ToggleButton>
                <ToggleButton Style="{StaticResource ViewportToolToggleStyle}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.Move, Korean='이동', English='Move'}" IsChecked="{Binding Presentation.IsMoveMode, ElementName=Root, Mode=OneWay}" Command="{Binding Presentation.MoveCommand, ElementName=Root}" AutomationProperties.AutomationId="ViewerMove" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Viewer.Move, Korean='이동', English='Move'}"><ui:SymbolIcon Symbol="ArrowMove24" FontSize="16" /></ToggleButton>
                <Border Width="1" Margin="3,4,5,4" Background="#3A4552" />
                <ToggleButton Style="{StaticResource ViewerRoiToggleStyle}" IsChecked="{Binding Presentation.IsRoiMode, ElementName=Root, Mode=OneWay}" Command="{Binding RoiCaptureCommand, ElementName=Root}" ToolTipService.ShowOnDisabled="True" ToolTip="{views:ThreeDText Key=ThreeD.Workbench.Roi.CaptureSelectedToolAccessible, Korean='선택 도구 ROI 그리기 또는 교체', English='Draw or replace selected tool ROI'}" AutomationProperties.AutomationId="ViewerRoiCapture" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><ui:SymbolIcon Symbol="SelectAllOff24" FontSize="16" /></ToggleButton>
                <ToggleButton Style="{StaticResource ViewportToolToggleStyle}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.ProfileTool, Korean='단면 A-B 지정', English='Section A-B'}" IsChecked="{Binding Presentation.IsProfileMode, ElementName=Root, Mode=OneWay}" Command="{Binding Presentation.MeasureCommand, ElementName=Root}" AutomationProperties.AutomationId="ViewerMeasure" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Viewer.ProfileTool, Korean='단면 A-B 지정', English='Section A-B'}"><ui:SymbolIcon Symbol="Line24" FontSize="16" /></ToggleButton>
                <Border Width="1" Margin="3,4,5,4" Background="#3A4552" />
                <Button Style="{StaticResource ViewportToolButtonStyle}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}" Command="{Binding Presentation.FitAllCommand, ElementName=Root}" AutomationProperties.AutomationId="ViewerFit" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}"><ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="16" /></Button>
                <Button Style="{StaticResource ViewportToolButtonStyle}" ToolTip="{views:ThreeDText Key=ThreeD.Viewer.FitRoi, Korean='ROI 맞춤', English='Fit ROI'}" Command="{Binding FitRoiCommand, ElementName=Root}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="ViewerFitRoiDirect" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"><ui:SymbolIcon Symbol="Target24" FontSize="16" /></Button>
            </StackPanel>
            <Button x:Name="ViewerDisplaySettingsButton"
                    Style="{StaticResource ViewportToolButtonStyle}"
                    Margin="0"
                    Command="{Binding Presentation.OpenDisplaySettingsCommand, ElementName=Root}"
                    ToolTip="{views:ThreeDText Key=ThreeD.R19.ViewerColorOptions, Korean='색상·높이 표시', English='Color and height display'}"
                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                    AutomationProperties.AutomationId="ViewerDisplaySettingsButton">
                <ui:SymbolIcon Symbol="Color24" FontSize="16" />
            </Button>
            <Popup x:Name="ViewerDisplaySettingsPopup"
                   DataContext="{Binding Presentation, ElementName=Root}"
                   IsOpen="{Binding IsDisplaySettingsOpen, Mode=TwoWay}"
                   Placement="Bottom"
                   VerticalOffset="6"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   Opened="OnViewerDisplaySettingsPopupOpened"
                   Closed="OnViewerDisplaySettingsPopupClosed"
                   FocusManager.IsFocusScope="True"
                   KeyboardNavigation.TabNavigation="Cycle"
                   AutomationProperties.AutomationId="ViewerDisplaySettingsPopup">
                <Popup.Style><Style TargetType="Popup"><Setter Property="PlacementTarget" Value="{Binding ElementName=ViewerDisplaySettingsButton}" /><Style.Triggers><DataTrigger Binding="{Binding DialogPlacementTarget.IsVisible, ElementName=Root}" Value="True"><Setter Property="PlacementTarget" Value="{Binding DialogPlacementTarget, ElementName=Root}" /></DataTrigger></Style.Triggers></Style></Popup.Style>
                <Grid Width="300"
                      FocusManager.IsFocusScope="True"
                      KeyboardNavigation.TabNavigation="Cycle"
                      PreviewKeyDown="OnDisplaySettingsPreviewKeyDown"
                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.ViewerDisplaySettings, Korean='표시 설정', English='Display settings'}">
                    <Grid.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding Presentation.CloseDisplaySettingsCommand, ElementName=Root}" />
                    </Grid.InputBindings>
                    <Border Width="300"
                            MaxWidth="300"
                            MaxHeight="600"
                            Padding="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#20272F"
                            BorderBrush="#4E5D6B"
                            BorderThickness="1"
                            CornerRadius="10"
                            AutomationProperties.AutomationId="ViewerDisplaySettingsDialog">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="ViewerDisplayOptionsScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                <ScrollViewer.Resources>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate></Setter.Value></Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel x:Name="ViewerDisplayOptionsContent" Width="{Binding ViewportWidth, ElementName=ViewerDisplayOptionsScroll}">
                                <TextBlock Margin="0,0,0,10"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.PrimaryTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.R19.ViewerColorOptions, Korean='색상·높이 표시', English='Color and height display'}" />
                                <StackPanel Margin="0,0,0,12" Visibility="{Binding ShowTextureOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock FontWeight="SemiBold" Text="{views:ThreeDText Key=ThreeD.Texture.Title, Korean='2D 텍스처 영상', English='2D texture image'}" />
                                    <TextBlock Margin="0,4,0,6" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Texture.Guidance, Korean='높이맵 전체에 정렬된 영상을 선택하세요. 왼쪽 위를 기준으로 표시하며 검사값은 바뀌지 않습니다.', English='Use an image aligned to the full height map, with a top-left origin. Display only; inspection values stay unchanged.'}" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource ViewerPresentationButtonStyle}" Margin="0,0,6,0" Command="{Binding LoadTextureCommand}" Content="{views:ThreeDText Key=ThreeD.Texture.SelectButton, Korean='영상 선택…', English='Choose image…'}" FocusVisualStyle="{StaticResource ViewportToolFocusVisualStyle}" AutomationProperties.AutomationId="ViewerLoadTexture" />
                                        <Button Style="{StaticResource ViewerPresentationButtonStyle}" Margin="0" Command="{Binding ClearTextureCommand}" Content="{views:ThreeDText Key=ThreeD.Texture.Remove, Korean='제거', English='Remove'}" FocusVisualStyle="{StaticResource ViewportToolFocusVisualStyle}" AutomationProperties.AutomationId="ViewerClearTexture" />
                                    </WrapPanel>
                                    <CheckBox Margin="0,8,0,4" IsChecked="{Binding TextureVisible, Mode=TwoWay}" IsEnabled="{Binding HasTexture}" Content="{views:ThreeDText Key=ThreeD.Texture.Visible, Korean='텍스처 표시', English='Show texture'}" AutomationProperties.AutomationId="ViewerTextureVisible" />
                                    <TextBlock Text="{Binding TextureName}" TextWrapping="Wrap" FontSize="11" AutomationProperties.AutomationId="ViewerTextureName" />
                                    <TextBlock Text="{Binding TextureError}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.WarningBrush}" FontSize="11" AutomationProperties.AutomationId="ViewerTextureError" />
                                </StackPanel>
                                <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Viewer.Color, Korean='색상', English='Color'}" />
                                <ListBox x:Name="PaletteSelector" Background="Transparent" BorderThickness="0" Padding="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ItemContainerStyle="{StaticResource ViewerPaletteItemStyle}"
                                          ItemsSource="{Binding Presentation.DisplayColorMaps, ElementName=Root}"
                                          SelectedItem="{Binding Presentation.SelectedColorMap, ElementName=Root, Mode=TwoWay}"
                                          IsEnabled="{Binding Presentation.CanSelectColorMap, ElementName=Root}"
                                          AutomationProperties.Name="{Binding DataContext.Localization.ViewerPalette, ElementName=Root}" AutomationProperties.AutomationId="ViewerPalette">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                        <Border Height="12" Margin="0,0,0,3" CornerRadius="3">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#739BC2" /><Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Height"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Offset="0" Color="#294CEB" /><GradientStop Offset="0.35" Color="#21BDAC" /><GradientStop Offset="0.7" Color="#FCCA47" /><GradientStop Offset="1" Color="#F47A48" /></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Grayscale"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Offset="0" Color="#171B20" /><GradientStop Offset="1" Color="#ECF1F6" /></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Thermal"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Offset="0" Color="#191C3B" /><GradientStop Offset="0.5" Color="#EA425B" /><GradientStop Offset="1" Color="#FDEA99" /></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="ColorVisionAssist"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Offset="0" Color="#00204d" /><GradientStop Offset="0.25" Color="#414d6b" /><GradientStop Offset="0.5" Color="#7c7b78" /><GradientStop Offset="0.75" Color="#bcaf6f" /><GradientStop Offset="1" Color="#ffea46" /></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="Deviation"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Offset="0" Color="#427BD4" /><GradientStop Offset="0.5" Color="#E9EDF2" /><GradientStop Offset="1" Color="#E55B5B" /></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Text"><Setter.Value><MultiBinding Converter="{StaticResource ViewerRuntimeTextConverter}"><Binding /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></Setter.Value></Setter>
                                            <Style.Triggers><DataTrigger Binding="{Binding}" Value="ColorVisionAssist"><Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Viewer.ColorVisionAssist, Korean='색각 보조', English='Color vision assist'}" /></DataTrigger><DataTrigger Binding="{Binding}" Value="Solid"><Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Viewer.MonochromeShading, Korean='단색', English='Solid'}" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style></TextBlock>
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="0,12,0,5" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Viewer.GeometryStyle, Korean='표현', English='Geometry'}" />
                                <Border Style="{StaticResource ViewerDisplaySegmentGroupStyle}"><StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.Viewer.Surface, Korean='면', English='Surface'}" IsChecked="{Binding IsSurfaceStyle, Mode=TwoWay}" IsEnabled="{Binding CanSelectSurfaceStyle}" AutomationProperties.AutomationId="ViewerGeometrySurface" />
                                    <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.Viewer.Points, Korean='점', English='Points'}" IsChecked="{Binding IsPointsStyle, Mode=TwoWay}" IsEnabled="{Binding CanSelectPointsStyle}" AutomationProperties.AutomationId="ViewerGeometryPoints" />
                                </StackPanel></Border>
                        <TextBlock Margin="0,12,0,5"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Viewer.HeightRangeColor, Korean='높이 범위 (색상)', English='Height range (color)'}" />
                        <Border Style="{StaticResource ViewerDisplaySegmentGroupStyle}"><StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ViewerHeightRangeAuto" Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.Legend.AutoFull, Korean='자동·전체', English='Auto full'}" IsChecked="{Binding IsAutomaticRange, Mode=TwoWay}" AutomationProperties.AutomationId="ViewerHeightRangeAuto" />
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.Legend.AutoDistribution, Korean='자동·분포', English='Distribution'}" IsChecked="{Binding IsDistributionRange, Mode=TwoWay}" AutomationProperties.AutomationId="ViewerHeightRangeDistribution" />
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.Legend.Region, Korean='영역 기준', English='Region'}" IsChecked="{Binding IsRegionRange, Mode=TwoWay}" IsEnabled="{Binding CanUseRegionRange}" AutomationProperties.AutomationId="ViewerHeightRangeRegion" />
                            <RadioButton x:Name="ViewerHeightRangeManual" Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.R19.HeightRangeManual, Korean='수동', English='Manual'}" IsChecked="{Binding IsManualRange, Mode=TwoWay}" AutomationProperties.AutomationId="ViewerHeightRangeManual" />
                        </StackPanel></Border>
                        <TextBlock Text="{Binding RegionRangeUnavailableReason}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource ThreeD.MutedTextBrush}" FontSize="11" />
                        <CheckBox x:Name="ViewerHeightRangeLinkedToggle" Margin="0,8,0,4" FontSize="12" IsChecked="{Binding IsHeightRangeLinked, Mode=TwoWay}" Content="{views:ThreeDText Key=ThreeD.Legend.Link, Korean='같은 맵 창의 범위 공유', English='Share range between views of the same map'}" AutomationProperties.AutomationId="ViewerHeightRangeLinked" />
                        <CheckBox Margin="0,0,0,4" FontSize="12" IsChecked="{Binding KeepHeightRange, Mode=TwoWay}" Content="{views:ThreeDText Key=ThreeD.Legend.Pin, Korean='파일을 넘겨도 범위 유지', English='Keep range when changing files'}" AutomationProperties.AutomationId="ViewerHeightRangePinned" />
                        <CheckBox Margin="0,0,0,4" FontSize="12" IsChecked="{Binding HighlightOutsideRange, Mode=TwoWay}" Content="{views:ThreeDText Key=ThreeD.Legend.Outside, Korean='범위 밖 별도 색으로 강조', English='Highlight values outside the range'}" AutomationProperties.AutomationId="ViewerHeightRangeOutside" />
                        <TextBlock Margin="0,8,0,4" FontSize="12" Text="{views:ThreeDText Key=ThreeD.Legend.ColorStyle, Korean='색 방식', English='Colour style'}" />
                        <Border Style="{StaticResource ViewerDisplaySegmentGroupStyle}"><StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.Legend.Continuous, Korean='연속', English='Continuous'}" IsChecked="{Binding IsContinuousHeightColor, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.Legend.Bands, Korean='등높이 띠', English='Height bands'}" IsChecked="{Binding IsBandedHeightColor, Mode=TwoWay}" AutomationProperties.AutomationId="ViewerHeightColorBands" />
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="{views:ThreeDText Key=ThreeD.Legend.Tolerance, Korean='허용 범위 색', English='Tolerance colours'}" IsChecked="{Binding IsToleranceHeightColor, Mode=TwoWay}" IsEnabled="{Binding CanUseMeasurementColor}" AutomationProperties.AutomationId="ViewerHeightColorTolerance" />
                        </StackPanel></Border>
                        <TextBlock Text="{Binding MeasurementColorGuidance}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource ThreeD.MutedTextBrush}" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding IsBandedHeightColor, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{views:ThreeDText Key=ThreeD.Legend.BandCount, Korean='띠 수', English='Bands'}" />
                            <ComboBox x:Name="ViewerHeightBandCountSelector" Width="76" ItemsSource="{Binding HeightBandCounts}" SelectedItem="{Binding HeightBandCount, Mode=TwoWay}" ItemContainerStyle="{StaticResource ViewerPresentationComboBoxItemStyle}" AutomationProperties.AutomationId="ViewerHeightBandCount" />
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding HeightBandInterval}" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0" Visibility="{Binding CanEditManualHeightRange, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,5"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeMinimum, Korean='최솟값 (raw)', English='Minimum (raw)'}" />
                                <TextBox x:Name="ViewerHeightRangeMinimumInput"
                                         Style="{StaticResource ViewerRangeTextBoxStyle}"
                                         Text="{Binding DraftHeightRangeMinimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditManualHeightRange}"
                                         AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.HeightRangeMinimum, Korean='최솟값 (raw)', English='Minimum (raw)'}"
                                         AutomationProperties.AutomationId="ViewerHeightRangeMinimumInput" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,5"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeMaximum, Korean='최댓값 (raw)', English='Maximum (raw)'}" />
                                <TextBox x:Name="ViewerHeightRangeMaximumInput"
                                         Style="{StaticResource ViewerRangeTextBoxStyle}"
                                         Text="{Binding DraftHeightRangeMaximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditManualHeightRange}"
                                         AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.HeightRangeMaximum, Korean='최댓값 (raw)', English='Maximum (raw)'}"
                                         AutomationProperties.AutomationId="ViewerHeightRangeMaximumInput" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.MutedTextBrush}" AutomationProperties.AutomationId="ViewerDefaultHeightRange">
                            <Run Text="{Binding HeightRangeSummaryCaption, Mode=OneWay}" /><Run Text="{Binding DefaultHeightRangeSummary, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Margin="0,4,0,0" Visibility="{Binding CanEditManualHeightRange, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button MinWidth="48" Height="24" MinHeight="24" Margin="0,0,6,0" Padding="7,0" Style="{StaticResource ViewerPresentationButtonStyle}" Content="{views:ThreeDText Key=ThreeD.R19.Cancel, Korean='취소', English='Cancel'}" Command="{Binding CancelDisplaySettingsCommand}" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.Cancel, Korean='취소', English='Cancel'}" AutomationProperties.AutomationId="ViewerDisplaySettingsCancel" />
                            <Button MinWidth="68" Height="24" MinHeight="24" Margin="0" Padding="7,0" Style="{StaticResource ViewerPresentationButtonStyle}" Content="{views:ThreeDText Key=ThreeD.Viewer.ApplyRange, Korean='범위 적용', English='Apply range'}" Command="{Binding ApplyDisplaySettingsCommand}" IsDefault="True" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.Apply, Korean='적용', English='Apply'}" AutomationProperties.AutomationId="ViewerDisplaySettingsApply" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,5"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Viewer.HeightEmphasisRatio, Korean='높이 강조 (3D 표시 비율)', English='Height emphasis (3D ratio)'}" />
                        <Border Style="{StaticResource ViewerDisplaySegmentGroupStyle}" AutomationProperties.AutomationId="ViewerHeightEmphasis"><StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="1×" IsChecked="{Binding IsHeightEmphasis1, Mode=TwoWay}" AutomationProperties.AutomationId="ViewerHeightEmphasis1" />
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="2×" IsChecked="{Binding IsHeightEmphasis2, Mode=TwoWay}" AutomationProperties.AutomationId="ViewerHeightEmphasis2" />
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="3×" IsChecked="{Binding IsHeightEmphasis3, Mode=TwoWay}" AutomationProperties.AutomationId="ViewerHeightEmphasis3" />
                            <RadioButton Style="{StaticResource ViewerDisplaySegmentStyle}" Content="5×" IsChecked="{Binding IsHeightEmphasis5, Mode=TwoWay}" AutomationProperties.AutomationId="ViewerHeightEmphasis5" />
                        </StackPanel></Border>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightEmphasisInvalid, Korean='높이 강조 값이 올바르지 않습니다.', English='The height emphasis value is not valid.'}"
                                   Visibility="{Binding HasDisplaySettingsEmphasisError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="ViewerHeightEmphasisValidation" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeInvalid, Korean='최솟값은 최댓값보다 작아야 합니다.', English='Minimum must be less than maximum.'}"
                                   Visibility="{Binding HasDisplaySettingsRangeError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="ViewerHeightRangeValidation" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeStale, Korean='입력이나 범위가 바뀌었습니다. 설정을 다시 여세요.', English='The input or range changed. Reopen display settings.'}"
                                   Visibility="{Binding HasDisplaySettingsStaleError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="ViewerHeightRangeStale" />
                        <CheckBox Margin="0,12,0,6" FontSize="12" IsChecked="{Binding FloorGridVisible, Mode=TwoWay}" Content="{views:ThreeDText Key=ThreeD.Viewer.FloorGrid, Korean='3D 바닥 격자와 눈금', English='3D floor grid and ticks'}" AutomationProperties.AutomationId="ViewerFloorGrid" />
                        <CheckBox FontSize="12" IsChecked="{Binding HeightImage.ShowInvalidCells, ElementName=Root, Mode=TwoWay}" Content="{views:ThreeDText Key=ThreeD.Viewer.MissingHatch, Korean='결측 셀 빗금 (높이 보기)', English='Missing-cell hatch (height view)'}" AutomationProperties.AutomationId="ViewerMissingHatch" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
