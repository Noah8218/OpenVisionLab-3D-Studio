<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.ViewerPresentationBar"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             AutomationProperties.AutomationId="ViewerPresentationBar">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
        <Style x:Key="ViewerPresentationComboBoxItemStyle"
               TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerPresentationDiagnosticItemStyle"
               TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource ViewerPresentationComboBoxItemStyle}">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                    <Setter Property="Opacity" Value="0.78" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerPresentationComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ViewerPresentationComboBoxItemStyle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerPresentationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="4,2,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerPresentationToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="4,2,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewerRangeTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Presentation.HasDisplaySettingsRangeError, ElementName=Root}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Padding="5,2"
            Background="{DynamicResource ThreeD.PanelBrush}"
            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
            BorderThickness="0">

        <WrapPanel VerticalAlignment="Center">
            <TextBlock Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                       Text="{Binding SlotLabel, ElementName=Root}" />
            <WrapPanel Margin="0,0,8,0" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource ViewerPresentationToggleStyle}" Content="{views:ThreeDText Key=ThreeD.Viewer.Rotate, Korean='회전', English='Rotate'}" IsChecked="{Binding Presentation.IsRotateMode, ElementName=Root, Mode=OneWay}" Command="{Binding Presentation.RotateCommand, ElementName=Root}" AutomationProperties.AutomationId="ViewerRotate" />
                <ToggleButton Style="{StaticResource ViewerPresentationToggleStyle}" Content="{views:ThreeDText Key=ThreeD.Viewer.Move, Korean='이동', English='Move'}" IsChecked="{Binding Presentation.IsMoveMode, ElementName=Root, Mode=OneWay}" Command="{Binding Presentation.MoveCommand, ElementName=Root}" AutomationProperties.AutomationId="ViewerMove" />
                <ToggleButton Style="{StaticResource ViewerPresentationToggleStyle}" Content="{views:ThreeDText Key=ThreeD.Viewer.Measure, Korean='두 점 측정', English='Measure'}" IsChecked="{Binding Presentation.IsProfileMode, ElementName=Root, Mode=OneWay}" Command="{Binding Presentation.MeasureCommand, ElementName=Root}" AutomationProperties.AutomationId="ViewerMeasure" />
                <Button Style="{StaticResource ViewerPresentationButtonStyle}" Margin="3,0,0,0" Content="{views:ThreeDText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}" Command="{Binding Presentation.FitAllCommand, ElementName=Root}" AutomationProperties.AutomationId="ViewerFit" />
            </WrapPanel>
            <Expander x:Name="ViewerSlotDisplayOptionsExpander"
                      IsExpanded="False"
                      HorizontalContentAlignment="Stretch"
                      Header="{views:ThreeDText Key=ThreeD.R19.ViewerColorOptions, Korean='색상·표시', English='Color and overlays'}"
                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.ViewerColorOptions, Korean='색상·표시', English='Color and overlays'}"
                      AutomationProperties.AutomationId="ViewerSlotDisplayOptionsExpander">
                <WrapPanel Margin="4,3,4,2"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsExpanded, ElementName=ViewerSlotDisplayOptionsExpander, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="0,0,4,0"
                                Orientation="Horizontal"
                                Visibility="{Binding Presentation.CanSelectColorMap, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding Localization.ViewerPalette}" />
                        <ComboBox x:Name="PaletteSelector"
                                  Width="96"
                                  Style="{StaticResource ViewerPresentationComboBoxStyle}"
                                  ItemsSource="{Binding Presentation.AvailableColorMaps, ElementName=Root}"
                                  SelectedItem="{Binding Presentation.SelectedColorMap, ElementName=Root, Mode=TwoWay}"
                                  IsEnabled="{Binding Presentation.CanSelectColorMap, ElementName=Root}"
                                  AutomationProperties.Name="{Binding Localization.ViewerPalette}"
                                  AutomationProperties.AutomationId="ViewerPalette">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ViewerRuntimeTextConverter}">
                                                <Binding />
                                                <Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Margin="3,0,3,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{Binding Localization.ViewerOverlays}" />
                    <ToggleButton Style="{StaticResource ViewerPresentationToggleStyle}"
                                  Content="{Binding Localization.ViewerSelectionOverlay}"
                                  IsChecked="{Binding Presentation.SelectionOverlayVisible, ElementName=Root, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Localization.ViewerSelectionOverlay}"
                                  AutomationProperties.AutomationId="ViewerSelectionOverlay" />
                    <ToggleButton Style="{StaticResource ViewerPresentationToggleStyle}"
                                  Content="{Binding Localization.ViewerResultOverlay}"
                                  IsChecked="{Binding Presentation.ResultOverlayVisible, ElementName=Root, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Localization.ViewerResultOverlay}"
                                  AutomationProperties.AutomationId="ViewerResultOverlay" />
                    <ToggleButton Style="{StaticResource ViewerPresentationToggleStyle}"
                                  Content="{Binding Localization.ViewerMeasurementOverlay}"
                                  IsChecked="{Binding Presentation.MeasurementVisible, ElementName=Root, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Localization.ViewerMeasurementOverlay}"
                                  AutomationProperties.AutomationId="ViewerMeasurementOverlay" />
                    <Button x:Name="ViewerDisplaySettingsButton"
                            MinHeight="30"
                            Margin="6,0,0,0"
                            Padding="9,2"
                            Style="{StaticResource ViewerPresentationButtonStyle}"
                            Content="{views:ThreeDText Key=ThreeD.R19.ViewerDisplaySettings, Korean='표시 설정', English='Display settings'}"
                            Visibility="{Binding Presentation.HasC3DHeightColorRange, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding Presentation.OpenDisplaySettingsCommand, ElementName=Root}"
                            ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}"
                            AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                            AutomationProperties.AutomationId="ViewerDisplaySettingsButton" />
                </WrapPanel>
            </Expander>
            <Popup x:Name="ViewerDisplaySettingsPopup"
                   DataContext="{Binding Presentation, ElementName=Root}"
                   IsOpen="{Binding IsDisplaySettingsOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding DialogPlacementTarget, ElementName=Root}"
                   Placement="Center"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   Opened="OnViewerDisplaySettingsPopupOpened"
                   Closed="OnViewerDisplaySettingsPopupClosed"
                   FocusManager.IsFocusScope="True"
                   KeyboardNavigation.TabNavigation="Cycle"
                   AutomationProperties.AutomationId="ViewerDisplaySettingsPopup">
                <Grid Width="{Binding DialogPlacementTarget.ActualWidth, ElementName=Root}"
                      Height="{Binding DialogPlacementTarget.ActualHeight, ElementName=Root}"
                      Background="{DynamicResource ThreeD.DialogBackdropBrush}"
                      FocusManager.IsFocusScope="True"
                      KeyboardNavigation.TabNavigation="Cycle"
                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.ViewerDisplaySettings, Korean='표시 설정', English='Display settings'}">
                    <Grid.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding CancelDisplaySettingsCommand}" />
                    </Grid.InputBindings>
                    <Border Width="540"
                            MaxWidth="540"
                            MaxHeight="600"
                            Margin="24"
                            Padding="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ThreeD.PanelBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            AutomationProperties.AutomationId="ViewerDisplaySettingsDialog">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                <TextBlock Margin="0,0,0,18"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.PrimaryTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.R19.ViewerDisplaySettings, Korean='표시 설정', English='Display settings'}" />
                        <TextBlock Margin="0,0,0,5"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeMode, Korean='범위 모드', English='Range mode'}" />
                        <ComboBox x:Name="ViewerHeightRangeMode"
                                  MinHeight="34"
                                  Style="{StaticResource ViewerPresentationComboBoxStyle}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding DraftHeightRangeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.HeightRangeMode, Korean='범위 모드', English='Range mode'}"
                                  AutomationProperties.AutomationId="ViewerHeightRangeMode">
                            <ComboBoxItem Tag="auto" Content="{views:ThreeDText Key=ThreeD.R19.HeightRangeAutomatic, Korean='자동', English='Automatic'}" />
                            <ComboBoxItem Tag="manual" Content="{views:ThreeDText Key=ThreeD.R19.HeightRangeManual, Korean='수동', English='Manual'}" />
                        </ComboBox>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,5"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeMinimum, Korean='최솟값 (raw)', English='Minimum (raw)'}" />
                                <TextBox x:Name="ViewerHeightRangeMinimumInput"
                                         Style="{StaticResource ViewerRangeTextBoxStyle}"
                                         Text="{Binding DraftHeightRangeMinimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditManualHeightRange}"
                                         AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.HeightRangeMinimum, Korean='최솟값 (raw)', English='Minimum (raw)'}"
                                         AutomationProperties.AutomationId="ViewerHeightRangeMinimumInput" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,5"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                           Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeMaximum, Korean='최댓값 (raw)', English='Maximum (raw)'}" />
                                <TextBox x:Name="ViewerHeightRangeMaximumInput"
                                         Style="{StaticResource ViewerRangeTextBoxStyle}"
                                         Text="{Binding DraftHeightRangeMaximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditManualHeightRange}"
                                         AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.HeightRangeMaximum, Korean='최댓값 (raw)', English='Maximum (raw)'}"
                                         AutomationProperties.AutomationId="ViewerHeightRangeMaximumInput" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,14,0,5"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightEmphasis, Korean='높이 강조', English='Height emphasis'}" />
                        <ComboBox MinHeight="34"
                                  Style="{StaticResource ViewerPresentationComboBoxStyle}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding DraftHeightEmphasis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.HeightEmphasis, Korean='높이 강조', English='Height emphasis'}"
                                  AutomationProperties.AutomationId="ViewerHeightEmphasis">
                            <ComboBoxItem Tag="1" Content="1×" />
                            <ComboBoxItem Tag="2" Content="2×" />
                            <ComboBoxItem Tag="3" Content="3×" />
                            <ComboBoxItem Tag="5" Content="5×" />
                        </ComboBox>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightEmphasisInvalid, Korean='높이 강조 값이 올바르지 않습니다.', English='The height emphasis value is not valid.'}"
                                   Visibility="{Binding HasDisplaySettingsEmphasisError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="ViewerHeightEmphasisValidation" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeInvalid, Korean='최솟값은 최댓값보다 작아야 합니다.', English='Minimum must be less than maximum.'}"
                                   Visibility="{Binding HasDisplaySettingsRangeError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="ViewerHeightRangeValidation" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.WarningBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeStale, Korean='입력이나 범위가 바뀌었습니다. 설정을 다시 여세요.', English='The input or range changed. Reopen display settings.'}"
                                   Visibility="{Binding HasDisplaySettingsStaleError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="ViewerHeightRangeStale" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.R19.HeightRangeDisplayOnly, Korean='화면 표시만 변경합니다. 레시피를 저장하거나 검사를 실행하지 않습니다.', English='Changes the display only. Does not save the recipe or run inspection.'}" />
                                </StackPanel>
                            </ScrollViewer>
                        <StackPanel Grid.Row="1"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button MinWidth="72"
                                    MinHeight="30"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ViewerPresentationButtonStyle}"
                                    Content="{views:ThreeDText Key=ThreeD.R19.Cancel, Korean='취소', English='Cancel'}"
                                    Command="{Binding CancelDisplaySettingsCommand}"
                                    AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.Cancel, Korean='취소', English='Cancel'}"
                                    AutomationProperties.AutomationId="ViewerDisplaySettingsCancel" />
                            <Button MinWidth="72"
                                    MinHeight="30"
                                    Style="{StaticResource ViewerPresentationButtonStyle}"
                                    Content="{views:ThreeDText Key=ThreeD.R19.Apply, Korean='적용', English='Apply'}"
                                    Command="{Binding ApplyDisplaySettingsCommand}"
                                    IsDefault="True"
                                    AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.Apply, Korean='적용', English='Apply'}"
                                    AutomationProperties.AutomationId="ViewerDisplaySettingsApply" />
                        </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Popup>
        </WrapPanel>
    </Border>
</UserControl>
