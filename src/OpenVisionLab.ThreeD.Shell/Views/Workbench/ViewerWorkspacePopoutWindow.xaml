<Window x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.ViewerWorkspacePopoutWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workbenchViews="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
        Width="960"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        Title="{Binding Localization.ViewerPopOutTitle}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThreeD.PanelBrush}"
        AutomationProperties.AutomationId="AuxiliaryViewerPopout">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="10,7"
                Background="{DynamicResource ThreeD.CommandBarBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,7,0"
                        Padding="5,2"
                        Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                        CornerRadius="2">
                    <TextBlock FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                               Text="B" />
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThreeD.TextBrush}"
                               Text="{Binding Localization.ViewerAuxiliarySlot}" />
                    <ComboBox Width="320"
                              ItemsSource="{Binding ViewerWorkspaceCandidates}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding AuxiliaryViewerContentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{Binding AuxiliaryViewerSummary}"
                              AutomationProperties.Name="{Binding Localization.ViewerAuxiliaryOutput}"
                              AutomationProperties.AutomationId="AuxiliaryViewerContentPin" />
                </StackPanel>
                <Button Grid.Column="2"
                        Margin="8,0,8,0"
                        Padding="8,4"
                        Command="{Binding ClearAuxiliaryViewerPinCommand}"
                        Content="×"
                        ToolTip="{Binding Localization.ViewerClearPin}"
                        AutomationProperties.Name="{Binding Localization.ViewerClearPin}"
                        AutomationProperties.AutomationId="ClearAuxiliaryViewerPin" />
                <Button Grid.Column="3"
                        Padding="8,4"
                        Command="{Binding SetSingleViewerLayoutCommand}"
                        Content="{Binding Localization.ViewerReturnToSingle}"
                        AutomationProperties.Name="{Binding Localization.ViewerReturnToSingle}" />
            </Grid>
        </Border>
        <workbenchViews:ViewerPresentationBar Grid.Row="1"
                                              Margin="0"
                                              ViewerViewModel="{Binding ViewerHost.Content.ViewModel, ElementName=Root}"
                                              SlotLabel="{Binding Localization.ViewerAuxiliarySlot}" />
        <Grid Grid.Row="2"
              Background="{DynamicResource ThreeD.ViewportBrush}"
              PreviewMouseDown="ViewerSurface_PreviewMouseDown">
            <ContentControl x:Name="ViewerHost" />
            <TextBlock x:Name="EmptyText"
                       MaxWidth="420"
                       Margin="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                       Text="{Binding AuxiliaryViewerSummary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
