                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Workbench.IsSourceReadyForRecipe}" Value="True" />
                                                <Condition Binding="{Binding Workbench.HasSelectedPipelineStep}" Value="False" />
                                                <Condition Binding="{Binding Workbench.IsC3DSourceLoading}" Value="False" />
                                                <Condition Binding="{Binding Workbench.IsSelectionCandidateActive}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThreeD.TextBrush}"
                                           Text="{Binding Localization.NoRecipeStepSelected}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{Binding Localization.NoRecipeStepSelectedDetail}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2"
                                Margin="0"
                                Padding="8,6"
                                Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding Workbench.IsSelectionCandidateActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="TeachingSelectionCaptureRibbon">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThreeD.InfoBrush}"
                                               Text="{Binding Workbench.TeachingSelectionCaptureTitle}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{Binding Workbench.TeachingSelectionCaptureProgress}" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center">
                                    <Button Margin="0,0,5,0" MinWidth="30" MinHeight="30"
                                            Command="{Binding Workbench.UndoTeachingSelectionCaptureCommand}"
                                            Visibility="{Binding Workbench.IsTeachingSelectionCaptureActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                            AutomationProperties.Name="{Binding Workbench.Localization.UndoLastPoint}">
                                        <ui:SymbolIcon Width="14" Height="14" Symbol="ArrowUndo24" />

                                    </Button>
                                    <Button Margin="0,0,5,0"
                                            Command="{Binding Workbench.CancelTeachingSelectionCaptureCommand}"
                                            AutomationProperties.AutomationId="CancelSelectionCandidate"
                                            AutomationProperties.Name="{Binding Workbench.Localization.Cancel}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Width="14" Height="14" Margin="0,0,5,0" Symbol="Dismiss24" />
                                            <TextBlock Text="{Binding Workbench.Localization.Cancel}" />
                                        </StackPanel>
                                    </Button>
                                    <ui:Button Appearance="Primary"
                                               ToolTip="{views:ThreeDText Key=ThreeD.Command.ApplySelectionTip, Korean='티칭 선택 적용 (Enter)', English='Apply the teaching selection (Enter)'}"
                                               Command="{Binding Workbench.ApplyTeachingSelectionCaptureCommand}"
                                               AutomationProperties.AutomationId="ApplyOrientedBox3D"
                                               AutomationProperties.Name="{Binding Workbench.Localization.ApplySelection}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Width="14" Height="14" Margin="0,0,5,0" Symbol="Checkmark24" />
                                            <TextBlock Text="{Binding Workbench.Localization.ApplySelection}" />
                                        </StackPanel>
                                    </ui:Button>
                                </WrapPanel>
                                <Border Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,5,0,0"
                                        Padding="6,4"
                                        Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                        BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Visibility="{Binding Workbench.IsTeachingGridRectangleEditorEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="GridRectangleCandidateCoordinates"
                                        AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.ExactGridCandidateCoordinatesAccessible, Korean='영역 좌표 (셀)', English='Region coordinates (cells)'}">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,12,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThreeD.InfoBrush}"
                                                   Text="{views:ThreeDText Key=ThreeD.Workspace.ExactGridCandidate, Korean='영역 좌표 (셀) · X=열, Z=행', English='Region coordinates (cells) · X=column, Z=row'}" />
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       Text="{views:ThreeDText Key=ThreeD.Workspace.StartColumnCompact, Korean='시작 X', English='Start X'}" />
                                            <TextBlock Margin="4,0,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Workbench.TeachingGridRectangleColumn}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       Text="{views:ThreeDText Key=ThreeD.Workspace.StartRowCompact, Korean='시작 Z', English='Start Z'}" />
                                            <TextBlock Margin="4,0,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Workbench.TeachingGridRectangleRow}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       Text="{views:ThreeDText Key=ThreeD.Workspace.ColumnCountCompact, Korean='X 길이', English='X length'}" />
                                            <TextBlock Margin="4,0,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Workbench.TeachingGridRectangleColumnCount}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                                       Text="{views:ThreeDText Key=ThreeD.Workspace.RowCountCompact, Korean='Z 길이', English='Z length'}" />
                                            <TextBlock Margin="4,0,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Workbench.TeachingGridRectangleRowCount}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <workbench:ViewerWorkspaceView Grid.Row="3"
                                               MainViewerContent="{Binding ViewerContent, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}"
                                               DataContext="{Binding Workbench}"
                                               Loaded="ViewerWorkspaceSurface_Loaded" />

</Grid>
        </dock:OpenVisionDockWorkspaceView.ViewerContent>

        <dock:OpenVisionDockWorkspaceView.ResultsContent>
            <workbench:ResultsWorkspaceView DataContext="{Binding}" IsDedicatedResultsLayout="{Binding IsResultsWorkspaceSelected, Mode=OneWay}" IsAuthoringLayout="{Binding IsAuthoringWorkspaceSelected, Mode=OneWay}" />
        </dock:OpenVisionDockWorkspaceView.ResultsContent>

        <dock:OpenVisionDockWorkspaceView.ToolInspectorContent>
            <workbench:SelectedToolWorkspaceView DataContext="{Binding Workbench}" />
        </dock:OpenVisionDockWorkspaceView.ToolInspectorContent>

        <dock:OpenVisionDockWorkspaceView.EvidenceContent>
            <workbench:RecipePipelineReviewView DataContext="{Binding Workbench}"
                                               IsValidationSamplesExternal="{Binding RunRecordContext.IsValidateWorkspaceSelected, RelativeSource={RelativeSource Self}}"
                                                RunRecordSteps="{Binding DataContext.InspectionSteps, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}"
                                                RunRecordSummary="{Binding DataContext.InspectionStepSummary, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}"
                                                RunRecordContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}"
                                                AutomationProperties.AutomationId="WorkbenchBottomPanel" />
        </dock:OpenVisionDockWorkspaceView.EvidenceContent>

        <dock:OpenVisionDockWorkspaceView.OutputCompareContent>
            <workbench:OutputCompareView DataContext="{Binding Workbench}" />
        </dock:OpenVisionDockWorkspaceView.OutputCompareContent>

        <dock:OpenVisionDockWorkspaceView.DisplayedOutputsContent>
            <workbench:DisplayedOutputsView DataContext="{Binding Workbench}" />
        </dock:OpenVisionDockWorkspaceView.DisplayedOutputsContent>

        <dock:OpenVisionDockWorkspaceView.LinkedViewContent>
            <workbench:RunLogView DataContext="{Binding Workbench}" />
        </dock:OpenVisionDockWorkspaceView.LinkedViewContent>

        <dock:OpenVisionDockWorkspaceView.ProfileContent>
            <workbench:HeightProfileView />
        </dock:OpenVisionDockWorkspaceView.ProfileContent>

        <dock:OpenVisionDockWorkspaceView.FitDiagnosticsContent>
            <workbench:LineFitDiagnosticsView />
        </dock:OpenVisionDockWorkspaceView.FitDiagnosticsContent>

        <dock:OpenVisionDockWorkspaceView.IntersectionEvidenceContent>
            <workbench:LineIntersectionEvidenceView />
        </dock:OpenVisionDockWorkspaceView.IntersectionEvidenceContent>
        <dock:OpenVisionDockWorkspaceView.CorrespondenceEvidenceContent>
            <workbench:LandmarkCorrespondenceEvidenceView />
        </dock:OpenVisionDockWorkspaceView.CorrespondenceEvidenceContent>
        </dock:OpenVisionDockWorkspaceView>
            <Border x:Name="TeachingDataDock" Grid.Column="1" Background="{DynamicResource ThreeD.PanelBrush}" Visibility="{Binding IsAuthoringWorkspaceSelected, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
<Border.Style><Style TargetType="Border"><Setter Property="Width" Value="232" /><Style.Triggers>
<DataTrigger Binding="{Binding IsTeachingDataExpanded, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="False"><Setter Property="Width" Value="28" /></DataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True" /><Condition Binding="{Binding IsTeachingDataPinned, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Width" Value="28" /></MultiDataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True" /><Condition Binding="{Binding IsTeachingDataPinned, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True" /><Condition Binding="{Binding IsTeachingDataExpanded, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Width" Value="248" /></MultiDataTrigger>
</Style.Triggers></Style></Border.Style>
<Grid>
<Grid x:Name="TeachingDataInline"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers>
<DataTrigger Binding="{Binding IsTeachingDataExpanded, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True" /><Condition Binding="{Binding IsTeachingDataPinned, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
</Style.Triggers></Style></Grid.Style>
<Grid.RowDefinitions><RowDefinition Height="35" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<ContentControl Content="{Binding}" ContentTemplate="{StaticResource TeachingDataHeader}" Tag="{Binding RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" />
<workbench:RecipeDataView x:Name="RecipeDataSurface" Grid.Row="1" />
</Grid>
<ToggleButton x:Name="TeachingDataToggle" VerticalAlignment="Top" Height="84" Width="28" IsChecked="{Binding IsTeachingDataExpanded, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}, Mode=TwoWay}" AutomationProperties.AutomationId="TeachingDataToggle" AutomationProperties.Name="데이터">
<ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource TeachingDataHeaderButton}"><Setter Property="Visibility" Value="Collapsed" /><Setter Property="Background" Value="{DynamicResource ThreeD.PanelHeaderBrush}" /><Style.Triggers>
<DataTrigger Binding="{Binding IsTeachingDataExpanded, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True" /><Condition Binding="{Binding IsTeachingDataPinned, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
</Style.Triggers></Style></ToggleButton.Style>
<TextBlock Text="{views:ThreeDText Key=ThreeD.Data.Title, Korean='데이터', English='Data'}" FontSize="12"><TextBlock.LayoutTransform><RotateTransform Angle="270" /></TextBlock.LayoutTransform></TextBlock>
</ToggleButton>
</Grid>
</Border>
<Popup x:Name="TeachingDataPopup" PlacementTarget="{Binding ElementName=TeachingDataDock}" Placement="Custom" CustomPopupPlacementCallback="{x:Static workbench:ToolRecipeWorkbenchView.TeachingDataPlacement}" AllowsTransparency="True" StaysOpen="False" Opened="OnTeachingDataPopupOpened" Closed="OnTeachingDataPopupClosed">
<Popup.Style><Style TargetType="Popup"><Setter Property="IsOpen" Value="False" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
<Condition Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True" /><Condition Binding="{Binding IsTeachingDataExpanded, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True" /><Condition Binding="{Binding IsTeachingDataPinned, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="False" /><Condition Binding="{Binding IsAuthoringWorkspaceSelected}" Value="True" />
</MultiDataTrigger.Conditions><Setter Property="IsOpen" Value="True" /></MultiDataTrigger></Style.Triggers></Style></Popup.Style>
<Border x:Name="TeachingDataPopupSurface" Width="250" Height="{Binding ActualHeight, ElementName=TeachingDataDock}" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DataPopupBorderBrush}" BorderThickness="1" CornerRadius="4" KeyDown="OnTeachingDataPopupKeyDown">
<Grid><Grid.RowDefinitions><RowDefinition Height="35" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<ContentControl x:Name="TeachingDataPopupHeader" ContentTemplate="{StaticResource TeachingDataHeader}" />
<workbench:RecipeDataView x:Name="RecipeDataPopupSurface" Grid.Row="1" IsTeachingGallery="True" />
</Grid>
</Border>
</Popup>
        </Grid>

        <Border x:Name="ToolLibraryOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="29"
                Background="#99000000"
                Visibility="Collapsed"
                PreviewKeyDown="OnToolLibraryOverlayPreviewKeyDown"
                AutomationProperties.AutomationId="ToolLibraryOverlay">
            <Border Width="690"
                    MaxHeight="720"
                    Margin="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ThreeD.PanelBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Focusable="True"
                    FocusManager.IsFocusScope="True"
                    FocusManager.FocusedElement="{Binding ElementName=CloseToolLibraryButton}"
                    IsVisibleChanged="OnToolLibraryScopeIsVisibleChanged"
                    KeyboardNavigation.DirectionalNavigation="Cycle"
                    KeyboardNavigation.TabNavigation="Cycle"
                    AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.ToolPicker, Korean='검사 도구 선택', English='Choose inspection tool'}">
                <Grid>
                    <workbench:ToolLibraryView x:Name="ToolLibraryDialogContent"
                                               DataContext="{Binding Workbench}" />
                    <ui:Button x:Name="CloseToolLibraryButton"
                               Width="30"
                               Height="30"
                               Margin="0,7,7,0"
                               Padding="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Click="CloseToolLibraryButton_Click"
                               ToolTip="{views:ThreeDText Key=ThreeD.Command.CloseToolPicker, Korean='도구 선택 닫기', English='Close tool picker'}"
                               AutomationProperties.AutomationId="CloseToolLibrary"
                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Command.CloseToolPicker, Korean='도구 선택 닫기', English='Close tool picker'}" />
                </Grid>
            </Border>
        </Border>

        <Border Grid.RowSpan="2"
                Panel.ZIndex="30"
                Background="#99000000"
                Visibility="{Binding Workbench.IsRecipeInfoEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                TextElement.Foreground="{DynamicResource ThreeD.TextBrush}" AutomationProperties.AutomationId="RecipeInfoEditorOverlay">
            <Border Width="540"
                    MaxHeight="560"
                    Margin="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ThreeD.PanelBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Cycle"
                    Focusable="True"
                    IsVisibleChanged="OnRecipeInfoEditorScopeIsVisibleChanged"
                    FocusManager.IsFocusScope="True"
                    FocusManager.FocusedElement="{Binding ElementName=RecipeInfoInspectionTargetField}"
                    AutomationProperties.Name="{Binding Localization.RecipeInfoEditTitle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="20,14"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Localization.RecipeInfoEditTitle}" />
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,18">
                            <TextBlock Margin="0,0,0,12"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding Workbench.RecipeName}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,5" Style="{DynamicResource ThreeD.FieldLabelTextStyle}" Text="{Binding Localization.RecipeInfoTarget}" />
                            <TextBox x:Name="RecipeInfoInspectionTargetField"
                                     Margin="0,0,0,12"
                                     Height="32"
                                     MaxLength="500"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Workbench.RecipeInfoInspectionTargetDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="RecipeInfoInspectionTargetEditor"
                                     AutomationProperties.Name="{Binding Localization.RecipeInfoTarget}" />
                            <TextBlock Margin="0,0,0,5" Style="{DynamicResource ThreeD.FieldLabelTextStyle}" Text="{Binding Localization.RecipeInfoCategory}" />
                            <TextBox x:Name="RecipeInfoCategoryField"
                                     Margin="0,0,0,12"
                                     Height="32"
                                     MaxLength="500"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Workbench.RecipeInfoCategoryDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="RecipeInfoCategoryEditor"
                                     AutomationProperties.Name="{Binding Localization.RecipeInfoCategory}" />
                            <TextBlock Margin="0,0,0,5" Style="{DynamicResource ThreeD.FieldLabelTextStyle}" Text="{Binding Localization.RecipeInfoDescription}" />
                            <TextBox Margin="0,0,0,8"
                                     MinHeight="96"
                                     MaxHeight="150"
                                     MaxLength="500"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Workbench.RecipeInfoDescriptionDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="RecipeInfoDescriptionEditor"
                                     AutomationProperties.Name="{Binding Localization.RecipeInfoDescription}" />
                            <TextBlock Margin="0,0,0,0"
                                       Foreground="{DynamicResource ThreeD.FailBrush}"
                                       Text="{Binding Workbench.RecipeInfoEditError}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="RecipeInfoEditError" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2"
                            Padding="20,12"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Content="{Binding Localization.Cancel}"
                                       Command="{Binding Workbench.CancelRecipeInfoEditorCommand}"
                                       AutomationProperties.Name="{Binding Localization.Cancel}" />
                            <ui:Button Appearance="Primary"
                                       Content="{Binding Localization.RecipeInfoApply}"
                                       Command="{Binding Workbench.ApplyRecipeInfoCommand}"
                                       AutomationProperties.AutomationId="ApplyRecipeInfo"
                                       AutomationProperties.Name="{Binding Localization.RecipeInfoApply}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
