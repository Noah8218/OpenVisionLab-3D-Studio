<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.ToolRecipeWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="clr-namespace:OpenVisionLab.ThreeD.Docking.Controls;assembly=OpenVisionLab.ThreeD.Docking.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:models="clr-namespace:OpenVisionLab.ThreeD.Shell.ViewModels.Workbench"
             AutomationProperties.AutomationId="ToolRecipeWorkbench">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="TeachingDataHeaderButton" TargetType="ToggleButton">
<Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers>
<Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderButtonSurface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderButtonSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderButtonSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<DataTemplate x:Key="TeachingDataHeader">
<Border Height="35" Padding="8,0,4,0" Background="{DynamicResource ThreeD.PanelHeaderBrush}" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Image24" FontSize="14" Margin="0,0,5,0" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" /><TextBlock Text="{views:ThreeDText Key=ThreeD.Data.Title, Korean='데이터', English='Data'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThreeD.TextBrush}" />
<Border Margin="6,0,0,0" Padding="5,1" CornerRadius="8" Background="{DynamicResource ThreeD.PanelAlternateBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Tag.IsCompactLayout, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Workbench.GalleryDataCount}" FontSize="10" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" /></Border>
</StackPanel>
<ToggleButton Grid.Column="2" Style="{StaticResource TeachingDataHeaderButton}" IsChecked="{Binding Tag.IsTeachingDataPinned, RelativeSource={RelativeSource AncestorType=ContentControl}, Mode=OneWay}" Click="OnTeachingDataPinClicked" ToolTip="데이터 패널 고정 또는 접기" AutomationProperties.Name="데이터 패널 고정 또는 접기"><ui:SymbolIcon Symbol="Pin24" FontSize="14" /></ToggleButton>
<ToggleButton Grid.Column="3" Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Style="{StaticResource TeachingDataHeaderButton}" Click="OnTeachingDataHeaderAction" ToolTip="데이터 패널 메뉴 또는 닫기" AutomationProperties.Name="데이터 패널 메뉴 또는 닫기">
<ToggleButton.ContextMenu><ContextMenu><MenuItem Header="접기" Click="OnTeachingDataCollapseClicked" /></ContextMenu></ToggleButton.ContextMenu>
<ui:SymbolIcon FontSize="14"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="MoreHorizontal24" /><Style.Triggers><DataTrigger Binding="{Binding Tag.IsCompactLayout, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="True"><Setter Property="Symbol" Value="Dismiss16" /></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon>
</ToggleButton>
</Grid></Border>
</DataTemplate>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="N"
                    Modifiers="Control"
                    Command="{Binding Workbench.NewTeachingRecipeCommand}" />
        <KeyBinding Key="O"
                    Modifiers="Control"
                    Command="{Binding Workbench.OpenTeachingRecipeCommand}" />
        <KeyBinding Key="S"
                    Modifiers="Control"
                    Command="{Binding Workbench.SaveTeachingRecipeCommand}" />
        <KeyBinding Key="S"
                    Modifiers="Control+Shift"
                    Command="{Binding Workbench.SaveTeachingRecipeAsCommand}" />
        <KeyBinding Key="Escape"
                    Command="{Binding Workbench.CancelCurrentWorkspaceCommand}" />
        <KeyBinding Key="Enter"
                    Command="{Binding Workbench.ApplyTeachingSelectionCaptureCommand}" />
        <KeyBinding Key="O"
                    Modifiers="Control+Shift"
                    Command="{Binding Workbench.LoadC3DSourceCommand}" />
        <KeyBinding Key="F5"
                    Command="{Binding Workbench.RunCurrentWorkspaceCommand}" />
        <KeyBinding Key="Enter"
                    Modifiers="Control"
                    Command="{Binding Workbench.RunCurrentWorkspaceCommand}" />
        <KeyBinding Key="F5"
                    Modifiers="Control"
                    Command="{Binding Workbench.RunCurrentRecipeCommand}" />
        <KeyBinding Key="F5"
                    Modifiers="Control+Shift"
                    Command="{Binding Workbench.RunCurrentValidationSetCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <dock:OpenVisionDockWorkspaceView Grid.Column="0"
                                      x:Name="DockWorkspace"
                                      ToolLibraryTitle="{Binding Localization.ToolLibrary}"
                                      CompactToolLibraryTitle="{views:ThreeDText Key=ThreeD.Workspace.CompactToolLibrary, Korean='도구 추가', English='Add Tool'}"
                                      DataLayersTitle="{Binding Localization.RecipeFlow}"
                                      CompactDataLayersTitle="{views:ThreeDText Key=ThreeD.Workspace.CompactRecipeFlow, Korean='도구 연결', English='Tool Flow'}"
                                      ViewerTitle="{Binding Localization.Viewer}"
                                      ResultsTitle="{Binding Localization.ResultsWorkspaceTitle}"
                                      ToolInspectorTitle="{views:ThreeDText Key=ThreeD.Workspace.SelectedTool, Korean='선택 도구', English='Selected Tool'}"
                                      CompactToolInspectorTitle="{views:ThreeDText Key=ThreeD.Workspace.CompactSelectedTool, Korean='도구 설정', English='Tool Settings'}"
                                      EvidenceTitle="{Binding Localization.PipelineValidation}"
                                      ValidationEvidenceTitle="{views:ThreeDText Key=ThreeD.Inspection.InputFiles, Korean='검사 파일', English='Inspection files'}"
                                      ValidationSamplesTitle="{Binding Workbench.Localization.ValidationSetSamples}"
                                      RecipeValidationResultsTitle="{views:ThreeDText Key=ThreeD.Validation.ResultsTitle, Korean='검증 결과', English='Validation results'}"
                                      OutputCompareTitle="{Binding Localization.OutputCompare}"
                                      DisplayedOutputsTitle="{Binding Localization.DisplayedOutputs}"
                                      LinkedViewTitle="{Binding Localization.SessionLog}"
                                      ProfileTitle="{Binding Localization.HeightProfile}"
                                      FitDiagnosticsTitle="{Binding Localization.FitDiagnostics}"
                                      IntersectionEvidenceTitle="{Binding Localization.IntersectionEvidence}"
                                      CorrespondenceEvidenceTitle="{Binding Localization.CorrespondenceEvidence}"
                                      IsOutputCompareViewerActive="{Binding Workbench.IsOutputCompareViewerActive}"
                                      IsActivityLogSelected="{Binding ResultsWorkspace.IsLogSelected}"
                                      IsSectionSelected="{Binding ResultsWorkspace.IsSectionSelected}"
                                      IsBottomPaneExpanded="False">
        <dock:OpenVisionDockWorkspaceView.DataLayersContent>
            <workbench:RecipeChainView DataContext="{Binding Workbench}" />
        </dock:OpenVisionDockWorkspaceView.DataLayersContent>

        <dock:OpenVisionDockWorkspaceView.ValidationSamplesContent>
            <workbench:ValidationSamplesView DataContext="{Binding Workbench}" />
        </dock:OpenVisionDockWorkspaceView.ValidationSamplesContent>

        <dock:OpenVisionDockWorkspaceView.ViewerContent>
            <Grid Background="{DynamicResource ThreeD.PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Height="44" Padding="10,0"
                        Background="{DynamicResource ThreeD.ExecutionBarBrush}" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsValidateWorkspaceSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="ValidationExecutionBar">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border AutomationProperties.AutomationId="ValidationTeachingIdentity" Padding="10,3" CornerRadius="14" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                            <Border.Style><Style TargetType="Border"><Setter Property="MaxWidth" Value="360" /><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True"><Setter Property="MaxWidth" Value="280" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Width="14" Height="14" Margin="0,0,6,0" Symbol="ClipboardTaskListLtr24" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{views:ThreeDText Key=ThreeD.Validation.CurrentTeaching, Korean='현재 티칭 조건', English='Current teaching'}" />
                                </StackPanel>
                                <TextBlock AutomationProperties.AutomationId="ValidationRecipeName" Grid.Column="1" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding Workbench.HeaderRecipeText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workbench.HeaderRecipeText}" />
                                <TextBlock AutomationProperties.AutomationId="ValidationTeachingSaveState" Grid.Column="2" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Workbench.Localization.Saved}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Workbench.HasRecipeIdentity}" Value="False"><Setter Property="Text" Value="{Binding Workbench.Localization.Unsaved}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Workbench.IsDirty}" Value="True"><Setter Property="Text" Value="{Binding Workbench.Localization.Modified}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="8,0">
                            <Grid Visibility="{Binding Workbench.IsValidationSetIdle, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Margin="0,0,8,0" Padding="7,2" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource ThreeD.WarningSurfaceBrush}" BorderBrush="{DynamicResource ThreeD.WarningBrush}" BorderThickness="1"
                                        Visibility="{Binding Workbench.IsValidationSetStale, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="ValidationStaleBasis" ToolTip="{Binding Workbench.ValidationSetRunBasisText}">
                                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Width="14" Height="14" Margin="0,0,6,0" Symbol="Warning16" Foreground="{DynamicResource ThreeD.WarningBrush}" /><TextBlock FontSize="12" Foreground="{DynamicResource ThreeD.WarningBrush}" Text="{views:ThreeDText Key=ThreeD.Validation.StaleBasis, Korean='이전 검증 · 티칭이 바뀜', English='Previous validation · teaching changed'}" /></StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock AutomationProperties.AutomationId="ValidationIdleSummary" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                               Text="{Binding Workbench.ValidationSetRunBasisText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workbench.ValidationSetRunBasisText}" />
                                    <TextBlock AutomationProperties.AutomationId="ValidationRunNotice" FontSize="11" Foreground="{DynamicResource ThreeD.WarningBrush}" Text="{Binding Workbench.ValidationSetRunNoticeText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workbench.ValidationSetRunNoticeText}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Workbench.ValidationSetRunNoticeText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <Grid HorizontalAlignment="Right" AutomationProperties.AutomationId="ValidationRunningProgress" Visibility="{Binding Workbench.IsValidationSetRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock AutomationProperties.AutomationId="ValidationProgressText" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{Binding Workbench.ValidationSetProgressText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workbench.ValidationSetProgressText}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="MaxWidth" Value="320" /><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True"><Setter Property="MaxWidth" Value="180" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <ProgressBar AutomationProperties.AutomationId="ValidationProgress" Grid.Column="1" Height="6" Margin="8,0,0,0" VerticalAlignment="Center" Maximum="100" Value="{Binding Workbench.ValidationSetProgress, Mode=OneWay}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                            <Setter Property="Width" Value="180" />
                                            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True"><Setter Property="Width" Value="110" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding Workbench.ValidationSetElapsedText}" AutomationProperties.AutomationId="ValidationElapsed" />
                            </Grid>
                        </Grid>
                        <ui:Button Grid.Column="2" Height="30" Padding="10,4" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Appearance="Primary" Icon="{ui:SymbolIcon Play20}"
                                   Command="{Binding Workbench.RunValidationSetCommand}" ToolTip="{Binding Workbench.Localization.ValidationSetRunAllHint}"
                                   Visibility="{Binding Workbench.IsValidationSetIdle, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="RunValidationWorkspaceSet" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Validation.Run, Korean='검증 실행', English='Run validation'}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{views:ThreeDText Key=ThreeD.Validation.Run, Korean='검증 실행', English='Run validation'}" /><TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Text="{Binding Workbench.ValidationSetAllCount}" /></StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="2" Width="32" Height="30" Padding="6,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Icon="{ui:SymbolIcon Stop20}" Command="{Binding Workbench.CancelValidationSetCommand}"
                                   Visibility="{Binding Workbench.IsValidationSetRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="CancelValidationWorkspaceSet" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Validation.Stop, Korean=중지, English=Stop}" ToolTip="{views:ThreeDText Key=ThreeD.Common.StopValidation, Korean='검증 중지', English='Stop validation'}" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Height="44" Padding="10,0"
                        Background="{DynamicResource ThreeD.ExecutionBarBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsInspectWorkspaceSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="InspectionExecutionBar">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Padding="10,3" CornerRadius="14" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1" AutomationProperties.AutomationId="InspectionBasisIdentity">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="MaxWidth" Value="300" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True"><Setter Property="MaxWidth" Value="200" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Width="14" Height="14" Margin="0,0,6,0" Symbol="ClipboardTaskListLtr24" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{views:ThreeDText Key=ThreeD.Inspection.Basis, Korean='검사 기준', English='Inspection basis'}" />
                                </StackPanel>
                                <TextBlock AutomationProperties.AutomationId="InspectionBasisName" Grid.Column="1" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding Workbench.InspectionQueue.InspectionBasisText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Workbench.InspectionQueue.InspectionBasisText}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding Workbench.IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="InspectionUnsavedTeaching">
                            <Border Padding="6,3" CornerRadius="10" Background="{DynamicResource ThreeD.WarningSurfaceBrush}">
                                <TextBlock FontSize="11" Foreground="{DynamicResource ThreeD.WarningBrush}" Text="{views:ThreeDText Key=ThreeD.Inspection.UnsavedTeaching, Korean='티칭 변경 미저장', English='Unsaved teaching changes'}" />
                            </Border>
                            <ui:Button Width="30" Height="28" Margin="6,0,0,0" Padding="7,0" Icon="{ui:SymbolIcon Save20}"
                                       Command="{Binding Workbench.SaveTeachingRecipeCommand}" ToolTip="{views:ThreeDText Key=ThreeD.Inspection.SaveTeachingTip, Korean='레시피 저장 (Ctrl+S)', English='Save recipe (Ctrl+S)'}" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.R19.SaveRecipe, Korean='레시피 저장', English='Save recipe'}" AutomationProperties.AutomationId="SaveInspectionTeaching" />
                        </StackPanel>
                        <Grid Grid.Column="2" Margin="8,0">
                            <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Workbench.InspectionQueue.RecipeReadinessText}" ToolTip="{Binding Workbench.InspectionQueue.RecipeReadinessText}"
                                       Visibility="{Binding Workbench.InspectionQueue.IsIdle, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="InspectionIdleReadiness" />
                            <Grid Visibility="{Binding Workbench.InspectionQueue.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="InspectionRunningProgress">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Workbench.InspectionQueue.ProgressText}" ToolTip="{Binding Workbench.InspectionQueue.ProgressText}" AutomationProperties.AutomationId="InspectionProgressText" />
                                <ProgressBar Grid.Column="1" Height="6" Margin="8,0,0,0" VerticalAlignment="Center" Maximum="100" Value="{Binding Workbench.InspectionQueue.ProgressPercent, Mode=OneWay}"
                                             AutomationProperties.AutomationId="InspectionProgress" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Inspection.Progress, Korean='파일 검사 진행', English='Inspection progress'}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                            <Setter Property="Width" Value="180" />
                                            <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=workbench:ToolRecipeWorkbenchView}}" Value="True"><Setter Property="Width" Value="110" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding Workbench.InspectionQueue.IsIdle, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ComboBox Height="32" MinWidth="116" Margin="0,0,8,0" SelectedValuePath="Tag" SelectedValue="{Binding Workbench.InspectionQueue.SelectedRunScope, Mode=TwoWay}" IsEnabled="{Binding Workbench.InspectionQueue.IsIdle}" AutomationProperties.AutomationId="InspectionRunScope" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Inspection.Scope, Korean='검사 범위', English='Inspection scope'}">
                                <ComboBoxItem Tag="{x:Static models:InspectionQueueRunScope.Selected}" Content="{views:ThreeDText Key=ThreeD.Inspection.SelectedScope, Korean='선택', English='Selected'}" />
                                <ComboBoxItem Tag="{x:Static models:InspectionQueueRunScope.All}" Content="{views:ThreeDText Key=ThreeD.Inspection.AllScope, Korean='전체', English='All'}" />
                                <ComboBoxItem Tag="{x:Static models:InspectionQueueRunScope.Checked}" Content="{views:ThreeDText Key=ThreeD.Inspection.CheckedScope, Korean='체크', English='Checked'}" />
                                <ComboBoxItem Tag="{x:Static models:InspectionQueueRunScope.Remaining}" Content="{views:ThreeDText Key=ThreeD.Inspection.RemainingScope, Korean='남은 파일', English='Remaining'}" />
                                <ComboBoxItem Tag="{x:Static models:InspectionQueueRunScope.FailedAndError}" Content="{views:ThreeDText Key=ThreeD.Inspection.FailedScope, Korean='NG·오류만', English='NG/error only'}" />
                            </ComboBox>
                            <ui:Button Height="32" Padding="10,0" CornerRadius="4" Appearance="Primary" Icon="{ui:SymbolIcon Play20}" Content="{Binding Workbench.InspectionQueue.RunScopeLabel}"
                                       Command="{Binding Workbench.InspectionQueue.RunScopeCommand}" AutomationProperties.AutomationId="StartInspectionQueueRun" AutomationProperties.Name="{Binding Workbench.InspectionQueue.RunScopeLabel}" />
                        </StackPanel>
                        <ui:Button Grid.Column="3" Width="32" Height="32" Padding="6,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon Stop20}" Command="{Binding Workbench.InspectionQueue.StopCommand}"
                                   Visibility="{Binding Workbench.InspectionQueue.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="StopInspectionQueueRun" AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Common.StopInspection, Korean='검사 중지', English='Stop inspection'}" ToolTip="{views:ThreeDText Key=ThreeD.Common.StopInspection, Korean='검사 중지', English='Stop inspection'}" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource ThreeD.CommandBarBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="0,0,0,1"
                        AutomationProperties.AutomationId="ViewerContextRibbon">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Padding" Value="16,10" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Workbench.IsC3DSourceLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Workbench.IsSelectionCandidateActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Workbench.IsSourceReadyForRecipe}" Value="True" />
                                        <Condition Binding="{Binding Workbench.HasSelectedPipelineStep}" Value="False" />
                                        <Condition Binding="{Binding Workbench.IsC3DSourceLoading}" Value="False" />
                                        <Condition Binding="{Binding Workbench.IsSelectionCandidateActive}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Margin="0"
                                Padding="9,7"
                                Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="{Binding Workbench.IsC3DSourceLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.AutomationId="C3DSourceLoadingRibbon">
