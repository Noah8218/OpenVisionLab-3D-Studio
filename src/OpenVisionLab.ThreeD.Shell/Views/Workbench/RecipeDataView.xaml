    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="10,6" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1">
            <TextBlock Style="{StaticResource GalleryHintStyle}"
                       Text="{views:ThreeDText Key=ThreeD.Data.GalleryHint, Korean='검사 흐름 순서', English='Inspection flow order'}" />
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8" AutomationProperties.AutomationId="RecipeDataGalleryScroll">
            <ItemsControl x:Name="RecipeDataGallery" ItemsSource="{Binding DisplayedOutputs}">
<ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="ItemTemplate" Value="{StaticResource TeachingGalleryCard}" /><Style.Triggers><DataTrigger Binding="{Binding IsTeachingGallery, RelativeSource={RelativeSource AncestorType=workbench:RecipeDataView}}" Value="False"><Setter Property="ItemTemplate" Value="{StaticResource LegacyGalleryCard}" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>
        <Expander x:Name="TeachingDataInformation" Grid.Row="2" IsExpanded="False" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,1,0,0">
<Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsTeachingGallery, RelativeSource={RelativeSource AncestorType=workbench:RecipeDataView}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Expander.Style>
<Expander.Template><ControlTemplate TargetType="Expander"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><StackPanel>
<ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left" Padding="10,7" FocusVisualStyle="{StaticResource GalleryButtonFocus}" AutomationProperties.AutomationId="RecipeDataInformationToggle" AutomationProperties.Name="입력 · ROI 정보">
<ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="InformationHeader" Padding="{TemplateBinding Padding}" Background="Transparent"><StackPanel Orientation="Horizontal"><TextBlock FontSize="12" x:Name="InformationArrow" Text="▸" Margin="0,0,6,0" /><TextBlock FontSize="12" Text="{views:ThreeDText Key=ThreeD.Data.Information, Korean='입력 · ROI 정보', English='Input and ROI information'}" /></StackPanel></Border><ControlTemplate.Triggers>
<Trigger Property="IsChecked" Value="True"><Setter TargetName="InformationArrow" Property="Text" Value="▾" /></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InformationHeader" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="InformationHeader" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></Trigger>
</ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
</ToggleButton>
<ContentPresenter x:Name="InformationBody" Visibility="Collapsed" />
</StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="InformationBody" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template>
<ScrollViewer MaxHeight="210" Padding="10,2,10,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<TextBlock FontSize="12" Text="{Binding Source.Name}" TextWrapping="Wrap" LineHeight="19.2" LineStackingStrategy="BlockLineHeight" />
<TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19.2" LineStackingStrategy="BlockLineHeight"><Run Text="{Binding SourceQuality.Report.Grid.Width, Mode=OneWay, FallbackValue=—}" /><Run Text=" × " /><Run Text="{Binding SourceQuality.Report.Grid.Height, Mode=OneWay, FallbackValue=—}" /><Run Text=" · " /><Run Text="{Binding Source.Unit, Mode=OneWay}" /></TextBlock>
<TextBlock FontSize="12" Text="{Binding SourceContractSummary}" TextWrapping="Wrap" LineHeight="19.2" LineStackingStrategy="BlockLineHeight" />
<TextBlock FontSize="12" Text="{views:ThreeDText Key=ThreeD.Data.RoiHint, Korean='ROI는 뷰어에서 선택하고 도구 설정에서 연결합니다.', English='Select an ROI in the viewer and connect it in tool settings.'}" TextWrapping="Wrap" LineHeight="19.2" LineStackingStrategy="BlockLineHeight" />
</StackPanel></ScrollViewer>
</Expander>
        <Expander x:Name="RecipeDataInformation" Grid.Row="2" Header="{views:ThreeDText Key=ThreeD.Data.Information, Korean='입력 · ROI 정보', English='Input and ROI information'}" IsExpanded="False" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" FontSize="12">
<Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsTeachingGallery, RelativeSource={RelativeSource AncestorType=workbench:RecipeDataView}}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Expander.Style>
    <TabControl x:Name="RecipeDataTabs" MaxHeight="310" Background="{DynamicResource ThreeD.PanelBrush}" BorderThickness="0" Padding="6">
        <TabItem Header="{views:ThreeDText Key=ThreeD.Data.Input, Korean='입력', English='Input'}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Source.Name}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Source.Path}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding LocalizedSourceReadinessSummary}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SourceContractSummary}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                    <ui:Button Margin="0,12,0,0" HorizontalAlignment="Left" Content="{Binding Localization.OpenSourceQuality}" Icon="{ui:SymbolIcon DataHistogram24}" Command="{Binding SelectSourceQualityCommand}" />
                    <ui:Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="{Binding Localization.Open3DMap}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding LoadC3DSourceCommand}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="ROI">
            <Grid Margin="4,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}">
                    <Run Text="ROI " /><Run Text="{Binding Selections.Count, Mode=OneWay}" />
                </TextBlock>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecipeDataRegions" ItemsSource="{Binding Selections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="8" Background="{DynamicResource ThreeD.PanelAlternateBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <ui:Button Margin="0,6,0,0" HorizontalAlignment="Right" Padding="6,3" Content="{views:ThreeDText Key=ThreeD.Data.ConnectRegion, Korean='연결 시작', English='Start connection'}" Icon="{ui:SymbolIcon ArrowFlowUpRight24}"
                                                   Command="{Binding DataContext.BeginFlowConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}"
                                                   AutomationProperties.AutomationId="RecipeDataRegionOutput" AutomationProperties.Name="{Binding Name}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="{views:ThreeDText Key=ThreeD.Data.Output, Korean='출력', English='Outputs'}">
            <ScrollViewer Margin="4,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DisplayedOutputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="8" Background="{DynamicResource ThreeD.PanelAlternateBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding StateDisplay}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.AccentBrush}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding ContractDisplay}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <ui:Button Padding="6,3" Margin="0,0,4,4" Content="{Binding DataContext.Localization.ShowInViewer, RelativeSource={RelativeSource AncestorType=UserControl}}" Icon="{ui:SymbolIcon Eye24}"
                                                   Command="{Binding DataContext.ShowDisplayedOutputInViewerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <ui:Button Padding="6,3" Margin="0,0,4,4" Content="{Binding DataContext.Localization.FocusStep, RelativeSource={RelativeSource AncestorType=UserControl}}" Icon="{ui:SymbolIcon FlowchartCircle24}"
                                                   Command="{Binding DataContext.FocusDisplayedOutputStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>
    </TabControl>
        </Expander>
    </Grid>
</UserControl>
