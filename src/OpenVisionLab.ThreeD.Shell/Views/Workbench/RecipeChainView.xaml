                               Command="{Binding BringSelectedToolIntoViewCommand, ElementName=RecipeChainRoot}"
                               IsEnabled="{Binding HasSelectedPipelineStep}"
                               AutomationProperties.AutomationId="RecipeFlowFocusSelected"
                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.FocusSelectedTool, Korean='선택 도구로 이동', English='Go to selected tool'}" />
                </WrapPanel>
            </Border>
                    </Popup>
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Padding="10,7,10,8" Background="{DynamicResource ThreeD.DockHeaderBrush}" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding IsTeachingMode, ElementName=RecipeChainRoot, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="RecipeReadinessStrip">
                <StackPanel>
                    <Grid>
                        <Grid IsHitTestVisible="False" Height="1.5" VerticalAlignment="Top" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="10*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Background="{StaticResource FlowThumbnailBorderBrush}" />
                        </Grid>
                    <UniformGrid x:Name="FlowReadinessCaptions" Columns="6">
                        <StackPanel HorizontalAlignment="Center"><Border Style="{StaticResource FlowReadinessCircleStyle}" Tag="{Binding IsSourceReadyForRecipe}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ReadinessGlyph}" Tag="{Binding IsSourceReadyForRecipe}" /></Border><TextBlock Style="{StaticResource FlowReadinessCaptionStyle}" Text="{views:ThreeDText Key=ThreeD.Ready.Input, Korean='입력', English='Input'}" /></StackPanel>
                        <StackPanel HorizontalAlignment="Center"><Border Style="{StaticResource FlowReadinessCircleStyle}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding PipelineSteps.Count}" /></Border><TextBlock Style="{StaticResource FlowReadinessCaptionStyle}" Text="{views:ThreeDText Key=ThreeD.Ready.Tools, Korean='도구', English='Tools'}" /></StackPanel>
                        <StackPanel HorizontalAlignment="Center"><Border Style="{StaticResource FlowReadinessCircleStyle}" Tag="{Binding IsEnabled, ElementName=TeachingRunAllButton}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ReadinessGlyph}" Tag="{Binding IsEnabled, ElementName=TeachingRunAllButton}" /></Border><TextBlock Style="{StaticResource FlowReadinessCaptionStyle}" Text="{views:ThreeDText Key=ThreeD.Ready.Run, Korean='실행', English='Run'}" /></StackPanel>
                        <StackPanel HorizontalAlignment="Center"><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource FlowReadinessCircleStyle}"><Setter Property="Tag" Value="{Binding SelectedPipelineStep.HasConfiguredAcceptanceLimits, FallbackValue=False}" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPipelineStep.HasUnconfiguredAcceptanceLimits}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock x:Name="FlowJudgmentReadiness" HorizontalAlignment="Center" VerticalAlignment="Center" Tag="{Binding SelectedPipelineStep.HasConfiguredAcceptanceLimits, FallbackValue=False}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ReadinessGlyph}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPipelineStep.HasUnconfiguredAcceptanceLimits}" Value="True"><Setter Property="Text" Value="!" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Style="{StaticResource FlowReadinessCaptionStyle}" Text="{views:ThreeDText Key=ThreeD.Ready.Decision, Korean='판정', English='Judge'}" /></StackPanel>
                        <StackPanel HorizontalAlignment="Center"><Border Style="{StaticResource FlowReadinessCircleStyle}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding ValidationSetSamples.Count}" /></Border><TextBlock Style="{StaticResource FlowReadinessCaptionStyle}" Text="{views:ThreeDText Key=ThreeD.Ready.Validate, Korean='검증', English='Verify'}" /></StackPanel>
                        <StackPanel HorizontalAlignment="Center"><Border Style="{StaticResource FlowReadinessCircleStyle}" Tag="{Binding CanSaveTeachingRecipe}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ReadinessGlyph}" Tag="{Binding CanSaveTeachingRecipe}" /></Border><TextBlock Style="{StaticResource FlowReadinessCaptionStyle}" Text="{views:ThreeDText Key=ThreeD.Ready.Save, Korean='저장', English='Save'}" /></StackPanel>
                    </UniformGrid>
                    </Grid>
                    <Button x:Name="FlowNextIssueButton" Margin="0,7,0,0" Padding="8,5" FontSize="12" Command="{Binding NextRecipeHealthIssueCommand}"
                            Style="{StaticResource FlowNextIssueButtonStyle}" AutomationProperties.Name="{Binding NextRecipeHealthIssueDetail}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{views:ThreeDText Key=ThreeD.Flow.NextIssue, Korean='다음', English='Next'}" />
                            <TextBlock Grid.Column="1" Text="{Binding NextRecipeHealthIssueDetail}" TextWrapping="Wrap" />
                            <ui:SymbolIcon Grid.Column="2" Margin="8,0,0,0" Symbol="ChevronRight24" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="FlowGraphViewport"
                          Style="{StaticResource NonOverlappingScrollViewerStyle}"
                          Grid.Row="2"
                          Background="{StaticResource FlowGridBrush}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          Focusable="True"
                          PanningMode="Both"
                          AutomationProperties.AutomationId="RecipeFlowViewport"
                          AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.FlowDiagram, Korean='도구 연결도', English='Tool flow diagram'}">
                <Grid x:Name="FlowGraphSurface" Background="{StaticResource FlowGridBrush}"
                      MinWidth="192"
                      Width="{Binding ViewportWidth, ElementName=FlowGraphViewport}"
                      MinHeight="{Binding ViewportHeight, ElementName=FlowGraphViewport}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding FlowZoom, ElementName=RecipeChainRoot}"
                                        ScaleY="{Binding FlowZoom, ElementName=RecipeChainRoot}" />
                    </Grid.LayoutTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="FlowConnectionCancelSurface"
                            Grid.RowSpan="3"
                            Panel.ZIndex="-1"
                            Background="Transparent"
                            behaviors:PreviewMouseDownCommandBehavior.IsEnabled="True"
                            behaviors:PreviewMouseDownCommandBehavior.Command="{Binding CancelFlowConnectionCommand}" />

                    <Canvas x:Name="FlowConnectionCanvas"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Panel.ZIndex="0"
                            ClipToBounds="True"
                            IsHitTestVisible="False"
                            AutomationProperties.AutomationId="RecipeFlowConnections"
                            AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.RecipeFlowConnections, Korean='저장된 도구 연결선', English='Saved tool connections'}" />

                    <Canvas x:Name="FlowPortConnectionCanvas"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Panel.ZIndex="2"
                            ClipToBounds="True"
                            IsHitTestVisible="False" />

            <Border x:Name="RecipeInputNode"
                    Grid.Row="0"
                    Panel.ZIndex="1"
                    Width="{Binding FlowCardWidth, ElementName=RecipeChainRoot}"
                    Margin="22,14,14,26"
                    Padding="0"
                    HorizontalAlignment="Left"
                    BorderThickness="1"
                    CornerRadius="7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource FlowSourceSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSourceQualityWorkspaceVisible}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cube24" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{views:ThreeDText Key=ThreeD.Flow.ThreeDInput, Korean='3D 입력', English='3D input'}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Width="24" Height="24" Padding="3" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding LoadC3DSourceCommand}" ToolTip="{Binding Localization.Open3DMap}" AutomationProperties.Name="{Binding Localization.Open3DMap}" />
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="84" Height="55"  Background="{StaticResource FlowThumbnailSurfaceBrush}"><Image Width="84" Height="55" Stretch="Uniform" Source="{Binding SourceQuality.PreviewFrame, Converter={StaticResource HeightImageFrameConverter}}" AutomationProperties.AutomationId="RecipeSourceThumbnail" ><Image.Clip><RectangleGeometry Rect="0,0,84,55" RadiusX="3" RadiusY="3" /></Image.Clip></Image><Border x:Name="FlowSourceThumbnailChrome" Style="{StaticResource FlowThumbnailFrameStyle}" /></Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Source.Name}" TextWrapping="Wrap" ToolTip="{Binding Source.Path}" />
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecipeInputContract">
                                <Run Text="{Binding SourceQuality.GridValue, Mode=OneWay}" /><Run Text=" · " /><InlineUIContainer BaselineAlignment="Baseline"><TextBlock FontSize="10.5" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding Source.Unit, Mode=OneWay}" TextWrapping="NoWrap" /></InlineUIContainer>
                            </TextBlock>
                            <WrapPanel x:Name="SourceEvidenceBadges">
                                <Button x:Name="SourceQualityBadge" Margin="0,3,6,0" HorizontalAlignment="Left" Style="{StaticResource FlowSourceQualityBadgeStyle}" Command="{Binding SelectSourceQualityCommand}" ToolTip="{Binding Localization.OpenSourceQuality}" AutomationProperties.Name="{Binding Localization.OpenSourceQuality}">
                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource ThreeD.WarningBrush}" TextWrapping="Wrap" ToolTip="{Binding SourceQuality.MissingValue}">
                                        <Run Text="{views:ThreeDText Key=ThreeD.Source.Missing, Korean='결측 ', English='Missing '}" /><Run Text="{Binding SourceQuality.Report.Coverage.MissingRatio, Mode=OneWay, StringFormat={}{0:P1}}" />
                                    </TextBlock>
                                </Button>
                                <Button x:Name="SourceCalibrationBadge" Margin="0,3,0,0" MaxWidth="{Binding ActualWidth, ElementName=SourceEvidenceBadges}" HorizontalAlignment="Left" Command="{Binding SelectSourceQualityCommand}" ToolTip="{Binding SourceQuality.MeasurementCalibrationSummary}" AutomationProperties.Name="{Binding Text, ElementName=SourceCalibrationText}" AutomationProperties.HelpText="{Binding SourceQuality.MeasurementCalibrationSummary}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlowSourceQualityBadgeStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SourceQuality.MeasurementState}" Value="CalibratedPhysical">
                                                    <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock x:Name="SourceCalibrationText" FontSize="10.5" TextWrapping="Wrap" TextTrimming="None" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Source.CalibrationUnknown, Korean='교정 정보 미확인', English='Calibration unknown'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceQuality.MeasurementState}" Value="CalibratedPhysical">
                                                        <Setter Property="Text" Value="{views:ThreeDText Key=ThreeD.Source.CalibrationEvidence, Korean='교정 근거 있음', English='Calibration evidence'}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,3,0,0" FontSize="11" Text="{Binding CurrentSourceHeaderStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.WarningBrush}" AutomationProperties.AutomationId="RecipeSourceQualityStatus">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="{Binding IsCurrentSourceHeaderStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}" /><Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSourceQualityStatusKind}" Value="Warning"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="SourceOutputPort"
                            Grid.Row="3"
                            Grid.ColumnSpan="3"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            Style="{StaticResource RecipeFlowPortButtonStyle}" Tag="HeightGrid"
                            Command="{Binding BeginFlowConnectionCommand}"
                            CommandParameter="{Binding Source.Id}"
                            ToolTip="{Binding Localization.FlowConnectionOutputPortHelp}"
                            AutomationProperties.AutomationId="RecipeSourceOutputPort"
                            AutomationProperties.Name="{Binding Localization.FlowConnectionOutputPort}"
                            AutomationProperties.HelpText="{Binding Localization.FlowConnectionOutputPortHelp}">
                        <TextBlock FontSize="12" TextWrapping="Wrap">
                            <Run Text="{views:ThreeDText Key=ThreeD.Flow.Output, Korean='출력', English='Output'}" /><Run Text=" " /><Run Text="{views:ThreeDText Key=ThreeD.Flow.Height, Korean='높이 데이터', English='Height data'}" /><Run Text=" → " /><Run Text="{Binding SourceConsumerCount, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="RecipeHealthCard"
                    Grid.Row="1"
                    Panel.ZIndex="1"
                    Margin="0,0,0,7"
                    Padding="8,7"
                    MaxWidth="{Binding ActualWidth, ElementName=FlowGraphViewport}"
                    Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    AutomationProperties.AutomationId="RecipeHealthCard">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSelectedPipelineStep}" Value="True" />
                                    <Condition Binding="{Binding IsTeachingMode, ElementName=RecipeChainRoot}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.PrimaryTextBrush}"
                                   Text="{Binding Localization.RecipeHealth}" />
                        <TextBlock Grid.Column="1"
                                   Margin="7,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.AccentBrush}"
                                   Text="{Binding RecipeHealthSummary}" />
                    </Grid>
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                               Text="{Binding RecipeHealthCountsPrimary}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,1,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                               Text="{Binding RecipeHealthCountsSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThreeD.AccentBrush}"
                               Text="{Binding SelectedRecipeHealthTitle}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding SelectedRecipeHealthTitle}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{Binding SelectedRecipeHealthDetail}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding SelectedRecipeHealthDetail}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedRecipeHealthDetail}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="PreviousRecipeHealthIssueButton"
                                   Margin="0,0,3,0"
                                   Padding="6,3"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Content="{Binding Localization.PreviousRequirement}"
                                   Icon="{ui:SymbolIcon ArrowLeft24}"
                                   Command="{Binding PreviousRecipeHealthIssueCommand}"
                                   ToolTip="{Binding Localization.PreviousRequirement}"
                                   AutomationProperties.AutomationId="PreviousRecipeHealthIssue"
                                   AutomationProperties.Name="{Binding Localization.PreviousRequirement}" />
                        <ui:Button x:Name="NextRecipeHealthIssueButton"
                                   Grid.Column="1"
                                   Margin="3,0,0,0"
                                   Padding="6,3"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Content="{Binding Localization.NextRequirement}"
                                   Icon="{ui:SymbolIcon ArrowRight24}"
                                   Command="{Binding NextRecipeHealthIssueCommand}"
                                   ToolTip="{Binding Localization.NextRequirement}"
                                   AutomationProperties.AutomationId="NextRecipeHealthIssue"
                                   AutomationProperties.Name="{Binding Localization.NextRequirement}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ListBox x:Name="RecipeStepList"
                     Grid.Row="2"
                     Panel.ZIndex="1"
                     Width="192"
                     MinHeight="1"
                     HorizontalAlignment="Left"
                     ItemsSource="{Binding PipelineSteps}"
                     SelectedItem="{Binding SelectedPipelineStep, Mode=TwoWay}"
                     behaviors:ScrollIntoViewOnSelectionChangedBehavior.IsEnabled="True"
                     RequestBringIntoView="OnStepRequestBringIntoView"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="False"
                     AutomationProperties.ItemStatus="{Binding PipelineSteps.Count}"
                     AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.OrderedRecipeChainAccessible, Korean='순서가 지정된 검사 레시피 체인', English='Ordered inspection recipe chain'}">
            <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="{Binding FlowCardWidth, RelativeSource={RelativeSource AncestorType={x:Type workbench:RecipeChainView}}}" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" /></ControlTemplate></Setter.Value>
                    </Setter>
                    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsTeachingMode, RelativeSource={RelativeSource AncestorType=workbench:RecipeChainView}}" Value="True" />
                        <Condition Binding="{Binding IsFlowRepeatGroupMember}" Value="True" />
                        <Condition Binding="{Binding IsFlowRepeatGroupLead}" Value="False" />
                        <Condition Binding="{Binding IsThicknessGroupExpanded, RelativeSource={RelativeSource AncestorType=workbench:RecipeChainView}}" Value="False" />
                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                    <Grid Visibility="{Binding Visibility, ElementName=FlowRepeatGroupCard}">
<Border x:Name="FlowGroupBackplate" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="4,4,-4,-4" /><Setter Property="CornerRadius" Value="7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{StaticResource FlowCardBorderBrush}" /><Setter Property="Background" Value="#1A2026" /><Style.Triggers>
<DataTrigger Binding="{Binding DataContext.SelectedPipelineStep.IsFlowRepeatGroupMember, RelativeSource={RelativeSource AncestorType=workbench:RecipeChainView}}" Value="True"><Setter Property="BorderBrush" Value="#3D5F5D" /></DataTrigger>
<DataTrigger Binding="{Binding IsThicknessGroupExpanded, RelativeSource={RelativeSource AncestorType=workbench:RecipeChainView}}" Value="True"><Setter Property="CornerRadius" Value="7,7,0,0" /><Setter Property="BorderThickness" Value="1,1,1,0" /></DataTrigger>
