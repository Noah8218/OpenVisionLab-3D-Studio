                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="26" Margin="0,0,6,0" Visibility="{Binding HasOutputPreview, Converter={StaticResource BoolToVisibilityConverter}}" Background="{StaticResource FlowThumbnailSurfaceBrush}"><Image Width="40" Height="26"  Stretch="Uniform" Source="{Binding OutputPreviewFrame, Converter={StaticResource HeightImageFrameConverter}}"
                                                AutomationProperties.AutomationId="FlowCollapsedOutputThumbnail" ><Image.Clip><RectangleGeometry Rect="0,0,40,26" RadiusX="3" RadiusY="3" /></Image.Clip></Image><Border x:Name="FlowCollapsedOutputThumbnailChrome" Style="{StaticResource FlowThumbnailFrameStyle}" /></Grid>
                                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding CollapsedOutputSummary, Converter={StaticResource MeasurementNumberTextConverter}}" /><Style.Triggers>
                                                <DataTrigger Binding="{Binding OutputContract}" Value="MeasurementResult"><Setter Property="Text" Value="{Binding CollapsedOutputSummary, Converter={StaticResource MeasurementNumberTextConverter}}" /></DataTrigger>
                                            </Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <ContentControl Margin="12,0" Content="{Binding}" ContentTemplate="{StaticResource FlowPortIssueDetails}" />
                        </StackPanel>
                    </Border>
<Border x:Name="FlowIndividualSelectionRing" Style="{StaticResource FlowSelectionRingStyle}" />
</Grid>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTeachingMode, RelativeSource={RelativeSource AncestorType=workbench:RecipeChainView}}" Value="True" /><Condition Binding="{Binding IsFlowRepeatGroupMember}" Value="True" /></MultiDataTrigger.Conditions><Setter TargetName="FlowIndividualCard" Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTeachingMode, RelativeSource={RelativeSource AncestorType=workbench:RecipeChainView}}" Value="True" /><Condition Binding="{Binding IsFlowRepeatGroupLead}" Value="True" /></MultiDataTrigger.Conditions><Setter TargetName="FlowRepeatGroupCard" Property="Visibility" Value="Visible" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsTeachingMode, RelativeSource={RelativeSource AncestorType=workbench:RecipeChainView}}" Value="True" /><Condition Binding="{Binding IsFlowRepeatGroupMember}" Value="True" /><Condition Binding="{Binding IsThicknessGroupExpanded, RelativeSource={RelativeSource AncestorType=workbench:RecipeChainView}}" Value="True" /></MultiDataTrigger.Conditions><Setter TargetName="FlowRepeatGroupMemberRow" Property="Visibility" Value="Visible" /></MultiDataTrigger>
                        <DataTrigger Binding="{Binding HasLongFlowName}" Value="True">
                            <Setter TargetName="FlowHeaderName" Property="Grid.Column" Value="0" /><Setter TargetName="FlowHeaderName" Property="Grid.ColumnSpan" Value="5" />
                            <Setter TargetName="FlowHeaderOrder" Property="Grid.Row" Value="1" /><Setter TargetName="FlowHeaderTypeIcon" Property="Grid.Row" Value="1" />
                            <Setter TargetName="FlowHeaderState" Property="Grid.Row" Value="1" /><Setter TargetName="FlowHeaderMenuButton" Property="Grid.Row" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=FlowNodeDetails}" Value="True"><Setter TargetName="FlowHeaderMenuButton" Property="Visibility" Value="Collapsed" /><Setter TargetName="FlowExpandedMenuButton" Property="Visibility" Value="Visible" /></DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
                    <TextBlock Grid.Row="2" Margin="22,16,14,16" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                               Text="{views:ThreeDText Key=ThreeD.Flow.EmptyRecipe, Korean='검사 도구를 추가하세요.', English='Add an inspection tool.'}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                            <DataTrigger Binding="{Binding PipelineSteps.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Row="3" Margin="22,12,14,16" Width="{Binding FlowCardWidth, ElementName=RecipeChainRoot}" HorizontalAlignment="Left"
                            MinHeight="30" Padding="8,4" Style="{StaticResource FlowAddButtonStyle}" Command="{Binding OpenToolLibraryCommand}"
                            AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Flow.AddTool, Korean='도구 추가', English='Add tool'}" AutomationProperties.AutomationId="RecipeFlowAddAfterSteps"
                            Visibility="{Binding IsTeachingMode, ElementName=RecipeChainRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock FontSize="12" Text="{views:ThreeDText Key=ThreeD.Flow.AddTool, Korean='도구 추가', English='Add tool'}" /></StackPanel>
                    </Button>

                </Grid>
            </ScrollViewer>

            <Border Grid.Row="5" Padding="10,6" Background="{DynamicResource ThreeD.DockHeaderBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}"
                    Visibility="{Binding IsTeachingMode, ElementName=RecipeChainRoot, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.AutomationId="FlowLegend">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"><TextBlock FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource ThreeD.AccentBrush}" Text="●" /><TextBlock FontSize="11" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Flow.Legend.Caption.Height, Korean='높이 맵', English='Height map'}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"><TextBlock FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource FlowRegionBrush}" Text="■" /><TextBlock FontSize="11" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Flow.Legend.Caption.Region, Korean='영역', English='Region'}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"><TextBlock FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource FlowDeviationBrush}" Text="●" /><TextBlock FontSize="11" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Flow.Legend.Caption.Deviation, Korean='편차 맵', English='Deviation map'}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"><TextBlock FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource ThreeD.TextBrush}" Text="◆" /><TextBlock FontSize="11" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Flow.Legend.Caption.Value, Korean='값', English='Value'}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"><TextBlock FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource ThreeD.AccentBrush}" Text="─" /><TextBlock FontSize="11" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Flow.Legend.Caption.Connection, Korean='연결', English='Connection'}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"><TextBlock FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource ThreeD.WarningBrush}" Text="┄" /><TextBlock FontSize="11" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{views:ThreeDText Key=ThreeD.Flow.Legend.Caption.Stale, Korean='재실행 필요', English='Rerun required'}" /></StackPanel>
                </WrapPanel>
            </Border>
            <Border x:Name="RecipeFlowHint"
                    Grid.Row="3"
                    MinHeight="49"
                    Padding="10,8"
                    Background="{DynamicResource ThreeD.CommandBarBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding HasPendingFlowConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.AutomationId="RecipeFlowHint">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{Binding FlowConnectionMessage}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <ui:Button Grid.Column="1"
                               Margin="8,0,0,0"
                               Padding="7,3"
                               Content="{Binding Localization.FlowConnectionCancel}"
                               Command="{Binding CancelFlowConnectionCommand}"
                               Visibility="{Binding HasPendingFlowConnection, Converter={StaticResource BoolToVisibilityConverter}}"
                               AutomationProperties.Name="{Binding Localization.FlowConnectionCancel}" />
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Margin="0,7,0,0"
                    Padding="8"
                    Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                    BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="{Binding HasSelectedPipelineStep, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTeachingMode, ElementName=RecipeChainRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Margin="0,0,0,6"
                            Padding="7,5"
                            Background="{DynamicResource ThreeD.CommandBarBrush}"
                            BorderBrush="{DynamicResource ThreeD.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="{Binding HasThicknessRepeatGroup, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="ThicknessRepeatGroup">
                        <StackPanel>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThreeD.AccentBrush}"
                                       Text="{Binding ThicknessRepeatGroupSummary}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                       Text="{Binding ThicknessRepeatGroupMembers}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ThicknessRepeatGroupMembers}" />
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedPipelineStepTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,6,0,0">
                        <ui:Button Margin="0,0,4,4"
                                   Padding="7,3"
                                   Content="{Binding Localization.MoveUp}"
                                   Command="{Binding MoveSelectedStepUpCommand}"
                                   AutomationProperties.Name="{Binding Localization.MoveUp}" />
                        <ui:Button Margin="0,0,4,4"
                                   Padding="7,3"
                                   Content="{Binding Localization.MoveDown}"
                                   Command="{Binding MoveSelectedStepDownCommand}"
                                   AutomationProperties.Name="{Binding Localization.MoveDown}" />
                        <ui:Button Margin="0,0,4,4"
                                   Padding="7,3"
                                   Content="{Binding Localization.RemoveStep}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding RemoveSelectedStepCommand}"
                                   AutomationProperties.Name="{Binding Localization.RemoveStep}" />
                        <ui:Button Padding="7,3"
                                   Content="{Binding Localization.OpenSelectedToolLab}"
                                   Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                                   Command="{Binding OpenSelectedToolLabCommand}"
                                   Visibility="{Binding IsSelectedToolLabAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.Name="{Binding Localization.OpenSelectedToolLab}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="7" Margin="0" Padding="12,10" Background="{DynamicResource ThreeD.CommandBarBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsTeachingMode, ElementName=RecipeChainRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:Button x:Name="TeachingRunAllButton" MinHeight="30" Padding="6,4" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon FastForward24}"
                                   Command="{Binding RunTeachingRecipeCommand}" ToolTip="Ctrl+F5" AutomationProperties.AutomationId="TeachingRunAllTools">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ThreeD.TextBrush}" Text="{views:ThreeDText Key=ThreeD.Flow.RunAll, Korean='모든 도구 실행', English='Run all tools'}" />
                                <Border Margin="6,0,0,0" Padding="3,1" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="Ctrl+F5" /></Border>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="1" Margin="4,0,0,0" Padding="6,4" Content="{Binding Localization.Cancel}" Command="{Binding CancelTeachingRecipeCommand}" Visibility="{Binding IsOrderedRunRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0" FontSize="11.5" Text="{Binding OrderedRunStatus}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <Expander Grid.Row="5"
                      Margin="0,7,0,0"
                      IsExpanded="False"
                      Header="{views:ThreeDText Key=ThreeD.Workspace.AdvancedRecipeExplorer, Korean='고급 레시피 탐색기', English='Advanced recipe explorer'}">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTeachingMode, ElementName=RecipeChainRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Border Margin="0,5,0,0"
                        MaxHeight="520"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1">
                    <workbench:ToolboxEntityExplorerView DataContext="{Binding}" />
                </Border>
            </Expander>
        </Grid>
    </Border>
</UserControl>
