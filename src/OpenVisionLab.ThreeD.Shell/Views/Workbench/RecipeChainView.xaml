<UserControl x:Name="RecipeChainRoot"
             x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.RecipeChainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             AutomationProperties.AutomationId="RecipeChain">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Border Padding="10"
            Background="{DynamicResource ThreeD.PanelBrush}"
            TextElement.Foreground="{DynamicResource ThreeD.TextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Width="18"
                                   Height="18"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource ThreeD.AccentBrush}"
                                   Symbol="Branch24" />
                    <TextBlock Style="{DynamicResource ThreeD.PanelTitleTextStyle}"
                               Text="{Binding Localization.RecipeFlow}" />
                </StackPanel>
                <TextBlock Margin="0,3,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{views:ThreeDText Key=ThreeD.Workspace.RecipeChainHint, Korean='검사 순서와 현재 선택을 한눈에 확인합니다.', English='Review inspection order and the current selection at a glance.'}"
                           TextWrapping="Wrap" />
                <Border x:Name="AuthoringFirstActionGuide"
                        Margin="0,7,0,0"
                        Padding="7,5"
                        Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                        BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        AutomationProperties.AutomationId="AuthoringFirstActionGuide">
                    <Grid>
                        <TextBlock x:Name="InputFirstActionText"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.InfoBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.InputFirstAction, Korean='1 · 3D 입력 열기', English='1 · Open 3D input'}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Current action: open 3D input">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="SelectToolFirstActionText"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.InfoBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.SelectToolFirstAction, Korean='2 · 검사 도구 선택', English='2 · Select inspection tool'}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Current action: select inspection tool">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSourceReadyForRecipe}" Value="True" />
                                                <Condition Binding="{Binding HasSelectedPipelineStep}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="RoiPreviewFirstActionText"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.InfoBrush}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.RoiPreviewFirstAction, Korean='3 · ROI 설정  →  4 · 미리보기', English='3 · Set ROI  →  4 · Preview'}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Current actions: set ROI and preview">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSourceReadyForRecipe}" Value="True" />
                                                <Condition Binding="{Binding HasSelectedPipelineStep}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,8,0,7"
                    Padding="8,6"
                    BorderThickness="1"
                    CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSourceReadyForRecipe}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSourceQualityWorkspaceVisible}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="9.5"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding Localization.SourceLabel}" />
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Text="{Binding Source.Name}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Source.Path}" />
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding LocalizedSourceReadinessSummary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Margin="7,0,0,0"
                               Padding="7,3"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSourceReadyForRecipe, Converter={StaticResource BoolToVisibilityConverter}}"
                               Icon="{ui:SymbolIcon DataHistogram24}"
                               Command="{Binding SelectSourceQualityCommand}"
                               ToolTip="{Binding Localization.OpenSourceQuality}"
                               AutomationProperties.Name="{Binding Localization.OpenSourceQuality}" />
                    <ui:Button Grid.Column="2"
                               Margin="7,0,0,0"
                               Padding="7,3"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSourceReadyForRecipe, Converter={StaticResource BoolToVisibilityConverter}}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding LoadC3DSourceCommand}"
                               ToolTip="{Binding Localization.Open3DMap}"
                               AutomationProperties.Name="{Binding Localization.Open3DMap}" />
                </Grid>
            </Border>

            <Border x:Name="RecipeHealthCard"
                    Grid.Row="2"
                    Margin="0,0,0,7"
                    Padding="8,7"
                    Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{Binding HasSelectedPipelineStep, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.AutomationId="RecipeHealthCard">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThreeD.PrimaryTextBrush}"
                                   Text="{Binding Localization.RecipeHealth}" />
                        <TextBlock Grid.Column="1"
                                   Margin="7,0,0,0"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource ThreeD.AccentBrush}"
                                   Text="{Binding RecipeHealthSummary}" />
                    </Grid>
                    <TextBlock Margin="0,4,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                               Text="{Binding RecipeHealthCountsPrimary}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,1,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                               Text="{Binding RecipeHealthCountsSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThreeD.AccentBrush}"
                               Text="{Binding SelectedRecipeHealthTitle}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding SelectedRecipeHealthTitle}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{Binding SelectedRecipeHealthDetail}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding SelectedRecipeHealthDetail}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="PreviousRecipeHealthIssueButton"
                                   Margin="0,0,3,0"
                                   Padding="6,3"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Content="{Binding Localization.PreviousRequirement}"
                                   Icon="{ui:SymbolIcon ArrowLeft24}"
                                   Command="{Binding PreviousRecipeHealthIssueCommand}"
                                   ToolTip="{Binding Localization.PreviousRequirement}"
                                   AutomationProperties.AutomationId="PreviousRecipeHealthIssue"
                                   AutomationProperties.Name="{Binding Localization.PreviousRequirement}" />
                        <ui:Button x:Name="NextRecipeHealthIssueButton"
                                   Grid.Column="1"
                                   Margin="3,0,0,0"
                                   Padding="6,3"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Content="{Binding Localization.NextRequirement}"
                                   Icon="{ui:SymbolIcon ArrowRight24}"
                                   Command="{Binding NextRecipeHealthIssueCommand}"
                                   ToolTip="{Binding Localization.NextRequirement}"
                                   AutomationProperties.AutomationId="NextRecipeHealthIssue"
                                   AutomationProperties.Name="{Binding Localization.NextRequirement}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ListBox x:Name="RecipeStepList"
                     Grid.Row="3"
                     ItemsSource="{Binding PipelineSteps}"
                     SelectedItem="{Binding SelectedPipelineStep, Mode=TwoWay}"
                     behaviors:ScrollIntoViewOnSelectionChangedBehavior.IsEnabled="True"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.ItemStatus="{Binding PipelineSteps.Count}"
                     AutomationProperties.Name="Ordered inspection recipe chain">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6"
                                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="23"
                                        Height="23"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ThreeD.CommandBarBrush}"
                                        CornerRadius="12">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ThreeD.AccentBrush}"
                                               Text="{Binding Order}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ToolName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="6,0,0,0"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource ThreeD.InfoBrush}"
                                                   Text="{Binding State}" />
                                    </Grid>
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="9"
                                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                               Text="{Binding Id}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="4"
                    Margin="0,7,0,0"
                    Padding="8"
                    Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                    BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="{Binding HasSelectedPipelineStep, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTeachingMode, ElementName=RecipeChainRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Margin="0,0,0,6"
                            Padding="7,5"
                            Background="{DynamicResource ThreeD.CommandBarBrush}"
                            BorderBrush="{DynamicResource ThreeD.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="{Binding HasThicknessRepeatGroup, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.AutomationId="ThicknessRepeatGroup">
                        <StackPanel>
                            <TextBlock FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThreeD.AccentBrush}"
                                       Text="{Binding ThicknessRepeatGroupSummary}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="8.5"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                       Text="{Binding ThicknessRepeatGroupMembers}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ThicknessRepeatGroupMembers}" />
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="10.5"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedPipelineStepTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,6,0,0">
                        <ui:Button Margin="0,0,4,4"
                                   Padding="7,3"
                                   Content="{Binding Localization.MoveUp}"
                                   Command="{Binding MoveSelectedStepUpCommand}"
                                   AutomationProperties.Name="{Binding Localization.MoveUp}" />
                        <ui:Button Margin="0,0,4,4"
                                   Padding="7,3"
                                   Content="{Binding Localization.MoveDown}"
                                   Command="{Binding MoveSelectedStepDownCommand}"
                                   AutomationProperties.Name="{Binding Localization.MoveDown}" />
                        <ui:Button Margin="0,0,4,4"
                                   Padding="7,3"
                                   Content="{Binding Localization.RemoveStep}"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding RemoveSelectedStepCommand}"
                                   AutomationProperties.Name="{Binding Localization.RemoveStep}" />
                        <ui:Button Padding="7,3"
                                   Content="{Binding Localization.OpenSelectedToolLab}"
                                   Icon="{ui:SymbolIcon WrenchScrewdriver24}"
                                   Command="{Binding OpenSelectedToolLabCommand}"
                                   Visibility="{Binding IsSelectedToolLabAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                   AutomationProperties.Name="{Binding Localization.OpenSelectedToolLab}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Expander Grid.Row="5"
                      Margin="0,7,0,0"
                      IsExpanded="False"
                      Header="{views:ThreeDText Key=ThreeD.Workspace.AdvancedRecipeExplorer, Korean='고급 레시피 탐색기', English='Advanced recipe explorer'}">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTeachingMode, ElementName=RecipeChainRoot}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Border Margin="0,5,0,0"
                        MaxHeight="520"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1">
                    <workbench:ToolboxEntityExplorerView DataContext="{Binding}" />
                </Border>
            </Expander>
        </Grid>
    </Border>
</UserControl>
