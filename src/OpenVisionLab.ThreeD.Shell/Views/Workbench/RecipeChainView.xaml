<UserControl x:Name="RecipeChainRoot"
             x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.RecipeChainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
             AutomationProperties.AutomationId="RecipeChain">
    <UserControl.Resources>
        <workbench:MeasurementNumberTextConverter x:Key="MeasurementNumberTextConverter" />
        <SolidColorBrush x:Key="FlowCardSurfaceBrush" Color="#1E252C" />
        <SolidColorBrush x:Key="FlowSourceSurfaceBrush" Color="#1A242A" />
        <SolidColorBrush x:Key="FlowCardBorderBrush" Color="#384451" />
        <SolidColorBrush x:Key="FlowSelectedBorderBrush" Color="#5E9F97" />
        <SolidColorBrush x:Key="FlowNodeHeaderHoverBrush" Color="#2C3640" />
        <SolidColorBrush x:Key="FlowNodeHeaderMutedBrush" Color="#8B98A6" />
        <Style x:Key="FlowNodeKeyboardFocusVisual" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
                <Border Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource ThreeD.FocusBrush}" CornerRadius="7" IsHitTestVisible="False" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <SolidColorBrush x:Key="FlowRegionBrush" Color="#B59CF2" />
        <SolidColorBrush x:Key="FlowDeviationBrush" Color="#F2B35E" />
        <DrawingBrush x:Key="FlowGridBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing><GeometryDrawing Brush="#17ADB9C6"><GeometryDrawing.Geometry><EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" /></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
        </DrawingBrush>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <workbench:HeightImageFrameConverter x:Key="HeightImageFrameConverter" />
        <SolidColorBrush x:Key="FlowThumbnailSurfaceBrush" Color="#0F1317" />
        <SolidColorBrush x:Key="FlowThumbnailBorderBrush" Color="#33404C" />
        <DropShadowEffect x:Key="FlowCardShadow" Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity=".28" />
        <DropShadowEffect x:Key="FlowSelectedCardShadow" Color="Black" BlurRadius="16" ShadowDepth="6" Direction="270" Opacity=".35" />
        <Style x:Key="FlowReadinessCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="2,0" />
            <Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="FlowPortIssueDetails">
            <StackPanel>
                <TextBlock x:Name="FlowInputIssueDetail" Margin="0,4,0,5" FontSize="11.5" Text="{Binding InputPortDetail}" TextWrapping="Wrap" TextTrimming="None"
                           Foreground="{DynamicResource ThreeD.WarningBrush}" Visibility="{Binding InputPortHasIssue, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock x:Name="FlowOutputIssueDetail" Margin="0,4,0,5" FontSize="11.5" Text="{Binding OutputPortDetail}" TextWrapping="Wrap" TextTrimming="None"
                           Foreground="{DynamicResource ThreeD.WarningBrush}" Visibility="{Binding OutputPortHasIssue, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="FlowThumbnailFrameStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource FlowThumbnailBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" /><Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="FlowSelectionRingStyle" TargetType="Border">
            <Setter Property="Margin" Value="-1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource FlowSelectedBorderBrush}" /><Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FlowSourceQualityBadgeStyle" TargetType="Button">
            <Setter Property="Padding" Value="4,1" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="BadgeSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BadgeSurface" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BadgeSurface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BadgeSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="BadgeSurface" Property="Opacity" Value=".65" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="FlowInputThumbnail">
            <Grid Background="{StaticResource FlowThumbnailSurfaceBrush}" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
            <Viewbox Stretch="Fill">
                <Grid Width="64" Height="42" ClipToBounds="True"><Grid.Clip><RectangleGeometry Rect="0,0,64,42" RadiusX="3" RadiusY="3" /></Grid.Clip>
                    <Image Stretch="Fill" Source="{Binding PreviewFrame, Converter={StaticResource HeightImageFrameConverter}}" />
                    <Canvas Visibility="{Binding HasSelectionPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Rectangle Canvas.Left="{Binding SelectionPreviewLeft}" Canvas.Top="{Binding SelectionPreviewTop}"
                                   Width="{Binding SelectionPreviewWidth}" Height="{Binding SelectionPreviewHeight}"
                                   Stroke="{StaticResource FlowRegionBrush}" StrokeThickness="1.5" Fill="#30B59CF2" />
                    </Canvas>
                </Grid>
            </Viewbox><Border Style="{StaticResource FlowThumbnailFrameStyle}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FlowSecondaryInputGlyph"><Border Margin="0,1,3,1" ToolTip="{Binding AccessibleName}" AutomationProperties.Name="{Binding AccessibleName}">
            <TextBlock FontSize="11" Foreground="{StaticResource FlowRegionBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="◇" /><Style.Triggers><DataTrigger Binding="{Binding IsRegionInput}" Value="True"><Setter Property="Text" Value="□" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Border></DataTemplate>
        <Style x:Key="ReadinessGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="·" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Text" Value="✓" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FlowReadinessCircleStyle" TargetType="Border">
            <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="Margin" Value="0,3,0,2" />
            <Setter Property="CornerRadius" Value="11" /><Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.MutedTextBrush}" /><Setter Property="Background" Value="{DynamicResource ThreeD.DockHeaderBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FlowHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="HeaderSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FlowAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border x:Name="AddSurface" Background="{TemplateBinding Background}" CornerRadius="7" />
                    <Rectangle x:Name="AddOutline" RadiusX="7" RadiusY="7" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" StrokeDashArray="3,2" />
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddSurface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /><Setter TargetName="AddOutline" Property="Stroke" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="AddSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /><Setter TargetName="AddOutline" Property="Stroke" Value="{DynamicResource ThreeD.AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AddOutline" Property="Stroke" Value="{DynamicResource ThreeD.FocusBrush}" /><Setter TargetName="AddOutline" Property="StrokeDashArray" Value="1" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Opacity" Value=".65" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FlowNextIssueButtonStyle" TargetType="Button" BasedOn="{StaticResource FlowAddButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="NextSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NextSurface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="NextSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NextSurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NextRecipeHealthIssueDetail}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="FlowNodeExpanderTemplate" TargetType="Expander">
                <StackPanel>
                    <Grid MinHeight="30" Margin="8,0,3,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        <ToggleButton x:Name="NodeHeaderToggle" behaviors:PointerHoverBehavior.IsEnabled="True" Grid.Column="1" Width="22" Height="22" Padding="0" Cursor="Hand" FocusVisualStyle="{StaticResource FlowNodeKeyboardFocusVisual}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ToolTip="{views:ThreeDText Key=ThreeD.Flow.ToggleDetails, Korean='접기 / 펼치기', English='Collapse / expand'}"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Flow.ToggleDetails, Korean='접기 / 펼치기', English='Collapse / expand'}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="NodeHeaderSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                    <ui:SymbolIcon x:Name="ExpandGlyph" Symbol="ChevronDown24" FontSize="12" Foreground="{StaticResource FlowNodeHeaderMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="behaviors:PointerHoverBehavior.IsHovered" Value="True"><Setter TargetName="NodeHeaderSurface" Property="Background" Value="{StaticResource FlowNodeHeaderHoverBrush}" /><Setter TargetName="ExpandGlyph" Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="NodeHeaderSurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ExpandGlyph" Property="Symbol" Value="ChevronUp24" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ExpandGlyph" Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                    <ContentPresenter x:Name="NodeBody" ContentSource="Content" Visibility="Collapsed" />
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="NodeBody" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="FlowNodeExpanderStyle" TargetType="Expander">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
            <Setter Property="Template" Value="{StaticResource FlowNodeExpanderTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="IsExpanded" Value="True" /></DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=FlowExpandAllToggle}" Value="True"><Setter Property="IsExpanded" Value="True" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecipeFlowPortButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource FlowCardSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditFlowConnection, RelativeSource={RelativeSource AncestorType={x:Type workbench:RecipeChainView}}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PortRow" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="PortVisual" Width="11" Height="11" Margin="-19,0,0,0" VerticalAlignment="Center"
                                         Fill="{TemplateBinding BorderBrush}"
                                         Stroke="{DynamicResource ThreeD.AccentBrush}" StrokeThickness="2" />
                                <Rectangle x:Name="TypedPortVisual" Width="10" Height="10" Margin="-19,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource ThreeD.AccentBrush}" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" Margin="0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HorizontalContentAlignment" Value="Right">
                                <Setter TargetName="PortVisual" Property="Grid.Column" Value="2" />
                                <Setter TargetName="PortVisual" Property="Margin" Value="0,0,-19,0" />
                                <Setter TargetName="TypedPortVisual" Property="Grid.Column" Value="2" />
                                <Setter TargetName="TypedPortVisual" Property="Margin" Value="0,0,-19,0" />
                                <Setter TargetName="PortVisual" Property="Fill" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter TargetName="PortVisual" Property="Stroke" Value="{DynamicResource ThreeD.PanelBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="MeasurementResult">
                                <Setter TargetName="PortVisual" Property="Opacity" Value="0" />
                                <Setter TargetName="TypedPortVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TypedPortVisual" Property="Fill" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
                                <Setter TargetName="TypedPortVisual" Property="LayoutTransform"><Setter.Value><RotateTransform Angle="45" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="Tag" Value="ConnectedRegionArtifact">
                                <Setter TargetName="PortVisual" Property="Opacity" Value="0" />
                                <Setter TargetName="TypedPortVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TypedPortVisual" Property="Fill" Value="{StaticResource FlowRegionBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="GridRectangle">
                                <Setter TargetName="PortVisual" Property="Opacity" Value="0" />
                                <Setter TargetName="TypedPortVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TypedPortVisual" Property="Fill" Value="{StaticResource FlowRegionBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Reference GridRectangle">
                                <Setter TargetName="PortVisual" Property="Opacity" Value="0" />
                                <Setter TargetName="TypedPortVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TypedPortVisual" Property="Fill" Value="{StaticResource FlowRegionBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Measurement GridRectangle">
                                <Setter TargetName="PortVisual" Property="Opacity" Value="0" />
                                <Setter TargetName="TypedPortVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TypedPortVisual" Property="Fill" Value="{StaticResource FlowRegionBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Published ConnectedRegionArtifact">
                                <Setter TargetName="PortVisual" Property="Opacity" Value="0" />
                                <Setter TargetName="TypedPortVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TypedPortVisual" Property="Fill" Value="{StaticResource FlowRegionBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="EditableRegionArtifact">
                                <Setter TargetName="PortVisual" Property="Opacity" Value="0" />
                                <Setter TargetName="TypedPortVisual" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TypedPortVisual" Property="Fill" Value="{StaticResource FlowRegionBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="SignedDeltaHeightField">
                                <Setter TargetName="PortVisual" Property="Stroke" Value="{StaticResource FlowDeviationBrush}" />
                                <Setter TargetName="PortVisual" Property="Fill" Value="{StaticResource FlowDeviationBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PortRow" Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                <Setter TargetName="PortRow" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PortRow" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                                <Setter TargetName="PortRow" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                                <Setter TargetName="PortVisual" Property="Fill" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PortRow" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PortRow" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="PortVisual" Property="Fill" Value="{DynamicResource ThreeD.MutedTextBrush}" />
                                <Setter TargetName="PortVisual" Property="Stroke" Value="{DynamicResource ThreeD.PanelBrush}" />
                                <Setter TargetName="PortRow" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False" />
                                    <Condition Property="HorizontalContentAlignment" Value="Left" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PortVisual" Property="Fill" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="PortVisual" Property="Stroke" Value="{DynamicResource ThreeD.MutedTextBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTeachingMode, RelativeSource={RelativeSource AncestorType={x:Type workbench:RecipeChainView}}}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConnectedFlowInputButtonStyle" TargetType="Button" BasedOn="{StaticResource RecipeFlowPortButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="{x:Type workbench:RecipeChainView}"><Style.Triggers>
            <Trigger Property="IsTeachingMode" Value="True"><Setter Property="Margin" Value="-2,0" /></Trigger>
        </Style.Triggers></Style>
    </UserControl.Style>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelFlowConnectionCommand}" />
    </UserControl.InputBindings>

    <Border Padding="0"
            Background="{DynamicResource ThreeD.PanelBrush}"
            TextElement.Foreground="{DynamicResource ThreeD.TextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Background="{DynamicResource ThreeD.DockHeaderBrush}">
                <Grid Height="34" Margin="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Flowchart24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                        <TextBlock FontSize="12.5" Style="{DynamicResource ThreeD.PanelTitleTextStyle}"
                                   Text="{views:ThreeDText Key=ThreeD.Workspace.ToolConnections, Korean='흐름도', English='Flow'}" />
                        <TextBlock Margin="7,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{Binding PipelineSteps.Count}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <ui:Button x:Name="RecipeFlowAddTool"
                               Margin="0"
                               Padding="0"
                               Width="26" Height="26"
                               Background="Transparent" BorderBrush="Transparent"
                               VerticalAlignment="Center"
                               MinHeight="26"
                               Content=""
                               Icon="{ui:SymbolIcon Add24}"
                               Command="{Binding OpenToolLibraryCommand}"
                               Visibility="{Binding IsTeachingMode, ElementName=RecipeChainRoot, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="{Binding Localization.AddToolFromCatalogToolTip}"
                               AutomationProperties.Name="{Binding Localization.AddToolFromCatalog}"
                               AutomationProperties.HelpText="{Binding Localization.AddToolFromCatalogToolTip}" />
                    <ToggleButton x:Name="FlowExpandAllToggle" Checked="OnExpandAllChanged" Unchecked="OnExpandAllChanged" Width="26" Height="26" Padding="3" Margin="2,0,0,0" Style="{StaticResource FlowHeaderToggleStyle}" IsChecked="False" ToolTip="{views:ThreeDText Key=ThreeD.Flow.ExpandAll, Korean='모든 노드 펼치기', English='Expand all nodes'}" AutomationProperties.AutomationId="FlowExpandAll"><ui:SymbolIcon Symbol="ChevronDown24" FontSize="14" /></ToggleButton>
                    <ToggleButton x:Name="FlowViewOptionsToggle" Width="26" Height="26" Margin="2,0,0,0" Padding="0"
                                  Style="{StaticResource FlowHeaderToggleStyle}" IsChecked="False"
                                  Visibility="{Binding IsTeachingMode, ElementName=RecipeChainRoot, Converter={StaticResource BoolToVisibilityConverter}}"
