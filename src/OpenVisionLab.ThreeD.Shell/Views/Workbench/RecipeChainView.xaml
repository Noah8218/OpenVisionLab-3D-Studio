                <WrapPanel VerticalAlignment="Center">
                    <ui:Button x:Name="RecipeFlowZoomOutButton"
                               Margin="0,0,4,4"
                               Padding="7,3"
                               Content="−"
                               Command="{Binding DecreaseFlowZoomCommand, ElementName=RecipeChainRoot}"
                               ToolTip="{views:ThreeDText Key=ThreeD.Workspace.FlowZoomOut, Korean='연결도 축소', English='Zoom out flow'}"
                               AutomationProperties.AutomationId="RecipeFlowZoomOut"
                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.FlowZoomOut, Korean='연결도 축소', English='Zoom out flow'}" />
                    <Border MinWidth="38"
                            Height="27"
                            Margin="0,0,4,4"
                            Padding="5,0"
                            Background="{DynamicResource ThreeD.PanelBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock x:Name="RecipeFlowZoomValue"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Text="{Binding FlowZoom, ElementName=RecipeChainRoot, StringFormat={}{0:P0}}"
                                   AutomationProperties.AutomationId="RecipeFlowZoomValue" />
                    </Border>
                    <ui:Button x:Name="RecipeFlowZoomInButton"
                               Margin="0,0,4,4"
                               Padding="7,3"
                               Content="＋"
                               Command="{Binding IncreaseFlowZoomCommand, ElementName=RecipeChainRoot}"
                               ToolTip="{views:ThreeDText Key=ThreeD.Workspace.FlowZoomIn, Korean='연결도 확대', English='Zoom in flow'}"
                               AutomationProperties.AutomationId="RecipeFlowZoomIn"
                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.FlowZoomIn, Korean='연결도 확대', English='Zoom in flow'}" />
                    <ui:Button x:Name="RecipeFlowResetButton"
                               Margin="0,0,4,4"
                               Padding="7,3"
                               Icon="{ui:SymbolIcon ArrowReset24}"
                               ToolTip="{views:ThreeDText Key=ThreeD.Workspace.ResetFlowLayout, Korean='노드 배치 정리', English='Reset layout'}"
                               Command="{Binding ResetFlowViewCommand, ElementName=RecipeChainRoot}"
                               AutomationProperties.AutomationId="RecipeFlowReset"
                               AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Workspace.ResetFlowLayout, Korean='노드 배치 정리', English='Reset layout'}" />
                    <ui:Button x:Name="RecipeFlowFocusSelectedButton"
                               Margin="0,0,0,4"
                               Padding="7,3"
                               Icon="{ui:SymbolIcon TargetArrow24}"
