<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.LineIntersectionEvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
             AutomationProperties.AutomationId="LineIntersectionEvidenceView">
    <UserControl.Resources>
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
    </UserControl.Resources>
    <Grid Margin="12,8" Background="{DynamicResource ThreeD.PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{DynamicResource ThreeD.DockPanelTitleTextStyle}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.Title, Korean='교점 정보', English='Intersection Evidence'}" />
                <TextBlock Style="{DynamicResource ThreeD.DockPanelCaptionTextStyle}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.Caption, Korean='적용된 선 입력과 현재 최근접 접근 결과입니다.', English='Applied line inputs and the current closest-approach result.'}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Style="{DynamicResource ThreeD.DockPanelStatusCardStyle}"

                    AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.ReadOnlyAction, Korean='읽기 전용 교점 정보', English='Read-only intersection evidence'}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Width="13" Height="13" Margin="0,0,4,0" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Symbol="Document24" />
                    <TextBlock FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.ReadOnly, Korean='읽기 전용', English='Read-only'}" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="1"
                Margin="0,8,0,6"
                Padding="10,8"
                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <StackPanel>
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.CurrentState, Korean='현재 상태', English='Current state'}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ViewerRuntimeTextConverter}" ConverterParameter="GeometryEvidenceSummary">
                            <Binding Path="LineIntersectionExecutionSummary" />
                            <Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.PublishedInputs, Korean='적용된 입력', English='Applied inputs'}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ViewerRuntimeTextConverter}" ConverterParameter="GeometryEvidenceSummary">
                            <Binding Path="LineIntersectionUpstreamSummary" />
                            <Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.ClosestApproach, Korean='최근접 접근 결과', English='Closest-approach result'}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource ThreeD.PrimaryTextBrush}" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ViewerRuntimeTextConverter}" ConverterParameter="GeometryEvidenceSummary">
                            <Binding Path="LineIntersectionEvidenceSummary" />
                            <Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ViewerRuntimeTextConverter}" ConverterParameter="GeometryEvidenceSummary">
                            <Binding Path="LineIntersectionOutputHashSummary" />
                            <Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2"
                   FontSize="12"
                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.Guidance, Korean='중점은 입력 데이터 좌표계에서 승인된 최근접 쌍 앵커를 나타냅니다. 보정된 물리적 교점은 아닙니다.', English='Midpoint represents the accepted closest-pair anchor in source coordinates; it is not a calibrated physical intersection.'}" />
    </Grid>
</UserControl>
