<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.LineIntersectionEvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
             AutomationProperties.AutomationId="LineIntersectionEvidenceView">
    <Grid Margin="12,8" Background="{DynamicResource ThreeD.PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{DynamicResource ThreeD.DockPanelTitleTextStyle}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.Title, Korean='교차점 증거', English='Intersection Evidence'}" />
                <TextBlock Style="{DynamicResource ThreeD.DockPanelCaptionTextStyle}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.Caption, Korean='Published 선 입력과 현재 최근접 접근 결과입니다.', English='Published line inputs and the current closest-approach result.'}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Style="{DynamicResource ThreeD.DockPanelStatusCardStyle}"
                    ToolTip="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.ReadOnlyTip, Korean='이 창은 증거만 표시하며 검사를 실행하지 않습니다.', English='This pane reports evidence only; it never runs the inspection.'}"
                    AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.ReadOnlyAction, Korean='읽기 전용 교차점 증거', English='Read-only intersection evidence'}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Width="13" Height="13" Margin="0,0,4,0" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Symbol="Document24" />
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                               Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.ReadOnly, Korean='읽기 전용', English='Read-only'}" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="1"
                Margin="0,8,0,6"
                Padding="10,8"
                Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <StackPanel>
                <TextBlock FontSize="10"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.CurrentState, Korean='현재 상태', English='Current state'}" />
                <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding LineIntersectionExecutionSummary}" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.PublishedInputs, Korean='Published 입력', English='Published inputs'}" />
                <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding LineIntersectionUpstreamSummary}" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                           Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.ClosestApproach, Korean='최근접 접근 결과', English='Closest-approach result'}" />
                <TextBlock Margin="0,2,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThreeD.PrimaryTextBrush}" TextWrapping="Wrap" Text="{Binding LineIntersectionEvidenceSummary}" />
                <TextBlock Margin="0,8,0,0" FontSize="9.5" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{Binding LineIntersectionOutputHashSummary}" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2"
                   FontSize="9.5"
                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.IntersectionEvidence.Guidance, Korean='중점은 소스 좌표계에서 승인된 최근접 쌍 앵커를 나타내며, 보정된 물리적 교차점이 아닙니다.', English='Midpoint represents the accepted closest-pair anchor in source coordinates; it is not a calibrated physical intersection.'}" />
    </Grid>
</UserControl>
