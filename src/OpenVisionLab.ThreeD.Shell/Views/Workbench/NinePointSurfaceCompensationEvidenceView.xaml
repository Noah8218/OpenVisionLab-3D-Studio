<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.NinePointSurfaceCompensationEvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:local="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             AutomationProperties.AutomationId="NinePointSurfaceCompensationEvidenceView">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectedStepNinePointCompensation}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <local:HeightImageFrameConverter x:Key="HeightFrameConverter" />
    </UserControl.Resources>
    <StackPanel Margin="12,8" Background="{DynamicResource ThreeD.PanelBrush}">
        <TextBlock Text="{Binding NinePointCompensationSummary}" TextWrapping="Wrap" Margin="0,0,0,6"
                   Foreground="{DynamicResource ThreeD.PrimaryTextBrush}" FontSize="12" />
        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                   Text="{i18n:ThreeDText Key=ThreeD.NinePoint.Coordinates, Korean='행·열은 0부터 시작합니다. X·Y는 원본 격자 좌표이며 높이 단위는 raw-height입니다.', English='Rows and columns start at 0. X/Y use source grid coordinates; height unit is raw-height.'}" />
        <ComboBox SelectedValue="{Binding NinePointPreviewKind, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6"
                  AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.NinePoint.Map, Korean='높이 맵', English='Height map'}">
            <ComboBoxItem Tag="Source" Content="{i18n:ThreeDText Key=ThreeD.NinePoint.Source, Korean='원본 높이', English='Original height'}" />
            <ComboBoxItem Tag="Background" Content="{i18n:ThreeDText Key=ThreeD.NinePoint.Background, Korean='배경 곡면', English='Background surface'}" />
            <ComboBoxItem Tag="Corrected" Content="{i18n:ThreeDText Key=ThreeD.NinePoint.Corrected, Korean='보정 높이', English='Compensated height'}" />
        </ComboBox>
        <Border Padding="8" Background="{DynamicResource ThreeD.PanelAlternateBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
            <Viewbox Stretch="Uniform" MaxHeight="240" HorizontalAlignment="Center">
                <Grid Width="{Binding NinePointPreviewFrame.Width}" Height="{Binding NinePointPreviewFrame.Height}">
                    <Image Source="{Binding NinePointPreviewFrame.DefaultDisplayFrame, Converter={StaticResource HeightFrameConverter}}" Stretch="Fill" />
                    <ItemsControl ItemsSource="{Binding NinePointCompensationRows}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                <Setter Property="Canvas.Top" Value="{Binding PixelY}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="4" Height="4" Margin="-2" Stroke="{DynamicResource ThreeD.PrimaryTextBrush}"
                                         Fill="{DynamicResource ThreeD.PanelBrush}" StrokeThickness="1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Viewbox>
        </Border>
        <DataGrid ItemsSource="{Binding NinePointCompensationRows}" AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="False" EnableColumnVirtualization="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                  Style="{DynamicResource ThreeD.CalibrationDataGridStyle}" Margin="0,8,0,0" MinColumnWidth="48"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.NinePoint.Points, Korean='9점 높이와 편차', English='Nine-point heights and deviations'}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="32" MinWidth="32" />
                <DataGridTemplateColumn Header="X / Y" MinWidth="86">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock>
                        <Run Text="{Binding X, Mode=OneWay, StringFormat='{}{0:0.##}'}" /><Run Text=" / " /><Run Text="{Binding Y, Mode=OneWay, StringFormat='{}{0:0.##}'}" />
                    </TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{i18n:ThreeDText Key=ThreeD.NinePoint.Height, Korean='높이', English='Height'}" Binding="{Binding Height, StringFormat='{}{0:0.##}'}" />
                <DataGridTextColumn Header="{i18n:ThreeDText Key=ThreeD.NinePoint.Plane, Korean='기준면', English='Plane'}" Binding="{Binding Plane, StringFormat='{}{0:0.##}'}" />
                <DataGridTextColumn Header="{i18n:ThreeDText Key=ThreeD.NinePoint.Residual, Korean='편차', English='Deviation'}" Binding="{Binding Residual, StringFormat='{}{0:0.##}'}" />
                <DataGridTextColumn Header="{i18n:ThreeDText Key=ThreeD.NinePoint.After, Korean='보정 후', English='Compensated'}" Binding="{Binding Compensated, StringFormat='{}{0:0.##}'}" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
