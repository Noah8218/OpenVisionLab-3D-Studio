<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workbench.RunLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:logView="clr-namespace:OpenVisionLab.Logging.Controls.View;assembly=OpenVisionLab.Logging.Controls"
             AutomationProperties.AutomationId="WorkbenchRunLog">
    <TabControl Background="{DynamicResource ThreeD.PanelBrush}">
        <TabItem Header="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.ApplicationLog, Korean='애플리케이션 로그', English='Application Log'}">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource ThreeD.DockPanelTitleTextStyle}"
                                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.ApplicationLog, Korean='애플리케이션 로그', English='Application Log'}" />
                        <TextBlock Style="{DynamicResource ThreeD.DockPanelCaptionTextStyle}"
                                   Text="{Binding Localization.WorkbenchApplicationLogRetention}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{DynamicResource ThreeD.DockPanelStatusCardStyle}"
                            ToolTip="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.ApplicationDiagnosticsTip, Korean='Workbench의 애플리케이션 진단 정보는 읽기 전용입니다.', English='Application diagnostics are read-only in the workbench.'}"
                            AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.ApplicationDiagnosticsAction, Korean='읽기 전용 애플리케이션 진단 정보', English='Read-only application diagnostics'}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Width="13" Height="13" Margin="0,0,4,0" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Symbol="Document24" />
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                       Text="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.ReadOnly, Korean='읽기 전용', English='Read-only'}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Padding="4"
                        Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <logView:LogPanelView />
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.WorkbenchSession, Korean='Workbench 세션', English='Workbench Session'}">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource ThreeD.DockPanelTitleTextStyle}"
                                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.WorkbenchSession, Korean='Workbench 세션', English='Workbench Session'}" />
                        <TextBlock Style="{DynamicResource ThreeD.DockPanelCaptionTextStyle}"
                                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.SessionCaption, Korean='이 레시피 세션의 순서화된 티칭, Preview, Publish 및 검증 활동입니다.', English='Ordered teaching, Preview, Publish, and validation activity for this recipe session.'}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{DynamicResource ThreeD.DockPanelStatusCardStyle}"
                            ToolTip="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.SessionActivityTip, Korean='세션 항목은 명시적인 Workbench 작업으로 생성됩니다.', English='Session entries are generated by explicit workbench actions.'}"
                            AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.SessionActivityAction, Korean='읽기 전용 세션 활동', English='Session activity is read-only'}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Width="13" Height="13" Margin="0,0,4,0" Foreground="{DynamicResource ThreeD.InfoBrush}" Symbol="History24" />
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThreeD.InfoBrush}"
                                       Text="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.Activity, Korean='활동', English='Activity'}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Border Padding="4"
                            Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ListBox Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding RunLog}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,3"
                                            Padding="6,4"
                                            Background="{DynamicResource ThreeD.ControlBrush}"
                                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{Binding Time}" />
                                            <TextBlock Grid.Column="1" Foreground="{DynamicResource ThreeD.AccentBrush}" Text="{Binding Category}" />
                                            <TextBlock Grid.Column="2"
                                                       Foreground="{DynamicResource ThreeD.TextBrush}"
                                                       Text="{Binding Message}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <TextBlock IsHitTestVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{i18n:ThreeDText Key=ThreeD.Workbench.RunLog.Empty, Korean='아직 세션 이벤트가 없습니다. 소스를 로드하거나 명시적인 티칭 작업을 시작하세요.', English='No session events yet. Load a source or use an explicit teaching action to begin.'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ThreeD.DockPanelCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RunLog.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
