<tooling:ToolLabWindowBase x:Class="OpenVisionLab.ThreeD.Shell.Views.Tooling.DatumPlaneDeviationToolLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
        xmlns:shell="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell"
        xmlns:shellChrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
        xmlns:tooling="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Tooling"
        Title="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumDeviation.WindowTitle, Korean='기준면 편차 도구 실험실 | OpenVisionLab 3D Studio', English='Datum Plane Deviation Tool Lab | OpenVisionLab 3D Studio'}"
        Width="1600" Height="920" MinWidth="1120" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource ThreeD.AppBackgroundBrush}"
        AutomationProperties.AutomationId="DatumPlaneDeviationToolLabWindow">
    <shellChrome:WindowChrome.WindowChrome>
        <shellChrome:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shellChrome:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="280" />
        </Grid.RowDefinitions>
        <shell:StudioTitleBarView TitleText="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumDeviation.Subtitle, Korean='기준면 편차 도구 실험실', English='Datum Plane Deviation Tool Lab'}" />
        <Border Grid.Row="1" Margin="16,16,16,0" Padding="16,12" Background="{DynamicResource ThreeD.PanelHeaderBrush}" BorderBrush="{DynamicResource ThreeD.PanelHeaderBorderBrush}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.TextBrush}" AutomationProperties.AutomationId="ToolLabSourceLoadError">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Content.HostState.Sources.CurrentC3DSourcePath, ElementName=InputViewerHost}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    <Run Text="{i18n:ThreeDText Key=ThreeD.ToolLab.SourceLoadError, Korean='입력을 열 수 없습니다. 파일을 확인하세요.', English='Cannot open the input. Check the file.'}" /><Run Text=" " /><Run Text="{Binding Content.HostState.ViewerStatus, ElementName=InputViewerHost, Mode=OneWay}" />
                </TextBlock>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,6,0" Content="{Binding Localization.ShowInput}" Icon="{ui:SymbolIcon Eye24}" Click="ShowInputsButton_Click" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumPlane.ShowInputTip, Korean='정확한 원본 C3D와 적용된 3점 평면을 표시합니다.', English='Show the exact raw C3D and Applied 3-Point Plane'}" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumPlane.ShowInputAction, Korean='기준면 편차 입력 보기', English='Show Datum Plane Deviation inputs'}" />
                    <ui:Button Appearance="Primary" Margin="0,0,6,0" Content="{Binding Localization.Preview}" Icon="{ui:SymbolIcon Play24}" Command="{Binding PreviewSelectedStepCommand}" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumPlane.PreviewTip, Korean='연결한 기준면에 대한 편차 계산', English='Calculate deviation from the connected datum plane'}" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumPlane.PreviewAction, Korean='기준면 편차 미리보기', English='Preview Datum Plane Deviation'}" />
                    <ui:Button Content="{Binding Localization.Publish}" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding PublishSelectedStepCommand}" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumPlane.PublishAction, Korean='기준면 편차 적용', English='Apply Datum Plane Deviation'}" />
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Grid.RowSpan="2" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <tooling:ToolLabReviewView Grid.Column="0" />
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="1" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="10,6" Background="{DynamicResource ThreeD.CommandBarBrush}"><StackPanel><DockPanel><ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="PointScan24" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumDeviation.Input, Korean='입력 | 원본 높이 데이터 + 적용된 기준 평면 + 격자 사각형', English='Input | raw C3D + Applied PlaneFeature + GridRectangle'}" /></DockPanel><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="DatumPlaneDeviationUpstreamSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel></Border>
                        <ContentControl x:Name="InputViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="1" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="10,6" Background="{DynamicResource ThreeD.CommandBarBrush}"><StackPanel><DockPanel><ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="DataHistogram24" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.DatumDeviation.Output, Korean='출력 | 읽기 전용 잔차 색상 오버레이', English='Output | read-only residual color overlay'}" /></DockPanel><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="DatumPlaneDeviationEvidenceSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ThreeD.DockPanelCaptionTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding HasCurrentDatumPlaneDeviationPreview}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Content.HostState.Sources.CurrentC3DSourcePath, ElementName=InputViewerHost}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Content.HostState.Sources.CurrentC3DSourcePath, ElementName=OutputViewerHost}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ThreeD.DockPanelCaptionTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasCurrentDatumPlaneDeviationPreview}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Content.HostState.Sources.CurrentC3DSourcePath, ElementName=InputViewerHost}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Content.HostState.Sources.CurrentC3DSourcePath, ElementName=OutputViewerHost}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="DatumPlaneDeviationExecutionSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock><Expander Margin="0,5,0,0" IsExpanded="False" Header="{i18n:ThreeDText Key=ThreeD.ToolLab.OutputDetails, Korean='출력 정보', English='Output details'}"><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="DatumPlaneDeviationOutputHashSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock></Expander></StackPanel></Border>
                        <ContentControl x:Name="OutputViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</tooling:ToolLabWindowBase>
