<tooling:ToolLabWindowBase x:Class="OpenVisionLab.ThreeD.Shell.Views.Tooling.HeightDifferenceEdgeToolLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
        xmlns:shell="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell"
        xmlns:shellChrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
        xmlns:tooling="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Tooling"
        Title="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.WindowTitle, Korean='높이차 엣지 도구 실험실 | OpenVisionLab 3D Studio', English='Height Difference Edge Tool Lab | OpenVisionLab 3D Studio'}"
        Width="1600"
        Height="920"
        MinWidth="1120"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThreeD.AppBackgroundBrush}"
        AutomationProperties.AutomationId="HeightDifferenceEdgeToolLabWindow">
    <shellChrome:WindowChrome.WindowChrome>
        <shellChrome:WindowChrome CaptionHeight="56"
                                  ResizeBorderThickness="6"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </shellChrome:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="280" />
        </Grid.RowDefinitions>

        <shell:StudioTitleBarView TitleText="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.Subtitle, Korean='높이차 엣지 도구 실험실', English='Edge Tool Lab'}" />

        <Border Grid.Row="1"
                Margin="16,16,16,0"
                Padding="16,12"
                Background="{DynamicResource ThreeD.PanelHeaderBrush}"
                BorderBrush="{DynamicResource ThreeD.PanelHeaderBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary" Margin="0,0,6,0"
                               Content="{Binding Localization.Preview}"
                               Icon="{ui:SymbolIcon Eye24}"
                               Command="{Binding PreviewSelectedStepCommand}"
                               ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.PreviewTip, Korean='적용된 필터 출력에서 에지 점 집합을 직접 생성합니다.', English='Explicitly create an EdgePointSet from the applied Filter output'}"
                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.PreviewAction, Korean='높이차 엣지 미리보기', English='Preview Height Difference Edge'}" />
                    <ui:Button Margin="0,0,6,0"
                               Content="{Binding Localization.ShowInput}"
                               Icon="{ui:SymbolIcon DataFunnel24}"
                               Click="ShowFilterInputButton_Click"
                               ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.ShowInputTip, Korean='적용된 필터 높이 데이터 입력 보기를 새로 고칩니다.', English='Refresh the exact applied FilteredHeightField input view'}"
                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.ShowInputAction, Korean='필터 높이 데이터 입력 보기', English='Show FilteredHeightField input'}" />
                    <ui:Button Content="{Binding Localization.Publish}"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Command="{Binding PublishSelectedStepCommand}"
                               ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.PublishTip, Korean='다시 실행하지 않고 현재 에지 점 집합 미리보기를 적용합니다.', English='Apply the current EdgePointSet Preview without running again'}"
                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.PublishAction, Korean='높이차 엣지 출력 적용', English='Apply Height Difference Edge output'}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.RowSpan="2" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <tooling:ToolLabReviewView Grid.Column="0" />
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="1"
                        Background="{DynamicResource ThreeD.PanelBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="10,6"
                                Background="{DynamicResource ThreeD.CommandBarBrush}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="DataFunnel24" />
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Localization.Input}" />
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.Input, Korean=' | 적용된 필터 높이 데이터', English=' | Applied FilteredHeightField'}" />
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="HeightDifferenceEdgeUpstreamSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock>
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="InputViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
                <Border Grid.Column="2"
                        Padding="1"
                        Background="{DynamicResource ThreeD.PanelBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="10,6"
                                Background="{DynamicResource ThreeD.CommandBarBrush}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="PointScan24" />
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Localization.Output}" />
                                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.Edge.Overlay, Korean=' | 에지 점 집합 오버레이', English=' | EdgePointSet Overlay'}" />
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="HeightDifferenceEdgeExecutionSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ThreeD.DockPanelCaptionTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding HeightDifferenceEdgeExecutionSummary}" Value="Recipe opened; Preview is required."><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <Expander Margin="0,5,0,0" IsExpanded="False" Header="{i18n:ThreeDText Key=ThreeD.ToolLab.OutputDetails, Korean='출력 정보', English='Output details'}"><TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="HeightDifferenceEdgeOutputHashSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock></Expander>
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="OutputViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</tooling:ToolLabWindowBase>
