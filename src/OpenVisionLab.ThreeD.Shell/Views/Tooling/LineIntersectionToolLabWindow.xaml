<tooling:ToolLabWindowBase x:Class="OpenVisionLab.ThreeD.Shell.Views.Tooling.LineIntersectionToolLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
        xmlns:shell="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell"
        xmlns:shellChrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
        xmlns:tooling="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Tooling"
        Title="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.WindowTitle, Korean='라인 교점 도구 실험실 | OpenVisionLab 3D Studio', English='Line Intersection Tool Lab | OpenVisionLab 3D Studio'}"
        Width="1600"
        Height="920"
        MinWidth="1120"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThreeD.AppBackgroundBrush}"
        AutomationProperties.AutomationId="LineIntersectionToolLabWindow">
    <shellChrome:WindowChrome.WindowChrome>
        <shellChrome:WindowChrome CaptionHeight="56"
                                  ResizeBorderThickness="6"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </shellChrome:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="280" />
        </Grid.RowDefinitions>

        <shell:StudioTitleBarView TitleText="OpenVisionLab 3D Studio"
                                  SubtitleText="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.Subtitle, Korean='라인 교점 도구 실험실', English='Line Intersection Tool Lab'}"
                                  StatusText="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.Status, Korean='적용된 라인 입력 / 코너 정보', English='Applied line inputs / corner evidence'}" />

        <Border Grid.Row="1"
                Margin="16,16,16,0"
                Padding="16,12"
                Background="{DynamicResource ThreeD.PanelHeaderBrush}"
                BorderBrush="{DynamicResource ThreeD.PanelHeaderBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Width="24" Height="24" Margin="0,0,9,0"
                                   Foreground="{DynamicResource ThreeD.AccentBrush}"
                                   Symbol="PointScan24" />
                    <StackPanel Grid.Column="1">
                        <TextBlock TextWrapping="Wrap" Style="{DynamicResource ThreeD.WindowHeaderTitleTextStyle}"
                                   Text="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.Title, Korean='전체 XYZ 라인 교점', English='Full-XYZ Line Intersection Tool Lab'}" />
                        <TextBlock TextWrapping="Wrap" Style="{DynamicResource ThreeD.WindowHeaderSubtitleTextStyle}"
                                   Text="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.Detail, Korean='선택한 두 직선을 비교합니다. 두 직선이 가장 가까운 위치의 중점을 기준점으로 사용하며, 교정된 실제 교점으로 사용할 수는 없습니다.', English='Two named Applied LineFeature inputs are compared. The output is a closest-approach midpoint anchor, never an implied calibrated intersection.'}" />
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary" Margin="0,0,6,0" Content="{Binding Localization.Preview}"
                               Icon="{ui:SymbolIcon Eye24}"
                               Command="{Binding PreviewSelectedStepCommand}"
                               ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.PreviewTip, Korean='적용된 두 피팅 라인을 직접 평가합니다.', English='Explicitly evaluate the two applied fitted lines'}"
                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.PreviewAction, Korean='라인 교점 미리보기', English='Preview Line Intersection'}" />
                    <ui:Button Margin="0,0,6,0" Content="{Binding Localization.ShowInput}"
                               Icon="{ui:SymbolIcon Branch24}"
                               Click="ShowInputsButton_Click"
                               ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.ShowInputTip, Korean='적용된 두 직선 오버레이를 새로 고칩니다.', English='Refresh the two exact applied LineFeature overlays'}"
                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.ShowInputAction, Korean='라인 교점 입력 보기', English='Show Line Intersection inputs'}" />
                    <ui:Button Content="{Binding Localization.Publish}"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Command="{Binding PublishSelectedStepCommand}"
                               ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.PublishTip, Korean='다시 실행하지 않고 현재 코너 앵커 미리보기를 적용합니다.', English='Apply the current corner-anchor Preview without running again'}"
                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.PublishAction, Korean='라인 교점 출력 적용', English='Apply Line Intersection output'}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.RowSpan="2" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <tooling:ToolLabReviewView Grid.Column="0" />
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="1" Background="{DynamicResource ThreeD.PanelBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="10,6" Background="{DynamicResource ThreeD.CommandBarBrush}">
                            <StackPanel>
                                    <DockPanel><ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="Branch24" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Localization.Inputs}" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.Inputs, Korean=' | 적용된 직선 A + B', English=' | Applied LineFeature A + B'}" /></DockPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="LineIntersectionUpstreamSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock>
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="InputViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="1" Background="{DynamicResource ThreeD.PanelBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="10,6" Background="{DynamicResource ThreeD.CommandBarBrush}">
                            <StackPanel>
                                    <DockPanel><ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="TargetArrow24" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Localization.Output}" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.LineIntersection.Output, Korean=' | 코너 앵커 정보', English=' | Corner Anchor Evidence'}" /></DockPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="LineIntersectionExecutionSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="LineIntersectionEvidenceSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock>
                                <Expander Margin="0,5,0,0" IsExpanded="False" Header="{i18n:ThreeDText Key=ThreeD.ToolLab.OutputDetails, Korean='출력 정보', English='Output details'}"><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="LineIntersectionOutputHashSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock></Expander>
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="OutputViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</tooling:ToolLabWindowBase>
