<tooling:ToolLabWindowBase x:Class="OpenVisionLab.ThreeD.Shell.Views.Tooling.LandmarkCorrespondenceToolLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
        xmlns:shell="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell"
        xmlns:shellChrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
        xmlns:tooling="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Tooling"
        xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
        Title="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.WindowTitle, Korean='랜드마크 대응 도구 실험실 | OpenVisionLab 3D Studio', English='Landmark Correspondence Tool Lab | OpenVisionLab 3D Studio'}"
        Width="1680"
        Height="940"
        MinWidth="1200"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ThreeD.AppBackgroundBrush}"
        AutomationProperties.AutomationId="LandmarkCorrespondenceToolLabWindow">
    <shellChrome:WindowChrome.WindowChrome>
        <shellChrome:WindowChrome CaptionHeight="56"
                                  ResizeBorderThickness="6"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </shellChrome:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>

        <shell:StudioTitleBarView TitleText="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.Subtitle, Korean='랜드마크 대응 도구 실험실', English='Landmark Correspondence Tool Lab'}" />

        <Border Grid.Row="1"
                Margin="16,16,16,0"
                Padding="16,12"
                Background="{DynamicResource ThreeD.PanelHeaderBrush}"
                BorderBrush="{DynamicResource ThreeD.PanelHeaderBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary" Margin="0,0,6,0" Content="{Binding Localization.Preview}"
                               Icon="{ui:SymbolIcon Eye24}"
                               Command="{Binding PreviewSelectedStepCommand}"
                               ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.PreviewTip, Korean='현재 적용된 교점 기준점 4개와 기준 사면체를 직접 검증합니다.', English='Explicitly validate the four current Applied CornerAnchors and reference tetrahedron'}"
                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.PreviewAction, Korean='랜드마크 대응 미리보기', English='Preview Landmark Correspondence'}" />
                    <ui:Button Margin="0,0,6,0" Content="{Binding Localization.ShowInput}"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="RefreshViewsButton_Click"
                               ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.ShowInputTip, Korean='입력 보기 새로고침', English='Refresh input view'}"
                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.ShowInputAction, Korean='랜드마크 대응 보기 새로 고침', English='Refresh Landmark Correspondence views'}" />
                    <ui:Button Content="{Binding Localization.Publish}"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Command="{Binding PublishSelectedStepCommand}"

                               AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.PublishAction, Korean='랜드마크 대응 출력 적용', English='Apply Landmark Correspondence output'}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.RowSpan="2" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <tooling:ToolLabReviewView Grid.Column="0" />
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.88*" />
                </Grid.ColumnDefinitions>
                <Border Padding="1" Background="{DynamicResource ThreeD.PanelBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="10,6" Background="{DynamicResource ThreeD.CommandBarBrush}">
                            <StackPanel>
                                    <DockPanel><ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="TargetArrow24" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Localization.Input}" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.SourceInputs, Korean=' | 원본 좌표계 / 적용된 교점 기준점 입력 4개', English=' | Source Frame / Four Applied CornerAnchor Inputs'}" /></DockPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.ToolTip><TextBlock Text="{Binding LandmarkCorrespondenceUpstreamSummary}" MaxWidth="560" TextWrapping="Wrap" /></TextBlock.ToolTip><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="LandmarkCorrespondenceSummary"><Binding Path="LandmarkCorrespondenceUpstreamSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock>
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="SourceViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="1" Background="{DynamicResource ThreeD.PanelBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="10,6" Background="{DynamicResource ThreeD.CommandBarBrush}">
                            <StackPanel>
                                    <DockPanel><ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="Cube24" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Localization.Output}" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.ReferenceEvidence, Korean=' | 기준 좌표 정보', English=' | Reference-coordinate evidence'}" /></DockPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.ToolTip><TextBlock Text="{Binding LandmarkCorrespondenceExecutionSummary}" MaxWidth="560" TextWrapping="Wrap" /></TextBlock.ToolTip><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="LandmarkCorrespondenceSummary"><Binding Path="LandmarkCorrespondenceExecutionSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ThreeD.DockPanelCaptionTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding LandmarkCorrespondenceExecutionSummary}" Value="Recipe opened; Preview is required."><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="LandmarkCorrespondenceSummary"><Binding Path="LandmarkCorrespondenceEvidenceSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock>
                                <Expander Margin="0,5,0,0" IsExpanded="False" Header="{i18n:ThreeDText Key=ThreeD.ToolLab.OutputDetails, Korean='출력 정보', English='Output details'}"><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="LandmarkCorrespondenceSummary"><Binding Path="LandmarkCorrespondenceOutputHashSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock></Expander>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.NoFabricatedSurface, Korean='티칭한 기준 좌표 집합을 표시합니다.', English='Shows the taught reference coordinates.'}" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,8,0"><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.ReferenceFrame, Korean='기준 좌표계', English='Reference frame'}" /><TextBox Margin="0,4,0,0" Text="{Binding CorrespondenceReferenceFrameId, UpdateSourceTrigger=PropertyChanged}" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.ReferenceFrameTip, Korean='기준 좌표계의 이름을 입력합니다.', English='Named reference coordinate frame'}" /></StackPanel>
                                <StackPanel><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.Unit, Korean='단위', English='Unit'}" /><TextBox Margin="0,4,0,0" Text="{Binding CorrespondenceReferenceUnit, UpdateSourceTrigger=PropertyChanged}" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.UnitTip, Korean='기준 좌표의 측정 단위를 입력합니다.', English='Reference-coordinate unit'}" /></StackPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,8">
                                <StackPanel Margin="0,0,8,0"><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.Provenance, Korean='출처', English='Provenance'}" /><TextBox Margin="0,4,0,0" Text="{Binding CorrespondenceReferenceProvenance, UpdateSourceTrigger=PropertyChanged}" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.ProvenanceTip, Korean='기준 좌표의 생성 출처를 입력합니다.', English='Reference coordinate provenance'}" /></StackPanel>
                                <StackPanel><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.Revision, Korean='리비전', English='Revision'}" /><TextBox Margin="0,4,0,0" Text="{Binding CorrespondenceReferenceRevision, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnlySampleView}" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.RevisionTip, Korean='기준 좌표의 리비전 식별자를 입력합니다.', English='Reference-coordinate revision'}" /></StackPanel>
                            </UniformGrid>
                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.MinimumTetrahedronVolume, Korean='최소 정규화 사면체 체적', English='Minimum normalized tetrahedron volume'}" />
                                <TextBox Margin="0,4,0,0" Width="180" HorizontalAlignment="Left" Text="{Binding CorrespondenceMinimumNormalizedTetrahedronVolume, UpdateSourceTrigger=PropertyChanged}" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.MinimumVolumeTip, Korean='0과 1 사이의 값이며 입력 데이터와 기준 모두 이 값을 초과해야 합니다.', English='Strictly between 0 and 1; source and reference must both exceed it'}" />
                            </StackPanel>
                            <Border Grid.Row="3" Padding="10" Background="{DynamicResource ThreeD.PanelAlternateBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.TaughtMappings, Korean='티칭된 대응', English='Taught mappings'}" />
                                    <DataGrid Grid.Row="1" Margin="0,8,0,8" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding SelectedCorrespondenceRows}" HeadersVisibility="Column" MinHeight="150" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Resources>
                                            <Style x:Key="CorrespondenceIdTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip">
                                                    <Setter.Value>
                                                        <ToolTip><TextBlock MaxWidth="560" TextWrapping="Wrap" Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}" /></ToolTip>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                        <DataGridTextColumn Header="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.SourceAnchor, Korean='원본 앵커', English='Source anchor'}" Binding="{Binding SourceEntityId}" Width="*" MinWidth="160" ElementStyle="{StaticResource CorrespondenceIdTextStyle}" />
                                        <DataGridTextColumn Header="{i18n:ThreeDText Key=ThreeD.ToolLab.Correspondence.Reference, Korean='기준점', English='Reference'}" Binding="{Binding ReferenceLandmarkId}" Width="*" MinWidth="160" ElementStyle="{StaticResource CorrespondenceIdTextStyle}" />
                                            <DataGridTextColumn Header="X" Binding="{Binding ReferencePosition.X, StringFormat=0.##}" Width="Auto" MinWidth="100" />
                                            <DataGridTextColumn Header="Y" Binding="{Binding ReferencePosition.Y, StringFormat=0.##}" Width="Auto" MinWidth="100" />
                                            <DataGridTextColumn Header="Z" Binding="{Binding ReferencePosition.Z, StringFormat=0.##}" Width="Auto" MinWidth="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="2" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap">
                                        <behaviors:WordBoundaryWrapBehavior.Text>
                                            <MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="LandmarkCorrespondenceSummary">
                                                <Binding Path="CorrespondenceSelectionSummary" />
                                                <Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" />
                                            </MultiBinding>
                                        </behaviors:WordBoundaryWrapBehavior.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</tooling:ToolLabWindowBase>
