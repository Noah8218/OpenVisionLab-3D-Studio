<tooling:ToolLabWindowBase x:Class="OpenVisionLab.ThreeD.Shell.Views.Tooling.ThreePointPlaneToolLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
        xmlns:shell="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell"
        xmlns:shellChrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
        xmlns:tooling="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Tooling"
        Title="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.WindowTitle, Korean='3포인트 평면 도구 실험실 | OpenVisionLab 3D Studio', English='3-Point Plane Tool Lab | OpenVisionLab 3D Studio'}"
        Width="1600" Height="920" MinWidth="1120" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource ThreeD.AppBackgroundBrush}"
        AutomationProperties.AutomationId="ThreePointPlaneToolLabWindow">
    <shellChrome:WindowChrome.WindowChrome>
        <shellChrome:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shellChrome:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="280" />
        </Grid.RowDefinitions>
        <shell:StudioTitleBarView TitleText="OpenVisionLab 3D Studio"
                                  SubtitleText="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.Subtitle, Korean='3포인트 평면 도구 실험실', English='3-Point Plane Tool Lab'}"
                                  StatusText="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.Status, Korean='순서가 있는 원본 높이 데이터 포인트 / 기준 평면 구성 정보', English='Ordered raw-C3D picks / datum-plane construction evidence'}" />
        <Border Grid.Row="1" Margin="16,16,16,0" Padding="16,12" Background="{DynamicResource ThreeD.PanelHeaderBrush}" BorderBrush="{DynamicResource ThreeD.PanelHeaderBorderBrush}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Width="24" Height="24" Margin="0,0,9,0" Foreground="{DynamicResource ThreeD.AccentBrush}" Symbol="PointScan24" />
                    <StackPanel Grid.Column="1">
                        <TextBlock TextWrapping="Wrap" Style="{DynamicResource ThreeD.WindowHeaderTitleTextStyle}" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.Title, Korean='전체 XYZ 3포인트 평면', English='Full-XYZ 3-Point Plane Tool Lab'}" />
                        <TextBlock TextWrapping="Wrap" Style="{DynamicResource ThreeD.WindowHeaderSubtitleTextStyle}" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.Detail, Korean='P1 → P2 → P3로 방향이 있는 기준 평면을 정의합니다. 현재 입력 데이터 높이만 해석하며 영역 피팅·어파인 적용·측정·OK/NG 판정은 수행하지 않습니다.', English='P1 → P2 → P3 define an oriented datum plane. The tool resolves current source height; it never fits a region, applies affine mapping, measures, or evaluates OK/NG.'}" />
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,6,0" Content="{i18n:ThreeDText Key=ThreeD.ToolLab.ShowPicks, Korean='포인트 보기', English='Show picks'}" Icon="{ui:SymbolIcon Eye24}" Click="ShowInputsButton_Click" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.ShowPicksTip, Korean='현재 입력 데이터와 지지 삼각형을 표시합니다.', English='Show the exact current source and support triangle'}" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.ShowPicksAction, Korean='3포인트 평면 입력 보기', English='Show 3-Point Plane inputs'}" />
                    <ui:Button Appearance="Primary" Margin="0,0,6,0" Content="{Binding Localization.Preview}" Icon="{ui:SymbolIcon Play24}" Command="{Binding PreviewSelectedStepCommand}" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.PreviewTip, Korean='작성된 순서의 포인트에 현재 원본 높이 데이터 값을 직접 해석합니다.', English='Resolve current raw C3D values for the authored ordered picks'}" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.PreviewAction, Korean='3포인트 평면 미리보기', English='Preview 3-Point Plane'}" />
                    <ui:Button Content="{Binding Localization.Publish}" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding PublishSelectedStepCommand}" ToolTip="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.PublishTip, Korean='다시 실행하지 않고 현재 3포인트 평면 미리보기를 적용합니다.', English='Apply the current 3-Point Plane Preview without running again'}" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.PublishAction, Korean='3포인트 평면 적용', English='Apply 3-Point Plane'}" />
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Grid.RowSpan="2" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <tooling:ToolLabReviewView Grid.Column="0" />
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="1" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="10,6" Background="{DynamicResource ThreeD.CommandBarBrush}"><StackPanel><DockPanel><ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="PointScan24" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.Input, Korean='입력 | 원본 높이 데이터 + 순서가 있는 점 3개', English='Input | raw C3D + three ordered grid points'}" /></DockPanel><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="ThreePointPlaneSelectionSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel></Border>
                        <ContentControl x:Name="InputViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="1" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="10,6" Background="{DynamicResource ThreeD.CommandBarBrush}"><StackPanel><DockPanel><ui:SymbolIcon Width="16" Height="16" Margin="0,0,5,0" Symbol="Branch24" /><TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.ToolLab.ThreePointPlane.Output, Korean='출력 | 방향이 있는 전체 XYZ 기준 평면', English='Output | Oriented full-XYZ datum plane'}" /></DockPanel><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="ThreePointPlaneExecutionSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock><Expander Margin="0,5,0,0" IsExpanded="False" Header="{i18n:ThreeDText Key=ThreeD.ToolLab.OutputDetails, Korean='출력 정보', English='Output details'}"><TextBlock TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" ><TextBlock.Text><MultiBinding Converter="{StaticResource ToolLabRuntimeText}" ConverterParameter="ToolLabSummary"><Binding Path="ThreePointPlaneOutputHashSummary" /><Binding Path="Revision" Source="{x:Static viewerLocalization:ViewerLocalization.Shared}" /></MultiBinding></TextBlock.Text></TextBlock></Expander></StackPanel></Border>
                        <ContentControl x:Name="OutputViewerHost" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</tooling:ToolLabWindowBase>
