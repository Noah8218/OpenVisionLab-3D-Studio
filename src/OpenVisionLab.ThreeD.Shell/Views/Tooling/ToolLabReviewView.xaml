<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Tooling.ToolLabReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             AutomationProperties.AutomationId="ToolLabReview">
    <UserControl.Resources>
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
    </UserControl.Resources>
    <Border Background="{DynamicResource ThreeD.PanelBrush}"
            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="10,6"
                    Background="{DynamicResource ThreeD.CommandBarBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Width="16"
                                       Height="16"
                                       Margin="0,1,6,0"
                                       Foreground="{DynamicResource ThreeD.InfoBrush}"
                                       Symbol="WrenchScrewdriver24" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding Localization.ToolLabReview}" />
                            <TextBlock Margin="0,1,0,0" FontSize="12"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                       Text="{Binding SelectedPipelineStep.ToolName}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="1"
                            DataContext="{Binding SelectedPipelineStep}"
                            Style="{DynamicResource ThreeD.WorkflowStateBadgeStyle}"
                            ToolTip="{Binding State, Converter={StaticResource ViewerRuntimeTextConverter}, ConverterParameter=PipelineStepState}"
                            AutomationProperties.Name="{Binding CanonicalStateAccessibleName}"
                            AutomationProperties.HelpText="{Binding State}">
                        <TextBlock MaxWidth="122"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Style="{DynamicResource ThreeD.WorkflowStateTextStyle}"
                                   Text="{Binding CanonicalStateLabel}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>
            <workbench:SelectedToolWorkspaceView Grid.Row="1" IsLabPresentation="True" />
        </Grid>
    </Border>
</UserControl>
