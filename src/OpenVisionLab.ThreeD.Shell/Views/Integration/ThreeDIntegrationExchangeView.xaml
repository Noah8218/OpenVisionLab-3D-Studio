<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Integration.ThreeDIntegrationExchangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:OpenVisionLab.ThreeD.Shell.Behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:shellViews="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell"
             xmlns:workbench="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             AutomationProperties.AutomationId="MachineExchangeWorkspace">
    <Grid Background="{DynamicResource ThreeD.PanelBrush}"
          TextElement.Foreground="{DynamicResource ThreeD.TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="16,10"
                Background="{DynamicResource ThreeD.CommandBarBrush}"
                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThreeD.TextBrush}"
                           Text="{views:ThreeDText Key=ThreeD.Exchange.Title, Korean='2D / Machine Studio TCP 연동', English='2D / Machine Studio TCP exchange'}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="14"
                        Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Exchange.Setup, Korean='연결 설정', English='Connection settings'}" />
                        <shellViews:PathInput Height="32"
                                              IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                              Text="{Binding IntegrationExchange.ExchangeRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              BrowseCommand="{Binding IntegrationExchange.BrowseExchangeRootCommand}"
                                              BrowseText="{views:ThreeDText Key=ThreeD.Exchange.Browse, Korean='찾아보기', English='Browse'}"
                                              InputAutomationId="IntegrationExchangeRoot"
                                              BrowseAutomationId="BrowseIntegrationExchangeRoot"
                                              AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Exchange.ExchangeFolderAccessible, Korean='Machine Studio 교환 폴더', English='Machine Studio exchange folder'}" />
                        <WrapPanel Margin="0,10,0,0">
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Save24}"
                                       Content="{views:ThreeDText Key=ThreeD.Exchange.SaveSetup, Korean='설정 저장', English='Save setup'}"
                                       Command="{Binding IntegrationExchange.SaveSetupCommand}"
                                       AutomationProperties.AutomationId="SaveIntegrationSetup" />
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       Content="{views:ThreeDText Key=ThreeD.Exchange.Reset, Korean='초기화', English='Reset'}"
                                       Command="{Binding IntegrationExchange.ResetSetupCommand}"
                                       Click="OnResetSetupClicked"
                                       AutomationProperties.AutomationId="ResetIntegrationSetup" />
                            <ui:Button x:Name="RefreshHandoffsButton"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Content="{views:ThreeDText Key=ThreeD.Exchange.Refresh, Korean='요청 새로고침', English='Refresh handoffs'}"
                                       Command="{Binding IntegrationExchange.RefreshHandoffsCommand}"
                                       AutomationProperties.AutomationId="RefreshIntegrationHandoffs" />
                        </WrapPanel>
                        <Expander Margin="0,12,0,0"
                                  IsExpanded="True"
                                  Header="{views:ThreeDText Key=ThreeD.Exchange.TcpSetup, Korean='TCP 직접 연결', English='Direct TCP connection'}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{views:ThreeDText Key=ThreeD.Exchange.TcpSetupHint, Korean='공유 키는 세션 메모리 또는 환경 변수에만 보관됩니다.', English='The shared key is kept only in session memory or an environment variable.'}" />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,6,8,0"
                                               Text="{views:ThreeDText Key=ThreeD.Exchange.ListenAddress, Korean='수신 주소', English='Listen address'}" />
                                    <TextBox Grid.Column="1"
                                             MinHeight="30"
                                             Padding="7,3"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                             Text="{Binding IntegrationExchange.TcpListenAddress, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="IntegrationListenAddress" />
                                    <TextBlock Grid.Row="1" Margin="0,10,8,0"
                                               Text="{views:ThreeDText Key=ThreeD.Exchange.ListenPort, Korean='수신 포트', English='Listen port'}" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Margin="0,6,0,0"
                                             MinHeight="30"
                                             Padding="7,3"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                             Text="{Binding IntegrationExchange.TcpListenPortText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="IntegrationListenPort" />
                                    <TextBlock Grid.Row="2" Margin="0,10,8,0"
                                               Text="{views:ThreeDText Key=ThreeD.Exchange.PeerHost, Korean='상대 주소', English='Peer host'}" />
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Margin="0,6,0,0"
                                             MinHeight="30"
                                             Padding="7,3"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                             Text="{Binding IntegrationExchange.TcpPeerHost, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="IntegrationPeerHost" />
                                    <TextBlock Grid.Row="3" Margin="0,10,8,0"
                                               Text="{views:ThreeDText Key=ThreeD.Exchange.PeerPort, Korean='상대 포트', English='Peer port'}" />
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Margin="0,6,0,0"
                                             MinHeight="30"
                                             Padding="7,3"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                             Text="{Binding IntegrationExchange.TcpPeerPortText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="IntegrationPeerPort" />
                                    <TextBlock Grid.Row="4" Margin="0,10,8,0"
                                               Text="{views:ThreeDText Key=ThreeD.Exchange.SharedKey, Korean='세션 공유 키', English='Session shared key'}" />
                                    <PasswordBox x:Name="IntegrationSharedKeyBox"
                                                 Grid.Row="4"
                                                 Grid.Column="1"
                                                 Margin="0,6,0,0"
                                                 MinHeight="30"
                                                 Padding="7,3"
                                                 VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                                 behaviors:PasswordChangedCommandBehavior.Command="{Binding IntegrationExchange.SetSessionSharedKeyCommand}"
                                                 AutomationProperties.AutomationId="IntegrationSharedKey" />
                                </Grid>
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                           Text="{Binding IntegrationExchange.SharedKeyStatusText}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="IntegrationSharedKeyStatus" />
                                <WrapPanel Margin="0,9,0,0">
                                    <ui:Button Margin="0,0,8,0"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Play24}"
                                               Content="{views:ThreeDText Key=ThreeD.Exchange.StartListener, Korean='수신 시작', English='Start listener'}"
                                               Command="{Binding IntegrationExchange.StartTcpListenerCommand}"
                                               AutomationProperties.AutomationId="StartIntegrationListener" />
                                    <ui:Button Margin="0,0,8,0"
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Dismiss24}"
                                               Content="{views:ThreeDText Key=ThreeD.Exchange.StopListener, Korean='수신 중지', English='Stop listener'}"
                                               Command="{Binding IntegrationExchange.StopTcpListenerCommand}"
                                               AutomationProperties.AutomationId="StopIntegrationListener" />
                                    <ui:Button Appearance="Secondary"
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               Content="{views:ThreeDText Key=ThreeD.Exchange.PingPeer, Korean='상대 Ping', English='Ping peer'}"
                                               Command="{Binding IntegrationExchange.PingTcpPeerCommand}"
                                               AutomationProperties.AutomationId="PingIntegrationPeer" />
                                </WrapPanel>
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource ThreeD.AccentBrush}"
                                           Text="{Binding IntegrationExchange.TcpListenerStatusText}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="IntegrationListenerStatus" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                        BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Exchange.Handoffs, Korean='Machine Studio 검사 요청', English='Machine Studio handoffs'}" />
                        <ListBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding IntegrationExchange.Transactions}"
                                 SelectedItem="{Binding IntegrationExchange.SelectedTransaction, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8"
                                            Background="{DynamicResource ThreeD.PanelBrush}"
                                            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ThreeD.TextBrush}" Text="{Binding Title}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{DynamicResource ThreeD.PanelAlternateBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Exchange.Review, Korean='검토 및 결과', English='Review and result'}" />
                        <TextBlock Margin="0,12,0,4"
                                   FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Exchange.InputViewer, Korean='수신된 높이 이미지', English='Received Height Image viewer'}" />
                        <Border MinHeight="420"
                                Background="{DynamicResource ThreeD.ViewportBrush}"
                                BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                AutomationProperties.AutomationId="IntegrationHeightImageViewer">
                            <workbench:HeightImageViewerView DataContext="{Binding Workbench.HeightImageViewer}" />
                        </Border>
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                   Text="{Binding IntegrationExchange.SelectedInputArtifactPath}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="IntegrationHeightImageSourcePath" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource ThreeD.AccentBrush}"
                                   Text="{Binding IntegrationExchange.SelectedSummary}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="IntegrationSequenceStatus" />
                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Exchange.Transfer, Korean='TCP 전송', English='TCP transaction transfer'}" />
                        <WrapPanel Margin="0,9,0,0">
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Send24}"
                                       Content="{views:ThreeDText Key=ThreeD.Exchange.Push, Korean='선택 항목 전송', English='Push selected'}"
                                       Command="{Binding IntegrationExchange.PushSelectedTransactionCommand}"
                                       AutomationProperties.AutomationId="PushIntegrationTransaction" />
                            <ui:Button Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Content="{views:ThreeDText Key=ThreeD.Exchange.Pull, Korean='ACK/Result 받기', English='Pull ACK/Result'}"
                                       Command="{Binding IntegrationExchange.PullSelectedTransactionCommand}"
                                       AutomationProperties.AutomationId="PullIntegrationTransaction" />
                        </WrapPanel>
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding IntegrationExchange.LastTcpTransferText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="IntegrationTransferStatus" />
                        <Separator Margin="0,16" />
                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Exchange.Acknowledge, Korean='1. 검사 요청 검토', English='1. Review handoff'}" />
                        <TextBox Margin="0,9,0,0"
                                 MinHeight="54"
                                 Padding="8,6"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding IntegrationExchange.RejectionReason, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Exchange.RejectionReasonAccessible, Korean='검사 요청 거부 사유', English='Handoff rejection reason'}" />
                        <WrapPanel Margin="0,9,0,0">
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon Checkmark24}"
                                       Content="{views:ThreeDText Key=ThreeD.Exchange.Accept, Korean='승인', English='Accept'}"
                                       Command="{Binding IntegrationExchange.AcceptCommand}" />
                            <ui:Button Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       Content="{views:ThreeDText Key=ThreeD.Exchange.Reject, Korean='거절', English='Reject'}"
                                       Command="{Binding IntegrationExchange.RejectCommand}" />
                        </WrapPanel>

                        <Separator Margin="0,16" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{views:ThreeDText Key=ThreeD.Exchange.RunInspection, Korean='2. 검사 실행 및 전송 준비', English='2. Run inspection and apply result'}" />
                        <ui:Button Margin="0,10,0,0"
                                   HorizontalAlignment="Left"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Content="{views:ThreeDText Key=ThreeD.Exchange.RunInspectionButton, Korean='검사 실행·전송 준비', English='Run inspection and apply result'}"
                                   Command="{Binding IntegrationExchange.RunInspectionCommand}"
                                   AutomationProperties.AutomationId="RunIntegrationInspection" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                   Text="{Binding IntegrationExchange.CurrentRunRecordSummary}"
                                   TextWrapping="Wrap" />
                        <ui:Button Margin="0,10,0,0"
                                   HorizontalAlignment="Left"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Send24}"
                                   Content="{views:ThreeDText Key=ThreeD.Exchange.PublishExisting, Korean='기존 기록으로 전송 준비', English='Prepare existing inspection record'}"
                                   Command="{Binding IntegrationExchange.PublishResultCommand}"
                                   AutomationProperties.AutomationId="PublishExistingIntegrationResult" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="14,0,14,12"
                Padding="11,8"
                Background="{DynamicResource ThreeD.InfoSurfaceBrush}"
                BorderBrush="{DynamicResource ThreeD.InfoBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold"
                               Text="{views:ThreeDText Key=ThreeD.Exchange.OperationState, Korean='TCP 작업 상태:', English='TCP action:'}" />
                    <TextBlock Margin="6,0,0,0"
                               Foreground="{DynamicResource ThreeD.AccentBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding IntegrationExchange.TcpOperationStateText}"
                               AutomationProperties.AutomationId="IntegrationTcpOperationState" />
                </StackPanel>
                <ui:Button Grid.RowSpan="2"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Content="{views:ThreeDText Key=ThreeD.Exchange.CancelTcpAction, Korean='현재 작업 취소', English='Cancel current action'}"
                           Command="{Binding IntegrationExchange.CancelTcpOperationCommand}"
                           AutomationProperties.AutomationId="CancelIntegrationTcpOperation"
                           AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Exchange.CancelTcpActionAccessible, Korean='현재 Integration Exchange TCP 작업 취소', English='Cancel the current Integration Exchange TCP action'}" />
                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource ThreeD.TextBrush}"
                           Text="{Binding IntegrationExchange.StatusText}"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="IntegrationTcpOperationStatus" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
