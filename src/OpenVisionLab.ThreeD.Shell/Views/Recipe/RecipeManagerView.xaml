<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Recipe.RecipeManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:shellViews="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell"
             xmlns:workbenchViews="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workbench"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             MinWidth="720"
             SizeChanged="OnViewSizeChanged"
             AutomationProperties.AutomationId="RecipeCenterView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DataTemplate x:Key="RecipeFilterCaptionTemplate"><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="300" /></DataTemplate>
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
        <ItemsPanelTemplate x:Key="RecipeBrowserWideSectionsPanel"><StackPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="RecipeBrowserCompactSectionsPanel"><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        <DataTemplate x:Key="RecipeOverviewSectionTemplate">
            <StackPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="8" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.R19.InputPreview, Korean='3D 입력 미리보기', English='3D input preview'}" />
                            <TextBlock Margin="0,4,0,7" Text="{Binding RecipePreviewIdentitySummary}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" />
                            <workbenchViews:HeightImageViewerView Height="230" MinHeight="210" DataContext="{Binding RecipePreviewViewer}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{Binding Localization.RecipeInfoTarget}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding BrowsedRecipe.InspectionTarget}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Localization.RecipeInfoCategory}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding BrowsedRecipe.Category}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Localization.RecipeInfoDescription}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding BrowsedRecipe.Description}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Localization.SourceLabel}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding BrowsedRecipe.Source.Name}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding BrowsedRecipe.Source.Format}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.R19.SavedInputs, Korean='도구와 입력', English='Tools and inputs'}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding BrowsedRecipe.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,5" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding InputEntityIds}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.R19.SavedParameters, Korean='저장된 조건', English='Saved conditions'}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding BrowsedRecipe.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Parameters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Value}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RecipeInputSectionTemplate">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Localization.SourceLabel}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding BrowsedRecipe.Source.Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid Margin="0,8,12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.InputPath, Korean='파일 위치', English='File location'}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" Text="{Binding BrowsedRecipe.Source.Path}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.InputFormat, Korean='입력 형식', English='Input format'}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" Text="{Binding BrowsedRecipe.Source.Format}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.HeightUnit, Korean='높이 단위', English='Height unit'}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" Text="{Binding BrowsedRecipe.Source.Unit}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecipeSourceHeightUnit" />
                        <TextBlock Grid.Row="3" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.GridSize, Korean='격자 크기 (열 × 행)', English='Grid size (columns × rows)'}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" TextWrapping="Wrap" AutomationProperties.AutomationId="RecipeSourceGridSize"><TextBlock.Text><MultiBinding StringFormat="{}{0} × {1}"><Binding Path="BrowsedRecipe.Source.GridWidth" /><Binding Path="BrowsedRecipe.Source.GridHeight" /></MultiBinding></TextBlock.Text></TextBlock>
                        <TextBlock Grid.Row="4" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.Frame, Korean='좌표계', English='Coordinate frame'}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,4" Text="{Binding BrowsedRecipe.Source.FrameId}" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Text="{Binding RecipePreviewIdentitySummary}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Padding="8" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <workbenchViews:HeightImageViewerView Height="340" MinHeight="280" DataContext="{Binding RecipePreviewViewer}" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RecipeToolsSectionTemplate">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>
                <ListBox ItemsSource="{Binding BrowsedRecipe.Steps}"
                         SelectedItem="{Binding SelectedBrowsedStep, Mode=TwoWay}"
                         SelectionChanged="OnRecipeSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="SavedRecipeSteps">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,7">
                                <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="{Binding SelectedBrowsedStep.ToolName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{i18n:ThreeDText Key=ThreeD.Recipe.SelectTool, Korean='검사 도구를 선택하세요.', English='Select an inspection tool.'}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedBrowsedStep}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Expander Margin="0,8,0,0" IsExpanded="False" Header="{i18n:ThreeDText Key=ThreeD.Recipe.ToolIdentity, Korean='도구 식별 정보', English='Tool identity'}">
                        <TextBlock Margin="8" Text="{Binding SelectedBrowsedStep.Id}" TextWrapping="Wrap" />
                    </Expander>
                    <TextBlock Margin="0,10,0,4" Text="{i18n:ThreeDText Key=ThreeD.R19.SavedInputs, Korean='입력', English='Inputs'}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                    <ItemsControl ItemsSource="{Binding SelectedBrowsedStep.InputEntityIds}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,10,0,4" Text="{i18n:ThreeDText Key=ThreeD.R19.SavedParameters, Korean='저장된 조건', English='Saved parameters'}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                    <ItemsControl ItemsSource="{Binding SelectedBrowsedStep.Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RecipeRegionsSectionTemplate">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="{i18n:ThreeDText Key=ThreeD.R19.SavedParameters, Korean='레시피에 저장된 영역 선택', English='Regions saved in this recipe'}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding BrowsedRecipe.Selections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="point-set"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{i18n:ThreeDText Key=ThreeD.Recipe.PointCount, Korean='선택한 점 개수', English='Selected points'}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Points.Count}" AutomationProperties.AutomationId="RecipeRegionPointCount" />
                                    </Grid>
                                    <Expander Margin="0,8,0,0" IsExpanded="False" Header="{i18n:ThreeDText Key=ThreeD.Recipe.RegionDetails, Korean='영역 상세 정보', English='Region details'}">
                                        <Grid Margin="0,8,12,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.RegionKind, Korean='영역 유형', English='Region type'}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" Text="{Binding Kind}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.RegionSource, Korean='입력 ID', English='Input ID'}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" Text="{Binding RootSourceId}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.Frame, Korean='좌표계', English='Coordinate frame'}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" Text="{Binding FrameId}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.InputFormat, Korean='입력 형식', English='Input format'}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" Text="{Binding SourceBinding.Format}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="4" Margin="0,4,12,4" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" Text="{i18n:ThreeDText Key=ThreeD.Recipe.GridSize, Korean='격자 크기 (열 × 행)', English='Grid size (columns × rows)'}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,4" TextWrapping="Wrap" AutomationProperties.AutomationId="RecipeRegionGridSize"><TextBlock.Text><MultiBinding StringFormat="{}{0} × {1}"><Binding Path="SourceBinding.GridWidth" /><Binding Path="SourceBinding.GridHeight" /></MultiBinding></TextBlock.Text></TextBlock>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{i18n:ThreeDText Key=ThreeD.R19.RegionSelectionEmpty, Korean='이 레시피에는 저장된 영역 선택이 없습니다.', English='This recipe has no saved region selections.'}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BrowsedRecipe.Selections.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RecipeCriteriaSectionTemplate">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="{i18n:ThreeDText Key=ThreeD.R19.SavedParameters, Korean='저장된 판정 조건', English='Saved inspection criteria'}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" TextWrapping="Wrap" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding BrowsedRecipe.Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Parameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Value}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewTeachingRecipeCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenTeachingRecipeCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveTeachingRecipeCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveTeachingRecipeAsCommand}" />
    </UserControl.InputBindings>
    <Border Padding="0"
            Background="{DynamicResource ThreeD.PanelBrush}"
            TextElement.Foreground="{DynamicResource ThreeD.TextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    x:Name="RecipeManagerPageTitle"
                    MinHeight="50"
                    Padding="18,12"
                    Background="{DynamicResource ThreeD.PanelBrush}"
                    BorderBrush="{DynamicResource ThreeD.DividerBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="{i18n:ThreeDText Key=ThreeD.R19.RecipeManagerTitle, Korean='레시피 관리자', English='Recipe Manager'}"
                           AutomationProperties.AutomationId="RecipeManagerTitle" />
            </Border>

            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFirstRecipeSetupVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Padding="12,6" Margin="18,2,18,2" Background="{DynamicResource ThreeD.PanelAlternateBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding Localization.CurrentRecipe}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                            <TextBox MaxWidth="480" HorizontalAlignment="Left" MinWidth="240" Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Localization.RecipeNameLabel}" />
                            <TextBlock Text="{Binding LocalizedRecipeStateSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LocalizedRecipeSaveBlocker}" TextWrapping="Wrap" Foreground="{DynamicResource ThreeD.WarningBrush}" Visibility="{Binding IsRecipeSaveBlocked, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button Content="{Binding Localization.Save}" Command="{Binding SaveTeachingRecipeCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="{Binding Localization.SaveAs}" Command="{Binding SaveTeachingRecipeAsCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="{Binding Localization.CompatibleVariant}" Command="{Binding BeginCompatibleSourceVariantCommand}" AutomationProperties.AutomationId="BeginCompatibleSourceVariant" />
                        </WrapPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource ThreeD.MutedTextBrush}" Text="{Binding LocalizedRecipePathSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecipeManagerSavePath" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Recipe.Manager.SavePath, Korean='현재 레시피 저장 파일', English='Current recipe save file'}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" x:Name="RecipeBrowserColumns">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.76*" MinWidth="285" /><ColumnDefinition Width="1*" MinWidth="155" /><ColumnDefinition Width="5.6*" MinWidth="300" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="0" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border x:Name="RecipeLibraryPanel" Grid.RowSpan="2" Padding="0" Margin="0" Background="{DynamicResource ThreeD.CommandBarBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="14,14,14,10">
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.R19.RecipeSearchTitle, Korean='레시피 검색', English='Search recipes'}" />
                                    <ui:Button HorizontalAlignment="Right" Width="32" Height="30" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenTeachingRecipeCommand}" ToolTip="{i18n:ThreeDText Key=ThreeD.Recipe.Manager.OpenTip, Korean='기존 레시피 열기 (Ctrl+O)', English='Open existing recipe (Ctrl+O)'}" AutomationProperties.AutomationId="OpenExistingRecipe" AutomationProperties.Name="{Binding Localization.OpenExistingRecipe}" />
                                </Grid>
                                <TextBox Margin="0,8,0,0" Text="{Binding RecipeSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.R19.RecipeSearchTitle, Korean='레시피 검색', English='Search recipes'}" />
                                <ScrollViewer x:Name="RecipeFiltersScroll" Margin="0,10,0,0" MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="RecipeFiltersScroll">
                                    <Grid Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="{Binding Localization.RecipeInfoCategory}" Foreground="{DynamicResource ThreeD.MutedTextBrush}" />
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding RecipeCategoryOptions}" SelectedValuePath="Key" SelectedValue="{Binding RecipeCategoryFilter, Mode=TwoWay}" AutomationProperties.AutomationId="RecipeCategoryFilter" AutomationProperties.Name="{Binding Localization.RecipeInfoCategory}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Value}" TextWrapping="Wrap" MaxWidth="300" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
