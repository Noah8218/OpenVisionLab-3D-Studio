                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style x:Key="FirstRecipeMetadataRowStyle" TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompatibleVariantSetup}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8" FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.RecipeCenter.RequiredInformation, Korean='필수 정보', English='Required information'}" />
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,16,0,0" FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.RecipeCenter.AdditionalSettings, Korean='추가 설정', English='Additional settings'}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center"
                                   Style="{DynamicResource ThreeD.FieldLabelTextStyle}"
                                   Text="{i18n:ThreeDText Key=ThreeD.RecipeCenter.NameRequiredLabel, Korean='레시피 이름 (필수)', English='Recipe name (required)'}" TextWrapping="Wrap" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Grid.ColumnSpan="2"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="FirstRecipeName"
                                 AutomationProperties.Name="{Binding Localization.RecipeNameLabel}"
                                 Text="{Binding FirstRecipeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,9,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource ThreeD.FieldLabelTextStyle}"
                                   Text="{i18n:ThreeDText Key=ThreeD.RecipeCenter.FolderRequiredLabel, Korean='저장 위치 (필수)', English='Save folder (required)'}" TextWrapping="Wrap" />
                        <shellViews:PathInput Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                              Height="34" Margin="0,9,0,0"
                                              Text="{Binding FirstRecipeFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              BrowseCommand="{Binding BrowseFirstRecipeFolderCommand}"
                                              BrowseText="{Binding Localization.FirstRecipeBrowse}"
                                              BrowseSymbol="Folder24"
                                              InputAutomationId="FirstRecipeFolder"
                                              BrowseAutomationId="BrowseFirstRecipeFolder"
                                              AutomationProperties.Name="{Binding Localization.FirstRecipeFolder}" />

                        <TextBlock Grid.Row="4" Margin="0,9,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ThreeD.FieldLabelTextStyle}">
                                    <Setter Property="Text" Value="{i18n:ThreeDText Key=ThreeD.RecipeCenter.SourceRequiredLabel, Korean='C3D 입력 (필수)', English='C3D input (required)'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFirstRecipeStarter.Id}" Value="none">
                                            <Setter Property="Text" Value="{i18n:ThreeDText Key=ThreeD.RecipeCenter.SourceOptionalLabel, Korean='C3D 입력 (선택)', English='C3D input (optional)'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <shellViews:PathInput Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                              Height="34" Margin="0,9,0,0"
                                              Text="{Binding FirstRecipeSourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              BrowseCommand="{Binding BrowseFirstRecipeSourceCommand}"
                                              BrowseText="{Binding Localization.FirstRecipeBrowse}"
                                              BrowseSymbol="FolderOpen24"
                                              InputAutomationId="FirstRecipeSource"
                                              BrowseAutomationId="BrowseFirstRecipeSource"
                                              AutomationProperties.Name="{Binding Localization.FirstRecipeSource}" />

                        <TextBlock Grid.Row="5"
                                   Margin="0,9,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource ThreeD.FieldLabelTextStyle}"
                                   Text="{Binding Localization.FirstRecipeStarter}" />
                        <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox VerticalContentAlignment="Center"
                                      IsEnabled="{Binding IsFirstRecipeStarterEditable}"
                                      ItemsSource="{Binding FirstRecipeStarterOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedFirstRecipeStarter, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="FirstRecipeStarter"
                                      AutomationProperties.Name="{Binding Localization.FirstRecipeStarter}" />
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                       Text="{Binding FirstRecipeStarterDetail}"
                                        TextWrapping="Wrap" />
                        </Grid>
                        <Grid Grid.Row="6" Grid.ColumnSpan="3" Margin="0,14,0,0" Style="{StaticResource FirstRecipeMetadataRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource ThreeD.FieldLabelTextStyle}" Text="{i18n:ThreeDText Key=ThreeD.RecipeCenter.CategoryOptionalLabel, Korean='분류 (선택)', English='Category (optional)'}" TextWrapping="Wrap" />
                            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Height="34" VerticalContentAlignment="Center" MaxLength="500" Text="{Binding FirstRecipeCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FirstRecipeCategory" AutomationProperties.Name="{Binding Localization.RecipeInfoCategory}" />
                        </Grid>
                        <Grid Grid.Row="7" Grid.ColumnSpan="3" Margin="0,9,0,0" Style="{StaticResource FirstRecipeMetadataRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource ThreeD.FieldLabelTextStyle}" Text="{i18n:ThreeDText Key=ThreeD.RecipeCenter.TargetOptionalLabel, Korean='검사 대상 (선택)', English='Inspection target (optional)'}" TextWrapping="Wrap" />
                            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Height="34" VerticalContentAlignment="Center" MaxLength="500" Text="{Binding FirstRecipeInspectionTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FirstRecipeInspectionTarget" AutomationProperties.Name="{Binding Localization.RecipeInfoTarget}" />
                        </Grid>
                        <Grid Grid.Row="8" Grid.ColumnSpan="3" Margin="0,9,0,0" Style="{StaticResource FirstRecipeMetadataRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Style="{DynamicResource ThreeD.FieldLabelTextStyle}" Text="{i18n:ThreeDText Key=ThreeD.RecipeCenter.DescriptionOptionalLabel, Korean='검사 목적·설명 (선택)', English='Purpose / description (optional)'}" TextWrapping="Wrap" />
                            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Height="76" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="500" Text="{Binding FirstRecipeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FirstRecipeDescription" AutomationProperties.Name="{Binding Localization.RecipeInfoDescription}" />
                        </Grid>
                    </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox Content="{Binding Localization.FirstRecipeRememberSetup}"
                                      IsChecked="{Binding RememberFirstRecipeSetup, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="RememberFirstRecipeSetup"
                                      AutomationProperties.Name="{Binding Localization.FirstRecipeRememberSetup}">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox"
                                           BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirstRecipeSetupMemoryAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding IsVariantRoiReuseConfirmed, Mode=TwoWay}"
                                      Visibility="{Binding IsCompatibleVariantSetup, Converter={StaticResource BoolToVisibilityConverter}}"
                                      AutomationProperties.AutomationId="VariantRoiReuseConfirmation"
                                      AutomationProperties.Name="{Binding Localization.CompatibleVariantReviewConfirmation}">
                                <TextBlock Text="{Binding Localization.CompatibleVariantReviewConfirmation}"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThreeD.MutedTextBrush}"
                                       Text="{Binding Localization.FirstRecipeTargetFile}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Text="{Binding FirstRecipeTargetPath, Converter={shellViews:PathSummaryConverter}}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FirstRecipeTargetPath}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Margin="14,0,0,0"
                                Padding="10,7"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FirstRecipeSetupStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFirstRecipeSetupValid}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12"
                                       Text="{Binding FirstRecipeSetupStatus}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="{Binding Localization.FirstRecipeReset}"
                                   Icon="{ui:SymbolIcon ArrowReset24}"
                                   Command="{Binding ResetFirstRecipeSetupCommand}"
                                   AutomationProperties.AutomationId="ResetFirstRecipeSetup"
                                   AutomationProperties.Name="{Binding Localization.FirstRecipeReset}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button"
                                       BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFirstRecipeSetupMemoryAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Grid.Column="1"
                                   Margin="7,0,0,0"
                                   Content="{Binding Localization.Cancel}"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding CancelFirstRecipeSetupCommand}"
                                   AutomationProperties.AutomationId="CancelFirstRecipeSetup"
                                   AutomationProperties.Name="{Binding Localization.Cancel}" />
                        <ui:Button Grid.Column="3"
                                   Margin="14,0,0,0"
                                   Content="{Binding FirstRecipeCreateLabel}"
                                   Icon="{ui:SymbolIcon DocumentAdd24}"
                                   Command="{Binding CreateFirstRecipeCommand}"
                                   Appearance="Primary"
                                   AutomationProperties.AutomationId="CreateFirstRecipe"
                                   AutomationProperties.Name="{Binding Localization.FirstRecipeCreate}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
