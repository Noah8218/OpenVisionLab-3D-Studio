<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Workspace.ThicknessTaskWorkspaceView"
             x:Name="TaskWorkspaceRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Workspace"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ThicknessTeachPanelStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsTeachWorkspaceSelected, ElementName=TaskWorkspaceRoot}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsThicknessTaskSelected, ElementName=TaskWorkspaceRoot}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThicknessInspectPanelStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsInspectWorkspaceSelected, ElementName=TaskWorkspaceRoot}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsThicknessTaskSelected, ElementName=TaskWorkspaceRoot}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WarpageTeachPanelStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsTeachWorkspaceSelected, ElementName=TaskWorkspaceRoot}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsWarpageTaskSelected, ElementName=TaskWorkspaceRoot}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WarpageInspectPanelStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsInspectWorkspaceSelected, ElementName=TaskWorkspaceRoot}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsWarpageTaskSelected, ElementName=TaskWorkspaceRoot}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f3f4f6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="304" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="10"
                Padding="14"
                Background="#ffffff"
                BorderBrush="#d1d5db"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Visibility="{Binding DataContext.IsTaskWorkspaceSelected, ElementName=TaskWorkspaceRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontWeight="SemiBold" Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.InspectionTask, Korean='검사 작업', English='Inspection task'}" />
                        <RadioButton Margin="0,7,0,0"
                                     Content="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Thickness, Korean='두께', English='Thickness'}"
                                     GroupName="InspectionTask"
                                     IsChecked="{Binding DataContext.IsThicknessTaskSelected, ElementName=TaskWorkspaceRoot, Mode=TwoWay}" />
                        <RadioButton Margin="0,4,0,0"
                                     Content="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Warpage, Korean='워페이지', English='Warpage'}"
                                     GroupName="InspectionTask"
                                     IsChecked="{Binding DataContext.IsWarpageTaskSelected, ElementName=TaskWorkspaceRoot, Mode=TwoWay}" />
                        <Separator Margin="0,13,0,2" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Style="{StaticResource ThicknessTeachPanelStyle}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.ThicknessRoiTeaching, Korean='두께 검사 ROI 티칭', English='Thickness ROI teaching'}" />

                        <TextBlock Margin="0,18,0,5"
                                   FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.SourceAndFrame, Korean='입력 데이터 및 좌표계', English='Source and frame'}" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding RecipeSourceName}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding RecipeSourcePath}" />
                        <StackPanel Margin="0,3,0,0"
                                    Orientation="Horizontal">
                            <TextBlock Foreground="#6b7280"
                                       Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Unit, Korean='단위', English='Unit'}" />
                            <TextBlock Margin="4,0,0,0"
                                       Foreground="#6b7280"
                                       TextWrapping="Wrap"
                                       Text="{Binding RecipeSourceUnit}" />
                        </StackPanel>
                        <StackPanel Margin="0,3,0,0"
                                    Orientation="Horizontal">
                            <TextBlock Foreground="#6b7280"
                                       Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Frame, Korean='좌표계', English='Frame'}" />
                            <TextBlock Margin="4,0,0,0"
                                       Foreground="#6b7280"
                                       TextWrapping="Wrap"
                                       Text="{Binding ThicknessFrameId}" />
                        </StackPanel>

                        <TextBlock Margin="0,18,0,5"
                                   FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.ThicknessMeasurementRoi, Korean='두께 측정 ROI', English='Thickness measurement ROI'}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,7,7">
                                <TextBlock FontSize="11" Foreground="#6b7280" Text="{i18n:ThreeDText Key=ThreeD.Workbench.RoiRow, Korean='시작 Z (행)', English='Start Z (row)'}" />
                                <TextBox Text="{Binding ThicknessRoiRow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock FontSize="11" Foreground="#6b7280" Text="{i18n:ThreeDText Key=ThreeD.Workbench.RoiColumn, Korean='시작 X (열)', English='Start X (column)'}" />
                                <TextBox Text="{Binding ThicknessRoiColumn, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,7">
                                <TextBlock FontSize="11" Foreground="#6b7280" Text="{i18n:ThreeDText Key=ThreeD.Workbench.RoiRowCount, Korean='Z 길이 (행)', English='Z length (rows)'}" />
                                <TextBox Text="{Binding ThicknessRoiRowCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock FontSize="11" Foreground="#6b7280" Text="{i18n:ThreeDText Key=ThreeD.Workbench.RoiColumnCount, Korean='너비 (열)', English='Width (columns)'}" />
                                <TextBox Text="{Binding ThicknessRoiColumnCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Margin="0,10,0,5"
                                   FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Acceptance, Korean='판정 조건', English='Acceptance'}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,7,7">
                                <TextBlock FontSize="11"
                                           Foreground="#6b7280"
                                           Text="{i18n:ThreeDText Key=ThreeD.Field.Lower, Korean='하한', English='Lower'}" />
                                <TextBox Text="{Binding ThicknessMinimum, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,7">
                                <TextBlock FontSize="11"
                                           Foreground="#6b7280"
                                           Text="{i18n:ThreeDText Key=ThreeD.Field.Upper, Korean='상한', English='Upper'}" />
                                <TextBox Text="{Binding ThicknessMaximum, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock FontSize="11"
                                           Foreground="#6b7280"
                                           Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.MinimumSamples, Korean='최소 샘플', English='Min samples'}" />
                                <TextBox Text="{Binding ThicknessMinimumValidSamples, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </UniformGrid>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,7,7"
                                    Content="{i18n:ThreeDText Key=ThreeD.Command.TeachThicknessRoi, Korean='두께 ROI 티칭', English='Teach Thickness ROI'}"
                                    Command="{Binding TeachThicknessRoiCommand}" />
                            <Button Margin="0,0,0,7"
                                    Content="{i18n:ThreeDText Key=ThreeD.Command.PreviewThickness, Korean='두께 미리보기', English='Preview Thickness'}"
                                    Command="{Binding PreviewThicknessCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Style="{StaticResource ThicknessInspectPanelStyle}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.ThicknessInspect, Korean='두께 검사', English='Thickness Inspect'}" />
                        <TextBlock Margin="0,18,0,5"
                                   FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.SelectedRoute, Korean='선택한 검사 단계', English='Selected inspection step'}" />
                        <TextBlock Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.ThicknessSelectedStep, Korean='두께 / C3D 격자 ROI', English='Thickness / C3D grid ROI'}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding ThicknessSummary}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding ThicknessDetails}" />
                        <Button Margin="0,18,0,7"
                                Content="{i18n:ThreeDText Key=ThreeD.Command.PreviewThickness, Korean='두께 미리보기', English='Preview Thickness'}"
                                Command="{Binding PreviewThicknessCommand}" />
                        <Button Content="{i18n:ThreeDText Key=ThreeD.Command.Publish, Korean='결과 적용', English='Apply'}"
                                Command="{Binding DataContext.PublishInspectionResultCommand, ElementName=TaskWorkspaceRoot}" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Style="{StaticResource WarpageTeachPanelStyle}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.WarpageTeach, Korean='워페이지 ROI 티칭', English='Warpage ROI teaching'}" />

                        <Expander Margin="0,12,0,0" Header="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.SourceAndFrame}">
                            <StackPanel Margin="0,5,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{Binding RecipeSourceName}" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="#6b7280"
                                           TextWrapping="Wrap"
                                           Text="{Binding RecipeSourcePath}" />
                                <StackPanel Margin="0,3,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock Foreground="#6b7280"
                                               Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Unit, Korean='단위', English='Unit'}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Foreground="#6b7280"
                                               TextWrapping="Wrap"
                                               Text="{Binding WarpageUnit}" />
                                </StackPanel>
                                <StackPanel Margin="0,3,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock Foreground="#6b7280"
                                               Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Frame, Korean='좌표계', English='Frame'}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Foreground="#6b7280"
                                               TextWrapping="Wrap"
                                               Text="{Binding WarpageFrameId}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <TextBlock Margin="0,12,0,5"
                                   FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.WarpageInspectionRoi, Korean='최적 평면 검사 ROI', English='Best-fit inspection ROI'}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,7,7">
                                <TextBlock FontSize="11" Foreground="#6b7280" Text="{i18n:ThreeDText Key=ThreeD.Workbench.RoiRow, Korean='시작 Z (행)', English='Start Z (row)'}" />
                                <TextBox Text="{Binding WarpageRoiRow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock FontSize="11" Foreground="#6b7280" Text="{i18n:ThreeDText Key=ThreeD.Workbench.RoiColumn, Korean='시작 X (열)', English='Start X (column)'}" />
                                <TextBox Text="{Binding WarpageRoiColumn, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,7">
                                <TextBlock FontSize="11" Foreground="#6b7280" Text="{i18n:ThreeDText Key=ThreeD.Workbench.RoiRowCount, Korean='Z 길이 (행)', English='Z length (rows)'}" />
                                <TextBox Text="{Binding WarpageRoiRowCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock FontSize="11" Foreground="#6b7280" Text="{i18n:ThreeDText Key=ThreeD.Workbench.RoiColumnCount, Korean='너비 (열)', English='Width (columns)'}" />
                                <TextBox Text="{Binding WarpageRoiColumnCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Margin="0,10,0,5"
                                   FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Acceptance, Korean='판정 조건', English='Acceptance'}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,7,7">
                                <TextBlock FontSize="11"
                                           Foreground="#6b7280"
                                           Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.MaximumPeakToValley, Korean='최대 P2V', English='Maximum P2V'}" />
                                <TextBox Text="{Binding WarpageMaximumPeakToValley, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock FontSize="11"
                                           Foreground="#6b7280"
                                           Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.MinimumSamples, Korean='최소 샘플', English='Min samples'}" />
                                <TextBox Text="{Binding WarpageMinimumValidSamples, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </UniformGrid>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,7,7"
                                    Content="{i18n:ThreeDText Key=ThreeD.Command.TeachWarpageRoi, Korean='워페이지 ROI 티칭', English='Teach Warpage ROI'}"
                                    Command="{Binding TeachWarpageRoiCommand}" />
                            <Button Margin="0,0,0,7"
                                    Content="{i18n:ThreeDText Key=ThreeD.Command.PreviewWarpage, Korean='워페이지 미리보기', English='Preview Warpage'}"
                                    Command="{Binding PreviewWarpageCommand}" />
                        </WrapPanel>
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#6b7280"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.WarpageUncalibratedHint, Korean='기준 평면과의 높이차를 검사합니다. 교정 정보가 없어 실제 휨량이나 GD&amp;T 평가값으로 사용할 수 없습니다.', English='This is an uncalibrated best-fit residual check. It does not establish physical Warpage or GD&amp;T evidence.'}" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Style="{StaticResource WarpageInspectPanelStyle}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.WarpageInspect, Korean='워페이지 검사', English='Warpage Inspect'}" />
                        <TextBlock Margin="0,18,0,5"
                                   FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Workbench.SelectedRoute, Korean='선택한 검사 단계', English='Selected inspection step'}" />
                        <TextBlock Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.WarpageSelectedStep, Korean='워페이지 / C3D 최적 평면 ROI 잔차', English='Warpage / C3D best-fit ROI residual'}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding WarpageSummary}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding WarpageDetails}" />
                        <Button Margin="0,18,0,7"
                                Content="{i18n:ThreeDText Key=ThreeD.Command.PreviewWarpage, Korean='워페이지 미리보기', English='Preview Warpage'}"
                                Command="{Binding PreviewWarpageCommand}" />
                        <Button Content="{i18n:ThreeDText Key=ThreeD.Command.Publish, Korean='결과 적용', English='Apply'}"
                                Command="{Binding DataContext.PublishInspectionResultCommand, ElementName=TaskWorkspaceRoot}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding DataContext.IsReviewWorkspaceSelected, ElementName=TaskWorkspaceRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Results.Title, Korean='결과 검토', English='Results review'}" />
                        <StackPanel Margin="0,18,0,0"
                                    DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.CurrentPublishedState, Korean='현재 적용 상태', English='Current applied state'}" />
                            <TextBlock Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding ViewerStatus}" />
                        </StackPanel>
                        <Separator Margin="0,14,0,12" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.RunnerReportEvidence, Korean='검사 실행 및 보고서 정보', English='Runner and report evidence'}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                Margin="0,10"
                Background="#111827"
                BorderBrush="#d1d5db"
                BorderThickness="1"
                CornerRadius="4">
            <ContentPresenter Content="{Binding ViewerContent, ElementName=TaskWorkspaceRoot}" />
        </Border>

        <Border Grid.Column="2"
                Margin="0,10,10,10"
                Padding="14"
                Background="#ffffff"
                BorderBrush="#d1d5db"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Style="{StaticResource ThicknessTeachPanelStyle}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.TeachValidation, Korean='티칭 검증', English='Teach validation'}" />
                        <StackPanel Margin="0,12,0,0"
                                    Orientation="Horizontal">
                            <TextBlock Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.RoiConfigured, Korean='ROI 설정됨', English='ROI configured'}" />
                            <TextBlock Margin="4,0,0,0"
                                       Text="{Binding ThicknessConfigured}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding ThicknessSummary}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding ThicknessDetails}" />
                        <Separator Margin="0,14,0,12" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Recipe, Korean='레시피', English='Recipe'}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding RecipeSummary}" />
                        <Button Margin="0,12,0,0"
                                Content="{i18n:ThreeDText Key=ThreeD.Command.SaveRecipe, Korean='레시피 저장', English='Save Recipe'}"
                                Command="{Binding DataContext.SaveRecipeCommand, ElementName=TaskWorkspaceRoot}" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Style="{StaticResource ThicknessInspectPanelStyle}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.CurrentResult, Korean='현재 결과', English='Current result'}" />
                        <TextBlock Margin="0,12,0,0"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding ResultSummary}" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding ViewerStatus}" />
                        <Separator Margin="0,14,0,12" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.PublishRule, Korean='적용 규칙', English='Apply rule'}" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Style="{StaticResource WarpageTeachPanelStyle}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.TeachValidation, Korean='티칭 검증', English='Teach validation'}" />
                        <StackPanel Margin="0,12,0,0"
                                    Orientation="Horizontal">
                            <TextBlock Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.RoiConfigured, Korean='ROI 설정됨', English='ROI configured'}" />
                            <TextBlock Margin="4,0,0,0"
                                       Text="{Binding WarpageConfigured}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding WarpageSummary}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding WarpageDetails}" />
                        <Separator Margin="0,14,0,12" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.Recipe, Korean='레시피', English='Recipe'}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding RecipeSummary}" />
                        <Button Margin="0,12,0,0"
                                Content="{i18n:ThreeDText Key=ThreeD.Command.SaveRecipe, Korean='레시피 저장', English='Save Recipe'}"
                                Command="{Binding DataContext.SaveRecipeCommand, ElementName=TaskWorkspaceRoot}" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Style="{StaticResource WarpageInspectPanelStyle}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.CurrentResult, Korean='현재 결과', English='Current result'}" />
                        <TextBlock Margin="0,12,0,0"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding ResultSummary}" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#6b7280"
                                   TextWrapping="Wrap"
                                   Text="{Binding ViewerStatus}" />
                        <Separator Margin="0,14,0,12" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.PublishRule, Korean='적용 규칙', English='Apply rule'}" />
                    </StackPanel>

                    <StackPanel DataContext="{Binding ViewerEditor, ElementName=TaskWorkspaceRoot}"
                                Visibility="{Binding DataContext.IsReviewWorkspaceSelected, ElementName=TaskWorkspaceRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.PublishedResult, Korean='적용된 결과', English='Applied result'}" />
                        <TextBlock Margin="0,12,0,0"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding PublishedResultSummary}" />
                        <TextBlock Margin="0,12,0,5"
                                   FontWeight="SemiBold"
                                   Text="{i18n:ThreeDText Key=ThreeD.Shell.TaskWorkspace.PublishedEntities, Korean='적용된 데이터', English='Applied entities'}" />
                        <ItemsControl ItemsSource="{Binding ResultEntities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="8"
                                            Background="#f9fafb"
                                            BorderBrush="#d1d5db"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding Status}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="#6b7280"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Message}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
