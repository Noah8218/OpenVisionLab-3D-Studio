<UserControl x:Name="Root"
             x:Class="OpenVisionLab.ThreeD.Shell.Views.Shell.StudioTitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             VerticalAlignment="Center"
             FontFamily="Segoe UI Variable Text"
             MinHeight="40"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             shell:WindowChrome.IsHitTestVisibleInChrome="True"
             MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
             AutomationProperties.AutomationId="StudioTitleBar">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="ThreeD.TitleBarCloseHoverBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="ThreeD.TitleBarCloseTextBrush" Color="#FFFFFF" />
        <Style x:Key="HeaderRecipeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{DynamicResource ThreeD.DockHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PanelHeaderTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderWindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderWindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.TitleBarCloseHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TitleBarCloseTextBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ThreeD.TitleBarCloseHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource ThreeD.TitleBarCloseTextBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource ThreeD.StudioChromeBrush}"
            BorderBrush="{DynamicResource ThreeD.SoftDividerBrush}"
            BorderThickness="0,0,0,1">
        <Grid Margin="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                <Grid Width="24" Height="24">
                    <Path Data="M12,2.5 L20.5,7.3 L20.5,16.7 L12,21.5 L3.5,16.7 L3.5,7.3 Z M12,7.5 L12,16.5 M8,9.8 L12,12 L16,9.8" Stroke="{DynamicResource ThreeD.AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
            </Viewbox>

            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock FontSize="13"
                           FontWeight="650"
                           Foreground="{DynamicResource ThreeD.PanelHeaderTextBrush}"
                           Text="{Binding TitleText, ElementName=Root}" />
                <TextBlock x:Name="StudioBrandSuffix" Margin="8,0,0,0" FontSize="13" FontWeight="650" Foreground="{DynamicResource ThreeD.PanelHeaderMutedTextBrush}" Text="3D Studio">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ContentPresenter Grid.Column="2" Content="{Binding MenuContent, ElementName=Root}" VerticalAlignment="Center" />

            <Grid Grid.Column="3"
                        Margin="14,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsRecipeContextVisible, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Shell.TitleBar.ActiveRecipeContextAccessible, Korean='현재 레시피', English='Current recipe'}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="RecipeContextButton" Style="{StaticResource HeaderRecipeButtonStyle}" Click="RecipeButton_Click"
                        ToolTip="{Binding RecipeDetailText, ElementName=Root}" AutomationProperties.AutomationId="HeaderRecipeContextButton"
                        AutomationProperties.Name="{Binding RecipeText, ElementName=Root}" AutomationProperties.HelpText="{Binding RecipeDetailText, ElementName=Root}">
                    <Button.MaxWidth><Binding Path="RecipeMaximumWidth" ElementName="Root" /></Button.MaxWidth>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Document24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}" />
                        <TextBlock x:Name="RecipeNameText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding RecipeText, ElementName=Root}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ThreeD.PanelHeaderMutedTextBrush}" Text="{Binding RecipeMetaText, ElementName=Root}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,5,0" Fill="{DynamicResource ThreeD.WarningBrush}" Visibility="{Binding IsRecipeModified, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock x:Name="RecipeStateStatusText" FontSize="12" Text="{Binding RecipeStateText, ElementName=Root}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecipeStateText, ElementName=Root}" AutomationProperties.Name="{Binding RecipeStateText, ElementName=Root}">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource ThreeD.PanelHeaderMutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecipeModified, ElementName=Root}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsRecipeSaveFailed, ElementName=Root}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Button>
                <Border x:Name="CurrentSourceQualityStatusBadge"
                        Grid.Column="1" MaxWidth="160"
                        Margin="6,0,0,0"
                        Padding="6,3"
                        BorderThickness="1"
                        CornerRadius="4"
                        ToolTip="{Binding SourceQualityStatusToolTip, ElementName=Root}"
                        Visibility="{Binding IsSourceQualityStatusVisible, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.AutomationId="StudioCurrentSourceQualityStatus"
                        AutomationProperties.Name="{Binding SourceQualityStatusText, ElementName=Root}"
                        AutomationProperties.HelpText="{Binding SourceQualityStatusToolTip, ElementName=Root}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SourceQualityStatusKind, ElementName=Root}" Value="Pass">
                                    <Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SourceQualityStatusKind, ElementName=Root}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SourceQualityStatusKind, ElementName=Root}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="CurrentSourceQualityStatusText"
                               FontSize="12"
                               Text="{Binding SourceQualityStatusText, ElementName=Root}"
                               TextWrapping="Wrap"
                               TextTrimming="None">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SourceQualityStatusKind, ElementName=Root}" Value="Pass">
                                        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SourceQualityStatusKind, ElementName=Root}" Value="Warning">
                                        <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SourceQualityStatusKind, ElementName=Root}" Value="Error">
                                        <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
            <Border Grid.Column="3"
                    MaxWidth="250"
                    Padding="9,4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ThreeD.ContextBadgeBrush}"
                    BorderBrush="{DynamicResource ThreeD.PanelHeaderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ToolTip="{Binding StatusText, ElementName=Root}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusText, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusText, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRecipeContextVisible, ElementName=Root}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.IsStartPageSelected, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="ShellStatusText" FontSize="12"
                           Foreground="{DynamicResource ThreeD.PanelHeaderMutedTextBrush}"
                           Text="{Binding StatusText, ElementName=Root}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <ContentPresenter Grid.Column="4" Content="{Binding ActionsContent, ElementName=Root}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="5"
                        x:Name="WindowControlGroup"
                        Margin="4,0,0,0"
                        VerticalAlignment="Stretch"
                        Orientation="Horizontal"
                        AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Shell.TitleBar.WindowControlsAccessible, Korean='창 컨트롤', English='Window controls'}">
                <Button x:Name="MinimizeWindowButton"
                        Content="—"
                        Style="{StaticResource HeaderWindowButtonStyle}"
                        Click="MinimizeButton_Click"
                        ToolTip="{i18n:ThreeDText Key=ThreeD.Shell.TitleBar.MinimizeTip, Korean='창 최소화', English='Minimize window'}"
                        AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Shell.TitleBar.MinimizeAccessible, Korean='창 최소화', English='Minimize window'}" />
                <Button x:Name="MaximizeRestoreWindowButton"
                        Content="□"
                        Style="{StaticResource HeaderWindowButtonStyle}"
                        Click="MaximizeRestoreButton_Click"
                        ToolTip="{i18n:ThreeDText Key=ThreeD.Shell.TitleBar.MaximizeRestoreTip, Korean='창 최대화 또는 복원', English='Maximize or restore window'}"
                        AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Shell.TitleBar.MaximizeRestoreAccessible, Korean='창 최대화 또는 복원', English='Maximize or restore window'}" />
                <Button x:Name="CloseWindowButton"
                        Content="✕"
                        Style="{StaticResource HeaderCloseButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="{i18n:ThreeDText Key=ThreeD.Shell.TitleBar.CloseTip, Korean='창 닫기', English='Close window'}"
                        AutomationProperties.Name="{i18n:ThreeDText Key=ThreeD.Shell.TitleBar.CloseAccessible, Korean='창 닫기', English='Close window'}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
