<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Shell.StudioHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewerLocalization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization;assembly=OpenVisionLab.ThreeD.Viewer"
             xmlns:shell="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell">
    <UserControl.Resources>
        <viewerLocalization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
    </UserControl.Resources>

    <shell:StudioTitleBarView
        TitleText="OpenVisionLab 3D Studio"
        SubtitleText="{Binding Localization.StudioSubtitle}"
        RecipeText="{Binding Workbench.RecipeName}"
        SourceContextText="{Binding Workbench.SourceContextSummary}"
        SourceQualityStatusText="{Binding Workbench.CurrentSourceQualitySummary}"
        SourceQualityStatusToolTip="{Binding Workbench.CurrentSourceQualityDetail}"
        SourceQualityStatusKind="{Binding Workbench.CurrentSourceQualityStatusKind}"
        IsSourceQualityStatusVisible="{Binding Workbench.IsCurrentSourceQualityStatusVisible}"
        AlignmentStatusText="{Binding Workbench.AlignmentStatusSummary}"
        RecipeStateText="{Binding Workbench.LocalizedRecipeStateSummary}"
        IsRecipeContextVisible="{Binding IsWorkbenchWorkspaceSelected}"
        StatusText="{Binding StatusText, Converter={StaticResource ViewerRuntimeTextConverter}}" />
</UserControl>
