<UserControl x:Class="OpenVisionLab.ThreeD.Shell.Views.Shell.PathInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:OpenVisionLab.ThreeD.Shell.Views.Shell"
             Focusable="False" MinHeight="32">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
            <TextBox x:Name="PathEditor" VerticalContentAlignment="Center"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType=local:PathInput}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=local:PathInput}}"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource AncestorType=local:PathInput}}"
                     ToolTipService.ShowOnDisabled="True"
                     AutomationProperties.AutomationId="{Binding InputAutomationId, RelativeSource={RelativeSource AncestorType=local:PathInput}}"
                     AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=local:PathInput}}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="False">
                                <Setter Property="Foreground" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock x:Name="PathSummary" Margin="9,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                       Text="{Binding Text, ElementName=PathEditor, Converter={local:PathSummaryConverter}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadOnly, ElementName=PathEditor}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=PathEditor}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PathEditor}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <ui:Button x:Name="BrowseButton" Grid.Column="1" Margin="7,0,0,0"
                   Content="{Binding BrowseText, RelativeSource={RelativeSource AncestorType=local:PathInput}}"
                   Command="{Binding BrowseCommand, RelativeSource={RelativeSource AncestorType=local:PathInput}}"
                   AutomationProperties.AutomationId="{Binding BrowseAutomationId, RelativeSource={RelativeSource AncestorType=local:PathInput}}"
                   AutomationProperties.Name="{Binding BrowseText, RelativeSource={RelativeSource AncestorType=local:PathInput}}">
            <ui:Button.Icon>
                <ui:SymbolIcon />
            </ui:Button.Icon>
            <ui:Button.Style>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=local:PathInput}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:Button.Style>
        </ui:Button>
    </Grid>
</UserControl>
