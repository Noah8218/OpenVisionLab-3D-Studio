<UserControl x:Name="NavigationRailRoot"
             x:Class="OpenVisionLab.ThreeD.Shell.Views.Shell.StudioNavigationRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:OpenVisionLab.ThreeD.Shell"
             xmlns:views="clr-namespace:OpenVisionLab.ThreeD.Shell"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             PreviewKeyDown="OnUtilityMenuPreviewKeyDown"
             AutomationProperties.AutomationId="StudioNavigationRail">
    <UserControl.Resources>
        <Style x:Key="RailLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MaxWidth" Value="48" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="RailRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="SelectedMarker" Width="3" Margin="-4,12,0,12" HorizontalAlignment="Left" Background="{DynamicResource ThreeD.AccentBrush}" CornerRadius="2" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource ThreeD.HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource ThreeD.RailSelectedBrush}" />
                                <Setter TargetName="SelectedMarker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.RailSelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource ThreeD.HoverSurfaceBrush}" />
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThreeD.DividerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThreeD.InputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThreeD.FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ThreeD.DividerBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource ThreeD.RailBackgroundBrush}"
            BorderBrush="{DynamicResource ThreeD.DividerBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,7,0,0">
                <RadioButton x:Name="AuthoringModeButton"
                             GroupName="WorkspaceMode"
                             IsChecked="{Binding IsAuthoringWorkspaceSelected, Mode=OneWay}"
                             Command="{Binding SelectWorkspaceCommand}"
                             CommandParameter="{x:Static app:ShellWorkspaceMode.Teach}"
                             Style="{StaticResource RailRadioButtonStyle}"
                             ToolTip="{views:ThreeDText Key=ThreeD.Navigation.AuthoringTip, Korean='검사 순서, 도구 설정과 3D 결과를 한 화면에서 편집합니다.', English='Edit the inspection chain, selected tool, and 3D result together.'}"
                             AutomationProperties.AutomationId="AuthoringModeButton"
                             AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.AuthoringAccessible, Korean='검사 작성 워크스페이스', English='Inspection authoring workspace'}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="68">
                        <ui:SymbolIcon Width="19" Height="19" Symbol="WrenchScrewdriver24" />
                        <TextBlock Style="{StaticResource RailLabelStyle}"
                                   Text="{views:ThreeDText Key=ThreeD.Navigation.AuthoringCompact, Korean='티칭', English='Teach'}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ValidateModeButton"
                             GroupName="WorkspaceMode"
                             IsChecked="{Binding IsValidateWorkspaceSelected, Mode=OneWay}"
                             Command="{Binding SelectWorkspaceCommand}"
                             CommandParameter="{x:Static app:ShellWorkspaceMode.Validate}"
                             Style="{StaticResource RailRadioButtonStyle}"
                             ToolTip="{views:ThreeDText Key=ThreeD.Navigation.ValidateTip, Korean='샘플 세트를 실행하고 실패 근거를 검토합니다.', English='Run the sample set and review failure evidence.'}"
                             AutomationProperties.AutomationId="ValidateModeButton"
                             AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.ValidateAccessible, Korean='검사 검증 워크스페이스', English='Validate inspection workspace'}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="68">
                        <ui:SymbolIcon Width="19" Height="19" Symbol="CheckmarkCircle24" />
                        <TextBlock Style="{StaticResource RailLabelStyle}"
                                   Text="{views:ThreeDText Key=ThreeD.Navigation.Validate, Korean='검증', English='Validate'}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="InspectionModeButton"
                             GroupName="WorkspaceMode"
                             IsChecked="{Binding IsInspectWorkspaceSelected, Mode=OneWay}"
                             Command="{Binding SelectWorkspaceCommand}"
                             CommandParameter="{x:Static app:ShellWorkspaceMode.Inspect}"
                             Style="{StaticResource RailRadioButtonStyle}"
                             ToolTip="{views:ThreeDText Key=ThreeD.Navigation.InspectTip, Korean='체크한 파일을 저장된 레시피로 검사합니다.', English='Inspect checked files with the saved recipe.'}"
                             AutomationProperties.AutomationId="InspectionModeButton"
                             AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.InspectAccessible, Korean='파일 검사 워크스페이스', English='File inspection workspace'}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="48">
                        <ui:SymbolIcon Width="19" Height="19" Symbol="PlayCircle24" />
                        <TextBlock Style="{StaticResource RailLabelStyle}"
                                   Text="{views:ThreeDText Key=ThreeD.Navigation.Inspect, Korean='검사', English='Inspect'}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ResultsModeButton"
                             GroupName="WorkspaceMode"
                             IsChecked="{Binding IsResultsWorkspaceSelected, Mode=OneWay}"
                             Command="{Binding SelectWorkspaceCommand}"
                             CommandParameter="{x:Static app:ShellWorkspaceMode.Review}"
                             Style="{StaticResource RailRadioButtonStyle}"
                             ToolTip="{views:ThreeDText Key=ThreeD.Navigation.ResultsTip, Korean='검사 판정, 실행 기록과 출력 비교를 확인합니다.', English='Review decisions, run records, and output comparison.'}"
                             AutomationProperties.AutomationId="ResultsModeButton"
                             AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.ResultsAccessible, Korean='검사 기록', English='Inspection records'}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="68">
                        <ui:SymbolIcon Width="19" Height="19" Symbol="DataHistogram24" />
                        <TextBlock Style="{StaticResource RailLabelStyle}"
                                   Text="{views:ThreeDText Key=ThreeD.Navigation.Results, Korean='기록', English='Records'}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="CalibrateModeButton" Visibility="Collapsed"
                             GroupName="WorkspaceMode"
                             IsChecked="{Binding IsCalibrationWorkspaceSelected, Mode=OneWay}"
                             Command="{Binding SelectWorkspaceCommand}"
                             CommandParameter="{x:Static app:ShellWorkspaceMode.Calibrate}"
                             Style="{StaticResource RailRadioButtonStyle}"
                             ToolTip="{Binding Localization.Calibrate}"
                             AutomationProperties.AutomationId="CalibrateModeButton"
                             AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.CalibrationAccessible, Korean='캘리브레이션 워크스페이스', English='Calibration workspace'}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="68">
                        <ui:SymbolIcon Width="19" Height="19" Symbol="TargetArrow24" />
                        <TextBlock Style="{StaticResource RailLabelStyle}"
                                   Text="{Binding Localization.Calibrate}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="AdvancedModeButton" Visibility="Collapsed"
                             GroupName="WorkspaceMode"
                             IsChecked="{Binding IsExpertWorkspaceSelected, Mode=OneWay}"
                             Command="{Binding SelectWorkspaceCommand}"
                             CommandParameter="{x:Static app:ShellWorkspaceMode.Expert}"
                             Style="{StaticResource RailRadioButtonStyle}"
                             ToolTip="{Binding Localization.OpenAdvancedToolTip}"
                             AutomationProperties.AutomationId="AdvancedModeButton"
                             AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.AdvancedAccessible, Korean='고급 레이아웃', English='Advanced layout'}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="68">
                        <ui:SymbolIcon Width="19" Height="19" Symbol="SettingsCogMultiple24" />
                        <TextBlock Style="{StaticResource RailLabelStyle}"
                                   Text="{views:ThreeDText Key=ThreeD.Navigation.Advanced, Korean='고급', English='Advanced'}" />
                    </StackPanel>
                </RadioButton>

            </StackPanel>

            <Expander Grid.Row="1" x:Name="RailUtilityMenu" Margin="4,0,4,7" AutomationProperties.AutomationId="RailUtilityMenu"
                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.Actions, Korean='설정 메뉴', English='Settings menu'}">
                <Expander.Template>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <ToggleButton x:Name="UtilityToggle" Height="48" Cursor="Hand" Foreground="{DynamicResource ThreeD.SecondaryTextBrush}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="UtilitySurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><ui:SymbolIcon Width="19" Height="19" Symbol="Settings24" /><TextBlock Margin="0,2,0,0" FontSize="11" Text="{views:ThreeDText Key=ThreeD.Navigation.ActionsShort, Korean='설정', English='Setup'}" /></StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="UtilitySurface" Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="UtilitySurface" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="UtilitySurface" Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="UtilitySurface" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" /></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Right" PlacementTarget="{Binding ElementName=UtilityToggle}" AllowsTransparency="True" StaysOpen="False" PreviewKeyDown="OnUtilityMenuPreviewKeyDown"
                                   IsOpen="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border Background="{DynamicResource ThreeD.PanelBrush}" BorderBrush="{DynamicResource ThreeD.DividerBrush}" BorderThickness="1" CornerRadius="6"><ContentPresenter /></Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Expander.Template>
                <StackPanel Width="226" Margin="4">


                <Button x:Name="RecipeManagerButton"
                        Style="{StaticResource RailActionButtonStyle}" Height="36" Margin="0,2" Padding="8,4" HorizontalContentAlignment="Left"
                        Click="OpenRecipeManagerButton_Click"
                        ToolTip="{Binding Localization.OpenRecipeManagerToolTip}"
                        AutomationProperties.AutomationId="OpenRecipeManagerButton"
                        AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.RecipeManagerAccessible, Korean='레시피 관리자 열기', English='Open Recipe Manager'}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:SymbolIcon Width="18" Height="18" Symbol="DocumentBulletList24" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Text="{views:ThreeDText Key=ThreeD.Navigation.RecipeShort, Korean='레시피', English='Recipe'}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ToolLabsMenuButton"
                        Style="{StaticResource RailActionButtonStyle}" Height="36" Margin="0,2" Padding="8,4" HorizontalContentAlignment="Left"
                        Click="OpenToolLabsMenuButton_Click"
                        ToolTip="{Binding Localization.OpenToolLabsToolTip}"
                        AutomationProperties.AutomationId="ToolLabsMenu"
                        AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.ToolLabsAccessible, Korean='도구 실험실 메뉴 열기', English='Open Tool Labs menu'}">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Right"
                                     Background="{DynamicResource ThreeD.PanelBrush}"
                                     Foreground="{DynamicResource ThreeD.TextBrush}">
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.Filter, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="filter"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenFilterToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.FilterToolLabAccessible, Korean='필터 도구 실험실 열기', English='Open Filter Tool Lab'}" />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.HeightDifferenceEdge, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="height-difference-edge"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenEdgeToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.HeightDifferenceEdgeToolLabAccessible, Korean='높이차 에지 도구 실험실 열기', English='Open Height Difference Edge Tool Lab'}" />
                            <Separator />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.TwoPointLine, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="two-point-line"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenTwoPointLineToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.TwoPointLineToolLabAccessible, Korean='2점 직선 도구 실험실 열기', English='Open 2-Point Line Tool Lab'}" />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.ThreePointPlane, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="three-point-plane"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenThreePointPlaneToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.ThreePointPlaneToolLabAccessible, Korean='3점 평면 도구 실험실 열기', English='Open 3-Point Plane Tool Lab'}" />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.DatumPlaneDeviation, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="datum-plane-raw-height-deviation"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenDatumPlaneDeviationToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.DatumPlaneDeviationToolLabAccessible, Korean='기준면 편차 도구 실험실 열기', English='Open Datum Plane Deviation Tool Lab'}" />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.LineIntersection, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="line-intersection"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenLineIntersectionToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.LineIntersectionToolLabAccessible, Korean='직선 교점 도구 실험실 열기', English='Open Line Intersection Tool Lab'}" />
                            <Separator />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.LandmarkCorrespondence, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="landmark-correspondence"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenLandmarkCorrespondenceToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.LandmarkCorrespondenceToolLabAccessible, Korean='랜드마크 대응 도구 실험실 열기', English='Open Landmark Correspondence Tool Lab'}" />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.XYZAffineSolve, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="xyz-affine-solve"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenXYZAffineSolveToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.XYZAffineSolveToolLabAccessible, Korean='XYZ 어파인 계산 도구 실험실 열기', English='Open XYZ Affine Solve Tool Lab'}" />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.XYZAffineApply, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="xyz-affine-apply"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenXYZAffineApplyToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.XYZAffineApplyToolLabAccessible, Korean='XYZ 어파인 적용 도구 실험실 열기', English='Open Apply XYZ Affine Tool Lab'}" />
                            <MenuItem Header="{Binding PlacementTarget.DataContext.Localization.RegridHeightMap, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      Tag="re-grid-height-map"
                                      Click="OpenToolLabMenuItem_Click"
                                      AutomationProperties.AutomationId="OpenRegridHeightMapToolLabButton"
                                      AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.RegridHeightMapToolLabAccessible, Korean='높이 맵 재격자화 도구 실험실 열기', English='Open Re-grid Height Map Tool Lab'}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:SymbolIcon Width="18" Height="18" Symbol="BoxToolbox24" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Text="{Binding Localization.ToolLabs}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ResetLayoutButton"
                        Style="{StaticResource RailActionButtonStyle}" Height="36" Margin="0,2" Padding="8,4" HorizontalContentAlignment="Left"
                        Click="ResetLayoutButton_Click"
                        ToolTip="{views:ThreeDText Key=ThreeD.Navigation.ResetLayoutTip, Korean='저장된 패널 크기와 탭 배치를 기본값으로 되돌립니다.', English='Reset saved panel sizes and tab placement to safe defaults.'}"
                        AutomationProperties.AutomationId="ResetStudioLayoutButton"
                        AutomationProperties.Name="{views:ThreeDText Key=ThreeD.Navigation.ResetLayoutAccessible, Korean='저장된 스튜디오 레이아웃 초기화', English='Reset saved studio layout'}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ui:SymbolIcon Width="18" Height="18" Symbol="ArrowReset24" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Text="{views:ThreeDText Key=ThreeD.Navigation.ResetShort, Korean='초기화', English='Reset'}" />
                    </StackPanel>
                </Button>

            </StackPanel>
            </Expander>
        </Grid>
    </Border>
</UserControl>
