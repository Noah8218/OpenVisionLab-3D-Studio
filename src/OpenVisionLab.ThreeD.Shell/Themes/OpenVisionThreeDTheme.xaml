<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Graphite workbench tokens. Semantic state colors are reserved for
        selection, focus, pass/warning/fail, while the Viewer height map keeps
        its independent scientific color scale.
    -->
    <SolidColorBrush x:Key="ThreeD.AppBackgroundBrush" Color="#090E15" />
    <SolidColorBrush x:Key="ThreeD.PanelBrush" Color="#141B24" />
    <SolidColorBrush x:Key="ThreeD.PanelAlternateBrush" Color="#1B2531" />
    <SolidColorBrush x:Key="ThreeD.CommandBarBrush" Color="#0E151E" />
    <SolidColorBrush x:Key="ThreeD.ControlBrush" Color="#202B38" />
    <SolidColorBrush x:Key="ThreeD.DividerBrush" Color="#334155" />
    <SolidColorBrush x:Key="ThreeD.TextBrush" Color="#E7EEF6" />
    <SolidColorBrush x:Key="ThreeD.PrimaryTextBrush" Color="#F3F7FB" />
    <SolidColorBrush x:Key="ThreeD.SecondaryTextBrush" Color="#BECADA" />
    <SolidColorBrush x:Key="ThreeD.MutedTextBrush" Color="#8796A8" />
    <SolidColorBrush x:Key="ThreeD.PanelHeaderBrush" Color="#080D14" />
    <SolidColorBrush x:Key="ThreeD.PanelHeaderBorderBrush" Color="#27374A" />
    <SolidColorBrush x:Key="ThreeD.PanelHeaderTextBrush" Color="#F5F9FC" />
    <SolidColorBrush x:Key="ThreeD.PanelHeaderMutedTextBrush" Color="#A7B6C7" />
    <SolidColorBrush x:Key="ThreeD.ContextBadgeBrush" Color="#203650" />
    <SolidColorBrush x:Key="ThreeD.AccentBrush" Color="#39C6C1" />
    <SolidColorBrush x:Key="ThreeD.AccentHoverBrush" Color="#56D8D2" />
    <SolidColorBrush x:Key="ThreeD.SelectedSurfaceBrush" Color="#15383D" />
    <SolidColorBrush x:Key="ThreeD.FocusBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="ThreeD.PassBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="ThreeD.WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ThreeD.FailBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="ThreeD.InfoBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="ThreeD.DisabledBrush" Color="#657487" />
    <SolidColorBrush x:Key="ThreeD.ViewportBrush" Color="#070B11" />
    <SolidColorBrush x:Key="ThreeD.ViewportGridBrush" Color="#526B83" />
    <SolidColorBrush x:Key="ThreeD.AxisXBrush" Color="#E05252" />
    <SolidColorBrush x:Key="ThreeD.AxisYBrush" Color="#2F9D62" />
    <SolidColorBrush x:Key="ThreeD.AxisZBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="ThreeD.WarningSurfaceBrush" Color="#3A2A12" />
    <SolidColorBrush x:Key="ThreeD.InfoSurfaceBrush" Color="#12313E" />
    <SolidColorBrush x:Key="ThreeD.PassSurfaceBrush" Color="#123322" />
    <SolidColorBrush x:Key="ThreeD.FailSurfaceBrush" Color="#3A1C27" />
    <SolidColorBrush x:Key="ThreeD.DisabledSurfaceBrush" Color="#222B36" />

    <!--
        WPF-UI's Button template consumes these resource names instead of the
        ordinary WPF Button properties.  Keep that shared template on the
        graphite semantic palette so Appearance=Primary/Secondary does not
        reintroduce the library's light-blue accent.
    -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#202B38" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#E7EEF6" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1B2531" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#15383D" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#39C6C1" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F3F7FB" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#222B36" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#334155" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#657487" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#39C6C1" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#56D8D2" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#15383D" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#071318" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#071318" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#334155" />

    <!--
        The WPF-UI Button template exposes its state brushes as dependency
        properties.  This implicit layer gives those properties deterministic
        graphite states while preserving each control's Appearance contract.
    -->
    <Style TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
        <Setter Property="PressedForeground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource ThreeD.AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AppBackgroundBrush}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Primary" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Primary" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            </MultiTrigger>
            <!-- Keep disabled actions muted even when Appearance=Primary is set. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.WorkflowStateBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="6,2" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ready">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview running">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview ready">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Published">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview stale">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Waiting for upstream">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught / needs correction">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught incomplete">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="empty">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="incomplete">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="stale">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="ready">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="running">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="pass">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="fail">
                <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="error">
                <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="disabled">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.WorkflowStateIconStyle" TargetType="ui:SymbolIcon">
        <Setter Property="Symbol" Value="Clock24" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ready">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview running">
                <Setter Property="Symbol" Value="ArrowClockwise24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview ready">
                <Setter Property="Symbol" Value="Eye24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Published">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview stale">
                <Setter Property="Symbol" Value="ArrowClockwise24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Waiting for upstream">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught / needs correction">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught incomplete">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter Property="Symbol" Value="ErrorCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="empty">
                <Setter Property="Symbol" Value="Clock24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="incomplete">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="stale">
                <Setter Property="Symbol" Value="ArrowClockwise24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="ready">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="running">
                <Setter Property="Symbol" Value="ArrowClockwise24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="pass">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="fail">
                <Setter Property="Symbol" Value="ErrorCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="error">
                <Setter Property="Symbol" Value="ErrorCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="disabled">
                <Setter Property="Symbol" Value="DismissCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.WorkflowStateTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview running"><Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview ready"><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Published"><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview stale"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Waiting for upstream"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught / needs correction"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught incomplete"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="incomplete"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="stale"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="ready"><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="running"><Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="pass"><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="fail"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="disabled"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Shared presentation for the docked workbench evidence panes. -->
    <Style x:Key="ThreeD.DockPanelTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
    </Style>

    <Style x:Key="ThreeD.DockPanelCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ThreeD.DockPanelStatusCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style x:Key="ThreeD.ModeRadioButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="MinWidth" Value="82" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="ModeBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ThreeD.AccentBrush}" />
                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PanelHeaderTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThreeD.PanelTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
    </Style>

    <Style x:Key="ThreeD.WindowHeaderTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PanelHeaderTextBrush}" />
    </Style>

    <Style x:Key="ThreeD.WindowHeaderSubtitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PanelHeaderMutedTextBrush}" />
    </Style>

    <Style x:Key="ThreeD.WindowControlButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PanelHeaderTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.WindowCloseButtonStyle"
           BasedOn="{StaticResource ThreeD.WindowControlButtonStyle}"
           TargetType="{x:Type Button}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.FailBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.FieldLabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
    </Style>

    <Style TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}"
           BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ComboBoxItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          ContentSource="Content"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBoxItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                            <Setter TargetName="ComboBoxItemBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ComboBoxItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                            <Setter TargetName="ComboBoxItemBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ThreeD.AccentBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboBoxItemBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ThreeD.FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ComboBoxItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                            <Setter TargetName="ComboBoxItemBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ThreeD.DividerBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ThreeD.DisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        <Setter Property="Padding" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.CalibrationDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource ThreeD.PanelBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,1" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.CalibrationDataGridHeaderStyle"
           TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.CalibrationDataGridCellStyle"
           TargetType="{x:Type DataGridCell}"
           BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.CalibrationDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ThreeD.PanelBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource ThreeD.PanelBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThreeD.PanelAlternateBrush}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="RowStyle" Value="{StaticResource ThreeD.CalibrationDataGridRowStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ThreeD.CalibrationDataGridHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource ThreeD.CalibrationDataGridCellStyle}" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>
</ResourceDictionary>
