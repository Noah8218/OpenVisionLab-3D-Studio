    <!--
        WPF-UI's Button template consumes these resource names instead of the
        ordinary WPF Button properties.  Keep that shared template on the
        graphite semantic palette so Appearance=Primary/Secondary does not
        reintroduce the library's light-blue accent.
    -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#252D36" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#E4E9EF" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#303A46" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#202730" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#718293" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E4E9EF" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#252D36" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#37424E" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#8B98A6" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#65B9AE" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7BCCC0" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4A9A91" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#11171B" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#11171B" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#37424E" />

    <!-- WPF-UI text templates read these resources for focused and disabled states. -->
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#A2DFD4" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#222A33" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#252D36" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#37424E" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8B98A6" />

    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#65B9AE" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#7BCCC0" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#4A9A91" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#11171B" />
    <SolidColorBrush x:Key="CheckBoxCheckBorderBrush" Color="#65B9AE" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#303A46" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#202730" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" Color="#252D36" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="#37424E" />
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="#8B98A6" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#11171B" />
    <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="#8B98A6" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" Color="#8B98A6" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#7BCCC0" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="#222A33" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillDisabled" Color="#252D36" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="#303A46" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPressed" Color="#202730" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#718293" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeDisabled" Color="#37424E" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePressed" Color="#718293" />

    <!--
        The WPF-UI Button template exposes its state brushes as dependency
        properties.  This implicit layer gives those properties deterministic
        graphite states while preserving each control's Appearance contract.
    -->
    <Style TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Background" Value="{DynamicResource ThreeD.ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.TextBrush}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
        <Setter Property="PressedForeground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.HoverSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PressedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InputBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Primary">
                <Setter Property="PressedBackground" Value="{DynamicResource ThreeD.AccentPressedBrush}" />
                <Setter Property="PressedBorderBrush" Value="{DynamicResource ThreeD.AccentPressedBrush}" />
                <Setter Property="PressedForeground" Value="{DynamicResource ThreeD.PrimaryButtonTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource ThreeD.AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryButtonTextBrush}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Primary" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentHoverBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Primary" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ThreeD.AccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryButtonTextBrush}" />
            </MultiTrigger>
            <!-- Keep keyboard focus visible through appearance and pointer states. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
                <Setter Property="PressedBorderBrush" Value="{DynamicResource ThreeD.FocusBrush}" />
            </Trigger>
            <!-- Keep disabled actions muted even when Appearance=Primary is set. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.WorkflowStateBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="6,2" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ready">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview running">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview ready">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Published">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview stale">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Waiting for upstream">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught / needs correction">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught incomplete">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="empty">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="incomplete">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="stale">
                <Setter Property="Background" Value="{DynamicResource ThreeD.WarningSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="ready">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="running">
                <Setter Property="Background" Value="{DynamicResource ThreeD.InfoSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="pass">
                <Setter Property="Background" Value="{DynamicResource ThreeD.PassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.PassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="fail">
                <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="error">
                <Setter Property="Background" Value="{DynamicResource ThreeD.FailSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="disabled">
                <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.WorkflowStateIconStyle" TargetType="ui:SymbolIcon">
        <Setter Property="Symbol" Value="Clock24" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ready">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview running">
                <Setter Property="Symbol" Value="ArrowClockwise24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview ready">
                <Setter Property="Symbol" Value="Eye24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Published">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview stale">
                <Setter Property="Symbol" Value="ArrowClockwise24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Waiting for upstream">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught / needs correction">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught incomplete">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter Property="Symbol" Value="ErrorCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="empty">
                <Setter Property="Symbol" Value="Clock24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="incomplete">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="stale">
                <Setter Property="Symbol" Value="ArrowClockwise24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="ready">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="running">
                <Setter Property="Symbol" Value="ArrowClockwise24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="pass">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="fail">
                <Setter Property="Symbol" Value="ErrorCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="error">
                <Setter Property="Symbol" Value="ErrorCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="disabled">
                <Setter Property="Symbol" Value="DismissCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThreeD.WorkflowStateTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview running"><Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview ready"><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Published"><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Preview stale"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Waiting for upstream"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught / needs correction"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taught incomplete"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="incomplete"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="stale"><Setter Property="Foreground" Value="{DynamicResource ThreeD.WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="ready"><Setter Property="Foreground" Value="{DynamicResource ThreeD.AccentBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="running"><Setter Property="Foreground" Value="{DynamicResource ThreeD.InfoBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="pass"><Setter Property="Foreground" Value="{DynamicResource ThreeD.PassBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="fail"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ThreeD.FailBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding CanonicalStateKey}" Value="disabled"><Setter Property="Foreground" Value="{DynamicResource ThreeD.DisabledBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Shared presentation for the docked workbench evidence panes. -->
    <Style x:Key="ThreeD.DockPanelTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.PrimaryTextBrush}" />
    </Style>

    <Style x:Key="ThreeD.DockPanelCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ThreeD.DockPanelStatusCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Background" Value="{DynamicResource ThreeD.DisabledSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThreeD.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style x:Key="ThreeD.ModeRadioButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="MinWidth" Value="82" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{DynamicResource ThreeD.SecondaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="ModeBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource ThreeD.AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThreeD.PanelHeaderTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource ThreeD.SelectedSurfaceBrush}" />
