                    Margin="0,0,12,12"
                    Padding="10"
                    Background="#eef9fafb"
                    BorderBrush="#9ca3af"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Text="{Binding PointCloudColorLegendTitle}" />
                    <Border Height="10" Margin="0,8,0,8" CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#0d59f2" Offset="0.0" />
                                <GradientStop Color="#0de6a6" Offset="0.5" />
                                <GradientStop Color="#ffb31a" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="10"
                                   Foreground="#374151"
                                   Text="{Binding PointCloudColorLegendLow}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="#374151"
                                   Text="{Binding PointCloudColorLegendHigh}" />
                    </Grid>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Fill="#0d59f2" />
                            <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="#111827" Text="Lower source Z" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Fill="#ffb31a" />
                            <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="#111827" Text="Higher source Z" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="#6b7280"
                               TextWrapping="Wrap"
                               Text="{Binding PointCloudColorLegendScale}" />
                </StackPanel>
            </Border>
            <Border x:Name="DeviationLegendPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="260"
                    Margin="0,0,12,12"
                    Padding="10"
                    Background="#eef9fafb"
                    BorderBrush="#9ca3af"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Text="Deviation Color Scale" />
                    <Border Height="10" Margin="0,8,0,8" CornerRadius="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#14b8a6" Offset="0.0" />
                                            <GradientStop Color="#facc15" Offset="0.62" />
                                            <GradientStop Color="#ef4444" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaneFlatnessVisible}" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#2563eb" Offset="0.0" />
                                                    <GradientStop Color="#ffffff" Offset="0.5" />
                                                    <GradientStop Color="#ef4444" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="10" Foreground="#374151" Text="{Binding DeviationLegendLowLabel}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   FontSize="10"
                                   Foreground="#374151"
                                   Text="{Binding DeviationLegendMiddleLabel}" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="#374151"
                                   Text="{Binding DeviationLegendHighLabel}" />
                    </Grid>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaneFlatnessVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Fill="#14b8a6" />
                            <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="#111827" Text="Within tolerance" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Fill="#ef4444" />
                            <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="#111827" Text="Fail marker" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="#374151"
                               Text="Blue: below plane | Red: above plane"
                               Visibility="{Binding PlaneFlatnessVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               TextWrapping="Wrap"
                               Text="{Binding DeviationLegendStatus}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="#111827"
                               TextWrapping="Wrap"
                               Text="{Binding DeviationLegendPeak}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="#111827"
                               TextWrapping="Wrap"
                               Text="{Binding DeviationLegendTolerance}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="#6b7280"
                               TextWrapping="Wrap"
                               Text="{Binding DeviationLegendScale}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
