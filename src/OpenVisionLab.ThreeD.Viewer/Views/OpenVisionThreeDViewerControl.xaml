<UserControl x:Class="OpenVisionLab.ThreeD.Viewer.OpenVisionThreeDViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sharpgl="clr-namespace:SharpGL.WPF;assembly=SharpGL.WPF"
             xmlns:localization="clr-namespace:OpenVisionLab.ThreeD.Viewer.Localization"
             xmlns:viewModels="clr-namespace:OpenVisionLab.ThreeD.Viewer.ViewModels"
             Background="#090E15">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <localization:ViewerRuntimeTextConverter x:Key="ViewerRuntimeTextConverter" />
        <Style x:Key="ViewerToolbarComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#E7EEF6" />
            <Setter Property="Background" Value="#202B38" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1B3539" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#15383D" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerToolbarComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Width" Value="116" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#E7EEF6" />
            <Setter Property="Background" Value="#202B38" />
            <Setter Property="BorderBrush" Value="#53657A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ViewerToolbarComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Padding="{TemplateBinding Padding}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  RecognizesAccessKey="True" />
                                                <Border Grid.Column="1"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1,0,0,0">
                                                    <Path Width="8"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0,0 L 4,4 L 8,0"
                                                          Stroke="#BECADA"
                                                          StrokeThickness="1.5" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="#202B38"
                                        BorderBrush="#53657A"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer Margin="2"
                                                  CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B2531" />
                    <Setter Property="BorderBrush" Value="#39C6C1" />
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="Background" Value="#15383D" />
                    <Setter Property="BorderBrush" Value="#39C6C1" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#67E8F9" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#657487" />
                    <Setter Property="Background" Value="#222B36" />
                    <Setter Property="BorderBrush" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E7EEF6" />
            <Setter Property="Background" Value="#202B38" />
            <Setter Property="BorderBrush" Value="#53657A" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15383D" />
                    <Setter Property="BorderBrush" Value="#39C6C1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#657487" />
                    <Setter Property="Background" Value="#222B36" />
                    <Setter Property="BorderBrush" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerToolbarToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E7EEF6" />
            <Setter Property="Background" Value="#202B38" />
            <Setter Property="BorderBrush" Value="#53657A" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#39C6C1" />
                    <Setter Property="Background" Value="#15383D" />
                    <Setter Property="BorderBrush" Value="#39C6C1" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15383D" />
                    <Setter Property="BorderBrush" Value="#39C6C1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.72" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewerToolbarIconButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>
        <Style x:Key="ViewerToolbarIconToggleStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource ViewerToolbarToggleStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="#0E151E"
                BorderBrush="#334155"
                BorderThickness="0,0,0,1"
                ToolTip="{Binding ViewerStatus, Converter={StaticResource ViewerRuntimeTextConverter}}"
                AutomationProperties.HelpText="{Binding ViewerStatus, Converter={StaticResource ViewerRuntimeTextConverter}}">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="18"
                             Height="18"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Canvas Width="16" Height="16">
                            <Path Data="M2,4 L8,1 L14,4 L8,7 Z M2,8 L8,11 L14,8 M2,12 L8,15 L14,12"
                                  Stroke="#BECADA"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <ComboBox Style="{StaticResource ViewerToolbarComboBoxStyle}"
                              ItemsSource="{Binding Display.AvailableGeometryStyles}"
                              SelectedItem="{Binding Display.SelectedGeometryStyle, Mode=TwoWay}"
                              IsEnabled="{Binding Display.CanSelectGeometryStyle, FallbackValue=False}"
                              ToolTip="{localization:ViewerText Key=ThreeD.Viewer.SelectGeometry, Korean='뷰어 형상 스타일을 선택합니다.', English='Select viewer geometry style'}"
                              AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.SelectGeometry, Korean='뷰어 형상 스타일 선택', English='Select viewer geometry style'}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ViewerRuntimeTextConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource ViewerToolbarIconToggleStyle}"
                                  Command="{Binding TopViewCommand}"
                                  IsChecked="{Binding IsTopOrthographicView, Mode=OneWay}"
                                  ToolTip="{localization:ViewerText Key=ThreeD.Viewer.TopViewTip, Korean='ROI 배치를 위한 X/Z 정투영 상단 보기', English='True X/Z orthographic Top view for ROI placement'}"
                                  AutomationProperties.AutomationId="ViewerTopView"
                                  AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.TopViewAccessible, Korean='상단 정투영 보기', English='Top orthographic view'}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="16" Height="16">
                                <Path Data="M2,3 H14 V13 H2 Z M5,6 H11 M8,4 V9 M5.5,7 L8,10 L10.5,7"
                                      Stroke="#BECADA"
                                      StrokeThickness="1.35"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ViewerToolbarIconToggleStyle}"
                                  Command="{Binding PerspectiveViewCommand}"
                                  IsChecked="{Binding IsPerspectiveView, Mode=OneWay}"
                                  ToolTip="{localization:ViewerText Key=ThreeD.Viewer.PerspectiveViewTip, Korean='3D 원근 보기로 돌아갑니다', English='Return to the 3D perspective view'}"
                                  AutomationProperties.AutomationId="ViewerPerspectiveView"
                                  AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.PerspectiveViewAccessible, Korean='원근 보기', English='Perspective view'}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="16" Height="16">
                                <Path Data="M8,1 L14,4.5 V11.5 L8,15 L2,11.5 V4.5 Z M2,4.5 L8,8 L14,4.5 M8,8 V15"
                                      Stroke="#BECADA"
                                      StrokeThickness="1.35"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <Border Width="1"
                            Height="22"
                            Margin="7,0,4,0"
                            VerticalAlignment="Center"
                            Background="#334155" />
                    <Button Style="{StaticResource ViewerToolbarIconButtonStyle}"
                            Command="{Binding FitAllCommand}"
                            ToolTip="{localization:ViewerText Key=ThreeD.Viewer.FitAllTip, Korean='현재 보기 방식으로 전체 모델을 맞춥니다', English='Fit the full model in the current projection'}"
                            AutomationProperties.AutomationId="ViewerFitAll"
                            AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="16" Height="16">
                                <Path Data="M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10"
                                      Stroke="#BECADA"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ViewerToolbarIconButtonStyle}"
                            Command="{Binding FitRoiCommand}"
                            ToolTip="{localization:ViewerText Key=ThreeD.Viewer.FitRoiTip, Korean='선택한 기준 또는 측정 ROI를 화면에 맞춥니다', English='Fit the selected Reference or Measurement ROI'}"
                            AutomationProperties.AutomationId="ViewerFitRoi"
                            AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.FitRoi, Korean='ROI 맞춤', English='Fit ROI'}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="16" Height="16">
                                <Path Data="M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10 M5.5,5.5 H10.5 V10.5 H5.5 Z"
                                      Stroke="#BECADA"
                                      StrokeThickness="1.35"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Menu Margin="4,0,0,0"
                          Padding="0"
                          VerticalAlignment="Center"
                          Background="#1B2531"
                          Foreground="#E7EEF6">
                        <MenuItem x:Name="ViewerViewMenuRoot"
                                  Width="32"
                                  Height="30"
                                  Padding="0"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  FontSize="18"
                                  Header="⋯"
                                  ToolTip="{localization:ViewerText Key=ThreeD.Viewer.ViewCommands, Korean='뷰어 보기 명령', English='Viewer view commands'}"
                                  AutomationProperties.AutomationId="ViewerViewOverflowMenu"
                                  AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.ViewCommands, Korean='뷰어 보기 명령', English='Viewer view commands'}">
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.FitAll, Korean='전체 맞춤', English='Fit all'}"
                                      Command="{Binding FitAllCommand}" />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.FitRoi, Korean='ROI 맞춤', English='Fit ROI'}"
                                      Command="{Binding FitRoiCommand}" />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.FitSelection, Korean='선택 맞춤', English='Fit selection'}"
                                      Command="{Binding FitSelectionCommand}" />
                            <Separator />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.TopView, Korean='상단 정투영', English='Top orthographic'}"
                                      Command="{Binding TopViewCommand}" />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.PerspectiveView, Korean='원근 보기', English='Perspective'}"
                                      Command="{Binding PerspectiveViewCommand}" />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.ResetView, Korean='보기 초기화', English='Reset view'}"
                                      Command="{Binding ResetCommand}" />
                            <Separator />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.Screenshot, Korean='화면 캡처', English='Screenshot'}"
                                      Command="{Binding ScreenshotCommand}" />
                            <Separator />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeight, Korean='ROI 오버레이 높이', English='ROI overlay height'}"
                                      Visibility="{Binding SelectedTeachingGridRectangleVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTip="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeightOffsetTip, Korean='보기 전용 Y축 위치 오프셋입니다. ROI 크기, 측정값, 레시피는 바뀌지 않습니다.', English='View-only Y-position offset. ROI size, measurement, and recipe are unchanged.'}"
                                      AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeight, Korean='ROI 오버레이 높이 · 보기 전용', English='ROI overlay height · view only'}">
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeightDecrease, Korean='아래로', English='Lower'}"
                                          Click="DecreaseTeachingRoiDisplayHeight_Click"
                                          AutomationProperties.AutomationId="TeachingRoiDisplayHeightDecrease"
                                          AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeightDecrease, Korean='ROI 오버레이 Y 위치 낮추기', English='Lower ROI overlay Y position'}" />
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeightIncrease, Korean='위로', English='Raise'}"
                                          Click="IncreaseTeachingRoiDisplayHeight_Click"
                                          AutomationProperties.AutomationId="TeachingRoiDisplayHeightIncrease"
                                          AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeightIncrease, Korean='ROI 오버레이 Y 위치 올리기', English='Raise ROI overlay Y position'}" />
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeightReset, Korean='표면 위치로 초기화', English='Reset to surface'}"
                                          Click="ResetTeachingRoiDisplayHeight_Click"
                                          AutomationProperties.AutomationId="TeachingRoiDisplayHeightReset"
                                          AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.RoiDisplayHeightReset, Korean='ROI 오버레이를 표면 위치로', English='Return ROI overlay to surface position'}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.Profile, Korean='높이 프로파일', English='Height profile'}"
                                      Command="{Binding ProfileCommand}"
                                      AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.OpenProfileAccessible, Korean='높이 프로파일 열기', English='Open height profile'}" />
                            <Separator />
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.LineFitOverlay, Korean='3D 라인 피팅 오버레이', English='3D Line Fit overlay'}"
                                      AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.LineFitOverlayOptions, Korean='3D 라인 피팅 오버레이 표시 옵션', English='3D Line Fit overlay display options'}">
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.InlierPoints, Korean='인라이어 포인트', English='Inlier points'}"
                                          IsCheckable="True"
                                          IsChecked="{Binding LineFitInliersVisible, Mode=TwoWay}" />
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.OutlierPoints, Korean='아웃라이어 포인트', English='Outlier points'}"
                                          IsCheckable="True"
                                          IsChecked="{Binding LineFitOutliersVisible, Mode=TwoWay}" />
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.FittedSegment, Korean='피팅 선분 및 방향', English='Fitted segment and direction'}"
                                          IsCheckable="True"
                                          IsChecked="{Binding LineFitSegmentVisible, Mode=TwoWay}" />
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.SelectedResidual, Korean='선택 잔차', English='Selected residual'}"
                                          IsCheckable="True"
                                          IsChecked="{Binding LineFitSelectedResidualVisible, Mode=TwoWay}" />
                            </MenuItem>
                            <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.IntersectionOverlay, Korean='라인 교차점 오버레이', English='Line Intersection overlay'}"
                                      AutomationProperties.Name="{localization:ViewerText Key=ThreeD.Viewer.IntersectionOverlayOptions, Korean='라인 교차점 오버레이 표시 옵션', English='Line Intersection overlay display options'}">
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.FirstFittedLine, Korean='첫 번째 피팅 라인', English='First fitted line'}"
                                          IsCheckable="True"
                                          IsChecked="{Binding LineIntersectionFirstLineVisible, Mode=TwoWay}" />
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.SecondFittedLine, Korean='두 번째 피팅 라인', English='Second fitted line'}"
                                          IsCheckable="True"
                                          IsChecked="{Binding LineIntersectionSecondLineVisible, Mode=TwoWay}" />
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.ClosestConnector, Korean='최근접 연결선', English='Closest-approach connector'}"
                                          IsCheckable="True"
                                          IsChecked="{Binding LineIntersectionClosestConnectorVisible, Mode=TwoWay}" />
                                <MenuItem Header="{localization:ViewerText Key=ThreeD.Viewer.CornerAnchor, Korean='코너 앵커 중점', English='Corner anchor midpoint'}"
                                          IsCheckable="True"
                                          IsChecked="{Binding LineIntersectionCornerAnchorVisible, Mode=TwoWay}" />
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="LeftSidePanel"
                DockPanel.Dock="Left"
                Width="240"
                Background="#ffffff"
                BorderBrush="#d1d5db"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Entities" />
                <CheckBox Margin="0,12,0,0"
                          Content="Generated Unit Cube"
                          IsChecked="{Binding CubeVisible, Mode=TwoWay}" />
                <CheckBox Margin="0,8,0,0"
                          Content="Generated Point Cloud"
                          IsChecked="{Binding PointCloudVisible, Mode=TwoWay}" />
                <CheckBox Margin="0,8,0,0"
                          Content="Thickness Coupon v1"
                          IsChecked="{Binding C3DSampleVisible, Mode=TwoWay}" />
                <CheckBox Margin="0,8,0,0"
                          Content="{Binding ImportedMeshLayerLabel}"
                          IsChecked="{Binding GlbSampleVisible, Mode=TwoWay}" />
                <CheckBox Margin="0,8,0,0"
                          Content="Public LAZ/LAS Point Cloud"
                          IsChecked="{Binding LazSampleVisible, Mode=TwoWay}" />
                <Separator Margin="0,14,0,10" />
                <StackPanel DataContext="{Binding NominalActual}">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="Nominal / Actual" />
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding ActualSourceSummary, FallbackValue='Actual: not loaded'}" />
                    <TextBlock Margin="0,3,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding NominalSourceSummary, FallbackValue='Nominal: not loaded'}" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#6b7280"
                               TextWrapping="Wrap"
                               Text="{Binding QuerySourceSummary, FallbackValue='Validation query: not loaded'}" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#6b7280"
                               TextWrapping="Wrap"
                               Text="{Binding FrameSummary, FallbackValue='Frame: not set | Units: not set'}" />
                    <WrapPanel Margin="0,7,0,0">
                        <CheckBox Margin="0,0,12,0"
                                  Content="Actual"
                                  IsChecked="{Binding ActualVisible, Mode=TwoWay, FallbackValue=False}"
                                  IsEnabled="{Binding InputsReady, FallbackValue=False}" />
                        <CheckBox Content="Nominal"
                                  IsChecked="{Binding NominalVisible, Mode=TwoWay, FallbackValue=False}"
                                  IsEnabled="{Binding InputsReady, FallbackValue=False}" />
                    </WrapPanel>
                </StackPanel>
                <Separator Margin="0,14,0,10" />
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Display" />
                <TextBlock Margin="0,10,0,4" Foreground="#6b7280" Text="Geometry Style" />
                <ComboBox ItemsSource="{Binding Display.AvailableGeometryStyles}"
                          SelectedItem="{Binding Display.SelectedGeometryStyle, Mode=TwoWay}"
                          IsEnabled="{Binding Display.CanSelectGeometryStyle, FallbackValue=False}">
                </ComboBox>
                <TextBlock Margin="0,10,0,4" Foreground="#6b7280" Text="Color Map" />
                <ComboBox ItemsSource="{Binding Display.AvailableColorMaps}"
                          SelectedItem="{Binding Display.SelectedColorMap, Mode=TwoWay}"
